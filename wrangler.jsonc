{
	// 站点以 Workers 部署（main Worker + 静态资源 assets）：
	// `npm run build` 产物 dist/ 整体上传；有匹配资源时由 assets 直接服务
	// （不计 Worker 请求），未匹配路径（如 /api/bark）进 Worker 处理。
	"name": "blog",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	// 友链申请推送的限次走 BARK_LIMIT KV（每人每天一次 + 全站每天 20 条），
	// 命名空间已在云端创建（remote: true，本地 dev 也直连真 KV）。
	// 主域直接给博客。旧域名 snark.casa 已弃用（2026-10-30 到期，不再续费）；
	// 若还想让旧域名多撑几天，临时加回一条：
	// { "pattern": "blog.snark.casa", "custom_domain": true }
	"routes": [
		{
			"pattern": "snarkm.com",
			"custom_domain": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "BARK_LIMIT",
			"id": "dceb58263d9b4220a7b4fe943f1f13e5",
			"remote": true
		}
	]
}