---
import { getCollection } from "astro:content";
import { tagPath } from "../utils/urls";

const posts = await getCollection("posts");
const allTags = new Map<string, number>();

for (const post of posts) {
  if (post.data.draft) continue;
  for (const tag of post.data.tags) {
    allTags.set(tag, (allTags.get(tag) || 0) + 1);
  }
}

// Sort by count descending, then alphabetically
const sortedTags = [...allTags.entries()].sort((a, b) => {
  const diff = b[1] - a[1];
  return diff !== 0 ? diff : a[0].localeCompare(b[0]);
});
---

{
  sortedTags.length > 0 ? (
    <ul class="m-0 flex list-none flex-wrap gap-2.5 p-0">
      {sortedTags.map(([tag, count]) => (
        <li>
          <a href={tagPath(tag)} class="tag-chip">
            {tag}
            <b aria-hidden="true">{count}</b>
            <span class="sr-only">{count} 篇</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty-note">还没有标签。</p>
  )
}
