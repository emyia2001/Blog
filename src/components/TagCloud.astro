---
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
const allTags = new Map<string, number>();

for (const post of posts) {
  if (post.data.draft) continue;
  for (const tag of post.data.tags) {
    allTags.set(tag, (allTags.get(tag) || 0) + 1);
  }
}

// Sort by count descending, then alphabetically
const sortedTags = [...allTags.entries()].sort((a, b) => {
  const diff = b[1] - a[1];
  return diff !== 0 ? diff : a[0].localeCompare(b[0]);
});
---

<div class="flex flex-wrap gap-3">
  {sortedTags.map(([tag, count]) => (
    <a
      href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}`}
      class="inline-flex items-center gap-1.5 border border-[var(--color-ed-faint)] px-3 py-1.5 text-xs tracking-[0.1em] text-[var(--color-ed-muted)] no-underline transition-all duration-200 hover:border-[var(--color-ed-fg)] hover:text-[var(--color-ed-fg)]"
    >
      {tag}
      <span class="text-[10px] text-[var(--color-ed-subtle)] tabular-nums">{count}</span>
    </a>
  ))}
</div>
