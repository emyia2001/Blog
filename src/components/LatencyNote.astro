---
/**
 * 首次访问延迟提示（首页左下角小浮条，单行：延迟 42 ms）
 *
 * - 每个浏览器会话只在首页出现一次：sessionStorage 记忆，跳过则连元素都不留。
 * - 数值取 Navigation Timing 的 TTFB（responseStart − requestStart），浏览器已测好，
 *   不额外发请求；命中本地缓存 / bfcache / 不支持该 API 时读数为 0，此时退化为对
 *   同源小文件发一次 cache: no-store 请求实测往返，避免报出一个假的 0 ms。
 * - 出现约 6 秒后自动淡出，悬停/聚焦暂停计时；点击浮条或按 Esc 也会提前收起。
 *   显示期间给 <html> 挂 .latency-note-open，CSS 借此把左下角「回到顶部」按钮上移避让。
 * - 动画与淡出在 CSS 里做，prefers-reduced-motion 下只保留淡入淡出。
 */
---

<aside
  id="latency-note"
  class="latency-note"
  role="status"
  aria-live="polite"
  title="首字节响应耗时（TTFB）· 每个会话只提示一次"
  hidden
>
  <span class="latency-note__bar" aria-hidden="true"></span>
  <span class="latency-note__label">延迟</span>
  <b class="latency-note__value" data-latency-ms>—</b>
  <span class="latency-note__unit">ms</span>
</aside>

<script>
  const STORAGE_KEY = "snark:latency-note";
  const AUTO_HIDE_MS = 6000;
  const EXIT_MS = 420;

  /** 首字节响应耗时（TTFB）：命中缓存 / bfcache 时为 0，视为测不到 */
  function measureTtfb(): number | null {
    try {
      const nav = performance.getEntriesByType("navigation")[0] as
        | PerformanceNavigationTiming
        | undefined;
      if (!nav) return null;
      const ms = nav.responseStart - nav.requestStart;
      return Number.isFinite(ms) && ms > 0 ? ms : null;
    } catch {
      return null;
    }
  }

  /** 兜底：对同源小文件量一次往返（只有缓存命中时才会走到这里） */
  async function measureRtt(): Promise<number | null> {
    const started = performance.now();
    try {
      await fetch("/favicon.svg", { cache: "no-store", credentials: "same-origin" });
    } catch {
      return null;
    }
    const ms = performance.now() - started;
    return Number.isFinite(ms) && ms > 0 ? ms : null;
  }

  function initLatencyNote() {
    const found = document.querySelector<HTMLElement>("#latency-note");
    if (!found || found.dataset.init === "1") return;
    // 收窄成非空的具名常量：闭包里 TS 不保留外层收窄结果
    const note: HTMLElement = found;
    note.dataset.init = "1";

    // 本会话已经提示过：直接移除，连占位节点都不留
    let seen = false;
    try {
      seen = sessionStorage.getItem(STORAGE_KEY) === "1";
    } catch {
      // 隐私模式禁用存储：无法记忆，就照常提示，不做额外处理
    }
    if (seen) {
      note.remove();
      return;
    }

    const valueEl = note.querySelector<HTMLElement>("[data-latency-ms]");

    let timer = 0;
    let remaining = AUTO_HIDE_MS;
    let startedAt = 0;
    let isOpen = false;

    function clearTimer() {
      if (timer) {
        window.clearTimeout(timer);
        timer = 0;
      }
    }

    function dismiss() {
      if (!isOpen) return;
      isOpen = false;
      clearTimer();
      note.classList.remove("is-open");
      // 撤掉避让标记，左下角「回到顶部」会自动落回原位
      document.documentElement.classList.remove("latency-note-open");
      window.setTimeout(() => {
        note.hidden = true;
        note.remove();
      }, EXIT_MS);
      window.removeEventListener("keydown", onKeyDown);
    }

    function onKeyDown(event: KeyboardEvent) {
      if (event.key === "Escape") dismiss();
    }

    function schedule(delay: number) {
      clearTimer();
      remaining = delay;
      startedAt = performance.now();
      timer = window.setTimeout(dismiss, delay);
    }

    function pause() {
      if (!isOpen || !timer) return;
      clearTimer();
      remaining = Math.max(0, remaining - (performance.now() - startedAt));
    }

    function resume() {
      if (!isOpen || timer) return;
      schedule(Math.max(remaining, 900));
    }

    async function show() {
      let ms = measureTtfb();
      if (ms === null) ms = await measureRtt();
      // 两种口径都测不到就不打扰
      if (ms === null) {
        note.remove();
        return;
      }

      if (valueEl) valueEl.textContent = ms < 1 ? "<1" : String(Math.round(ms));

      note.hidden = false;
      // 给 <html> 挂标记：CSS 借此把左下角「回到顶部」按钮上移，避免叠在一起
      document.documentElement.classList.add("latency-note-open");
      // 两帧后再加类：元素刚从 hidden 显示出来时直接加类，过渡不会跑
      requestAnimationFrame(() => {
        requestAnimationFrame(() => note.classList.add("is-open"));
      });

      isOpen = true;
      schedule(AUTO_HIDE_MS);

      try {
        sessionStorage.setItem(STORAGE_KEY, "1");
      } catch {
        // 存不进去就只能在每次加载时提示，接受这个降级
      }

      note.addEventListener("pointerenter", pause);
      note.addEventListener("pointerleave", resume);
      note.addEventListener("focusin", pause);
      note.addEventListener("focusout", resume);
      note.addEventListener("click", dismiss);
      window.addEventListener("keydown", onKeyDown);
    }

    void show();
  }

  initLatencyNote();
  // View Transitions 站内跳转后 DOM 已换，需要重新初始化
  document.addEventListener("astro:page-load", initLatencyNote);
</script>
