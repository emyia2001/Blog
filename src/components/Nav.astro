---
const navLinks = [
  { href: "/", label: "首页" },
  { href: "/timeline", label: "纪事" },
  { href: "/notes", label: "随感" },
  { href: "/archive", label: "归档" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<nav
  class="sticky top-0 z-40 border-b border-[var(--color-ed-faint)]"
  style="background: var(--color-ed-bg); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
>
  <div class="h-0.5 w-full bg-[var(--color-ed-accent)] opacity-70" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a
      href="/"
      class="flex items-baseline gap-3 font-serif text-lg tracking-[0.08em] text-[var(--color-ed-fg)] no-underline"
    >
      <span>Snark</span>
      <span class="hidden sm:inline font-sans text-[10px] tracking-[0.28em] text-[var(--color-ed-subtle)]">
        JOURNAL
      </span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
        return (
          <li>
            <a
              href={link.href}
              class={`text-xs tracking-[0.05em] no-underline transition-colors duration-200 ${
                isActive
                  ? "text-[var(--color-ed-accent)]"
                  : "text-[var(--color-ed-muted)] hover-underline"
              }`}
            >
              {link.label}
            </a>
          </li>
        );
      })}
      <li>
        <button
          type="button"
          data-open-search
          class="hover-underline text-xs tracking-[0.05em] text-[var(--color-ed-muted)]"
        >
          搜索
        </button>
      </li>
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="nav-toggle"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="切换菜单"
      aria-expanded="false"
    >
      <span class="block h-px w-5 bg-[var(--color-ed-fg)] transition-transform duration-300"></span>
      <span class="block h-px w-5 bg-[var(--color-ed-fg)] transition-opacity duration-300"></span>
      <span class="block h-px w-5 bg-[var(--color-ed-fg)] transition-transform duration-300"></span>
    </button>
  </div>
</nav>

  <!-- Mobile drawer + backdrop, clipped to the viewport so the off-canvas
       drawer never creates horizontal scroll on mobile -->
  <div class="fixed inset-0 z-50 overflow-hidden pointer-events-none md:hidden">
    <div
      id="nav-backdrop"
      class="absolute inset-0 z-40 hidden bg-black/20 pointer-events-auto"
      aria-hidden="true"
    ></div>

    <div
      id="nav-drawer"
      class="absolute inset-y-0 right-0 z-50 w-72 translate-x-full border-l border-[var(--color-ed-faint)] p-8 transition-transform duration-300 pointer-events-auto"
      style="background: var(--color-ed-bg);"
      aria-hidden="true"
    >
      <div class="flex justify-end mb-12">
        <button id="nav-close" class="p-2" aria-label="关闭菜单">
          <span class="block font-serif text-2xl leading-none">&times;</span>
        </button>
      </div>
      <ul class="flex flex-col gap-6">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-serif text-xl text-[var(--color-ed-fg)] no-underline"
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <button
            type="button"
            data-open-search
            class="font-serif text-xl text-[var(--color-ed-fg)]"
          >
            搜索
          </button>
        </li>
      </ul>
    </div>
  </div>

<script>
  // 注:本站启用了 Astro View Transitions,站内跳转会 SPA 式替换 <body> 内 DOM,
  // 直接绑在元素上的监听器会随旧节点一起丢失。因此这里统一使用
  // document 级事件委托,并在每次 astro:page-load 后重新获取元素引用。

  function getRefs() {
    return {
      toggle: document.getElementById("nav-toggle"),
      drawer: document.getElementById("nav-drawer"),
      backdrop: document.getElementById("nav-backdrop"),
      close: document.getElementById("nav-close"),
    };
  }

  function open() {
    const { drawer, backdrop, toggle } = getRefs();
    drawer?.classList.remove("translate-x-full");
    backdrop?.classList.remove("hidden");
    toggle?.setAttribute("aria-expanded", "true");
    drawer?.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeDrawer() {
    const { drawer, backdrop, toggle } = getRefs();
    drawer?.classList.add("translate-x-full");
    backdrop?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
    drawer?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  // 每次页面加载(VT 换页后也会触发)重新绑定可点击区域的状态,并兜底关闭残留抽屉
  document.addEventListener("astro:page-load", () => {
    closeDrawer();
    const { drawer } = getRefs();
    const mq = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (mq.matches && drawer) {
      drawer.style.transition = "none";
    }
  });

  // 事件委托:hamburger 打开/关闭
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const toggle = target.closest("#nav-toggle");
    if (toggle) {
      e.preventDefault();
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      isOpen ? closeDrawer() : open();
      return;
    }
    // 抽屉内的关闭按钮 / 背板点击关闭
    if (target.closest("#nav-close") || target.closest("#nav-backdrop")) {
      closeDrawer();
      return;
    }
    // 抽屉内的搜索按钮:关闭抽屉后打开搜索弹层(SearchModal 监听 open-search)
    if (target.closest("[data-open-search]")) {
      closeDrawer();
      document.dispatchEvent(new CustomEvent("open-search"));
    }
  });

  // Escape 关闭(委托到 document,天然跨 VT 存活)
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const { toggle } = getRefs();
      if (toggle?.getAttribute("aria-expanded") === "true") closeDrawer();
    }
  });
</script>
