---
import { SITE_NAME } from "../consts";
import { ROUTES } from "../utils/urls";

const navLinks = [
  { href: ROUTES.home, label: "首页" },
  { href: ROUTES.timeline, label: "纪事" },
  { href: ROUTES.graph, label: "图谱" },
  { href: ROUTES.projects, label: "项目" },
  { href: ROUTES.archive, label: "归档" },
  { href: ROUTES.friends, label: "友链" },
];

// 开往（Travellings）友链接力：外链需放在打开网站即可见的位置（顶栏/侧栏）
const TRAVELLINGS_HREF = "https://www.travellings.cn/go.html";
const travellingsAttrs = {
  href: TRAVELLINGS_HREF,
  target: "_blank",
  rel: "noopener noreferrer",
  title: "开往 · 友链接力",
};

// 去尾斜杠后比较：ROUTES 里的路径带尾斜杠，而 Astro.url.pathname 依产物形态而定，
// 原来直接 === 比较导致「当前页」永远匹配不上（导航从不显示选中态）。
const normalize = (p: string) => p.replace(/\/$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
const isActivePath = (href: string) => {
  const target = normalize(href);
  return currentPath === target ||
    (target !== "/" && currentPath.startsWith(`${target}/`));
};
---

<nav
  class="site-nav sticky top-0 z-40 border-b border-[var(--color-ed-rule)]"
  style="background: var(--color-ed-bg); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); view-transition-name: site-nav;"
  aria-label="站点导航"
>
  <div class="h-0.5 w-full bg-[var(--color-ed-accent)] opacity-70" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-[1380px] items-center justify-between px-6 py-4 md:px-8">
    <a
      href="/"
      class="flex items-baseline gap-3 font-serif text-lg tracking-[0.08em] text-[var(--color-ed-fg)] no-underline"
    >
      <span>{SITE_NAME}</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => {
        const isActive = isActivePath(link.href);
        return (
          <li>
            <a
              href={link.href}
              class={`nav-link ${isActive ? "is-active" : ""}`}
              aria-current={isActive ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        );
      })}
      <li>
        <a {...travellingsAttrs} class="nav-link">开往</a>
      </li>
      <li>
        <button type="button" data-open-search class="nav-link nav-link--button">
          搜索
        </button>
      </li>
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="nav-toggle"
      class="md:hidden flex h-11 w-11 flex-col items-center justify-center gap-1.5"
      aria-label="切换菜单"
      aria-expanded="false"
      aria-controls="nav-drawer"
    >
      <span class="block h-px w-5 bg-[var(--color-ed-fg)] transition-transform duration-300"></span>
      <span class="block h-px w-5 bg-[var(--color-ed-fg)] transition-opacity duration-300"></span>
      <span class="block h-px w-5 bg-[var(--color-ed-fg)] transition-transform duration-300"></span>
    </button>
  </div>
</nav>

  <!-- Mobile drawer + backdrop, clipped to the viewport so the off-canvas
       drawer never creates horizontal scroll on mobile -->
  <div class="fixed inset-0 z-50 overflow-hidden pointer-events-none md:hidden">
    <div
      id="nav-backdrop"
      class="absolute inset-0 z-40 hidden bg-black/25 pointer-events-auto"
      aria-hidden="true"
    ></div>

    <div
      id="nav-drawer"
      class="absolute inset-y-0 right-0 z-50 w-72 translate-x-full border-l border-[var(--color-ed-rule)] p-8 transition-transform duration-300 pointer-events-auto"
      style="background: var(--color-ed-bg);"
      aria-hidden="true"
      inert
    >
      <div class="flex justify-end mb-10">
        <button
          id="nav-close"
          class="-mr-2 flex h-11 w-11 items-center justify-center"
          aria-label="关闭菜单"
        >
          <span class="block font-serif text-2xl leading-none">&times;</span>
        </button>
      </div>
      <ul class="flex flex-col gap-1">
        {navLinks.map((link) => {
          const isActive = isActivePath(link.href);
          return (
            <li>
              <a
                href={link.href}
                class={`nav-drawer-link ${isActive ? "is-active" : ""}`}
                aria-current={isActive ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
        <li>
          <a {...travellingsAttrs} class="nav-drawer-link">开往</a>
        </li>
        <li>
          <button type="button" data-open-search class="nav-drawer-link">
            搜索
          </button>
        </li>
      </ul>
    </div>
  </div>

<style>
  /* 向下滚动收起、向上滚动露出（由脚本切换 .is-hidden） */
  .site-nav {
    transition: transform 320ms var(--ease-ed);
  }
  .site-nav.is-hidden {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav {
      transition: none;
    }
  }

  /* 桌面导航：下划线随 hover/当前页展开，当前页用砖红点出 */
  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.4rem 0.7rem;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--color-ed-muted);
    text-decoration: none;
    white-space: nowrap;
    border-radius: 6px;
    transition:
      color 180ms ease,
      background-color 220ms ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.35rem;
    height: 1px;
    background: var(--color-ed-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 220ms var(--ease-ed);
  }
  .nav-link:hover {
    color: var(--color-ed-fg);
    background: rgba(28, 28, 28, 0.04);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }
  .nav-link.is-active {
    color: var(--color-ed-accent);
    background: rgba(166, 58, 43, 0.06);
  }
  .nav-link--button {
    border: 0;
    background: none;
    font-family: inherit;
    cursor: pointer;
  }

  /* 移动抽屉：左侧细线标出当前页，整行 44px 命中 */
  .nav-drawer-link {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.35rem 0 0.35rem 0.85rem;
    border: 0;
    border-left: 2px solid transparent;
    background: none;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--color-ed-fg);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 220ms ease,
      transform 200ms var(--ease-ed);
  }
  .nav-drawer-link:hover {
    color: var(--color-ed-accent);
    background: rgba(166, 58, 43, 0.06);
    transform: translateX(3px);
  }
  .nav-drawer-link.is-active {
    color: var(--color-ed-accent);
    border-left-color: var(--color-ed-accent);
  }
</style>

<script>
  // 注:本站启用了 Astro View Transitions,站内跳转会 SPA 式替换 <body> 内 DOM,
  // 直接绑在元素上的监听器会随旧节点一起丢失。因此这里统一使用
  // document 级事件委托,并在每次 astro:page-load 后重新获取元素引用。

  function getRefs() {
    return {
      toggle: document.getElementById("nav-toggle"),
      drawer: document.getElementById("nav-drawer"),
      backdrop: document.getElementById("nav-backdrop"),
      close: document.getElementById("nav-close"),
    };
  }

  // 关闭态用 inert：仅靠 translate-x-full 隐藏时，抽屉里的 6 个链接仍在 Tab 序列里
  function open() {
    const { drawer, backdrop, toggle } = getRefs();
    drawer?.classList.remove("translate-x-full");
    drawer?.removeAttribute("inert");
    backdrop?.classList.remove("hidden");
    toggle?.setAttribute("aria-expanded", "true");
    drawer?.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    // 焦点移入抽屉，键盘用户不会「打开后还在原地」
    drawer?.querySelector<HTMLElement>("a, button")?.focus();
  }

  function closeDrawer(restoreFocus = false) {
    const { drawer, backdrop, toggle } = getRefs();
    const wasOpen = toggle?.getAttribute("aria-expanded") === "true";
    drawer?.classList.add("translate-x-full");
    drawer?.setAttribute("inert", "");
    backdrop?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
    drawer?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    if (restoreFocus && wasOpen) toggle?.focus();
  }

  // 每次页面加载(VT 换页后也会触发)重新绑定可点击区域的状态,并兜底关闭残留抽屉
  document.addEventListener("astro:page-load", () => {
    closeDrawer();
    const { drawer } = getRefs();
    const mq = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (mq.matches && drawer) {
      drawer.style.transition = "none";
    }
  });

  // 事件委托:hamburger 打开/关闭
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const toggle = target.closest("#nav-toggle");
    if (toggle) {
      e.preventDefault();
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      isOpen ? closeDrawer() : open();
      return;
    }
    // 抽屉内的关闭按钮 / 背板点击关闭
    if (target.closest("#nav-close") || target.closest("#nav-backdrop")) {
      closeDrawer(true);
      return;
    }
    // 抽屉内的搜索按钮:关闭抽屉后打开搜索弹层(SearchModal 监听 open-search)
    if (target.closest("[data-open-search]")) {
      closeDrawer();
      document.dispatchEvent(new CustomEvent("open-search"));
    }
  });

  // 向下滚动时收起导航、向上滚动时露出：按累计滚动量判断，慢速滚动也能触发
  let lastScrollY = window.scrollY;
  let scrollAcc = 0;
  function setNavHidden(hidden: boolean) {
    document.querySelector(".site-nav")?.classList.toggle("is-hidden", hidden);
    document.documentElement.classList.toggle("nav-hidden", hidden);
  }
  window.addEventListener(
    "scroll",
    () => {
      const y = window.scrollY;
      const dy = y - lastScrollY;
      lastScrollY = y;
      if (y < 80) {
        scrollAcc = 0;
        setNavHidden(false);
        return;
      }
      if (dy * scrollAcc < 0) scrollAcc = 0;
      scrollAcc += dy;
      if (scrollAcc > 24 && document.body.style.overflow !== "hidden") setNavHidden(true);
      else if (scrollAcc < -12) setNavHidden(false);
    },
    { passive: true }
  );
  // 键盘聚焦进导航时必须露出；换页后状态重置
  document.addEventListener("focusin", (e) => {
    if ((e.target as HTMLElement | null)?.closest?.(".site-nav")) setNavHidden(false);
  });
  document.addEventListener("astro:page-load", () => {
    lastScrollY = window.scrollY;
    scrollAcc = 0;
    setNavHidden(false);
  });

  // Escape 关闭(委托到 document,天然跨 VT 存活)
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const { toggle } = getRefs();
      if (toggle?.getAttribute("aria-expanded") === "true") closeDrawer(true);
    }
  });
</script>
