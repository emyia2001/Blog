---
import { SITE_NAME } from "../consts";
import { ROUTES } from "../utils/urls";

const navLinks = [
  { href: ROUTES.home, label: "首页" },
  { href: ROUTES.timeline, label: "纪事" },
  { href: ROUTES.archive, label: "归档" },
  { href: ROUTES.collection, label: "拾集" },
  { href: ROUTES.friends, label: "友链" },
];

// 开往（Travellings）友链接力：外链需放在打开网站即可见的位置（顶栏/侧栏）
const TRAVELLINGS_HREF = "https://www.travellings.cn/go.html";
const travellingsAttrs = {
  href: TRAVELLINGS_HREF,
  target: "_blank",
  rel: "noopener noreferrer",
  title: "开往 · 友链接力",
};

// 去尾斜杠后比较：ROUTES 里的路径带尾斜杠，而 Astro.url.pathname 依产物形态而定，
// 原来直接 === 比较导致「当前页」永远匹配不上（导航从不显示选中态）。
const normalize = (p: string) => p.replace(/\/$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
const isActivePath = (href: string) => {
  const target = normalize(href);
  return currentPath === target ||
    (target !== "/" && currentPath.startsWith(`${target}/`));
};
---

<nav
  class="site-nav sticky top-0 z-40 border-b border-[var(--color-ed-rule)]"
  style="background: var(--color-ed-bg); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); view-transition-name: site-nav;"
  aria-label="站点导航"
>
  <div class="h-0.5 w-full bg-[var(--color-ed-accent)] opacity-70" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-[1380px] items-center justify-between px-6 py-4 md:px-8">
    <a
      href="/"
      class="flex items-baseline gap-3 font-serif text-lg tracking-[0.08em] text-[var(--color-ed-fg)] no-underline"
    >
      <span>{SITE_NAME}</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => {
        const isActive = isActivePath(link.href);
        return (
          <li>
            <a
              href={link.href}
              class={`nav-link ${isActive ? "is-active" : ""}`}
              aria-current={isActive ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        );
      })}
      <li>
        <a {...travellingsAttrs} class="nav-link">开往</a>
      </li>
      <li>
        <button type="button" data-open-search class="nav-link nav-link--button">
          搜索
        </button>
      </li>
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="nav-toggle"
      class="md:hidden flex h-11 w-11 flex-col items-center justify-center gap-1.5"
      aria-label="切换菜单"
      aria-expanded="false"
      aria-controls="nav-drawer"
    >
      <span class="block h-px w-5 bg-[var(--color-ed-fg)]"></span>
      <span class="block h-px w-5 bg-[var(--color-ed-fg)]"></span>
      <span class="block h-px w-5 bg-[var(--color-ed-fg)]"></span>
    </button>
  </div>
</nav>

  <!-- Mobile drawer + backdrop, clipped to the viewport so the off-canvas
       drawer never creates horizontal scroll on mobile -->
  <div class="fixed inset-0 z-50 overflow-hidden pointer-events-none md:hidden">
    <!-- 遮罩不做 hidden 瞬切：由 CSS 用 opacity 收口（开 180ms / 关 220ms）。
         两者都从导航下沿开始，汉堡 X 因此不被盖住、始终可点。 -->
    <div id="nav-backdrop" class="absolute inset-0 z-40 bg-black/25" aria-hidden="true"></div>

    <div
      id="nav-drawer"
      class="absolute inset-y-0 right-0 z-50 w-72 translate-x-full border-l border-[var(--color-ed-rule)] p-8 pointer-events-auto"
      style="background: var(--color-ed-bg);"
      aria-hidden="true"
      inert
    >
      <div class="flex justify-end mb-10">
        <button
          id="nav-close"
          class="-mr-2 flex h-11 w-11 items-center justify-center"
          aria-label="关闭菜单"
        >
          <span class="block font-serif text-2xl leading-none">&times;</span>
        </button>
      </div>
      <ul class="flex flex-col gap-1">
        {navLinks.map((link, i) => {
          const isActive = isActivePath(link.href);
          return (
            <li>
              <a
                href={link.href}
                class={`nav-drawer-link ${isActive ? "is-active" : ""}`}
                style={`--i:${i}`}
                aria-current={isActive ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
        <li>
          <a {...travellingsAttrs} class="nav-drawer-link" style="--i:5">开往</a>
        </li>
        <li>
          <button type="button" data-open-search class="nav-drawer-link" style="--i:6">
            搜索
          </button>
        </li>
      </ul>
    </div>
  </div>

<style>
  /* 向下滚动收起、向上滚动露出（由脚本切换 .is-hidden） */
  .site-nav {
    transition: transform 320ms var(--ease-ed);
  }
  .site-nav.is-hidden {
    transform: translateY(-100%);
  }
  /* 抽屉内滚动不穿透到背后的页面 */
  #nav-drawer {
    overscroll-behavior: contain;
  }

  /* 抽屉与遮罩都从导航下沿开始：汉堡 X 落在遮罩之上，开着也能再点一次关掉。
     --nav-h 由脚本按实际导航高度写入，脚本失效时退回 4.875rem。 */
  #nav-backdrop,
  #nav-drawer {
    top: var(--nav-h, 4.875rem);
  }

  /* 遮罩：不用 hidden 瞬切，纯 opacity 收口（开 180ms / 关 220ms） */
  #nav-backdrop {
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease-ed);
  }
  #nav-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
    transition-duration: 180ms;
  }

  /* 抽屉位移：替换 Tailwind 的 duration-300 默认缓动 */
  #nav-drawer {
    transition: transform 260ms var(--ease-ed);
  }

  /* 打开时抽屉内链接只做透明度交错（不做位移：链接已用 transform 做 hover 位移） */
  #nav-drawer.is-open .nav-drawer-link {
    animation: nav-drawer-link-in 180ms var(--ease-ed) both;
    animation-delay: calc(60ms + var(--i, 0) * 30ms);
  }
  @keyframes nav-drawer-link-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* 汉堡 → X：三段线在 240ms 内并成十字，中间一段淡出 */
  #nav-toggle {
    transition: transform 120ms var(--ease-ed);
  }
  #nav-toggle span {
    transition:
      transform 240ms var(--ease-ed),
      opacity 240ms var(--ease-ed);
  }
  /* 三条 1px 线 + 6px 间距，中点到首尾各 7px：位移取 7px 才能正中 */
  #nav-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #nav-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  #nav-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  #nav-toggle:active {
    transform: scale(0.94);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav,
    #nav-drawer,
    #nav-backdrop,
    #nav-toggle,
    #nav-toggle span {
      transition: none;
    }
    #nav-drawer.is-open .nav-drawer-link {
      animation: none;
    }
  }

  /* 桌面导航：下划线随 hover/当前页展开，当前页用砖红点出 */
  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.45rem 0.75rem;
    /* 字号随视口 clamp：2K/4K 全屏不缩放时 12px 小字会糊，高分屏自动放大到 ~1rem */
    font-size: clamp(0.8125rem, 0.7rem + 0.4vw, 1rem);
    letter-spacing: 0.05em;
    /* 从 fg 派生 80%：比 muted(68%) 更扛住雅黑小字渲染 */
    color: color-mix(in srgb, var(--color-ed-fg) 80%, transparent);
    text-decoration: none;
    white-space: nowrap;
    border-radius: 6px;
    transition:
      color 180ms ease,
      background-color 220ms ease,
      transform 90ms var(--ease-ed);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.4rem;
    height: 1px;
    background: var(--color-ed-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 220ms var(--ease-ed);
  }
  .nav-link:hover {
    color: var(--color-ed-fg);
    background: rgba(28, 28, 28, 0.04);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }
  .nav-link.is-active {
    color: var(--color-ed-accent);
    background: rgba(166, 58, 43, 0.06);
  }
  .nav-link--button {
    border: 0;
    background: none;
    font-family: inherit;
    cursor: pointer;
  }

  /* 移动抽屉：左侧细线标出当前页，整行 44px 命中 */
  .nav-drawer-link {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.35rem 0 0.35rem 0.85rem;
    border: 0;
    border-left: 2px solid transparent;
    background: none;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--color-ed-fg);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 220ms ease,
      transform 200ms var(--ease-ed);
  }
  .nav-drawer-link:hover {
    color: var(--color-ed-accent);
    background: rgba(166, 58, 43, 0.06);
    transform: translateX(3px);
  }
  .nav-drawer-link.is-active {
    color: var(--color-ed-accent);
    border-left-color: var(--color-ed-accent);
  }
  .nav-drawer-link:active {
    background: rgba(166, 58, 43, 0.1);
  }

  /* ---- 导航选中线「落定」--------------------------------------------------
     site-nav 带 view-transition-name，换页时旧/新快照是 animation:none（瞬切），
     下划线本来会直接跳到新位置。这里在每次 astro:page-load 后给当前项重播一次
     scaleX(0)→scaleX(1)（左侧 origin，280ms + 40ms 延迟），让线「长」到新位置。
     armed 态由脚本在首帧前加上，避免首次加载先满格再收起。 */
  .nav-link.nav-settle-armed::after {
    transform: scaleX(0);
  }
  .nav-link.nav-settle::after {
    animation: nav-underline-settle 280ms var(--ease-ed) 40ms both;
  }
  @keyframes nav-underline-settle {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* 可点元素补一点按压反馈（幅度克制） */
  .nav-link:active {
    transform: scale(0.97);
  }

  /* 放在最后：上面的落定/按压规则定义在后面，reduced-motion 覆盖必须更靠后 */
  @media (prefers-reduced-motion: reduce) {
    /* 落定动画整体取消；armed 态也要还原，否则下划线会被藏起来 */
    .nav-link.nav-settle::after {
      animation: none;
    }
    .nav-link.nav-settle-armed::after {
      transform: scaleX(1);
    }
    .nav-link:active,
    #nav-toggle:active {
      transform: none;
    }
  }
</style>

<script>
  // 注:本站启用了 Astro View Transitions,站内跳转会 SPA 式替换 <body> 内 DOM,
  // 直接绑在元素上的监听器会随旧节点一起丢失。因此这里统一使用
  // document 级事件委托,并在每次 astro:page-load 后重新获取元素引用。

  function getRefs() {
    return {
      toggle: document.getElementById("nav-toggle"),
      drawer: document.getElementById("nav-drawer"),
      backdrop: document.getElementById("nav-backdrop"),
      close: document.getElementById("nav-close"),
    };
  }

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // 抽屉/遮罩的顶边贴着导航下沿（汉堡 X 因此不被遮罩盖住），高度用实测值写入变量
  function syncNavHeight() {
    const nav = document.querySelector<HTMLElement>(".site-nav");
    if (!nav) return;
    document.documentElement.style.setProperty("--nav-h", `${nav.offsetHeight}px`);
  }

  // 关闭态用 inert：仅靠 translate-x-full 隐藏时，抽屉里的 6 个链接仍在 Tab 序列里。
  // 现在 inert / aria-hidden 等抽屉真正滑出（transitionend）之后再落定。
  let settleTimer: number | undefined;
  function settleClosed(drawer: HTMLElement | null) {
    if (!drawer) return;
    const finish = () => {
      window.clearTimeout(settleTimer);
      // 收口途中又被打开：不要把 inert 落回去
      if (getRefs().toggle?.getAttribute("aria-expanded") === "true") return;
      if (!drawer.classList.contains("translate-x-full")) return;
      drawer.setAttribute("inert", "");
      drawer.setAttribute("aria-hidden", "true");
    };
    if (reduceMotion.matches) {
      finish();
      return;
    }
    drawer.addEventListener(
      "transitionend",
      (e) => {
        if (e.propertyName !== "transform") return;
        finish();
      },
      { once: true }
    );
    // 兜底：transitionend 没来（换页替换节点 / transition 被禁用）也要收口
    window.clearTimeout(settleTimer);
    settleTimer = window.setTimeout(finish, 420);
  }

  function open() {
    const { drawer, backdrop, toggle } = getRefs();
    if (!drawer) return;
    syncNavHeight();
    drawer.classList.remove("translate-x-full");
    drawer.classList.add("is-open");
    drawer.removeAttribute("inert");
    drawer.setAttribute("aria-hidden", "false");
    backdrop?.classList.add("is-open");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    // 焦点移入抽屉，键盘用户不会「打开后还在原地」
    drawer.querySelector<HTMLElement>("a, button")?.focus();
  }

  function closeDrawer(restoreFocus = false) {
    const { drawer, backdrop, toggle } = getRefs();
    const wasOpen = toggle?.getAttribute("aria-expanded") === "true";
    // 模板默认就是关闭态（首次加载 / 换页后）：不必再走一遍收口流程
    if (!wasOpen && drawer?.getAttribute("aria-hidden") === "true") {
      document.body.style.overflow = "";
      return;
    }
    drawer?.classList.add("translate-x-full");
    drawer?.classList.remove("is-open");
    backdrop?.classList.remove("is-open");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    if (restoreFocus && wasOpen) toggle?.focus();
    settleClosed(drawer);
  }

  // 当前选中项的下划线重播一次（换页后新 DOM 也要「长」出来）
  function replayUnderlineSettle() {
    document.querySelectorAll<HTMLElement>(".nav-link.is-active").forEach((el) => {
      el.classList.remove("nav-settle-armed");
      el.classList.remove("nav-settle");
      void el.offsetWidth; // 强制 reflow，动画才能重播
      el.classList.add("nav-settle");
    });
  }

  // 首帧前先收掉下划线：避免首次加载「先满格 → 收起 → 再长出」的闪烁
  if (!reduceMotion.matches) {
    document
      .querySelectorAll<HTMLElement>(".nav-link.is-active")
      .forEach((el) => el.classList.add("nav-settle-armed"));
  }

  // 换页时 DOM 是 SPA 替换的：after-swap 紧跟替换发生（早于新页面绘制），
  // 在这里重播才不会被「先满格再收起」闪一下；page-load 只兜底首次加载。
  let settleReplayed = false;
  document.addEventListener("astro:after-swap", () => {
    replayUnderlineSettle();
    settleReplayed = true;
  });

  // 每次页面加载(VT 换页后也会触发)重新绑定可点击区域的状态,并兜底关闭残留抽屉
  document.addEventListener("astro:page-load", () => {
    closeDrawer();
    syncNavHeight();
    if (!settleReplayed) replayUnderlineSettle();
    settleReplayed = false;
  });

  // 抽屉开着时视口变化（转屏 / 地址栏收起）要重算顶边
  window.addEventListener("resize", () => {
    if (getRefs().toggle?.getAttribute("aria-expanded") === "true") syncNavHeight();
  });

  // 事件委托:hamburger 打开/关闭
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const toggle = target.closest("#nav-toggle");
    if (toggle) {
      e.preventDefault();
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      isOpen ? closeDrawer() : open();
      return;
    }
    // 抽屉内的关闭按钮 / 背板点击关闭
    if (target.closest("#nav-close") || target.closest("#nav-backdrop")) {
      closeDrawer(true);
      return;
    }
    // 抽屉内的搜索按钮:关闭抽屉后打开搜索弹层(SearchModal 监听 open-search)
    if (target.closest("[data-open-search]")) {
      closeDrawer();
      document.dispatchEvent(new CustomEvent("open-search"));
    }
  });

  // 向下滚动时收起导航、向上滚动时露出：按累计滚动量判断，慢速滚动也能触发
  let lastScrollY = window.scrollY;
  let scrollAcc = 0;
  function setNavHidden(hidden: boolean) {
    document.querySelector(".site-nav")?.classList.toggle("is-hidden", hidden);
    document.documentElement.classList.toggle("nav-hidden", hidden);
  }
  window.addEventListener(
    "scroll",
    () => {
      const y = window.scrollY;
      const dy = y - lastScrollY;
      lastScrollY = y;
      if (y < 80) {
        scrollAcc = 0;
        setNavHidden(false);
        return;
      }
      if (dy * scrollAcc < 0) scrollAcc = 0;
      scrollAcc += dy;
      if (scrollAcc > 24 && document.body.style.overflow !== "hidden") setNavHidden(true);
      else if (scrollAcc < -12) setNavHidden(false);
    },
    { passive: true }
  );
  // 键盘聚焦进导航时必须露出；换页后状态重置
  document.addEventListener("focusin", (e) => {
    if ((e.target as HTMLElement | null)?.closest?.(".site-nav")) setNavHidden(false);
  });
  document.addEventListener("astro:page-load", () => {
    lastScrollY = window.scrollY;
    scrollAcc = 0;
    setNavHidden(false);
  });

  // Escape 关闭(委托到 document,天然跨 VT 存活)
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const { toggle } = getRefs();
      if (toggle?.getAttribute("aria-expanded") === "true") closeDrawer(true);
    }
  });
</script>
