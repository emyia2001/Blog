---
interface Props {
  src: string;
  title?: string;
}

const { src, title } = Astro.props;
---

<mini-player>
  <button
    id="mp-btn"
    class="fixed bottom-6 right-6 z-50 flex h-11 w-11 items-center justify-center font-serif text-sm border"
    style="background: var(--color-ed-bg); color: var(--color-ed-fg); border-color: var(--color-ed-faint); border-radius: 50%;"
    aria-label={title ? `Play ${title}` : "Play background music"}
  >
    <span id="mp-icon">&#9654;</span>
  </button>
  <div
    id="mp-bar"
    class="fixed bottom-6 right-6 z-50 hidden items-center gap-3 h-11 px-4 border"
    style="background: var(--color-ed-bg); color: var(--color-ed-fg); border-color: var(--color-ed-faint);"
  >
    <button id="mp-play" class="font-serif text-sm" aria-label="Play/Pause">
      &#9654;
    </button>
    {title && (
      <span class="text-xs text-[var(--color-ed-muted)] whitespace-nowrap max-w-[120px] truncate">
        {title}
      </span>
    )}
    <div class="w-24 h-px" style="background: var(--color-ed-faint);">
      <div
        id="mp-progress"
        class="h-px"
        style="background: var(--color-ed-fg); width: 0%;"
      ></div>
    </div>
  </div>
</mini-player>

<script define:vars={{ src, title }}>
  const FADE_INTERVAL = 50; // ms
  const FADE_STEP = 0.04; // volume per tick (~0.8s full fade)

  class MiniPlayer extends HTMLElement {
    audio = null;
    fadeTimer = null;
    playing = false;
    unlocked = false;
    btn = null;
    bar = null;
    playBtn = null;
    progress = null;
    icon = null;
    unlockEvents = ["pointerdown", "keydown", "scroll", "touchstart"];

    _onUnlock = () => {
      if (this.unlocked || this.playing) return;
      this.unlocked = true;
      this.unlockEvents.forEach((evt) => window.removeEventListener(evt, this._onUnlock));
      this.play();
    };

    _onVisibility = () => {
      if (document.hidden && this.playing && this.audio) {
        if (this.fadeTimer) {
          clearInterval(this.fadeTimer);
          this.fadeTimer = null;
        }
        this.audio.pause();
        this.playing = false;
        this.setIcons(false);
      }
    };

    _onPageHide = () => {
      if (this.fadeTimer) {
        clearInterval(this.fadeTimer);
        this.fadeTimer = null;
      }
      if (this.audio) this.audio.pause();
    };

    connectedCallback() {
      this.btn = this.querySelector("#mp-btn");
      this.bar = this.querySelector("#mp-bar");
      this.playBtn = this.querySelector("#mp-play");
      this.progress = this.querySelector("#mp-progress");
      this.icon = this.querySelector("#mp-icon");

      this.audio = new Audio(src);
      this.audio.loop = true; // 单曲循环

      this.audio.addEventListener("timeupdate", () => {
        if (this.audio.duration) {
          const pct = (this.audio.currentTime / this.audio.duration) * 100;
          this.progress.style.width = `${pct}%`;
        }
      });

      this.audio.addEventListener("error", () => {
        // disconnect 时清空 src 会异步触发 error 事件，此时 audio 已销毁
        if (!this.audio) return;
        if (this.fadeTimer) {
          clearInterval(this.fadeTimer);
          this.fadeTimer = null;
        }
        this.playing = false;
        this.audio.volume = 1;
        if (this.btn) {
          this.btn.style.display = "flex";
          this.btn.innerHTML = "!";
        }
        if (this.bar) this.bar.style.display = "none";
        this.setIcons(false);
        setTimeout(() => {
          if (this.btn) this.btn.innerHTML = "&#9654;";
        }, 1500);
      });

      this.btn?.addEventListener("click", () => {
        if (this.bar) this.bar.style.display = "flex";
        this.btn.style.display = "none";
        this.play();
      });

      this.playBtn?.addEventListener("click", () => this.toggle());

      // Respect prefers-reduced-motion
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches && this.bar) {
        this.bar.style.transition = "none";
      }

      // 默认打开页面即尝试播放：直接显示进度条，跳过圆形按钮
      if (this.bar) this.bar.style.display = "flex";
      if (this.btn) this.btn.style.display = "none";
      this.setIcons(false);
      this.play();

      // 浏览器自动播放策略：无用户交互的有声播放会被拦截。
      // 首次用户交互（点击/滚动/按键/触摸）后立即解锁播放，
      // 此时浏览器允许带声音播放，实现"打开页面就响"的效果。
      this.unlockEvents.forEach((evt) =>
        window.addEventListener(evt, this._onUnlock, { passive: true })
      );

      // 离开页面（切后台/切标签页/导航走）时立即停止音乐
      document.addEventListener("visibilitychange", this._onVisibility);
      window.addEventListener("pagehide", this._onPageHide);
    }

    // ViewTransitions 客户端导航不触发 pagehide，旧元素被移除时
    // 必须手动暂停并销毁 audio，否则音乐会继续播放（与下一页重复）
    disconnectedCallback() {
      if (this.fadeTimer) {
        clearInterval(this.fadeTimer);
        this.fadeTimer = null;
      }
      if (this.audio) {
        this.audio.pause();
        this.audio.src = "";
        this.audio.load();
        this.audio = null;
      }
      this.playing = false;
      this.unlocked = true;
      this.unlockEvents.forEach((evt) => window.removeEventListener(evt, this._onUnlock));
      document.removeEventListener("visibilitychange", this._onVisibility);
      window.removeEventListener("pagehide", this._onPageHide);
    }

    setIcons(isPlaying) {
      const glyph = isPlaying ? "&#9632;" : "&#9654;";
      if (this.playBtn) this.playBtn.innerHTML = glyph;
      if (this.icon) this.icon.innerHTML = glyph;
    }

    fadeTo(target, onDone) {
      if (!this.audio) return;
      if (this.fadeTimer) clearInterval(this.fadeTimer);
      const dir = target > this.audio.volume ? 1 : -1;
      this.fadeTimer = setInterval(() => {
        if (!this.audio) {
          clearInterval(this.fadeTimer);
          this.fadeTimer = null;
          return;
        }
        let v = this.audio.volume + FADE_STEP * dir;
        if ((dir > 0 && v >= target) || (dir < 0 && v <= target)) {
          v = target;
          clearInterval(this.fadeTimer);
          this.fadeTimer = null;
          if (onDone) onDone();
        }
        this.audio.volume = Math.max(0, Math.min(1, v));
      }, FADE_INTERVAL);
    }

    play() {
      if (!this.audio) return;
      this.audio.volume = 0;
      this.setIcons(true);
      this.audio
        .play()
        .then(() => {
          this.playing = true;
          this.fadeTo(1); // 渐入
        })
        .catch(() => {
          // 自动播放被浏览器拦截：保持可见，等待用户点击
          this.playing = false;
          this.setIcons(false);
        });
    }

    pause() {
      if (!this.audio) return;
      this.fadeTo(0, () => {
        // 渐出完成后真正暂停
        this.audio.pause();
        this.playing = false;
        this.setIcons(false);
      });
    }

    toggle() {
      if (this.playing) this.pause();
      else this.play();
    }
  }

  customElements.define("mini-player", MiniPlayer);
</script>
