---
interface Props {
  src: string;
  title?: string;
}

const { src, title } = Astro.props;
---

<mini-player>
  <button
    id="mp-btn"
    class="fixed bottom-6 right-6 z-50 flex h-11 w-11 items-center justify-center font-serif text-sm border"
    style="background: var(--color-ed-bg); color: var(--color-ed-fg); border-color: var(--color-ed-faint); border-radius: 50%;"
    aria-label={title ? `Play ${title}` : "Play background music"}
  >
    <span id="mp-icon">&#9654;</span>
  </button>
  <div
    id="mp-bar"
    class="fixed bottom-6 right-6 z-50 hidden items-center gap-3 h-11 px-4 border"
    style="background: var(--color-ed-bg); color: var(--color-ed-fg); border-color: var(--color-ed-faint);"
  >
    <button id="mp-play" class="font-serif text-sm" aria-label="Play/Pause">
      &#9654;
    </button>
    {title && (
      <span class="text-xs text-[var(--color-ed-muted)] whitespace-nowrap max-w-[120px] truncate">
        {title}
      </span>
    )}
    <div class="w-24 h-px" style="background: var(--color-ed-faint);">
      <div
        id="mp-progress"
        class="h-px"
        style="background: var(--color-ed-fg); width: 0%;"
      ></div>
    </div>
  </div>
</mini-player>

<script define:vars={{ src, title }}>
  class MiniPlayer extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector("#mp-btn");
      const bar = this.querySelector("#mp-bar");
      const playBtn = this.querySelector("#mp-play");
      const progress = this.querySelector("#mp-progress");
      const icon = this.querySelector("#mp-icon");

      const audio = new Audio(src);
      audio.loop = true; // 单曲循环
      let playing = false;
      let fadeTimer = null;
      const FADE_INTERVAL = 50; // ms
      const FADE_STEP = 0.04; // volume per tick (~0.8s full fade)

      function setIcons(isPlaying) {
        const glyph = isPlaying ? "&#9632;" : "&#9654;";
        if (playBtn) playBtn.innerHTML = glyph;
        if (icon) icon.innerHTML = glyph;
      }

      function fadeTo(target, onDone) {
        if (fadeTimer) clearInterval(fadeTimer);
        const dir = target > audio.volume ? 1 : -1;
        fadeTimer = setInterval(() => {
          let v = audio.volume + FADE_STEP * dir;
          if ((dir > 0 && v >= target) || (dir < 0 && v <= target)) {
            v = target;
            clearInterval(fadeTimer);
            fadeTimer = null;
            if (onDone) onDone();
          }
          audio.volume = Math.max(0, Math.min(1, v));
        }, FADE_INTERVAL);
      }

      function play() {
        audio.volume = 0;
        setIcons(true);
        audio
          .play()
          .then(() => {
            playing = true;
            fadeTo(1); // 渐入
          })
          .catch(() => {
            // 自动播放被浏览器拦截：保持可见，等待用户点击
            playing = false;
            setIcons(false);
          });
      }

      function pause() {
        fadeTo(0, () => {
          // 渐出完成后真正暂停
          audio.pause();
          playing = false;
          setIcons(false);
        });
      }

      function toggle() {
        if (playing) pause();
        else play();
      }

      audio.addEventListener("timeupdate", () => {
        if (audio.duration) {
          const pct = (audio.currentTime / audio.duration) * 100;
          progress.style.width = `${pct}%`;
        }
      });

      audio.addEventListener("error", () => {
        if (fadeTimer) {
          clearInterval(fadeTimer);
          fadeTimer = null;
        }
        playing = false;
        audio.volume = 1;
        if (btn) {
          btn.style.display = "flex";
          btn.innerHTML = "!";
        }
        if (bar) bar.style.display = "none";
        setIcons(false);
        setTimeout(() => {
          if (btn) btn.innerHTML = "&#9654;";
        }, 1500);
      });

      btn?.addEventListener("click", () => {
        if (bar) bar.style.display = "flex";
        btn.style.display = "none";
        play();
      });

      playBtn?.addEventListener("click", toggle);

      // Respect prefers-reduced-motion
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        if (bar) bar.style.transition = "none";
      }

      // 默认打开页面即尝试播放：直接显示进度条，跳过圆形按钮
      if (bar) bar.style.display = "flex";
      if (btn) btn.style.display = "none";
      setIcons(false);
      play();

      // 浏览器自动播放策略：无用户交互的有声播放会被拦截。
      // 首次用户交互（点击/滚动/按键/触摸）后立即解锁播放，
      // 此时浏览器允许带声音播放，实现"打开页面就响"的效果。
      let unlocked = false;
      function unlockAndPlay() {
        if (unlocked || playing) return;
        unlocked = true;
        const events = ["pointerdown", "keydown", "scroll", "touchstart"];
        events.forEach((evt) => window.removeEventListener(evt, unlockAndPlay));
        play();
      }
      ["pointerdown", "keydown", "scroll", "touchstart"].forEach((evt) =>
        window.addEventListener(evt, unlockAndPlay, { passive: true })
      );

      // 离开页面（切后台/切标签页/导航走）时立即停止音乐
      document.addEventListener("visibilitychange", () => {
        if (document.hidden && playing) {
          if (fadeTimer) {
            clearInterval(fadeTimer);
            fadeTimer = null;
          }
          audio.pause();
          playing = false;
          setIcons(false);
        }
      });
      window.addEventListener("pagehide", () => {
        if (fadeTimer) {
          clearInterval(fadeTimer);
          fadeTimer = null;
        }
        audio.pause();
      });
    }
  }

  customElements.define("mini-player", MiniPlayer);
</script>
