<!-- Search modal: opens via `open-search` CustomEvent, or Cmd/Ctrl+K -->
<div
  id="search-modal"
  class="fixed inset-0 z-[60] hidden items-start justify-center bg-black/20 px-4 pt-[12vh]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-title"
>
  <div class="w-full max-w-xl border border-[var(--color-ed-rule)]"
    style="background: var(--color-ed-bg);"
  >
    <h2 id="search-title" class="sr-only">站内搜索</h2>
    <label for="search-input" class="sr-only">搜索文章关键词</label>
    <input
      type="search"
      id="search-input"
      placeholder="搜索文章…"
      autocomplete="off"
      class="w-full border-b border-[var(--color-ed-rule)] bg-transparent px-5 py-4 text-sm text-[var(--color-ed-fg)] placeholder:text-[var(--color-ed-subtle)] focus:outline-none"
    />
    <div
      id="search-results"
      class="max-h-[50vh] overflow-y-auto px-5 py-2"
      role="status"
      aria-live="polite"
    >
      <p class="py-3 text-sm text-[var(--color-ed-muted)]">
        输入关键词开始搜索。
      </p>
    </div>
  </div>
</div>

<script>
  // 注:本站启用了 Astro View Transitions,站内跳转会替换 <body> 内 DOM,
  // 缓存的元素引用和元素级监听器会随旧节点一起失效。
  // 因此:open-search / keydown 等绑定在 document 上(天然跨 VT 存活),
  // modal 内的元素引用在每次 astro:page-load 时重新获取。

  let pf: any = null;
  let loaded = false;
  let loadPromise: Promise<void> | null = null;
  // 打开弹层前的焦点元素，关闭时归还（键盘用户不会「关掉后焦点掉到 body」）
  let lastFocused: HTMLElement | null = null;

  const FOCUSABLE =
    'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';

  function trapFocus(e: KeyboardEvent) {
    const { modal } = getRefs();
    if (!modal || modal.classList.contains("hidden") || e.key !== "Tab") return;
    const nodes = Array.from(modal.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
      (el) => el.offsetParent !== null
    );
    if (!nodes.length) return;
    const first = nodes[0];
    const last = nodes[nodes.length - 1];
    const active = document.activeElement as HTMLElement | null;
    if (e.shiftKey && (active === first || !modal.contains(active))) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  }

  function getRefs() {
    return {
      modal: document.getElementById("search-modal"),
      input: document.getElementById("search-input") as HTMLInputElement | null,
      results: document.getElementById("search-results"),
    };
  }

  function setMessage(message: string) {
    const results = getRefs().results;
    if (!results) return;
    const p = document.createElement("p");
    p.className = "py-3 text-sm text-[var(--color-ed-muted)]";
    p.textContent = message;
    results.replaceChildren(p);
  }

  async function loadSearch() {
    if (loadPromise) return loadPromise;
    loadPromise = (async () => {
      try {
        // pagefind.js 是 ES module，API 是具名导出（init/search...），不挂 window.Pagefind
        // 变量形式动态 import：避免 Vite 编译期解析（dev 下索引尚未生成，
        // postbuild 才产出），改由运行时加载——404 由下方 catch 优雅处理。
        // @vite-ignore：显式告诉 Vite 这是刻意保留的运行时导入，别再分析（否则每次 dev 都刷 warning）
        const pagefindUrl = "/pagefind/pagefind.js";
        pf = await import(/* @vite-ignore */ pagefindUrl);
        await pf.init();
        loaded = true;
      } catch {
        // Pagefind 未构建（dev 模式）
        loaded = false;
        loadPromise = null;
      }
    })();
    return loadPromise;
  }

  function open() {
    const { modal, input } = getRefs();
    if (!modal || !input) return;
    lastFocused = document.activeElement as HTMLElement | null;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
    requestAnimationFrame(() => input.focus());
    if (!loaded) void loadSearch();
  }

  function close() {
    const { modal, input } = getRefs();
    if (!modal || !input) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
    input.value = "";
    setMessage("输入关键词开始搜索。");
    lastFocused?.focus?.();
    lastFocused = null;
  }

  function isOpen() {
    const { modal } = getRefs();
    return modal ? !modal.classList.contains("hidden") : false;
  }

  // 一次性 document 级监听(委托,跨 VT 存活)
  document.addEventListener("open-search", open);

  // Esc closes, Cmd/Ctrl+K opens
  document.addEventListener("keydown", (e) => {
    trapFocus(e);
    if (e.key === "Escape" && isOpen()) {
      close();
    } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (isOpen()) close();
      else open();
    }
  });

  // modal 内点击(backdrop 关闭、搜索结果跳转)也走 document 委托
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const { modal } = getRefs();
    if (!modal || modal.classList.contains("hidden")) return;
    if (target === modal) {
      // 点击 backdrop(modal 自身)关闭
      close();
      return;
    }
    const resultLink = target.closest("[data-search-result]");
    if (resultLink) {
      // 点击搜索结果:允许跳转并关闭弹层
      close();
    }
  });

  // Debounced search:input 事件委托到 document(输入框节点会随 VT 更换)
  let debounce: ReturnType<typeof setTimeout>;
  document.addEventListener("input", (e) => {
    const target = e.target as HTMLElement | null;
    if (!target || target.id !== "search-input") return;
    const input = getRefs().input;
    if (!input) return;
    clearTimeout(debounce);
    debounce = setTimeout(async () => {
      const query = input.value.trim();
      if (!query) {
        setMessage("输入关键词开始搜索。");
        return;
      }

      if (!loaded) await loadSearch();
      if (!loaded || !pf) {
        setMessage("搜索索引尚未生成，请先构建站点。");
        return;
      }

      const search = await pf.search(query);
      if (!search.results.length) {
        setMessage("未找到结果。");
        return;
      }

      const fragment = document.createDocumentFragment();
      for (const result of search.results) {
        const data = await result.data();
        const link = document.createElement("a");
        link.href = data.url;
        link.dataset.searchResult = "";
        link.className =
          "block border-b border-[var(--color-ed-hairline)] py-4 no-underline group";

        const title = document.createElement("h3");
        title.className =
          "font-serif text-base text-[var(--color-ed-fg)] group-hover:text-[var(--color-ed-muted)] transition-colors";
        title.textContent = data.meta?.title || "无标题";

        const excerpt = document.createElement("p");
        excerpt.className =
          "mt-1 text-xs text-[var(--color-ed-subtle)] line-clamp-2";
        excerpt.textContent = data.excerpt || "";

        link.append(title, excerpt);
        fragment.appendChild(link);
      }
      const results = getRefs().results;
      if (results) results.replaceChildren(fragment);
    }, 300);
  });
</script>
