<!-- Search modal: opens via `open-search` CustomEvent, or Cmd/Ctrl+K -->
<div
  id="search-modal"
  class="fixed inset-0 z-[60] hidden items-start justify-center bg-black/20 px-4 pt-[12vh]"
  role="dialog"
  aria-modal="true"
  aria-label="搜索"
>
  <div class="w-full max-w-xl border border-[var(--color-ed-faint)]"
    style="background: var(--color-ed-bg);"
  >
    <input
      type="search"
      id="search-input"
      placeholder="搜索文章…"
      autocomplete="off"
      class="w-full border-b border-[var(--color-ed-faint)] bg-transparent px-5 py-4 text-sm text-[var(--color-ed-fg)] placeholder:text-[var(--color-ed-subtle)] focus:outline-none"
    />
    <div id="search-results" class="max-h-[50vh] overflow-y-auto px-5 py-2">
      <p class="py-3 text-sm text-[var(--color-ed-muted)]">
        输入关键词开始搜索。
      </p>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("search-modal");
  const input = document.getElementById("search-input");
  const results = document.getElementById("search-results");
  if (!modal || !input || !results) throw new Error("search modal elements missing");

  let pf: any = null;
  let loaded = false;
  let loadPromise: Promise<void> | null = null;

  function setMessage(message: string) {
    const p = document.createElement("p");
    p.className = "py-3 text-sm text-[var(--color-ed-muted)]";
    p.textContent = message;
    results.replaceChildren(p);
  }

  async function loadSearch() {
    if (loadPromise) return loadPromise;
    loadPromise = (async () => {
      try {
        // pagefind.js 是 ES module，API 是具名导出（init/search...），不挂 window.Pagefind
        // 变量形式动态 import：避免 Vite 编译期解析（dev 下索引尚未生成，
        // postbuild 才产出），改由运行时加载——404 由下方 catch 优雅处理
        const pagefindUrl = "/pagefind/pagefind.js";
        pf = await import(pagefindUrl);
        await pf.init();
        loaded = true;
      } catch {
        // Pagefind 未构建（dev 模式）
        loaded = false;
        loadPromise = null;
      }
    })();
    return loadPromise;
  }

  function open() {
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
    requestAnimationFrame(() => input.focus());
    if (!loaded) void loadSearch();
  }

  function close() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
    input.value = "";
    setMessage("输入关键词开始搜索。");
  }

  document.addEventListener("open-search", open);

  // Close on backdrop click
  modal.addEventListener("click", (e) => {
    if (e.target === modal) close();
  });

  // Esc closes, Cmd/Ctrl+K opens
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal.classList.contains("hidden")) {
      close();
    } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (modal.classList.contains("hidden")) {
        open();
      } else {
        close();
      }
    }
  });

  // Debounced search
  let debounce: ReturnType<typeof setTimeout>;
  input.addEventListener("input", () => {
    clearTimeout(debounce);
    debounce = setTimeout(async () => {
      const query = input.value.trim();
      if (!query) {
        setMessage("输入关键词开始搜索。");
        return;
      }

      if (!loaded) await loadSearch();
      if (!loaded || !pf) {
        setMessage("搜索索引尚未生成，请先构建站点。");
        return;
      }

      const search = await pf.search(query);
      if (!search.results.length) {
        setMessage("未找到结果。");
        return;
      }

      const fragment = document.createDocumentFragment();
      for (const result of search.results) {
        const data = await result.data();
        const link = document.createElement("a");
        link.href = data.url;
        link.dataset.searchResult = "";
        link.className =
          "block border-b border-[var(--color-ed-faint)] py-4 no-underline group";

        const title = document.createElement("h3");
        title.className =
          "font-serif text-base text-[var(--color-ed-fg)] group-hover:text-[var(--color-ed-muted)] transition-colors";
        title.textContent = data.meta?.title || "无标题";

        const excerpt = document.createElement("p");
        excerpt.className =
          "mt-1 text-xs text-[var(--color-ed-subtle)] line-clamp-2";
        excerpt.textContent = data.excerpt || "";

        link.append(title, excerpt);
        fragment.appendChild(link);
      }
      results.replaceChildren(fragment);
    }, 300);
  });

  // Close the modal before navigating to a result
  results.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a[data-search-result]")) {
      close();
    }
  });
</script>
