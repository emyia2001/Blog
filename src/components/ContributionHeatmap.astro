---
import type { ContributionCell } from "../utils/contributions";

interface Props {
  grid: ContributionCell[][];
  total: number | null;
}

const { grid, total } = Astro.props;

// 取自站内纸 / 墨 / 砖红三色，由浅到深（原来用 GitHub 的绿色，放在纸色卡片上很跳）
const CAL_COLORS = ["#ecebe6", "#d8d0c7", "#bda79a", "#94685a", "#a63a2b"];
---

{
  grid.length > 0 && (
    <div>
      <p class="mb-3 flex items-baseline gap-2 text-[11px] tracking-[0.12em] uppercase text-[var(--color-ed-subtle)]">
        GitHub 贡献
        {total !== null && (
          <span class="normal-case tracking-normal text-[var(--color-ed-muted)]">
            {total} 次
          </span>
        )}
      </p>
      <svg
        class="h-auto w-full"
        viewBox={`0 0 ${grid.length * 16 + 2} ${7 * 16 - 2}`}
        role="img"
        aria-label="GitHub 贡献热力图"
      >
        {grid.map((col, w) =>
          col.map((cell, d) => (
            <rect
              x={w * 16}
              y={d * 16}
              width="13"
              height="13"
              rx="3"
              fill={CAL_COLORS[cell.level]}
            >
              <title>
                {cell.date}：{cell.count} 次提交
              </title>
            </rect>
          ))
        )}
      </svg>
    </div>
  )
}
