---
interface Props {
  title: string;
  eyebrow?: string;
  date?: string;
  image?: string;
  variant?: number; // 0 波浪 · 1 涟漪 · 2 等高线（韵律线条家族）
  ratioClass?: string; // aspect-[3/4] / aspect-square / aspect-[16/9] ...
  caption?: boolean; // false = 只渲染图形/图片，不叠文字层（小缩略图用）
  size?: "card" | "thumb";
  alt?: string;
  class?: string;
}

const {
  title,
  eyebrow = "",
  date = "",
  image,
  variant = 0,
  ratioClass = "aspect-[3/4]",
  caption = true,
  size = "card",
  alt = title,
  class: className = "",
} = Astro.props;

// 稳定取模：同一篇文章每次构建得到同一构图
const v = ((Math.abs(Math.trunc(variant)) % 3) + 3) % 3;
---

{image ? (
  <div class={`cover-root relative w-full overflow-hidden bg-[#EDEAE4] ${ratioClass} ${className}`}>
    <img src={image} alt={alt} class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
    {caption && (
      <>
        <div class="absolute inset-x-0 bottom-0 h-[45%]" style="background: linear-gradient(180deg, transparent, rgba(28,28,28,0.55));" aria-hidden="true"></div>
        <div class="absolute inset-0 flex flex-col justify-end p-[7%]">
          <span class="cover-title text-[#F9F8F6]">{title}</span>
          {date && <span class="cover-date mt-2 text-[#F9F8F6]/70">{date}</span>}
        </div>
      </>
    )}
  </div>
) : (
  <div class={`cover-root relative w-full overflow-hidden bg-[#F9F8F6] ${ratioClass} ${className}`}>
    {v === 0 && (
      <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1200 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="1200" height="900" fill="#F9F8F6"/>
        <path d="M 0 250 Q 150 205 300 250 T 600 250 T 900 250 T 1200 250" fill="none" stroke="#1C1C1C" stroke-opacity="0.7"/>
        <path d="M 0 340 Q 150 260 300 340 T 600 340 T 900 340 T 1200 340" fill="none" stroke="#1C1C1C" stroke-opacity="0.45"/>
        <path d="M 0 430 Q 150 315 300 430 T 600 430 T 900 430 T 1200 430" fill="none" stroke="#1C1C1C" stroke-opacity="0.3"/>
        <path d="M 0 520 Q 150 440 300 520 T 600 520 T 900 520 T 1200 520" fill="none" stroke="#1C1C1C" stroke-opacity="0.45"/>
        <path d="M 0 610 Q 150 565 300 610 T 600 610 T 900 610 T 1200 610" fill="none" stroke="#1C1C1C" stroke-opacity="0.7"/>
        <circle cx="150" cy="150" r="9" fill="none" stroke="#1C1C1C" stroke-opacity="0.6"/>
        <rect x="1060" y="760" width="44" height="44" fill="#1C1C1C" fill-opacity="0.85"/>
      </svg>
    )}
    {v === 1 && (
      <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1200 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="1200" height="900" fill="#F9F8F6"/>
        <g fill="none" stroke="#1C1C1C">
          <circle cx="980" cy="-120" r="560" stroke-opacity="0.85"/>
          <circle cx="980" cy="-120" r="700" stroke-opacity="0.6"/>
          <circle cx="980" cy="-120" r="850" stroke-opacity="0.4"/>
          <circle cx="980" cy="-120" r="1010" stroke-opacity="0.25"/>
          <circle cx="980" cy="-120" r="1180" stroke-opacity="0.15"/>
        </g>
        <circle cx="150" cy="700" r="6" fill="#1C1C1C" fill-opacity="0.5"/>
        <line x1="0" y1="780" x2="1200" y2="780" stroke="#1C1C1C" stroke-opacity="0.2"/>
      </svg>
    )}
    {v === 2 && (
      <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1200 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="1200" height="900" fill="#F9F8F6"/>
        <g fill="none" stroke="#1C1C1C">
          <path d="M 0 640 C 150 600 250 660 400 630 C 550 600 700 680 850 640 C 1000 600 1100 660 1200 630" stroke-opacity="0.8"/>
          <path d="M 0 560 C 180 510 300 590 460 550 C 620 510 760 600 920 555 C 1060 515 1140 580 1200 560" stroke-opacity="0.55"/>
          <path d="M 0 480 C 160 420 320 510 500 465 C 660 425 800 520 980 470 C 1100 435 1160 500 1200 480" stroke-opacity="0.4"/>
          <path d="M 0 400 C 200 340 340 430 520 385 C 700 345 840 440 1020 390 C 1120 360 1170 420 1200 400" stroke-opacity="0.28"/>
          <path d="M 0 320 C 180 270 360 350 540 305 C 720 265 880 350 1060 310 C 1130 292 1170 330 1200 320" stroke-opacity="0.18"/>
        </g>
        <line x1="0" y1="700" x2="1200" y2="700" stroke="#1C1C1C" stroke-opacity="0.35"/>
      </svg>
    )}

    {caption && (
      <div class="absolute inset-0 flex flex-col justify-between p-[8%]">
        {eyebrow && (
          <span class="cover-eyebrow text-[var(--color-ed-subtle)]">{eyebrow}</span>
        )}
        <div class="flex items-end justify-between gap-4">
          <span class="cover-title text-[var(--color-ed-fg)]">{title}</span>
          {date && <span class="cover-date text-[var(--color-ed-subtle)]">{date}</span>}
        </div>
      </div>
    )}
  </div>
)}
