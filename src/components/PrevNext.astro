---
import type { CollectionEntry } from "astro:content";
import { postPath } from "../utils/urls";

interface Props {
  prev: CollectionEntry<"posts"> | null;
  next: CollectionEntry<"posts"> | null;
}

const { prev, next } = Astro.props;
---

<nav class="mt-16 pt-8 border-t-2 border-[var(--color-ed-rule-strong)]">
  <div class="flex justify-between items-start gap-4">
    {prev ? (
      <a
        href={postPath(prev)}
        class="pn-link pn-link-prev group flex-1 no-underline text-left"
      >
        <span class="block text-xs tracking-[0.05em] text-[var(--color-ed-subtle)] mb-1">
          <span class="pn-arrow pn-arrow-prev">&larr;</span> 上一篇
        </span>
        <span class="pn-title font-serif text-sm text-[var(--color-ed-fg)] group-hover:text-[var(--color-ed-accent)] transition-colors">
          {prev.data.title}
        </span>
      </a>
    ) : (
      <div class="flex-1" />
    )}

    {next ? (
      <a
        href={postPath(next)}
        class="pn-link pn-link-next group flex-1 no-underline text-right"
      >
        <span class="block text-xs tracking-[0.05em] text-[var(--color-ed-subtle)] mb-1">
          下一篇 <span class="pn-arrow pn-arrow-next">&rarr;</span>
        </span>
        <span class="pn-title font-serif text-sm text-[var(--color-ed-fg)] group-hover:text-[var(--color-ed-accent)] transition-colors">
          {next.data.title}
        </span>
      </a>
    ) : (
      <div class="flex-1" />
    )}
  </div>
</nav>

<style>
  /* 按下反馈：整块轻微内收，松手回位 */
  .pn-link {
    transition: transform 120ms var(--ease-ed);
  }
  .pn-link:active {
    transform: scale(0.98);
  }

  /* 箭头顺着方向滑出：上一篇向左、下一篇向右 */
  .pn-arrow {
    display: inline-block;
    transition: transform 240ms var(--ease-ed);
  }

  /* 标题下划线按方向生长：上一篇从左、下一篇从右 */
  .pn-title {
    position: relative;
    display: inline-block;
  }
  .pn-title::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 1px;
    background: var(--color-ed-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 280ms var(--ease-ed);
  }
  .pn-link-next .pn-title::after {
    transform-origin: right center;
  }
  .group:hover .pn-title::after {
    transform: scaleX(1);
  }

  /* 悬停位移收进 hover-gate：触屏（hover:none）不再粘滞位移 */
  @media (hover: hover) and (pointer: fine) {
    .group:hover .pn-arrow-prev {
      transform: translateX(-3px);
    }
    .group:hover .pn-arrow-next {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pn-link,
    .pn-arrow,
    .pn-title::after {
      transition: none;
    }
    .pn-link:active {
      transform: none;
    }
    .group:hover .pn-arrow-prev,
    .group:hover .pn-arrow-next {
      transform: none;
    }
  }
</style>
