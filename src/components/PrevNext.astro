---
import type { CollectionEntry } from "astro:content";
import { postPath } from "../utils/urls";

interface Props {
  prev: CollectionEntry<"posts"> | null;
  next: CollectionEntry<"posts"> | null;
}

const { prev, next } = Astro.props;
---

<nav class="mt-16 pt-8 border-t-2 border-[var(--color-ed-rule-strong)]">
  <div class="flex justify-between items-start gap-4">
    {prev ? (
      <a
        href={postPath(prev)}
        class="group flex-1 no-underline text-left"
      >
        <span class="block text-xs tracking-[0.05em] text-[var(--color-ed-subtle)] mb-1">
          &larr; 上一篇
        </span>
        <span class="font-serif text-sm text-[var(--color-ed-fg)] group-hover:text-[var(--color-ed-muted)] transition-colors">
          {prev.data.title}
        </span>
      </a>
    ) : (
      <div class="flex-1" />
    )}

    {next ? (
      <a
        href={postPath(next)}
        class="group flex-1 no-underline text-right"
      >
        <span class="block text-xs tracking-[0.05em] text-[var(--color-ed-subtle)] mb-1">
          下一篇 &rarr;
        </span>
        <span class="font-serif text-sm text-[var(--color-ed-fg)] group-hover:text-[var(--color-ed-muted)] transition-colors">
          {next.data.title}
        </span>
      </a>
    ) : (
      <div class="flex-1" />
    )}
  </div>
</nav>
