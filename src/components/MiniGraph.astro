---
/**
 * 相关文章迷你图谱：当前文章居中，相关文章环绕成环。
 * - 纯静态 SVG（无 d3 / 无交互脚本）：节点不带常驻文字，悬停显示名称
 * - 点击节点跳转对应文章；当前文章节点不可点
 */
import type { CollectionEntry } from "astro:content";
import { postPath } from "../utils/urls";

interface Props {
  current: CollectionEntry<"posts">;
  related: CollectionEntry<"posts">[];
}

const { current, related } = Astro.props;

// 画布与几何：相关文章不超过 3 篇（Sidebar 截取），环半径按数量微调
const W = 260;
const H = 170;
const cx = W / 2;
const cy = H / 2 + 6;
const ring = 58;

const satellites = related.map((p, i) => {
  // 从正上方开始均分圆周
  const a = (i / Math.max(related.length, 1)) * Math.PI * 2 - Math.PI / 2;
  return {
    title: p.data.title,
    url: postPath(p),
    x: cx + Math.cos(a) * ring,
    y: cy + Math.sin(a) * ring * 0.78, // 略压扁成椭圆，适配窄卡片
  };
});
---

<div class="mini-graph" role="group" aria-label="相关文章图谱">
  <svg viewBox={`0 0 ${W} ${H}`} class="mini-graph__svg">
    {satellites.map((s) => (
      <line
        x1={cx}
        y1={cy}
        x2={s.x}
        y2={s.y}
        class="mini-graph__link"
        aria-hidden="true"
      />
    ))}
    {satellites.map((s) => (
      <a href={s.url} class="mini-graph__node">
        <title>{s.title}</title>
        <circle cx={s.x} cy={s.y} r="10" class="mini-graph__hit" />
        <circle cx={s.x} cy={s.y} r="5.5" class="mini-graph__dot" />
      </a>
    ))}
    <!-- 当前文章：中心实心点 -->
    <g class="mini-graph__self">
      <title>{current.data.title}</title>
      <circle cx={cx} cy={cy} r="12" class="mini-graph__hit" />
      <circle cx={cx} cy={cy} r="8" class="mini-graph__dot--self" />
    </g>
  </svg>
</div>

<style>
  .mini-graph__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .mini-graph__link {
    stroke: var(--color-ed-subtle);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    opacity: 0.7;
  }

  .mini-graph__dot {
    fill: var(--color-ed-bg);
    stroke: var(--color-ed-fg);
    stroke-width: 1.5;
    transition: fill 0.15s ease, stroke 0.15s ease;
  }

  .mini-graph__node {
    cursor: pointer;
    outline: none;
  }

  /* 命中区透明放大，悬停/聚焦不必精确瞄准小圆点 */
  .mini-graph__hit {
    fill: transparent;
  }

  .mini-graph__node:hover .mini-graph__dot,
  .mini-graph__node:focus-visible .mini-graph__dot {
    fill: var(--color-ed-accent);
    stroke: var(--color-ed-accent);
  }

  .mini-graph__node:hover ~ .mini-graph__self .mini-graph__dot--self,
  .mini-graph__dot--self {
    fill: var(--color-ed-fg);
  }

  .mini-graph__self .mini-graph__hit {
    fill: transparent;
  }
</style>
