---
/**
 * 相关文章迷你图谱：复用 GraphView（懒初始化）。
 * - 服务端只输出 SVG 骨架与数据 JSON，不抢首屏；
 * - 浏览器空闲时 GraphView 脚本才拉 d3-force chunk 并渲染力导；
 * - 节点悬停/点开显示名称，中心是当前文章，环绕的是相关文章。
 */
import type { CollectionEntry } from "astro:content";
import type { GraphLink, GraphNode } from "../utils/graphData";
import GraphView from "./GraphView.astro";
import { postPath } from "../utils/urls";

interface Props {
  current: CollectionEntry<"posts">;
  related: CollectionEntry<"posts">[];
}

const { current, related } = Astro.props;

// 中心 = 当前文章（借用 self 形态：实心大点），环绕 = 相关文章（post 形态）
const nodes: GraphNode[] = [
  {
    id: "self",
    kind: "self",
    title: current.data.title,
    url: "",
    contentIndex: -1,
  },
  ...related.map((p) => ({
    id: p.id,
    kind: "post" as const,
    title: p.data.title,
    url: postPath(p),
    contentIndex: -1,
  })),
];
const links: GraphLink[] = related.map((p) => ({
  source: "self",
  target: p.id,
}));
---

<div class="minigraph">
  <GraphView nodes={nodes} links={links} lazy />
</div>

<style>
  /* 侧栏卡片里的紧凑画幅；GraphView 高度走 --graph-h 变量 */
  .minigraph {
    --graph-h: 13rem;
  }

  .minigraph :global(.graph-hint) {
    display: none; /* 卡片太小，提示语省略 */
  }
</style>
