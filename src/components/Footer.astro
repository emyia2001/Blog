---
import { SITE_NAME } from "../consts";
const year = new Date().getFullYear();
// 博客联盟 / 友链接力链接：以后加入新联盟，在此追加一项即可。
// 注：开往因规则要求"打开网站即可见"，另在 Nav.astro 顶栏保留入口（桌面+移动抽屉）。
const allianceLinks = [
  {
    href: "https://www.travellings.cn/go.html",
    label: "开往",
    title: "开往 · 友链接力",
  },
];
---

<footer class="mt-16 border-t-2 border-[var(--color-ed-rule-strong)] py-10">
  <div class="mx-auto flex max-w-[1380px] flex-col items-center gap-3 px-6 text-center md:px-8">
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-xs tracking-[0.05em] text-[var(--color-ed-muted)]">
      <span class="text-[var(--color-ed-subtle)]">
        &copy; {year} {SITE_NAME}
      </span>
      <span class="text-[var(--color-ed-sep)]" aria-hidden="true">&middot;</span>
      <a href="/rss.xml" class="hover-underline no-underline hit-24">RSS</a>
    </div>

    {allianceLinks.length > 0 && (
      <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-xs tracking-[0.05em] text-[var(--color-ed-muted)]">
        <span class="text-[var(--color-ed-subtle)]">联盟</span>
        <span class="text-[var(--color-ed-sep)]" aria-hidden="true">&middot;</span>
        {allianceLinks.map((link) => (
          <a
            href={link.href}
            class="hover-underline no-underline hit-24"
            target="_blank"
            rel="noopener noreferrer"
            title={link.title}
          >
            {link.label}
          </a>
        ))}
      </div>
    )}
  </div>
</footer>
