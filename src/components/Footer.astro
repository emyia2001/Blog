---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-ed-faint)] py-12">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-4 px-6 text-center md:flex-row md:justify-between">
    <p class="text-xs text-[var(--color-ed-subtle)]">
      &copy; {year} Snark
    </p>
    <nav class="flex items-center gap-3 text-xs tracking-[0.05em] text-[var(--color-ed-muted)]">
      <span class="text-[var(--color-ed-faint)]">&middot;</span>
      <a href="/rss.xml" class="hover-underline">RSS</a>
    </nav>
  </div>
</footer>
