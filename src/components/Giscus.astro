---
import { GISCUS_REPO, SITE_URL } from "../consts";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// 自定义主题改为同源 URL：由 src/pages/giscus-theme.css.ts 这个 endpoint 输出，
// 带 Access-Control-Allow-Origin: *（giscus 在 giscus.app iframe 里以 CORS 模式拉取）。
// 以前指向 cdn.jsdelivr.net：一是依赖第三方可用性（实测国内线路直接连不上，评论会掉回
// 默认主题），二是构建期要跑 git log 取 hash，浅克隆下容易退化。
const themeUrl = new URL("/giscus-theme.css", SITE_URL).href;
---

<div id="giscus" class={className} data-pagefind-ignore>
  <!-- giscus 要拉 client.js + iframe + GitHub API，国内网络下常要 1~2s 才出内容。
       改为点击后再加载：首屏不为评论区付出任何请求，想评论的人自己点。 -->
  <button type="button" class="giscus-load" data-giscus-load>加载评论</button>
</div>

<script define:vars={{ themeUrl, repo: GISCUS_REPO }}>
  const GISCUS_CONFIG = {
    src: "https://giscus.app/client.js",
    "data-repo": repo,
    "data-repo-id": "R_kgDOT0CTSw",
    "data-category": "Announcements",
    "data-category-id": "DIC_kwDOT0CTS84DDDuA",
    "data-mapping": "pathname",
    "data-strict": "0",
    "data-reactions-enabled": "0",
    "data-emit-metadata": "0",
    "data-input-position": "bottom",
    "data-theme": "",
    "data-lang": "zh-CN",
    "data-loading": "lazy",
    crossorigin: "anonymous",
  };

  function loadGiscus() {
    const container = document.getElementById("giscus");
    if (!container || container.dataset.loaded === "1") return;

    // 自定义主题：同源 /giscus-theme.css，见文件头注释。
    const script = document.createElement("script");
    script.async = true;
    script.crossOrigin = GISCUS_CONFIG.crossorigin;
    for (const [key, value] of Object.entries(GISCUS_CONFIG)) {
      if (key !== "src" && key !== "crossorigin" && key !== "data-theme") {
        script.setAttribute(key, value);
      }
    }
    script.setAttribute("data-theme", themeUrl);
    script.src = GISCUS_CONFIG.src;
    container.appendChild(script);
    container.dataset.loaded = "1";
  }

  // 事件委托：监听器挂在 document 上，View Transitions 换页后 #giscus 是新的节点也不会失联。
  // 用 window 上的标记去重——脚本在站内跳转后可能被再次执行，重复绑定会积累监听器。
  const BOUND_FLAG = "__giscusClickBound";
  function bindTrigger() {
    const w = window as unknown as Record<string, boolean>;
    if (w[BOUND_FLAG]) return;
    w[BOUND_FLAG] = true;
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest("[data-giscus-load]");
      if (!trigger) return;
      trigger.remove();
      loadGiscus();
    });
  }

  bindTrigger();
  document.addEventListener("astro:page-load", bindTrigger);
</script>

<style>
  #giscus :global(.giscus-load) {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.55rem 1.35rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--color-ed-fg);
    background: transparent;
    border: 1px solid var(--color-ed-rule);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  #giscus :global(.giscus-load:hover) {
    color: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
  }
</style>
