---
import { execSync } from "node:child_process";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// 自动取 src/styles/giscus-theme.css 最后一次被提交的 commit hash，
// 拼成 jsDelivr 直链。改主题 CSS 并提交后，下次构建自动指向新版本，
// 无需手动更新 hash。jsDelivr 对精确 commit hash 不走普通缓存，立即生效。
// 构建环境若不是 git 仓库（如 shallow clone 且无历史）则回退到已知有效 hash。
function getThemeHash(): string {
  const fallback = "6e91f4f53d4fbe0e56780f13a774797f4d3ee56a";
  try {
    const hash = execSync(
      "git log -1 --format=%H -- src/styles/giscus-theme.css",
      { encoding: "utf-8" }
    ).trim();
    return hash || fallback;
  } catch {
    return fallback;
  }
}

const themeUrl = `https://cdn.jsdelivr.net/gh/emyia2001/Blog@${getThemeHash()}/src/styles/giscus-theme.css`;
---

<div id="giscus" class={className} data-pagefind-ignore></div>

<script define:vars={{ themeUrl }}>
  const GISCUS_CONFIG = {
    src: "https://giscus.app/client.js",
    "data-repo": "emyia2001/comment",
    "data-repo-id": "R_kgDOT0CTSw",
    "data-category": "Announcements",
    "data-category-id": "DIC_kwDOT0CTS84DDDuA",
    "data-mapping": "pathname",
    "data-strict": "0",
    "data-reactions-enabled": "0",
    "data-emit-metadata": "0",
    "data-input-position": "bottom",
    "data-theme": "",
    "data-lang": "zh-CN",
    "data-loading": "lazy",
    crossorigin: "anonymous",
  };

  function loadGiscus() {
    const container = document.getElementById("giscus");
    if (!container || container.dataset.loaded === "1") return;

    // 自定义主题：经 jsDelivr CDN 加载。giscus 在 giscus.app 跨域 iframe 内以
    // <link crossorigin="anonymous"> (CORS 模式) 拉取主题 CSS。jsDelivr 对所有
    // 文件固定返回 Access-Control-Allow-Origin:*，静态托管下也不会被拦截。
    // themeUrl 由构建时按 giscus-theme.css 的最新 commit hash 自动生成。
    const script = document.createElement("script");
    script.async = true;
    script.crossOrigin = GISCUS_CONFIG.crossorigin;
    for (const [key, value] of Object.entries(GISCUS_CONFIG)) {
      if (key !== "src" && key !== "crossorigin" && key !== "data-theme") {
        script.setAttribute(key, value);
      }
    }
    script.setAttribute("data-theme", themeUrl);
    script.src = GISCUS_CONFIG.src;
    container.appendChild(script);
    container.dataset.loaded = "1";
  }

  document.addEventListener("astro:page-load", loadGiscus);
</script>
