---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div id="giscus" class={className} data-pagefind-ignore></div>

<script>
  const GISCUS_CONFIG = {
    src: "https://giscus.app/client.js",
    "data-repo": "emyia2001/comment",
    "data-repo-id": "R_kgDOT0CTSw",
    "data-category": "Announcements",
    "data-category-id": "DIC_kwDOT0CTS84DDDuA",
    "data-mapping": "pathname",
    "data-strict": "0",
    "data-reactions-enabled": "0",
    "data-emit-metadata": "0",
    "data-input-position": "bottom",
    "data-theme": "",
    "data-lang": "zh-CN",
    "data-loading": "lazy",
    crossorigin: "anonymous",
  };

  function loadGiscus() {
    const container = document.getElementById("giscus");
    if (!container || container.dataset.loaded === "1") return;

    // 自定义主题：经 jsDelivr CDN 加载。giscus 在 giscus.app 同源外 iframe 内以
    // <link crossorigin="anonymous"> (CORS 模式) 拉取主题 CSS。
    // 本地/预览用 Astro 服务器执行 endpoint 会带 CORS 头，但静态托管直接提供
    // dist/giscus-theme.css 文件时没有 CORS 头，会被浏览器静默拦截（字体透明/
    // 边框不可见）。jsDelivr 对所有文件固定返回 Access-Control-Allow-Origin:*，
    // 因此改为 CDN 直链，与本站音频资源（cdn.jsdelivr.net/gh/...）一致。
    // 引用固定的 commit hash（6e91f4f，含最新主题 CSS 且已 push）。jsDelivr 对
    // 精确 commit hash 不走普通 CDN 缓存，首次即生效。将来修改 giscus-theme.css
    // 后，需把下方 hash 换成新提交的完整 hash，否则会一直取旧版样式。
    const themeUrl =
      "https://cdn.jsdelivr.net/gh/emyia2001/Blog@6e91f4f53d4fbe0e56780f13a774797f4d3ee56a/src/styles/giscus-theme.css";

    const script = document.createElement("script");
    script.async = true;
    script.crossOrigin = GISCUS_CONFIG.crossorigin;
    for (const [key, value] of Object.entries(GISCUS_CONFIG)) {
      if (key !== "src" && key !== "crossorigin" && key !== "data-theme") {
        script.setAttribute(key, value);
      }
    }
    script.setAttribute("data-theme", themeUrl);
    script.src = GISCUS_CONFIG.src;
    container.appendChild(script);
    container.dataset.loaded = "1";
  }

  document.addEventListener("astro:page-load", loadGiscus);
</script>
