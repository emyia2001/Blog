---
import { GISCUS_REPO, SITE_URL } from "../consts";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// 自定义主题改为同源 URL：由 src/pages/giscus-theme.css.ts 这个 endpoint 输出，
// 带 Access-Control-Allow-Origin: *（giscus 在 giscus.app iframe 里以 CORS 模式拉取）。
// 以前指向 cdn.jsdelivr.net：一是依赖第三方可用性（实测国内线路直接连不上，评论会掉回
// 默认主题），二是构建期要跑 git log 取 hash，浅克隆下容易退化。
const themeUrl = new URL("/giscus-theme.css", SITE_URL).href;
---

<div id="giscus" class={className} data-pagefind-ignore></div>

<script define:vars={{ themeUrl, repo: GISCUS_REPO }}>
  const GISCUS_CONFIG = {
    src: "https://giscus.app/client.js",
    "data-repo": repo,
    "data-repo-id": "R_kgDOT0CTSw",
    "data-category": "Announcements",
    "data-category-id": "DIC_kwDOT0CTS84DDDuA",
    "data-mapping": "pathname",
    "data-strict": "0",
    "data-reactions-enabled": "0",
    "data-emit-metadata": "0",
    "data-input-position": "bottom",
    "data-theme": "",
    "data-lang": "zh-CN",
    "data-loading": "lazy",
    crossorigin: "anonymous",
  };

  function loadGiscus() {
    const container = document.getElementById("giscus");
    if (!container || container.dataset.loaded === "1") return;
    // 已经滚出视口就先不加载：giscus 要拉 client.js + iframe + API，约 1~1.5s，
    // 文章页首屏根本用不到评论区。
    if (container.dataset.loading === "deferred") return;

    // 自定义主题：同源 /giscus-theme.css，见文件头注释。
    const script = document.createElement("script");
    script.async = true;
    script.crossOrigin = GISCUS_CONFIG.crossorigin;
    for (const [key, value] of Object.entries(GISCUS_CONFIG)) {
      if (key !== "src" && key !== "crossorigin" && key !== "data-theme") {
        script.setAttribute(key, value);
      }
    }
    script.setAttribute("data-theme", themeUrl);
    script.src = GISCUS_CONFIG.src;
    container.appendChild(script);
    container.dataset.loaded = "1";
  }

  // 评论区进入视口附近再加载（首屏省掉 giscus 的 client.js 与 iframe 请求）
  function setupLazyLoad() {
    const container = document.getElementById("giscus");
    if (!container || container.dataset.loaded === "1") return;
    if (!("IntersectionObserver" in window)) {
      loadGiscus();
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          io.disconnect();
          loadGiscus();
        }
      },
      { rootMargin: "400px 0px" }
    );
    io.observe(container);
  }

  document.addEventListener("astro:page-load", setupLazyLoad);
</script>
