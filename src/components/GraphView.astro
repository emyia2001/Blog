---
import { SITE_DESCRIPTION } from "../consts";

interface GraphNode {
  id: string;
  kind: "post" | "person" | "event" | "self";
  title: string;
  url: string;
  contentIndex: number;
}

interface GraphLink {
  source: string;
  target: string;
}

interface Props {
  nodes: GraphNode[];
  links: GraphLink[];
}

const { nodes, links } = Astro.props;
const graphData = JSON.stringify({ nodes, links }).replace(/</g, "\\u003c");
---

<figure id="graph-view" aria-label="关系图谱">
  <svg
    id="graph-svg"
    viewBox="0 0 800 500"
    class="h-[26rem] w-full cursor-grab touch-none select-none rounded-md border border-[var(--color-ed-faint)] bg-[var(--color-ed-bg)] active:cursor-grabbing"
    role="img"
    aria-label="内容关系图谱，支持拖拽缩放"
  >
    <g id="graph-zoom">
      <g id="graph-links" stroke="var(--color-ed-faint)" stroke-width="1.2"></g>
      <g id="graph-nodes"></g>
    </g>
  </svg>
  <script type="application/json" id="graph-data" set:html={graphData}></script>
</figure>

<template id="self-card">
  <article class="border-t border-[var(--color-ed-faint)] pt-8 pb-4">
    <h2 class="font-serif text-2xl text-[var(--color-ed-fg)]">我</h2>
    <p class="mt-3 max-w-[60ch] text-sm leading-relaxed text-[var(--color-ed-muted)]">
      {SITE_DESCRIPTION}
    </p>
  </article>
</template>

<style>
  @media (max-width: 767px) {
    .graph-label {
      display: none;
    }
  }
</style>

<script>
  const svg = document.getElementById("graph-svg") as SVGSVGElement;
  const zoomG = document.getElementById("graph-zoom") as SVGGElement;
  const linksG = document.getElementById("graph-links") as SVGGElement;
  const nodesG = document.getElementById("graph-nodes") as SVGGElement;
  const data = JSON.parse(
    (document.getElementById("graph-data") as HTMLScriptElement).textContent ??
      "{}"
  ) as { nodes: GraphNode[]; links: GraphLink[] };

  const {
    forceSimulation,
    forceLink,
    forceManyBody,
    forceCenter,
    forceCollide,
    forceX,
    forceY,
  } = await import("d3-force");

  const W = 800;
  const H = 500;
  const nodes = data.nodes.map((n) => ({ ...n })) as Array<
    GraphNode & {
      x?: number;
      y?: number;
      fx?: number | null;
      fy?: number | null;
    }
  >;
  const links = data.links.map((l) => ({ ...l }));
  const nodeById = new Map(nodes.map((n) => [n.id, n]));

  nodes.forEach((n, i) => {
    const angle = (i / Math.max(nodes.length, 1)) * Math.PI * 2;
    n.x = W / 2 + Math.cos(angle) * 120;
    n.y = H / 2 + Math.sin(angle) * 120;
  });

  const NS = "http://www.w3.org/2000/svg";

  const linkEls = links.map((l) => {
    const line = document.createElementNS(NS, "line");
    linksG.appendChild(line);
    return line;
  });

  const nodeEls = nodes.map((n) => {
    const g = document.createElementNS(NS, "g");
    g.setAttribute("class", "graph-node");
    g.dataset.id = n.id;
    g.dataset.kind = n.kind;
    g.dataset.contentIndex = String(n.contentIndex);
    g.dataset.url = n.url;
    g.setAttribute("role", "button");
    g.setAttribute("tabindex", "0");
    g.setAttribute("aria-label", n.title);
    g.style.cursor = "pointer";
    g.style.outline = "none";

    // Large transparent hit area: forgiving click/drag targets
    const hit = document.createElementNS(NS, "circle");
    hit.setAttribute("r", "24");
    hit.setAttribute("fill", "transparent");
    hit.style.pointerEvents = "all";
    g.appendChild(hit);

    const isEvent = n.kind === "event";
    const isSelf = n.kind === "self";
    const shape = document.createElementNS(
      NS,
      isEvent ? "polygon" : isSelf ? "circle" : "circle"
    );
    if (isEvent) {
      // diamond outline to keep it distinct from post (dot) and person (ring)
      shape.setAttribute("points", "0,-9 9,0 0,9 -9,0");
      shape.setAttribute("fill", "none");
      shape.setAttribute("stroke", "var(--color-ed-muted)");
      shape.setAttribute("stroke-width", "1.5");
    } else if (isSelf) {
      shape.setAttribute("r", "11");
      shape.setAttribute("fill", "var(--color-ed-fg)");
      shape.setAttribute("stroke", "var(--color-ed-bg)");
      shape.setAttribute("stroke-width", "3");
    } else {
      shape.setAttribute("r", "7");
      if (n.kind === "post") {
        shape.setAttribute("fill", "var(--color-ed-fg)");
      } else {
        shape.setAttribute("fill", "var(--color-ed-bg)");
        shape.setAttribute("stroke", "var(--color-ed-muted)");
        shape.setAttribute("stroke-width", "1.5");
      }
    }
    g.appendChild(shape);

    const label = document.createElementNS(NS, "text");
    label.setAttribute("class", "graph-label");
    label.setAttribute("text-anchor", "middle");
    label.setAttribute("y", "26");
    label.setAttribute(
      "style",
      `font-family: 'Source Sans 3', sans-serif; font-size: 12px; fill: var(--color-ed-muted);${isSelf ? " font-weight: 600;" : ""}`
    );
    label.textContent = n.title;
    g.appendChild(label);

    nodesG.appendChild(g);
    return g;
  });

  const simulation = forceSimulation(nodes as never)
    .force(
      "link",
      forceLink(links as never)
        .id((d) => (d as GraphNode).id)
        .distance(110)
    )
    .force("charge", forceManyBody().strength(-300))
    .force("center", forceCenter(W / 2, H / 2))
    .force("collide", forceCollide().radius(34))
    // "self" is pinned to the center, everything else orbits it
    .force("x", forceX(W / 2).strength((d) => ((d as GraphNode).kind === "self" ? 1 : 0)))
    .force("y", forceY(H / 2).strength((d) => ((d as GraphNode).kind === "self" ? 1 : 0)))
    .on("tick", ticked);

  function resolveNode(
    ref: string | (GraphNode & { x?: number; y?: number })
  ): (GraphNode & { x?: number; y?: number }) | undefined {
    return typeof ref === "string" ? nodeById.get(ref) : ref;
  }

  // Distance from a node center to its shape edge along a unit direction.
  // Circles are constant-radius; the diamond is an L1 ball (R = 9).
  function radial(n: GraphNode, ux: number, uy: number): number {
    if (n.kind === "event") {
      return 9 / (Math.abs(ux) + Math.abs(uy));
    }
    if (n.kind === "self") return 11;
    return 7; // post, person
  }

  // Shorten each link so it touches the node edges instead of crossing to centers
  function edgePoints(
    a: GraphNode & { x?: number; y?: number },
    b: GraphNode & { x?: number; y?: number }
  ): [number, number, number, number] {
    const dx = (b.x ?? 0) - (a.x ?? 0);
    const dy = (b.y ?? 0) - (a.y ?? 0);
    const d = Math.hypot(dx, dy);
    if (d === 0) return [a.x ?? 0, a.y ?? 0, b.x ?? 0, b.y ?? 0];
    const ux = dx / d;
    const uy = dy / d;
    const r1 = radial(a, ux, uy);
    const r2 = radial(b, -ux, -uy);
    return [
      (a.x ?? 0) + ux * r1,
      (a.y ?? 0) + uy * r1,
      (b.x ?? 0) - ux * r2,
      (b.y ?? 0) - uy * r2,
    ];
  }

  function ticked() {
    linkEls.forEach((line, i) => {
      const l = links[i];
      const s = resolveNode(l.source);
      const t = resolveNode(l.target);
      if (!s || !t) return;
      const [x1, y1, x2, y2] = edgePoints(s, t);
      line.setAttribute("x1", String(x1));
      line.setAttribute("y1", String(y1));
      line.setAttribute("x2", String(x2));
      line.setAttribute("y2", String(y2));
    });
    nodeEls.forEach((g, i) => {
      const n = nodes[i];
      g.setAttribute("transform", `translate(${n.x},${n.y})`);
    });
  }

  // Fit the viewBox to the visible canvas so the graph fills it (no letterboxing)
  function fitViewBox() {
    const w = svg.clientWidth;
    const h = svg.clientHeight;
    if (!w || !h) return;
    svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
    simulation.force("center", forceCenter(w / 2, h / 2));
    simulation
      .force("x", forceX(w / 2).strength((d) => ((d as GraphNode).kind === "self" ? 1 : 0)))
      .force("y", forceY(h / 2).strength((d) => ((d as GraphNode).kind === "self" ? 1 : 0)));
    simulation.alpha(0.3).restart();
  }
  new ResizeObserver(fitViewBox).observe(svg);
  fitViewBox();

  // --- Pan & zoom ---
  let zoom = { k: 1, tx: 0, ty: 0 };
  function applyZoom() {
    zoomG.setAttribute(
      "transform",
      `translate(${zoom.tx},${zoom.ty}) scale(${zoom.k})`
    );
  }
  applyZoom();

  function svgPoint(e: PointerEvent | WheelEvent | Touch) {
    const pt = svg.createSVGPoint();
    pt.x = e.clientX;
    pt.y = e.clientY;
    return pt.matrixTransform(svg.getScreenCTM()!.inverse());
  }

  svg.addEventListener(
    "wheel",
    (e) => {
      e.preventDefault();
      const p = svgPoint(e);
      const factor = Math.exp(-e.deltaY * 0.001);
      const newK = Math.min(4, Math.max(0.4, zoom.k * factor));
      zoom.tx = p.x - ((p.x - zoom.tx) / zoom.k) * newK;
      zoom.ty = p.y - ((p.y - zoom.ty) / zoom.k) * newK;
      zoom.k = newK;
      applyZoom();
    },
    { passive: false }
  );

  // --- Drag nodes (click vs drag distinguished by movement threshold) ---
  let pointerId: string | null = null;
  let dragged = false;
  let dragActive = false;
  let downOnNode = false;
  let downX = 0;
  let downY = 0;
  const dragOffset = { x: 0, y: 0 };

  function selectOrToggle(id: string) {
    if (activeId === id) {
      clearActive();
    } else {
      selectNode(id);
    }
  }

  svg.addEventListener("pointerdown", (e) => {
    const target = (e.target as Element).closest?.(
      ".graph-node"
    ) as SVGGElement | null;
    downOnNode = !!target;
    dragged = false;
    downX = e.clientX;
    downY = e.clientY;
    if (!target) {
      clearActive();
      return;
    }
    pointerId = target.dataset.id ?? null;
    if (pointerId) {
      const n = nodeById.get(pointerId)!;
      const p = svgPoint(e);
      dragOffset.x = (p.x - zoom.tx) / zoom.k - (n.x ?? 0);
      dragOffset.y = (p.y - zoom.ty) / zoom.k - (n.y ?? 0);
      target.focus();
    }
  });

  window.addEventListener("pointermove", (e) => {
    if (!pointerId) return;
    if (!dragged && Math.hypot(e.clientX - downX, e.clientY - downY) > 5) {
      dragged = true;
      // Keep the simulation warm but steady while dragging (official d3 pattern:
      // alphaTarget holds alpha at 0.3 instead of re-heating on every move)
      if (!dragActive) {
        dragActive = true;
        simulation.alphaTarget(0.3).restart();
      }
    }
    if (!dragged) return;
    const n = nodeById.get(pointerId);
    if (!n) return;
    const p = svgPoint(e);
    n.fx = (p.x - zoom.tx) / zoom.k - dragOffset.x;
    n.fy = (p.y - zoom.ty) / zoom.k - dragOffset.y;
  });

  window.addEventListener("pointerup", () => {
    if (pointerId) {
      const n = nodeById.get(pointerId);
      if (n) {
        n.fx = null;
        n.fy = null;
      }
    }
    if (dragActive) {
      dragActive = false;
      simulation.alphaTarget(0);
    }
    if (downOnNode && !dragged && pointerId) {
      selectOrToggle(pointerId);
    }
    pointerId = null;
    downOnNode = false;
    dragged = false;
  });

  // --- Active / highlight ---
  let activeId: string | null = null;

  function linkEndIds(l: GraphLink): [string, string] {
    const s = resolveNode(l.source as never);
    const t = resolveNode(l.target as never);
    return [s?.id ?? "", t?.id ?? ""];
  }

  function neighborsOf(id: string): Set<string> {
    const out = new Set<string>([id]);
    for (const l of links) {
      const [sid, tid] = linkEndIds(l);
      if (sid === id) out.add(tid);
      if (tid === id) out.add(sid);
    }
    return out;
  }

  function clearActive() {
    activeId = null;
    nodeEls.forEach((g) => {
      g.style.opacity = "1";
      g.classList.remove("is-active");
    });
    linkEls.forEach((line) => {
      line.setAttribute("opacity", "1");
    });
    const detail = document.getElementById("timeline-detail");
    if (detail) detail.innerHTML = "";
  }

  function showDetail(contentIndex: number) {
    const detail = document.getElementById("timeline-detail");
    if (!detail) return;
    if (contentIndex < 0) {
      const selfCard = document.getElementById(
        "self-card"
      ) as HTMLTemplateElement | null;
      if (selfCard) {
        detail.innerHTML = "";
        detail.appendChild(selfCard.content.cloneNode(true) as HTMLElement);
      }
      return;
    }
    const template = document.getElementById(
      "content-templates"
    ) as HTMLTemplateElement | null;
    if (!template) return;
    const bodies = template.content.querySelectorAll<HTMLElement>(
      ".content-body"
    );
    const body = Array.from(bodies).find(
      (b) => b.dataset.contentIndex === String(contentIndex)
    );
    if (body) {
      detail.innerHTML = "";
      detail.appendChild(body.cloneNode(true) as HTMLElement);
    }
  }

  function selectNode(id: string) {
    const n = nodeById.get(id);
    if (!n) return;
    const nb = neighborsOf(id);
    activeId = id;
    nodeEls.forEach((g) => {
      const on = nb.has(g.dataset.id ?? "");
      g.style.opacity = on ? "1" : "0.25";
      g.classList.toggle("is-active", g.dataset.id === id);
    });
    linkEls.forEach((line, i) => {
      const [sid, tid] = linkEndIds(links[i]);
      const on = nb.has(sid) && nb.has(tid);
      line.setAttribute("opacity", on ? "1" : "0.1");
    });
    showDetail(n.contentIndex);
    window.dispatchEvent(new CustomEvent("graph:select"));
  }

  nodeEls.forEach((g) => {
    g.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        const id = g.dataset.id;
        if (!id) return;
        if (activeId === id) clearActive();
        else selectNode(id);
      }
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") clearActive();
  });

  // timeline selected something -> clear graph highlight
  window.addEventListener("timeline:select", clearActive);
</script>
