---
import { SITE_DESCRIPTION } from "../consts";

interface GraphNode {
  id: string;
  kind: "post" | "person" | "event" | "self";
  title: string;
  url: string;
  contentIndex: number;
  avatar?: string;
  excerpt?: string;
  heroImage?: string;
}

interface GraphLink {
  source: string;
  target: string;
}

interface Props {
  nodes: GraphNode[];
  links: GraphLink[];
}

const { nodes, links } = Astro.props;
const graphData = JSON.stringify({ nodes, links }).replace(/</g, "\\u003c");
---

<figure id="graph-view" aria-label="关系图谱">
  <div class="graph-layout" id="graph-layout">
    <svg
      id="graph-svg"
      viewBox="0 0 800 500"
      class="graph-svg h-[26rem] flex-1 min-w-0 cursor-grab touch-none select-none rounded-md border border-[var(--color-ed-faint)] bg-[var(--color-ed-bg)] shadow-[0_8px_30px_rgba(28,28,28,0.10)] active:cursor-grabbing"
      role="img"
      aria-label="内容关系图谱，支持拖拽缩放"
    >
      <g id="graph-zoom">
        <g id="graph-links" stroke="var(--color-ed-faint)" stroke-width="1.2"></g>
        <g id="graph-nodes"></g>
      </g>
    </svg>

    <aside id="graph-detail" class="graph-detail" aria-live="polite"></aside>

    <!-- 放大 / 还原 -->
    <button
      type="button"
      id="graph-expand"
      class="graph-expand"
      aria-label="放大关系图谱"
      title="放大关系图谱"
    >
      <svg id="graph-expand-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
      </svg>
    </button>
  </div>
  <script type="application/json" id="graph-data" set:html={graphData}></script>
</figure>

<style>
  .graph-layout {
    display: flex;
    align-items: stretch;
    gap: 0;
    position: relative;
    container-type: inline-size;
  }

  /* 放大按钮：悬浮在图右上角 */
  .graph-expand {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-ed-faint);
    background: rgba(249, 248, 246, 0.9);
    color: var(--color-ed-muted);
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
    backdrop-filter: blur(4px);
  }
  .graph-expand:hover {
    color: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
    background: var(--color-ed-bg);
  }

  /* 全屏展开态 */
  .graph-layout.is-expanded {
    position: fixed;
    inset: 1rem;
    z-index: 100;
    gap: 0;
    padding: 1rem;
    background: rgba(28, 28, 28, 0.5);
    border-radius: 0.75rem;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.4);
  }
  .graph-layout.is-expanded .graph-svg {
    height: auto;
    max-height: none;
    box-shadow: none;
    border-color: rgba(255, 255, 255, 0.15);
  }
  .graph-layout.is-expanded .graph-expand {
    width: 2.5rem;
    height: 2.5rem;
    top: 1.25rem;
    right: 1.25rem;
    background: var(--color-ed-fg);
    color: var(--color-ed-bg);
    border-color: var(--color-ed-fg);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }
  .graph-layout.is-expanded .graph-expand:hover {
    background: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
    color: var(--color-ed-bg);
  }
  .graph-layout.is-expanded .graph-detail {
    background: var(--color-ed-bg);
  }

  .graph-detail {
    flex: 0 0 auto;
    width: 0;
    opacity: 0;
    overflow: hidden;
    border-left: 1px solid var(--color-ed-faint);
    transition:
      width 0.35s ease,
      opacity 0.35s ease,
      padding 0.35s ease;
  }
  .graph-detail.is-open {
    width: 20rem;
    opacity: 1;
    padding-left: 1.5rem;
  }

  /* 窄容器（如首页右栏 / 时间线右栏内的图谱）：详情改为浮层盖在图上 */
  @container (max-width: 620px) {
    .graph-detail {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      height: 100%;
      width: 0;
      border-left: 1px solid var(--color-ed-faint);
      background: var(--color-ed-bg);
      box-shadow: -12px 0 30px rgba(28, 28, 28, 0.12);
      overflow-y: auto;
    }
    .graph-detail.is-open {
      width: 100%;
      padding: 1rem;
      opacity: 1;
    }
  }

  .graph-preview-img {
    width: 100%;
    height: 9rem;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }
  .graph-preview-kind {
    display: inline-block;
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--color-ed-muted);
    border: 1px solid var(--color-ed-faint);
    padding: 1px 6px;
    border-radius: 2px;
    margin-bottom: 0.5rem;
  }
  .graph-preview-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-ed-fg);
    line-height: 1.3;
  }
  .graph-preview-excerpt {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-ed-muted);
  }
  .graph-preview-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-ed-fg);
  }

  @media (max-width: 767px) {
    .graph-layout {
      flex-direction: column;
    }
    .graph-detail {
      border-left: none;
      border-top: 1px solid var(--color-ed-faint);
    }
    .graph-detail.is-open {
      width: 100%;
      padding-left: 0;
      padding-top: 1.5rem;
    }
    .graph-label {
      display: none;
    }
  }
</style>

<script>
  const svg = document.getElementById("graph-svg") as SVGSVGElement;
  const zoomG = document.getElementById("graph-zoom") as SVGGElement;
  const linksG = document.getElementById("graph-links") as SVGGElement;
  const nodesG = document.getElementById("graph-nodes") as SVGGElement;
  const data = JSON.parse(
    (document.getElementById("graph-data") as HTMLScriptElement).textContent ??
      "{}"
  ) as { nodes: GraphNode[]; links: GraphLink[] };

  const {
    forceSimulation,
    forceLink,
    forceManyBody,
    forceCenter,
    forceCollide,
    forceX,
    forceY,
  } = await import("d3-force");

  const W = 800;
  const H = 500;
  const cleanupController = new AbortController();

  const nodes = data.nodes.map((n) => ({ ...n })) as Array<
    GraphNode & {
      x?: number;
      y?: number;
      fx?: number | null;
      fy?: number | null;
    }
  >;
  const links = data.links.map((l) => ({ ...l }));
  const nodeById = new Map(nodes.map((n) => [n.id, n]));

  // 节点大小随节点总数自动缩放：节点少时略收敛、多时递减，避免拥挤/过大。
  // 4 个节点 → ≈0.82；10 个 → ≈0.60；上限 1、下限 0.5。
  const nodeScale = Math.max(
    0.5,
    Math.min(1, 1.25 / Math.pow(Math.max(nodes.length, 1), 0.35))
  );
  // 半径（diamond 的 L1 半径）
  const R = {
    avatarSelf: 13 * nodeScale,
    avatar: 10 * nodeScale,
    self: 11 * nodeScale,
    node: 7 * nodeScale, // post / person
    event: 9 * nodeScale,
    hit: 24 * nodeScale,
    collide: 34 * nodeScale,
    labelY: 26 * nodeScale + 4,
  };

  nodes.forEach((n, i) => {
    const angle = (i / Math.max(nodes.length, 1)) * Math.PI * 2;
    const spread = Math.min(W / 2 - 40, 60 + nodes.length * 22);
    n.x = W / 2 + Math.cos(angle) * spread;
    n.y = H / 2 + Math.sin(angle) * spread;
  });

  const NS = "http://www.w3.org/2000/svg";

  const linkEls = links.map((l) => {
    const line = document.createElementNS(NS, "line");
    linksG.appendChild(line);
    return line;
  });

  const nodeEls = nodes.map((n, ni) => {
    const g = document.createElementNS(NS, "g");
    g.setAttribute("class", "graph-node");
    g.dataset.id = n.id;
    g.dataset.kind = n.kind;
    g.dataset.contentIndex = String(n.contentIndex);
    g.dataset.url = n.url;
    g.setAttribute("role", "button");
    g.setAttribute("tabindex", "0");
    g.setAttribute("aria-label", n.title);
    g.style.cursor = "pointer";
    g.style.outline = "none";

    // Large transparent hit area: forgiving click/drag targets
    const hit = document.createElementNS(NS, "circle");
    hit.setAttribute("r", String(R.hit));
    hit.setAttribute("fill", "transparent");
    hit.style.pointerEvents = "all";
    g.appendChild(hit);

    const isEvent = n.kind === "event";
    const isSelf = n.kind === "self";

    if (n.avatar) {
      const r = isSelf ? R.avatarSelf : R.avatar;
      const clipId = `graph-clip-${ni}`;
      const defs = document.createElementNS(NS, "defs");
      const clip = document.createElementNS(NS, "clipPath");
      clip.setAttribute("id", clipId);
      const cc = document.createElementNS(NS, "circle");
      cc.setAttribute("r", String(r));
      clip.appendChild(cc);
      defs.appendChild(clip);
      g.appendChild(defs);

      const img = document.createElementNS(NS, "image");
      img.setAttribute("href", n.avatar);
      img.setAttributeNS(
        "http://www.w3.org/1999/xlink",
        "xlink:href",
        n.avatar
      );
      img.setAttribute("width", String(r * 2));
      img.setAttribute("height", String(r * 2));
      img.setAttribute("x", String(-r));
      img.setAttribute("y", String(-r));
      img.setAttribute("clip-path", `url(#${clipId})`);
      img.setAttribute("preserveAspectRatio", "xMidYMid slice");
      g.appendChild(img);
    } else {
      const shape = document.createElementNS(
        NS,
        isEvent ? "polygon" : "circle"
      );
      if (isEvent) {
        // diamond outline to keep it distinct from post (dot) and person (ring)
        const er = R.event;
        shape.setAttribute("points", `0,${-er} ${er},0 0,${er} ${-er},0`);
        shape.setAttribute("fill", "none");
        shape.setAttribute("stroke", "var(--color-ed-muted)");
        shape.setAttribute("stroke-width", "1.5");
      } else if (isSelf) {
        shape.setAttribute("r", String(R.self));
        shape.setAttribute("fill", "var(--color-ed-fg)");
        shape.setAttribute("stroke", "var(--color-ed-bg)");
        shape.setAttribute("stroke-width", "3");
      } else {
        shape.setAttribute("r", String(R.node));
        if (n.kind === "post") {
          shape.setAttribute("fill", "var(--color-ed-fg)");
        } else {
          shape.setAttribute("fill", "var(--color-ed-bg)");
          shape.setAttribute("stroke", "var(--color-ed-muted)");
          shape.setAttribute("stroke-width", "1.5");
        }
      }
      g.appendChild(shape);
    }

    const label = document.createElementNS(NS, "text");
    label.setAttribute("class", "graph-label");
    label.setAttribute("text-anchor", "middle");
    label.setAttribute("y", String(R.labelY));
    label.setAttribute(
      "style",
      `font-family: 'Source Sans 3', sans-serif; font-size: 12px; fill: var(--color-ed-muted);${isSelf ? " font-weight: 600;" : ""}`
    );
    label.textContent = n.title;
    g.appendChild(label);

    nodesG.appendChild(g);
    return g;
  });

  const simulation = forceSimulation(nodes as never)
    .force(
      "link",
      forceLink(links as never)
        .id((d) => (d as GraphNode).id)
        .distance(110)
    )
    .force("charge", forceManyBody().strength(-300))
    .force("center", forceCenter(W / 2, H / 2))
    .force("collide", forceCollide().radius(R.collide))
    // "self" is pinned to the center, everything else orbits it
    .force("x", forceX(W / 2).strength((d) => ((d as GraphNode).kind === "self" ? 1 : 0)))
    .force("y", forceY(H / 2).strength((d) => ((d as GraphNode).kind === "self" ? 1 : 0)))
    .on("tick", ticked);

  let resizeObserver: ResizeObserver | null = null;

  function cleanup() {
    cleanupController.abort();
    resizeObserver?.disconnect();
    resizeObserver = null;
    simulation.stop();
    document.body.style.overflow = "";
    // 若正展开：把 layout 移回原位，避免离开页面后 layout 残留在 body 末尾
    const lay = document.getElementById("graph-layout");
    if (lay && lay.classList.contains("is-expanded") && layoutOrigin) {
      const { parent, next } = layoutOrigin;
      if (next && next.parentNode === parent) {
        parent.insertBefore(lay, next);
      } else {
        parent.appendChild(lay);
      }
      lay.classList.remove("is-expanded");
      layoutOrigin = null;
    }
  }

  document.addEventListener("astro:before-swap", cleanup, {
    once: true,
    signal: cleanupController.signal,
  });
  window.addEventListener("pagehide", cleanup, {
    once: true,
    signal: cleanupController.signal,
  });

  function resolveNode(
    ref: string | (GraphNode & { x?: number; y?: number })
  ): (GraphNode & { x?: number; y?: number }) | undefined {
    return typeof ref === "string" ? nodeById.get(ref) : ref;
  }

  // Distance from a node center to its shape edge along a unit direction.
  // Circles are constant-radius; the diamond is an L1 ball (R = 9).
  function radial(n: GraphNode, ux: number, uy: number): number {
    if (n.kind === "event") {
      return R.event / (Math.abs(ux) + Math.abs(uy));
    }
    if (n.kind === "self") return R.self;
    return R.node; // post, person
  }

  // Shorten each link so it touches the node edges instead of crossing to centers
  function edgePoints(
    a: GraphNode & { x?: number; y?: number },
    b: GraphNode & { x?: number; y?: number }
  ): [number, number, number, number] {
    const dx = (b.x ?? 0) - (a.x ?? 0);
    const dy = (b.y ?? 0) - (a.y ?? 0);
    const d = Math.hypot(dx, dy);
    if (d === 0) return [a.x ?? 0, a.y ?? 0, b.x ?? 0, b.y ?? 0];
    const ux = dx / d;
    const uy = dy / d;
    const r1 = radial(a, ux, uy);
    const r2 = radial(b, -ux, -uy);
    return [
      (a.x ?? 0) + ux * r1,
      (a.y ?? 0) + uy * r1,
      (b.x ?? 0) - ux * r2,
      (b.y ?? 0) - uy * r2,
    ];
  }

  function ticked() {
    linkEls.forEach((line, i) => {
      const l = links[i];
      const s = resolveNode(l.source);
      const t = resolveNode(l.target);
      if (!s || !t) return;
      const [x1, y1, x2, y2] = edgePoints(s, t);
      line.setAttribute("x1", String(x1));
      line.setAttribute("y1", String(y1));
      line.setAttribute("x2", String(x2));
      line.setAttribute("y2", String(y2));
    });
    nodeEls.forEach((g, i) => {
      const n = nodes[i];
      g.setAttribute("transform", `translate(${n.x},${n.y})`);
    });
  }

  // Fit the viewBox to the visible canvas so the graph fills it (no letterboxing)
  let fitTries = 0;
  function fitViewBox() {
    if (!svg.isConnected) {
      fitTries = 0;
      return;
    }
    const w = svg.clientWidth;
    const h = svg.clientHeight;
    if (!w || !h) {
      // Layout not ready yet (cold load / font swap / mid-transition): retry next frame.
      if (fitTries++ < 120) requestAnimationFrame(fitViewBox);
      return;
    }
    fitTries = 0;
    svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
    simulation.force("center", forceCenter(w / 2, h / 2));
    simulation
      .force("x", forceX(w / 2).strength((d) => ((d as GraphNode).kind === "self" ? 1 : 0)))
      .force("y", forceY(h / 2).strength((d) => ((d as GraphNode).kind === "self" ? 1 : 0)));
    simulation.alpha(0.3).restart();
  }
  resizeObserver = new ResizeObserver(fitViewBox);
  resizeObserver.observe(svg);
  // Run once immediately, then re-fit after layout settles so a stale/zero initial
  // size (cold load, client-side nav, late web fonts) can't leave a broken viewBox.
  fitViewBox();
  requestAnimationFrame(() => requestAnimationFrame(fitViewBox));
  window.addEventListener("load", fitViewBox);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitViewBox);

  // --- Pan & zoom ---
  let zoom = { k: 1, tx: 0, ty: 0 };
  function applyZoom() {
    zoomG.setAttribute(
      "transform",
      `translate(${zoom.tx},${zoom.ty}) scale(${zoom.k})`
    );
  }
  applyZoom();

  function svgPoint(e: PointerEvent | WheelEvent | Touch) {
    const pt = svg.createSVGPoint();
    pt.x = e.clientX;
    pt.y = e.clientY;
    return pt.matrixTransform(svg.getScreenCTM()!.inverse());
  }

  svg.addEventListener(
    "wheel",
    (e) => {
      e.preventDefault();
      const p = svgPoint(e);
      const factor = Math.exp(-e.deltaY * 0.001);
      const newK = Math.min(4, Math.max(0.4, zoom.k * factor));
      zoom.tx = p.x - ((p.x - zoom.tx) / zoom.k) * newK;
      zoom.ty = p.y - ((p.y - zoom.ty) / zoom.k) * newK;
      zoom.k = newK;
      applyZoom();
    },
    { passive: false, signal: cleanupController.signal }
  );

  // --- Drag nodes (click vs drag distinguished by movement threshold) ---
  let pointerId: string | null = null;
  let dragged = false;
  let dragActive = false;
  let downOnNode = false;
  let downX = 0;
  let downY = 0;
  const dragOffset = { x: 0, y: 0 };

  function selectOrToggle(id: string) {
    if (activeId === id) {
      clearActive();
    } else {
      selectNode(id);
    }
  }

  svg.addEventListener("pointerdown", (e) => {
    const target = (e.target as Element).closest?.(
      ".graph-node"
    ) as SVGGElement | null;
    downOnNode = !!target;
    dragged = false;
    downX = e.clientX;
    downY = e.clientY;
    if (!target) {
      clearActive();
      return;
    }
    pointerId = target.dataset.id ?? null;
    if (pointerId) {
      const n = nodeById.get(pointerId)!;
      const p = svgPoint(e);
      dragOffset.x = (p.x - zoom.tx) / zoom.k - (n.x ?? 0);
      dragOffset.y = (p.y - zoom.ty) / zoom.k - (n.y ?? 0);
      target.focus();
    }
  });

  window.addEventListener("pointermove", (e) => {
    if (!pointerId) return;
    if (!dragged && Math.hypot(e.clientX - downX, e.clientY - downY) > 5) {
      dragged = true;
      // Keep the simulation warm but steady while dragging (official d3 pattern:
      // alphaTarget holds alpha at 0.3 instead of re-heating on every move)
      if (!dragActive) {
        dragActive = true;
        simulation.alphaTarget(0.3).restart();
      }
    }
    if (!dragged) return;
    const n = nodeById.get(pointerId);
    if (!n) return;
    const p = svgPoint(e);
    n.fx = (p.x - zoom.tx) / zoom.k - dragOffset.x;
    n.fy = (p.y - zoom.ty) / zoom.k - dragOffset.y;
  }, { signal: cleanupController.signal });

  window.addEventListener("pointerup", () => {
    if (pointerId) {
      const n = nodeById.get(pointerId);
      if (n) {
        n.fx = null;
        n.fy = null;
      }
    }
    if (dragActive) {
      dragActive = false;
      simulation.alphaTarget(0);
    }
    if (downOnNode && !dragged && pointerId) {
      selectOrToggle(pointerId);
    }
    pointerId = null;
    downOnNode = false;
    dragged = false;
  }, { signal: cleanupController.signal });

  // --- Active / highlight ---
  let activeId: string | null = null;

  // --- 放大 / 还原（全屏） ---
  const layoutEl = document.getElementById("graph-layout");
  const expandBtn = document.getElementById("graph-expand");
  // 展开时把 layout 移到 body 直属：sticky/transform 父级会锁死 fixed 定位，
  // 导致全屏层被限制在右栏内、被顶部 nav 盖住（层叠上下文困住）。
  // 记录原位置以便还原时移回。
  let layoutOrigin: { parent: Node; next: Node | null } | null = null;
  function setExpanded(on: boolean) {
    if (!layoutEl) return;
    if (on && layoutEl.parentElement !== document.body) {
      layoutOrigin = {
        parent: layoutEl.parentNode as Node,
        next: layoutEl.nextSibling,
      };
      document.body.appendChild(layoutEl);
    } else if (!on && layoutOrigin) {
      const { parent, next } = layoutOrigin;
      if (next && next.parentNode === parent) {
        parent.insertBefore(layoutEl, next);
      } else {
        parent.appendChild(layoutEl);
      }
      layoutOrigin = null;
    }
    layoutEl.classList.toggle("is-expanded", on);
    if (expandBtn) {
      expandBtn.setAttribute("aria-label", on ? "还原关系图谱" : "放大关系图谱");
      expandBtn.title = on ? "还原 (Esc)" : "放大";
    }
    // 图标切换：⤢ 放大 ⇄ ✕ 还原
    const icon = document.getElementById("graph-expand-icon");
    if (icon) {
      const p = icon.querySelector("path");
      if (p) {
        p.setAttribute(
          "d",
          on ? "M6 6l12 12M18 6L6 18" : "M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"
        );
      }
    }
    if (on) {
      document.body.style.overflow = "hidden";
    } else {
      document.body.style.overflow = "";
    }
    // 容器尺寸变化后：viewBox 跟随新尺寸，并让 d3 在新画布上重算布局
    // （保持 zoom 不动，不做自动铺满）
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        fitViewBox();
        simulation.alpha(0.6).restart();
      })
    );
  }
  expandBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    setExpanded(!layoutEl?.classList.contains("is-expanded"));
  }, { signal: cleanupController.signal });

  function linkEndIds(l: GraphLink): [string, string] {
    const s = resolveNode(l.source as never);
    const t = resolveNode(l.target as never);
    return [s?.id ?? "", t?.id ?? ""];
  }

  function neighborsOf(id: string): Set<string> {
    const out = new Set<string>([id]);
    for (const l of links) {
      const [sid, tid] = linkEndIds(l);
      if (sid === id) out.add(tid);
      if (tid === id) out.add(sid);
    }
    return out;
  }

  function clearActive() {
    activeId = null;
    nodeEls.forEach((g) => {
      g.style.opacity = "1";
      g.classList.remove("is-active");
    });
    linkEls.forEach((line) => {
      line.setAttribute("opacity", "1");
    });
    const panel = document.getElementById("graph-detail");
    if (panel) {
      panel.classList.remove("is-open");
      panel.innerHTML = "";
    }
  }

  function buildPreview(n: GraphNode & { x?: number; y?: number }) {
    const wrap = document.createElement("div");
    wrap.className = "graph-preview";

    const imgSrc = n.heroImage || n.avatar;
    if (imgSrc) {
      const img = document.createElement("img");
      img.src = imgSrc;
      img.alt = n.title;
      img.className = "graph-preview-img";
      wrap.appendChild(img);
    }

    const head = document.createElement("div");
    const kindLabel: Record<string, string> = {
      post: "文章",
      person: "人物",
      event: "事件",
      self: "我",
    };
    const label = kindLabel[n.kind];
    if (label) {
      const k = document.createElement("span");
      k.className = "graph-preview-kind";
      k.textContent = label;
      head.appendChild(k);
    }
    const h = document.createElement("h3");
    h.className = "graph-preview-title";
    h.textContent = n.title;
    head.appendChild(h);
    wrap.appendChild(head);

    if (n.excerpt) {
      const p = document.createElement("p");
      p.className = "graph-preview-excerpt";
      p.textContent = n.excerpt;
      wrap.appendChild(p);
    }

    if (n.kind === "post" && n.url) {
      const a = document.createElement("a");
      a.href = n.url;
      a.className = "graph-preview-link hover-underline";
      a.textContent = "阅读全文 →";
      wrap.appendChild(a);
    }
    return wrap;
  }

  function showDetail(n: GraphNode & { x?: number; y?: number }) {
    const panel = document.getElementById("graph-detail");
    if (!panel) return;
    panel.innerHTML = "";
    const preview = buildPreview(n);
    if (preview) panel.appendChild(preview);
    panel.classList.add("is-open");
  }

  function selectNode(id: string) {
    const n = nodeById.get(id);
    if (!n) return;
    const nb = neighborsOf(id);
    activeId = id;
    nodeEls.forEach((g) => {
      const on = nb.has(g.dataset.id ?? "");
      g.style.opacity = on ? "1" : "0.25";
      g.classList.toggle("is-active", g.dataset.id === id);
    });
    linkEls.forEach((line, i) => {
      const [sid, tid] = linkEndIds(links[i]);
      const on = nb.has(sid) && nb.has(tid);
      line.setAttribute("opacity", on ? "1" : "0.1");
    });
    showDetail(n);
    window.dispatchEvent(new CustomEvent("graph:select"));
  }

  nodeEls.forEach((g) => {
    g.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        const id = g.dataset.id;
        if (!id) return;
        if (activeId === id) clearActive();
        else selectNode(id);
      }
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      if (layoutEl?.classList.contains("is-expanded")) {
        setExpanded(false);
      } else {
        clearActive();
      }
    }
  }, { signal: cleanupController.signal });

  // timeline selected something -> clear graph highlight
  window.addEventListener("timeline:select", clearActive, { signal: cleanupController.signal });
</script>
