---
import type { GraphLink, GraphNode } from "../utils/graphData";

interface Props {
  nodes: GraphNode[];
  links: GraphLink[];
  /** 懒初始化：脚本推迟到浏览器空闲再跑（d3-force chunk 也不占首屏）。
   *  侧栏迷你图谱等非关键场景用；独立大图谱建议保持立即初始化。 */
  lazy?: boolean;
  /** 极简模式：只保留节点与连线，去掉图例/控制按钮/提示/详情面板/纸底网格。 */
  bare?: boolean;
}

const { nodes, links, lazy = false, bare = false } = Astro.props;
const graphData = JSON.stringify({ nodes, links }).replace(/</g, "\\u003c");
const nodeCount = nodes.length;
const linkCount = links.length;
---

<figure id="graph-view" class="graph-view" data-lazy={lazy ? "1" : undefined} data-bare={bare ? "1" : undefined}>
  <div class="graph-layout" id="graph-layout">
    <div class="graph-canvas">
      <svg
        id="graph-svg"
        viewBox="0 0 800 500"
        class="graph-svg"
        role="group"
        aria-labelledby="graph-svg-title"
        aria-describedby="graph-svg-desc graph-hint"
      >
        <title id="graph-svg-title">内容关系图谱</title>
        <desc id="graph-svg-desc">{`共 ${nodeCount} 个节点、${linkCount} 条关联。用 Tab 键逐个聚焦节点，回车查看详情。`}</desc>
        <defs>
          <pattern
            id="graph-dots"
            width="26"
            height="26"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="1.5" cy="1.5" r="1" fill="rgba(28, 28, 28, 0.13)"
            ></circle>
          </pattern>
        </defs>
        <rect
          class="graph-paper"
          width="100%"
          height="100%"
          fill="url(#graph-dots)"
          aria-hidden="true"></rect>
        <g id="graph-zoom">
          <g id="graph-links" stroke-linecap="round"></g>
          <g id="graph-nodes"></g>
        </g>
      </svg>

      <div class="graph-controls" role="group" aria-label="图谱视图控制">
        <button
          type="button"
          id="graph-expand"
          class="graph-ctrl"
          aria-label="放大关系图谱"
          title="放大"
        >
          <svg
            id="graph-expand-icon"
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
          </svg>
        </button>
        <span class="graph-ctrl-sep" aria-hidden="true"></span>
        <button
          type="button"
          id="graph-zoom-in"
          class="graph-ctrl"
          aria-label="放大地图"
          title="放大 (滚轮向上)"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14"></path>
          </svg>
        </button>
        <button
          type="button"
          id="graph-zoom-out"
          class="graph-ctrl"
          aria-label="缩小地图"
          title="缩小 (滚轮向下)"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M5 12h14"></path>
          </svg>
        </button>
        <button
          type="button"
          id="graph-reset"
          class="graph-ctrl"
          aria-label="复位视图"
          title="复位视图"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 12a9 9 0 1 0 2.65-6.35"></path>
            <path d="M3 4v5h5"></path>
          </svg>
        </button>
      </div>

      <p class="graph-hint" id="graph-hint">
        <span aria-hidden="true">缩放 · 点击查看详情</span>
        <span class="sr-only">
          在图上可用 Tab 键切换节点，按回车查看节点详情，方向键不移动视图，请使用「放大地图」「缩小地图」「复位视图」按钮缩放。
        </span>
      </p>

      <ul class="graph-legend" aria-label="节点图例">
        <li>
          <span class="graph-legend-glyph" aria-hidden="true">
            <svg viewBox="0 0 16 16">
              <circle cx="8" cy="8" r="3.6" fill="var(--color-ed-fg)"></circle>
            </svg>
          </span>
          文章
        </li>
        <li>
          <span class="graph-legend-glyph" aria-hidden="true">
            <svg viewBox="0 0 16 16">
              <circle cx="8" cy="8" r="4.2" fill="none" stroke="var(--color-ed-fg)" stroke-width="1.4"></circle>
            </svg>
          </span>
          人物
        </li>
        <li>
          <span class="graph-legend-glyph" aria-hidden="true">
            <svg viewBox="0 0 16 16">
              <polygon points="8,2.8 13.2,8 8,13.2 2.8,8" fill="none" stroke="var(--color-ed-fg)" stroke-width="1.4"></polygon>
            </svg>
          </span>
          事件
        </li>
      </ul>

      <aside
        id="graph-detail"
        class="graph-detail"
        aria-label="节点详情"
        aria-live="polite"
        aria-hidden="true"></aside>
    </div>
  </div>

  <script type="application/json" id="graph-data" set:html={graphData}></script>
</figure>

<style>
  .graph-view {
    margin: 0;
  }

  /* 极简模式：只留节点与连线（相关文章迷你图谱用）；标签平时隐藏，悬停/选中才出现 */
  .graph-view[data-bare="1"] :global(.graph-label) {
    opacity: 0;
    transition: opacity 160ms ease;
  }
  .graph-view[data-bare="1"] :global(.graph-node.is-hover .graph-label),
  .graph-view[data-bare="1"] :global(.graph-node.is-active .graph-label) {
    opacity: 1;
  }
  /* bare 模式没有详情抽屉，节点就是链接：给按下反馈与手型光标 */
  .graph-view[data-bare="1"] :global(.graph-node) {
    cursor: pointer;
  }
  .graph-view[data-bare="1"] :global(.graph-node:active .graph-node-shape) {
    transform: scale(0.96);
    transition: transform 120ms ease;
  }
  .graph-view[data-bare="1"] .graph-legend,
  .graph-view[data-bare="1"] .graph-legend,
  .graph-view[data-bare="1"] .graph-controls,
  .graph-view[data-bare="1"] .graph-hint,
  .graph-view[data-bare="1"] .graph-detail,
  .graph-view[data-bare="1"] .graph-paper {
    display: none;
  }
  .graph-view[data-bare="1"] .graph-canvas {
    border: 0;
    box-shadow: none;
    background: transparent;
  }

  .graph-layout {
    position: relative;
    container-type: inline-size;
  }

  /* 画布：纸底 + 点阵网格 + 极浅的内阴影，让图谱像印在纸上的一张图版 */
  .graph-canvas {
    position: relative;
    height: var(--graph-h, 26rem);
    overflow: hidden;
    border: 1px solid var(--color-ed-rule);
    border-radius: 4px;
    background:
      radial-gradient(
        120% 92% at 50% 0%,
        rgba(255, 255, 255, 0.72),
        transparent 68%
      ),
      var(--color-ed-bg);
    box-shadow:
      0 1px 0 rgba(28, 28, 28, 0.04),
      0 22px 44px -36px rgba(28, 28, 28, 0.6);
    transition: box-shadow 0.3s var(--ease-ed);
  }

  .graph-svg {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  /* 触屏：纵向滑动交给页面滚动（整块画布几乎占满手机屏，否则会把页面滚死），
     横向拖拽与双指缩放仍由图谱接管 */
  @media (hover: none) and (pointer: coarse) {
    .graph-svg {
      touch-action: pan-y;
    }
  }
  .graph-svg:active {
    cursor: grabbing;
  }

  .graph-paper {
    pointer-events: none;
  }

  /* 悬浮控制条：竖排一组圆角按钮，纸底 + 极细描边 */
  .graph-controls {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 3px;
    border: 1px solid var(--color-ed-hairline);
    border-radius: 999px;
    background: rgba(249, 248, 246, 0.88);
    box-shadow: 0 1px 2px rgba(28, 28, 28, 0.06);
    backdrop-filter: blur(6px);
  }

  .graph-ctrl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ed-muted);
    cursor: pointer;
    transition:
      color 0.18s ease,
      background 0.18s ease;
  }
  .graph-ctrl:hover {
    color: var(--color-ed-accent);
    background: rgba(166, 58, 43, 0.08);
  }
  .graph-ctrl:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: 1px;
  }
  .graph-ctrl:disabled {
    color: var(--color-ed-faint);
    cursor: default;
    background: transparent;
  }
  /* 展开/还原图标：d 值仍是硬切，但叠加 200ms 旋转过渡，读作形变而非跳变 */
  #graph-expand svg {
    transition: transform 200ms var(--ease-ed);
  }
  #graph-expand.is-expanded svg {
    transform: rotate(90deg);
  }

  .graph-ctrl-sep {
    width: 1.1rem;
    height: 1px;
    background: var(--color-ed-hairline);
    margin: 2px 0;
  }

  /* 操作提示：首次交互后淡出，不遮挡长期阅读 */
  .graph-hint {
    position: absolute;
    top: 0.75rem;
    left: 0.8rem;
    z-index: 3;
    max-width: 60%;
    margin: 0;
    padding: 0.2rem 0.45rem;
    border-radius: 2px;
    background: rgba(249, 248, 246, 0.7);
    color: var(--color-ed-subtle);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    line-height: 1.5;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  .graph-layout.has-interacted .graph-hint {
    opacity: 0;
  }

  /* 图例：浮在画布左下角，形状与真实节点一一对应 */
  .graph-legend {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.8rem;
    margin: 0;
    padding: 0.35rem 0.55rem;
    list-style: none;
    border: 1px solid var(--color-ed-hairline);
    border-radius: 3px;
    background: rgba(249, 248, 246, 0.82);
    color: var(--color-ed-subtle);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    backdrop-filter: blur(4px);
  }
  .graph-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
  }
  .graph-legend-glyph {
    display: inline-flex;
    width: 0.875rem;
    height: 0.875rem;
  }
  .graph-legend-glyph svg {
    width: 100%;
    height: 100%;
  }

  /* 详情抽屉：浮层盖在画布右侧，不改变画布尺寸，避免每次点节点都重排布局 */
  .graph-detail {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 6;
    width: min(21rem, 100%);
    overflow: hidden;
    background: rgba(249, 248, 246, 0.97);
    border-left: 1px solid var(--color-ed-rule);
    box-shadow: -18px 0 40px -28px rgba(28, 28, 28, 0.45);
    opacity: 0;
    visibility: hidden;
    transform: translateX(102%);
    transition:
      transform 0.38s var(--ease-ed),
      opacity 0.2s ease,
      visibility 0s linear 0.38s;
  }
  .graph-detail.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      transform 0.38s var(--ease-ed),
      opacity 0.2s ease,
      visibility 0s;
  }

  /* 全屏展开态 */
  .graph-layout.is-expanded {
    position: fixed;
    inset: 1rem;
    z-index: 100;
    display: flex;
    align-items: stretch;
    padding: 1rem;
    border-radius: 0.5rem;
  }
  /* 遮罩独立到 ::before：画布本体走 FLIP 位移动画，遮罩只负责压暗，
     两者不再共享整层透明度动画。z-index: 0 落在画布（relative）与
     工具条/图例/提示（z-index 3-4）、详情抽屉（z-index 6）之下 */
  .graph-layout.is-expanded::before,
  .graph-layout.is-closing::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 0.5rem;
    background: rgba(28, 28, 28, 0.55);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(3px);
    pointer-events: none;
  }
  .graph-layout.is-expanded::before {
    animation: graph-scrim-in 320ms var(--ease-ed) both;
  }
  /* 还原时 is-expanded 必须先摘掉（fixed 定位下量不到内联矩形），
     所以遮罩淡出要在没有展开态时独立成立：is-closing 自己持有
     上面那一份视觉属性，否则遮罩会随类移除瞬间消失 */
  .graph-layout.is-closing::before {
    animation: graph-scrim-out 200ms var(--ease-ed) both;
  }
  @keyframes graph-scrim-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes graph-scrim-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  .graph-layout.is-expanded .graph-canvas {
    flex: 1;
    height: auto;
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: none;
  }
  .graph-layout.is-expanded .graph-detail {
    border-radius: 4px;
    border: 1px solid var(--color-ed-rule);
    background: var(--color-ed-bg);
  }

  /* --- 动态生成的 SVG 元素 --- */
  /* 键盘焦点可见：图谱节点是可聚焦的 role=button，必须有可见焦点环 */
  :global(.graph-svg .graph-node:focus-visible) {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  :global(.graph-node) {
    transition: opacity 0.25s ease;
  }
  :global(.graph-node-shape),
  :global(.graph-node-halo) {
    transition:
      transform 0.28s var(--ease-ed),
      stroke 0.25s ease,
      stroke-width 0.28s var(--ease-ed);
    transform-origin: center;
    transform-box: fill-box;
  }
  :global(.graph-node.is-hover .graph-node-shape),
  :global(.graph-node.is-hover .graph-node-halo) {
    transform: scale(1.12);
  }
  :global(.graph-node-halo) {
    fill: none;
    stroke: rgba(166, 58, 43, 0);
    stroke-width: 1.2;
  }
  :global(.graph-node.is-hover .graph-node-halo),
  :global(.graph-node.is-active .graph-node-halo) {
    stroke: rgba(166, 58, 43, 0.55);
    stroke-width: 2;
  }
  :global(.graph-node.is-active .graph-node-halo) {
    stroke: var(--color-ed-accent);
  }
  :global(.graph-node.is-hover .graph-node-shape),
  :global(.graph-node.is-active .graph-node-shape) {
    stroke: var(--color-ed-accent);
  }
  /* 主模式节点按压反馈：与 .is-hover 的放大同权级，:active 规则必须排在其后，按住时才能胜出 */
  :global(.graph-node:active .graph-node-shape),
  :global(.graph-node:active .graph-node-halo) {
    transform: scale(0.96);
  }

  :global(.graph-label) {
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.01em;
    fill: var(--color-ed-muted);
    /* 纸色描边垫在文字下面：标签压在连线/其它节点上也读得清 */
    paint-order: stroke fill;
    stroke: var(--color-ed-bg);
    stroke-width: 3.5px;
    stroke-linejoin: round;
    pointer-events: none;
    /* 标签不参与节点形状的缩放，保持稳定可读 */
    transform: none !important;
    transition:
      fill 0.2s ease,
      opacity 0.2s ease;
  }
  /* 节点很多时标签一定会互相压字：只保留悬停/选中节点的标签，其余交给抽屉 */
  .graph-layout.is-dense :global(.graph-label) {
    opacity: 0;
  }
  .graph-layout.is-dense :global(.graph-node.is-hover .graph-label),
  .graph-layout.is-dense :global(.graph-node.is-active .graph-label) {
    opacity: 1;
  }
  :global(.graph-node.is-hover .graph-label),
  :global(.graph-node.is-active .graph-label) {
    fill: var(--color-ed-fg);
    font-weight: 600;
  }

  :global(.graph-link) {
    transition:
      opacity 0.25s ease,
      stroke 0.25s ease,
      stroke-width 0.28s var(--ease-ed);
  }
  :global(.graph-link--self) {
    stroke: rgba(28, 28, 28, 0.24);
    stroke-width: 1;
  }
  :global(.graph-link--peer) {
    stroke: rgba(28, 28, 28, 0.44);
    stroke-width: 1.4;
  }
  :global(.graph-link.is-hot) {
    stroke: var(--color-ed-accent);
    stroke-width: 2.2;
  }

  /* 节点可拖拽（Obsidian 式）：静置 grab、按住 grabbing */
  :global(.graph-node) {
    cursor: grab;
  }
  :global(.graph-node:active) {
    cursor: grabbing;
  }

  @keyframes graph-in {
    from {
      opacity: 0;
    }
  }
  :global(.graph-node),
  :global(.graph-link) {
    animation: graph-in 0.5s var(--ease-ed) backwards;
  }

  /* 抽屉已开时换节点：内文 160ms 淡入，避免整块文字瞬换 */
  :global(.graph-detail-inner.is-swapping) {
    animation: graph-detail-swap 160ms ease-out both;
  }
  @keyframes graph-detail-swap {
    from {
      opacity: 0;
      transform: translateY(2px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* 详情抽屉内容（DOM 由脚本拼装） */
  :global(.graph-detail-inner) {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.2rem 1.35rem 1.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  :global(.graph-detail-top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.8rem;
  }
  :global(.graph-detail-close) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 1px solid var(--color-ed-hairline);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ed-muted);
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      transform 120ms var(--ease-ed);
  }
  :global(.graph-detail-close:hover) {
    color: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
  }
  /* 按压反馈：圆形小钮，缩到 0.94 */
  :global(.graph-detail-close:active) {
    transform: scale(0.94);
  }
  :global(.graph-preview-img) {
    width: 100%;
    height: 8.5rem;
    margin-bottom: 0.85rem;
    border-radius: 3px;
    object-fit: cover;
    filter: saturate(0.95);
  }
  :global(.graph-preview-kind) {
    display: inline-block;
    padding: 1px 6px;
    border: 1px solid rgba(166, 58, 43, 0.4);
    border-radius: 2px;
    background: rgba(166, 58, 43, 0.06);
    color: var(--color-ed-accent);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }
  :global(.graph-preview-title) {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-ed-fg);
    text-wrap: balance;
  }
  :global(.graph-preview-excerpt) {
    display: -webkit-box;
    margin: 0.55rem 0 0;
    overflow: hidden;
    color: var(--color-ed-muted);
    font-size: 0.8125rem;
    line-height: 1.68;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
  }
  :global(.graph-detail-rel) {
    margin-top: 1.1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-ed-hairline);
  }
  :global(.graph-rel-head) {
    margin: 0 0 0.5rem;
    color: var(--color-ed-subtle);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }
  :global(.graph-rel-head b) {
    color: var(--color-ed-fg);
    font-weight: 600;
  }
  :global(.graph-rel-list) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.graph-rel-chip) {
    padding: 0.26rem 0.5rem;
    border: 1px solid var(--color-ed-hairline);
    border-radius: 2px;
    background: transparent;
    color: var(--color-ed-fg);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.2;
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      transform 120ms var(--ease-ed);
  }
  :global(.graph-rel-chip:hover) {
    color: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
  }
  /* 按压反馈：小型 chip 类，用 0.97 的轻缩 */
  :global(.graph-rel-chip:active) {
    transform: scale(0.97);
  }
  :global(.graph-preview-link) {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-ed-fg);
    font-size: 0.8125rem;
  }

  /* 窄容器（手机 / 侧栏）：详情改为底部抽屉 */
  @container (max-width: 620px) {
    .graph-detail {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      max-height: 78%;
      border-left: 0;
      border-top: 1px solid var(--color-ed-rule);
      border-radius: 6px 6px 0 0;
      transform: translateY(101%);
      box-shadow: 0 -18px 40px -28px rgba(28, 28, 28, 0.5);
    }
    .graph-detail.is-open {
      transform: none;
    }
    .graph-legend {
      gap: 0.25rem 0.6rem;
      padding: 0.3rem 0.45rem;
    }
  }

  @media (max-width: 767px) {
    .graph-hint {
      max-width: 55%;
      font-size: 0.6875rem;
    }
    .graph-ctrl {
      width: 2.25rem;
      height: 2.25rem;
    }
    :global(.graph-label) {
      font-size: 11.5px;
      stroke-width: 3px;
    }
    .graph-layout.is-expanded {
      inset: 0.5rem;
      padding: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* 详情抽屉不再滑入滑出：位移归零，隐藏由 opacity+visibility 承担，只留 150ms 淡入淡出
       （visibility 时序保留：关=淡出结束后再隐藏，开=立即可见） */
    .graph-detail {
      transform: none;
      transition:
        opacity 150ms linear,
        visibility 0s linear 150ms;
    }
    .graph-detail.is-open {
      transition:
        opacity 150ms linear,
        visibility 0s;
    }
    /* 节点形状/光晕：缩放过渡取消，悬停/按压位移归零（位移动画 reduce 覆盖补漏） */
    :global(.graph-node-shape),
    :global(.graph-node-halo) {
      transition: none;
    }
    :global(.graph-node.is-hover .graph-node-shape),
    :global(.graph-node.is-hover .graph-node-halo),
    :global(.graph-node:active .graph-node-shape),
    :global(.graph-node:active .graph-node-halo) {
      transform: none;
    }
    .graph-ctrl,
    #graph-expand svg,
    .graph-hint,
    :global(.graph-node),
    :global(.graph-link),
    :global(.graph-label) {
      transition: none;
    }
    :global(.graph-node),
    :global(.graph-link) {
      animation: none;
    }
    /* 展开 / 换篇：直接落位（缩放补间与展开/还原 FLIP 在脚本里也走 instant
       分支），遮罩保留极短的 linear 淡入淡出 */
    .graph-layout.is-expanded::before,
    .graph-layout.is-closing::before {
      animation-duration: 150ms;
      animation-timing-function: linear;
    }
    :global(.graph-detail-inner.is-swapping) {
      animation: none;
    }
    .graph-view[data-bare="1"] :global(.graph-node:active .graph-node-shape) {
      transform: none;
    }
  }
</style>

<script>
  import type { GraphLink, GraphNode } from "../utils/graphData";
  import { initSnake } from "../utils/graphSnake";

  async function initGraph() {
  const svg = document.querySelector<SVGSVGElement>("#graph-svg")!;
  const zoomG = document.querySelector<SVGGElement>("#graph-zoom")!;
  const linksG = document.querySelector<SVGGElement>("#graph-links")!;
  const nodesG = document.querySelector<SVGGElement>("#graph-nodes")!;
  const layoutEl = document.getElementById("graph-layout");
  const panel = document.getElementById("graph-detail");
  // bare（相关文章迷你图谱）：详情抽屉被 display:none，点击必须直接跳转
  const isBare =
    document.getElementById("graph-view")?.dataset.bare === "1";
  const data = JSON.parse(
    document.querySelector<HTMLScriptElement>("#graph-data")?.textContent ?? "{}"
  ) as { nodes: GraphNode[]; links: GraphLink[] };

  const {
    forceSimulation,
    forceLink,
    forceManyBody,
    forceCenter,
    forceCollide,
    forceX,
    forceY,
  } = await import("d3-force");

  const W = 800;
  const H = 500;
  const cleanupController = new AbortController();
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  type SimNode = GraphNode & {
    x: number;
    y: number;
    vx?: number;
    vy?: number;
    fx?: number | null;
    fy?: number | null;
  };

  const nodes = data.nodes.map((n) => ({ ...n })) as SimNode[];
  const links = data.links.map((l) => ({ ...l }));
  const nodeById = new Map(nodes.map((n) => [n.id, n]));
  // 书虫吞下的节点 id：collide 半径归零、连线沉底（集合由 graphSnake 模块增删）
  const swallowedIds = new Set<string>();

  // 节点较多时隐藏常驻标签（见 .graph-layout.is-dense），避免整页叠字
  if (nodes.length > 18) {
    layoutEl?.classList.add("is-dense");
    const hintText = document.querySelector<HTMLElement>(
      ".graph-hint [aria-hidden]"
    );
    if (hintText) hintText.textContent = "缩放 · 悬停查看名称";
  }

  // 节点尺寸随节点总数缓慢收敛：6 个以内保持满尺寸，之后每多 1 个缩 1.2%，
  // 下限 0.8（缩太狠节点小到看不清图标）
  const nodeScale = Math.max(
    0.8,
    Math.min(1, 1 - (nodes.length - 6) * 0.012)
  );
  // 半径（事件的菱形按 L1 半径计）
  const R = {
    self: 6 * nodeScale, // 相关文章图谱的中心（当前文章，与环绕文章点等大）
    avatarSelf: 12 * nodeScale,
    avatar: 12 * nodeScale, // 头像节点
    node: 6 * nodeScale, // 文章
    person: 7 * nodeScale,
    event: 8 * nodeScale,
    hit: 20 * nodeScale,
    collide: 34 * nodeScale,
  };

  const radiusOf = (n: GraphNode): number => {
    if (n.avatar) return n.kind === "self" ? R.avatarSelf : R.avatar;
    if (n.kind === "self") return R.self;
    if (n.kind === "event") return R.event;
    if (n.kind === "person") return R.person;
    return R.node;
  };

  // 初始位置：从中心按黄金角螺旋散开（确定性，无随机）——Obsidian 式纯力导
  // 没有环带/中枢锚点，最终形态完全由连线弹簧 + 斥力涌现，孤点自然漂到外圈
  function seedNodes(w: number, h: number) {
    const cx = w / 2;
    const cy = h / 2;
    const golden = Math.PI * (3 - Math.sqrt(5));
    nodes.forEach((n, i) => {
      const r = 30 + Math.sqrt(i) * 46;
      const a = i * golden;
      n.x = cx + Math.cos(a) * r;
      n.y = cy + Math.sin(a) * r;
    });
  }
  seedNodes(svg.clientWidth || W, svg.clientHeight || H);

  const NS = "http://www.w3.org/2000/svg";

  // 连线默认透明度：Obsidian 式「淡网」，悬停/选中节点时关联线点亮到 1
  const LINK_FADED_OPACITY = "0.35";

  const linkEls = links.map((l, i) => {
    const line = document.createElementNS(NS, "line");
    const sid = String(l.source);
    const tid = String(l.target);
    // self 连线仅出现在相关文章迷你图谱（当前文章 → 相关文章）
    const isSelfLink = sid === "self" || tid === "self";
    line.setAttribute(
      "class",
      isSelfLink ? "graph-link graph-link--self" : "graph-link graph-link--peer"
    );
    // 默认淡化连线（Obsidian 式）：悬停/选中节点才点亮关联线；
    // bare 迷你图的连线就是信息本体，不淡化
    if (!isBare) line.setAttribute("opacity", LINK_FADED_OPACITY);
    line.style.animationDelay = `${i * 24}ms`;
    linksG.appendChild(line);
    return line;
  });

  // 标签最大字数：窄屏更容易顶到画布边缘，截短一点
  const maxLabelChars = (svg.clientWidth || window.innerWidth) < 480 ? 9 : 14;
  const labelEls: SVGTextElement[] = [];
  const labelMeta: { sign: number; r: number }[] = [];

  const nodeEls = nodes.map((n, ni) => {
    const g = document.createElementNS(NS, "g");
    g.setAttribute("class", "graph-node");
    g.dataset.id = n.id;
    g.dataset.kind = n.kind;
    g.dataset.contentIndex = String(n.contentIndex);
    g.dataset.url = n.url;
    g.setAttribute("role", "button");
    g.setAttribute("tabindex", "0");
    g.setAttribute("aria-label", `${kindLabel(n.kind)}：${n.title}`);
    // bare 迷你图是导航组件（点击跳转），保持 pointer；全图节点可拖拽走 CSS grab
    if (isBare) g.style.cursor = "pointer";
    g.style.animationDelay = `${80 + ni * 40}ms`;

    const r = radiusOf(n);
    const isEvent = n.kind === "event";
    const isSelf = n.kind === "self";

    // 纸色光晕：连线/其它节点压过来时仍能读清节点轮廓
    const halo = document.createElementNS(NS, "circle");
    halo.setAttribute("class", "graph-node-halo");
    halo.setAttribute("r", String(r + 6));
    g.appendChild(halo);

    // Large transparent hit area: forgiving click/drag targets
    const hit = document.createElementNS(NS, "circle");
    hit.setAttribute("r", String(Math.max(R.hit, r + 12)));
    hit.setAttribute("fill", "transparent");
    hit.style.pointerEvents = "all";
    g.appendChild(hit);

    if (n.avatar) {
      const clipId = `graph-clip-${ni}`;
      const defs = document.createElementNS(NS, "defs");
      const clip = document.createElementNS(NS, "clipPath");
      clip.setAttribute("id", clipId);
      const cc = document.createElementNS(NS, "circle");
      cc.setAttribute("r", String(r));
      clip.appendChild(cc);
      defs.appendChild(clip);
      g.appendChild(defs);

      // 头像下面垫一圈纸色，避免头像与连线糊在一起
      const backing = document.createElementNS(NS, "circle");
      backing.setAttribute("r", String(r + 2.5));
      backing.setAttribute("fill", "var(--color-ed-bg)");
      g.appendChild(backing);

      const img = document.createElementNS(NS, "image");
      img.setAttribute("class", "graph-node-shape");
      img.setAttribute("href", n.avatar);
      img.setAttributeNS(
        "http://www.w3.org/1999/xlink",
        "xlink:href",
        n.avatar
      );
      img.setAttribute("width", String(r * 2));
      img.setAttribute("height", String(r * 2));
      img.setAttribute("x", String(-r));
      img.setAttribute("y", String(-r));
      img.setAttribute("clip-path", `url(#${clipId})`);
      img.setAttribute("preserveAspectRatio", "xMidYMid slice");
      g.appendChild(img);

      if (isSelf) {
        const ring = document.createElementNS(NS, "circle");
        ring.setAttribute("class", "graph-node-shape");
        ring.setAttribute("r", String(r + 2.5));
        ring.setAttribute("fill", "none");
        ring.setAttribute("stroke", "var(--color-ed-accent)");
        ring.setAttribute("stroke-width", "1.4");
        g.appendChild(ring);
      }
    } else if (isEvent) {
      const er = R.event;
      const shape = document.createElementNS(NS, "polygon");
      shape.setAttribute("class", "graph-node-shape");
      shape.setAttribute(
        "points",
        `0,${-er} ${er},0 0,${er} ${-er},0`
      );
      shape.setAttribute("fill", "var(--color-ed-bg)");
      shape.setAttribute("stroke", "var(--color-ed-fg)");
      shape.setAttribute("stroke-width", "1.6");
      shape.setAttribute("stroke-linejoin", "round");
      g.appendChild(shape);
    } else if (isSelf) {
      const shape = document.createElementNS(NS, "circle");
      shape.setAttribute("class", "graph-node-shape");
      shape.setAttribute("r", String(R.self));
      shape.setAttribute("fill", "var(--color-ed-fg)");
      shape.setAttribute("stroke", "var(--color-ed-bg)");
      shape.setAttribute("stroke-width", "2");
      g.appendChild(shape);
    } else if (n.kind === "post") {
      const shape = document.createElementNS(NS, "circle");
      shape.setAttribute("class", "graph-node-shape");
      shape.setAttribute("r", String(R.node));
      shape.setAttribute("fill", "var(--color-ed-fg)");
      shape.setAttribute("stroke", "var(--color-ed-bg)");
      shape.setAttribute("stroke-width", "2");
      g.appendChild(shape);
    } else {
      // person：空心圆环，与实心文章点区分
      const shape = document.createElementNS(NS, "circle");
      shape.setAttribute("class", "graph-node-shape");
      shape.setAttribute("r", String(R.person));
      shape.setAttribute("fill", "var(--color-ed-bg)");
      shape.setAttribute("stroke", "var(--color-ed-fg)");
      shape.setAttribute("stroke-width", "1.6");
      g.appendChild(shape);
    }

    // 标签上下交错，减少同一水平线上的叠字
    const sign = ni % 2 === 0 ? 1 : -1;
    const label = document.createElementNS(NS, "text");
    label.setAttribute("class", "graph-label");
    label.setAttribute("text-anchor", "middle");
    label.setAttribute("dominant-baseline", "middle");
    label.setAttribute("y", String(sign * (r + 13)));
    if (isSelf) label.style.fontWeight = "600";
    label.textContent =
      n.title.length > maxLabelChars
        ? `${n.title.slice(0, maxLabelChars - 1)}…`
        : n.title;
    g.appendChild(label);
    labelEls.push(label);
    labelMeta.push({ sign, r });

    nodesG.appendChild(g);
    return g;
  });

  function kindLabel(kind: GraphNode["kind"]): string {
    return (
      {
        post: "文章",
        person: "人物",
        event: "事件",
        self: "当前文章",
      }[kind] ?? "节点"
    );
  }

  // 提前声明：ticked() 在 simulation.stop() 后立即调用，晚声明会踩 TDZ
  let viewW = 0;
  let viewH = 0;
  // 标签宽度缓存：换字体 / 断点改变字号后重测一次，避免每帧读布局
  let labelWidths: number[] = [];
  function measureLabels() {
    labelWidths = labelEls.map((l) => {
      try {
        return l.getComputedTextLength();
      } catch {
        return 0;
      }
    });
  }
  measureLabels();

  const simulation = forceSimulation(nodes as never)
    .force(
      "link",
      forceLink(links as never)
        .id((d: GraphNode) => d.id)
        // 统一短边：真实关联（graph.links / 站内 md 链接）表达「强关联」
        .distance(110)
    )
    // Obsidian 式纯力导：斥力摊开 + 碰撞防叠 + 中心聚拢，没有环带/中枢锚点，
    // 连线密集处自然成簇，孤点漂到外圈
    .force("charge", forceManyBody().strength(-200))
    .force("center", forceCenter(W / 2, H / 2))
    // 被书虫吞下的节点不占碰撞位（隐身且钉在原地）
    .force(
      "collide",
      forceCollide().radius((d: GraphNode) =>
        swallowedIds.has(d.id) ? 0 : R.collide
      )
    )
    // "self" is pinned to the center（相关文章迷你图谱：当前文章居中）
    .force(
      "x",
      forceX(W / 2).strength((d: GraphNode) => (d.kind === "self" ? 1 : 0))
    )
    .force(
      "y",
      forceY(H / 2).strength((d: GraphNode) => (d.kind === "self" ? 1 : 0))
    )
    .on("tick", ticked);
  // 力导自动开跑：seedNodes 提供初始位置，收敛后 alpha 衰减自动停表

  let resizeObserver: ResizeObserver | null = null;

  function cleanup() {
    cleanupController.abort();
    disposeSnake?.();
    disposeSnake = null;
    stopZoomAnim();
    resizeObserver?.disconnect();
    resizeObserver = null;
    simulation.stop();
    document.body.style.overflow = "";
    // 若正展开：把 layout 移回原位，避免离开页面后 layout 残留在 body 末尾
    if (layoutEl?.classList.contains("is-expanded") && layoutOrigin) {
      const { parent, next } = layoutOrigin;
      if (next && next.parentNode === parent) {
        parent.insertBefore(layoutEl, next);
      } else {
        parent.appendChild(layoutEl);
      }
      layoutEl.classList.remove("is-expanded");
      layoutEl.classList.remove("is-closing");
      // 若动画中途离页（pagehide 后可能从 bfcache 回存），
      // FLIP 的内联 transition/transform 不能残留
      layoutEl.style.transition = "";
      layoutEl.style.transform = "";
      layoutEl.style.transformOrigin = "";
      layoutOrigin = null;
      expanding = false;
    }
  }

  document.addEventListener("astro:before-swap", cleanup, {
    once: true,
    signal: cleanupController.signal,
  });
  window.addEventListener("pagehide", cleanup, {
    once: true,
    signal: cleanupController.signal,
  });

  // 彩蛋：墨色书虫（蠹鱼）——在图里漫游、叼走节点过会儿吐回、鼠标靠近逃跑。
  // bare 迷你图 / reduce-motion / 节点太少（书虫没得挑）都不养
  let disposeSnake: (() => void) | null = null;
  if (!isBare && !prefersReducedMotion && nodes.length >= 3) {
    disposeSnake = initSnake({
      svg,
      zoomG,
      nodes,
      nodeEls,
      links,
      linkEls,
      swallowedIds,
      restingLinkOpacity: LINK_FADED_OPACITY,
      busyId: () => dragNode?.id ?? activeId ?? null,
      cleanupSignal: cleanupController.signal,
    });
  }

  function resolveNode(
    ref: string | (GraphNode & { x?: number; y?: number })
  ): (GraphNode & { x?: number; y?: number }) | undefined {
    return typeof ref === "string" ? nodeById.get(ref) : ref;
  }

  // Distance from a node center to its shape edge along a unit direction.
  // Circles are constant-radius; the diamond is an L1 ball.
  function radial(n: GraphNode, ux: number, uy: number): number {
    if (n.kind === "event" && !n.avatar) {
      return R.event / (Math.abs(ux) + Math.abs(uy) || 1);
    }
    return radiusOf(n);
  }

  // Shorten each link so it touches the node edges instead of crossing to centers
  function edgePoints(
    a: GraphNode & { x?: number; y?: number },
    b: GraphNode & { x?: number; y?: number }
  ): [number, number, number, number] {
    const dx = (b.x ?? 0) - (a.x ?? 0);
    const dy = (b.y ?? 0) - (a.y ?? 0);
    const d = Math.hypot(dx, dy);
    if (d === 0) return [a.x ?? 0, a.y ?? 0, b.x ?? 0, b.y ?? 0];
    const ux = dx / d;
    const uy = dy / d;
    const r1 = radial(a, ux, uy);
    const r2 = radial(b, -ux, -uy);
    return [
      (a.x ?? 0) + ux * r1,
      (a.y ?? 0) + uy * r1,
      (b.x ?? 0) - ux * r2,
      (b.y ?? 0) - uy * r2,
    ];
  }

  function ticked() {
    const w = viewW || W;
    const h = viewH || H;
    // 节点先 clamp、连线后重算——顺序不能反：
    // 在线模式下 ticked 由 d3 定时器的 tick 事件逐帧驱动，离线定格（reduce-motion）
    // 下由显式调用驱动（d3 的手动 simulation.tick() 不派发事件）。clamp 会改写
    // 节点坐标，若先画线，线端点会停在节点被压回边界之前的旧位置，缩略图上整段错开
    nodeEls.forEach((g, i) => {
      const n = nodes[i];
      // 兜底 clamp：节点本体压进画布内边距，上下不再顶边
      // （下边距更大，给下侧标签留位；标签另有独立 clamp）
      n.x = Math.min(Math.max(n.x, 26), Math.max(w - 26, 26));
      n.y = Math.min(Math.max(n.y, 38), Math.max(h - 42, 38));
      g.setAttribute("transform", `translate(${n.x},${n.y})`);

      // 标签贴着节点但在画布内：越界的部分向内收，避免被裁掉
      const label = labelEls[i];
      const meta = labelMeta[i];
      if (label && meta) {
        const half = (labelWidths[i] ?? 0) / 2;
        const x = Math.min(
          Math.max(n.x, half + 6),
          Math.max(half + 6, w - half - 6)
        );
        const y = Math.min(
          Math.max(n.y + meta.sign * (meta.r + 13), 12),
          h - 12
        );
        label.setAttribute("x", String(x - n.x));
        label.setAttribute("y", String(y - n.y));
      }
    });
    linkEls.forEach((line, i) => {
      const l = links[i];
      const s = resolveNode(l.source);
      const t = resolveNode(l.target);
      if (!s || !t) return;
      const [x1, y1, x2, y2] = edgePoints(s, t);
      line.setAttribute("x1", String(x1));
      line.setAttribute("y1", String(y1));
      line.setAttribute("x2", String(x2));
      line.setAttribute("y2", String(y2));
    });
  }

  // Fit the viewBox to the visible canvas so the graph fills it (no letterboxing)
  let fitTries = 0;
  let graphFitted = false;

  // reduce-motion 退路：离线松弛 90 tick 后定格（手动 tick 不派发事件，
  // DOM 落盘由循环后的显式 ticked() 一次完成——节点先 clamp、连线后重算）
  function settleOffline() {
    simulation.alpha(1);
    for (let i = 0; i < 90; i++) simulation.tick();
    ticked();
    simulation.stop();
  }

  function fitViewBox() {
    if (!svg.isConnected) {
      fitTries = 0;
      return;
    }
    const w = svg.clientWidth;
    const h = svg.clientHeight;
    if (!w || !h) {
      // Layout not ready yet (cold load / font swap / mid-transition): retry next frame.
      if (fitTries++ < 120) requestAnimationFrame(fitViewBox);
      return;
    }
    fitTries = 0;
    const sizeChanged = viewW !== w || viewH !== h;
    const firstFit = !graphFitted;
    viewW = w;
    viewH = h;
    graphFitted = true;
    svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
    measureLabels();
    simulation.force("center", forceCenter(w / 2, h / 2));
    simulation
      .force(
        "x",
        forceX(w / 2).strength((d: GraphNode) => (d.kind === "self" ? 1 : 0))
      )
      .force(
        "y",
        forceY(h / 2).strength((d: GraphNode) => (d.kind === "self" ? 1 : 0))
      );
    // 画布变化：只更新中心/轴向力与夹取边界，节点在力导下滑向新画布中心（回流）
    if (firstFit) {
      // 首次定位：立即落盘一帧；在线力导自创建起已在跑（tick 事件逐帧驱动
      // ticked），alpha 衰减到阈值后 d3 自动停表，静止时不漂移
      ticked();
      if (prefersReducedMotion) settleOffline();
      return;
    }
    // 同尺寸触发（load / fonts.ready）：只补测量与锚点，不重排
    if (!sizeChanged) return;
    if (prefersReducedMotion) {
      settleOffline();
    } else {
      // Obsidian 式回流：小幅预热，节点在力导下滑到新画布的位置后自然沉降
      simulation.alpha(0.4).restart();
    }
  }
  resizeObserver = new ResizeObserver(fitViewBox);
  resizeObserver.observe(svg);
  // Run once immediately, then re-fit after layout settles so a stale/zero initial
  // size (cold load, client-side nav, late web fonts) can't leave a broken viewBox.
  fitViewBox();
  requestAnimationFrame(() => requestAnimationFrame(fitViewBox));
  window.addEventListener("load", fitViewBox);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitViewBox);

  // --- Pan & zoom ---
  const ZMIN = 0.45;
  const ZMAX = 3.5;
  let zoom = { k: 1, tx: 0, ty: 0 };
  const resetBtn = document.getElementById(
    "graph-reset"
  ) as HTMLButtonElement | null;

  function applyZoom() {
    zoomG.setAttribute(
      "transform",
      `translate(${zoom.tx},${zoom.ty}) scale(${zoom.k})`
    );
    if (resetBtn) {
      resetBtn.disabled =
        Math.abs(zoom.k - 1) < 0.001 && zoom.tx === 0 && zoom.ty === 0;
    }
  }
  applyZoom();

  // 系数为全站令牌 --ease-ed 的四个分量（editorial.css），用于 rAF 采样
  // cubic-bezier(0.16, 1, 0.3, 1) 求值：与 CSS 的 var(--ease-ed) 同一条曲线，
  // 这样按钮缩放和站点其它动效的节奏一致。
  const EASE_ED = (() => {
    const x1 = 0.16;
    const y1 = 1;
    const x2 = 0.3;
    const y2 = 1;
    const cx = 3 * x1;
    const bx = 3 * (x2 - x1) - cx;
    const ax = 1 - cx - bx;
    const cy = 3 * y1;
    const by = 3 * (y2 - y1) - cy;
    const ay = 1 - cy - by;
    const sx = (t: number) => ((ax * t + bx) * t + cx) * t;
    const sy = (t: number) => ((ay * t + by) * t + cy) * t;
    const dsx = (t: number) => (3 * ax * t + 2 * bx) * t + cx;
    return (x: number) => {
      if (x <= 0) return 0;
      if (x >= 1) return 1;
      let t = x;
      for (let i = 0; i < 6; i++) {
        const d = dsx(t);
        if (Math.abs(d) < 1e-6) break;
        t -= (sx(t) - x) / d;
        if (t < 0) t = 0;
        else if (t > 1) t = 1;
      }
      return sy(t);
    };
  })();

  // 按钮缩放 / 复位补间 200ms；滚轮、捏合、再次点按钮都会立刻打断重算
  let zoomRaf = 0;
  function stopZoomAnim() {
    if (zoomRaf) cancelAnimationFrame(zoomRaf);
    zoomRaf = 0;
  }
  function animateZoomTo(target: { k: number; tx: number; ty: number }) {
    stopZoomAnim();
    if (prefersReducedMotion) {
      zoom = target;
      applyZoom();
      return;
    }
    const from = { ...zoom };
    const t0 = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - t0) / 200);
      const e = EASE_ED(p);
      zoom.k = from.k + (target.k - from.k) * e;
      zoom.tx = from.tx + (target.tx - from.tx) * e;
      zoom.ty = from.ty + (target.ty - from.ty) * e;
      applyZoom();
      if (p < 1) {
        zoomRaf = requestAnimationFrame(tick);
      } else {
        zoomRaf = 0;
        zoom = target;
        applyZoom();
      }
    };
    zoomRaf = requestAnimationFrame(tick);
  }

  function svgPoint(e: { clientX: number; clientY: number }) {
    const pt = svg.createSVGPoint();
    pt.x = e.clientX;
    pt.y = e.clientY;
    return pt.matrixTransform(svg.getScreenCTM()!.inverse());
  }

  // 拖拽目标坐标必须落在 #graph-zoom 空间（节点 x/y 是 zoom 层坐标）：
  // 对 zoom 层求 getScreenCTM 逆矩阵，viewBox 与 zoom 的平移缩放一次算齐
  function zoomPoint(e: { clientX: number; clientY: number }) {
    const ctm = zoomG.getScreenCTM();
    if (!ctm) return svgPoint(e);
    const pt = svg.createSVGPoint();
    pt.x = e.clientX;
    pt.y = e.clientY;
    return pt.matrixTransform(ctm.inverse());
  }

  svg.addEventListener(
    "wheel",
    (e) => {
      e.preventDefault();
      markInteracted();
      stopZoomAnim(); // 滚轮随时接管补间
      const p = svgPoint(e);
      const factor = Math.exp(-e.deltaY * 0.001);
      const newK = Math.min(ZMAX, Math.max(ZMIN, zoom.k * factor));
      zoom.tx = p.x - ((p.x - zoom.tx) / zoom.k) * newK;
      zoom.ty = p.y - ((p.y - zoom.ty) / zoom.k) * newK;
      zoom.k = newK;
      applyZoom();
    },
    { passive: false, signal: cleanupController.signal }
  );

  function zoomBy(factor: number) {
    const rect = svg.getBoundingClientRect();
    const p = svgPoint({
      clientX: rect.left + svg.clientWidth / 2,
      clientY: rect.top + svg.clientHeight / 2,
    });
    const newK = Math.min(ZMAX, Math.max(ZMIN, zoom.k * factor));
    // 以「当前可见缩放」为基准算目标，补间中途再点也不会漂
    animateZoomTo({
      k: newK,
      tx: p.x - ((p.x - zoom.tx) / zoom.k) * newK,
      ty: p.y - ((p.y - zoom.ty) / zoom.k) * newK,
    });
  }

  document
    .getElementById("graph-zoom-in")
    ?.addEventListener(
      "click",
      () => {
        zoomBy(1.3);
      },
      { signal: cleanupController.signal }
    );
  document
    .getElementById("graph-zoom-out")
    ?.addEventListener(
      "click",
      () => {
        zoomBy(1 / 1.3);
      },
      { signal: cleanupController.signal }
    );
  resetBtn?.addEventListener(
    "click",
    () => {
      animateZoomTo({ k: 1, tx: 0, ty: 0 });
    },
    { signal: cleanupController.signal }
  );

  function markInteracted() {
    layoutEl?.classList.add("has-interacted");
  }

  // --- Node click & canvas pan ---
  let pointerId: string | null = null;
  let downOnNode = false;

  // 双指捏合缩放（移动端没有滚轮）
  const pointers = new Map<number, { x: number; y: number }>();
  // 空白处按下后的画布平移状态：按住拖动 = 平移视图（grab 光标对应的真实行为）
  let panState: {
    id: number;
    x: number;
    y: number;
    tx: number;
    ty: number;
  } | null = null;
  let pinch: {
    dist: number;
    k: number;
    tx: number;
    ty: number;
    px: number;
    py: number;
  } | null = null;

  // 节点拖拽（Obsidian 式）：拖过阈值后用 fx/fy 钉住节点并预热力导（alpha 0.3），
  // 邻居经连线弹簧/斥力被自然牵动；松手释放钉住、alphaTarget 归零降温，
  // 全网回流沉降后 d3 自动停表。拖动 >3px 才算拖拽（纯点击不惊动力导）；
  // reduce-motion 退化为直接落位；bare 迷你图不支持拖拽
  let dragNode: SimNode | null = null;
  let dragStart: { x: number; y: number } | null = null;
  let dragMoved = false;

  function selectOrToggle(id: string) {
    if (activeId === id) {
      clearActive();
    } else {
      selectNode(id);
    }
  }

  // 节点激活的统一入口。bare 模式（相关文章迷你图谱）没有详情抽屉，
  // 之前点击只会高亮、什么都不发生 —— 有落地页的节点直接跳转。
  function activateNode(id: string) {
    if (isBare) {
      const url = nodeById.get(id)?.url ?? "";
      if (url) {
        window.location.href = url;
        return;
      }
    }
    selectOrToggle(id);
  }

  svg.addEventListener(
    "pointerdown",
    (e) => {
      markInteracted();
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const mid = svgPoint({
          clientX: (a.x + b.x) / 2,
          clientY: (a.y + b.y) / 2,
        });
        stopZoomAnim(); // 捏合接管补间
        pinch = {
          dist: Math.hypot(a.x - b.x, a.y - b.y) || 1,
          k: zoom.k,
          tx: zoom.tx,
          ty: zoom.ty,
          px: mid.x,
          py: mid.y,
        };
        pointerId = null;
        downOnNode = false;
        dragNode = null; // 第二根手指落下即转捏合，挂起的拖拽作废
        return;
      }

      const target = (e.target as Element).closest?.(
        ".graph-node"
      ) as SVGGElement | null;
      downOnNode = !!target;
      if (!target) {
        // 点空白处清空选中，并把焦点从节点上移开（否则悬停高亮会残留）；
        // 同时进入画布平移状态——移动超阈值即拖动画布
        const el = document.activeElement as HTMLElement | null;
        if (el && el.closest?.(".graph-node")) el.blur();
        clearActive();
        panState = {
          id: e.pointerId,
          x: e.clientX,
          y: e.clientY,
          tx: zoom.tx,
          ty: zoom.ty,
        };
        return;
      }
      pointerId = target.dataset.id ?? null;
      if (pointerId) {
        target.focus();
        // 记录拖拽起点：bare 迷你图是导航组件，不支持拖拽
        if (!isBare) {
          dragNode = nodeById.get(pointerId) ?? null;
          dragStart = dragNode ? { x: dragNode.x, y: dragNode.y } : null;
          dragMoved = false;
        }
      }
    },
    { signal: cleanupController.signal }
  );

  window.addEventListener(
    "pointermove",
    (e) => {
      if (pinch && pointers.size >= 2) {
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        const [a, b] = [...pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y) || 1;
        const newK = Math.min(
          ZMAX,
          Math.max(ZMIN, (pinch.k * dist) / pinch.dist)
        );
        zoom.tx = pinch.px - ((pinch.px - pinch.tx) / pinch.k) * newK;
        zoom.ty = pinch.py - ((pinch.py - pinch.ty) / pinch.k) * newK;
        zoom.k = newK;
        applyZoom();
        return;
      }
      // 节点拖拽：拖过阈值即钉住节点（fx/fy）并预热力导，邻居被连线弹簧牵动；
      // reduce-motion 不惊动力导，直接落位
      if (dragNode) {
        const p = zoomPoint(e);
        if (
          !dragMoved &&
          dragStart &&
          Math.hypot(p.x - dragStart.x, p.y - dragStart.y) > 3
        ) {
          dragMoved = true;
          if (!prefersReducedMotion) {
            // 先钉在当前位置避免起跳，再预热力导
            dragNode.fx = dragNode.x;
            dragNode.fy = dragNode.y;
            simulation.alpha(0.3);
            simulation.alphaTarget(0.3);
            simulation.restart();
          }
        }
        if (!prefersReducedMotion) {
          dragNode.fx = p.x;
          dragNode.fy = p.y;
        } else {
          dragNode.x = p.x;
          dragNode.y = p.y;
          ticked();
        }
        return;
      }
      // 空白处平移：按住拖动 = 移动视图
      if (panState && e.pointerId === panState.id) {
        zoom.tx = panState.tx + (e.clientX - panState.x);
        zoom.ty = panState.ty + (e.clientY - panState.y);
        applyZoom();
        return;
      }
    },
    { signal: cleanupController.signal }
  );

  function endPointer(e: PointerEvent | undefined, cancelled = false) {
    if (e) pointers.delete(e.pointerId);
    if (pointers.size < 2) pinch = null;
    panState = null;
    const wasDrag = dragNode;
    const moved = dragMoved;
    // 释放钉住并降温：alphaTarget 归零后力导自然回流沉降、衰减停表
    if (wasDrag && moved && !prefersReducedMotion) {
      wasDrag.fx = null;
      wasDrag.fy = null;
      simulation.alphaTarget(0);
    }
    dragNode = null;
    dragStart = null;
    dragMoved = false;
    // 拖动过的松手不算点击（不选中/不跳转）
    if (!cancelled && !moved && wasDrag && downOnNode && pointerId) {
      activateNode(pointerId);
    }
    pointerId = null;
    downOnNode = false;
  }

  window.addEventListener(
    "pointerup",
    (e) => endPointer(e),
    { signal: cleanupController.signal }
  );
  window.addEventListener(
    "pointercancel",
    (e) => endPointer(e, true),
    { signal: cleanupController.signal }
  );

  // --- Active / highlight ---
  let activeId: string | null = null;
  let hoverId: string | null = null;

  // --- 放大 / 还原（全屏） ---
  const expandBtn = document.getElementById("graph-expand");
  // 展开时把 layout 移到 body 直属：sticky/transform 父级会锁死 fixed 定位，
  // 导致全屏层被限制在右栏内、被顶部 nav 盖住（层叠上下文困住）。
  // 记录原位置以便还原时移回。
  let layoutOrigin: { parent: Node; next: Node | null } | null = null;
  // 展开动画进行中的重入保护：快速连点按钮 / 连按 Esc 不会打断半程的 FLIP
  let expanding = false;
  // 原函数尾部的状态收尾：aria-label / title / 按钮展开态类 / 图标 d 值 /
  // body overflow。展开分支在 FLIP 起跳前调用；还原分支延迟到飞回结束的
  // 定时器里调用——overflow 在整个还原动画期间保持 hidden，落地才解冻。
  function finishExpandToggle(on: boolean) {
    if (expandBtn) {
      expandBtn.setAttribute(
        "aria-label",
        on ? "还原关系图谱" : "放大关系图谱"
      );
      expandBtn.title = on ? "还原 (Esc)" : "放大";
      expandBtn.classList.toggle("is-expanded", on);
    }
    // 图标切换：⤢ 放大 ⇄ ✕ 还原（d 值硬切，配合 svg 的 200ms 旋转过渡读作形变）
    const icon = document.getElementById("graph-expand-icon");
    if (icon) {
      const p = icon.querySelector("path");
      if (p) {
        p.setAttribute(
          "d",
          on ? "M6 6l12 12M18 6L6 18" : "M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"
        );
      }
    }
    document.body.style.overflow = on ? "hidden" : "";
  }
  // 容器尺寸变化后：viewBox 跟随新尺寸，并按新画布重排（离线松弛后定格，
  // 保持 zoom 不动，不做自动铺满）
  function scheduleGraphResize() {
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        fitViewBox();
      })
    );
  }
  function setExpanded(on: boolean) {
    if (!layoutEl || expanding) return;
    expanding = true;
    const reduced = prefersReducedMotion;
    if (on) {
      if (layoutEl.parentElement === document.body) {
        expanding = false;
        return;
      }
      layoutOrigin = {
        parent: layoutEl.parentNode as Node,
        next: layoutEl.nextSibling,
      };
      if (reduced) {
        document.body.appendChild(layoutEl);
        layoutEl.classList.add("is-expanded");
        finishExpandToggle(on);
        scheduleGraphResize();
        expanding = false;
        return;
      }
      // FLIP 展开：记录内联矩形 → reparent + 展开态 → 记录全屏矩形 →
      // 反向 transform 起跳 → 过渡回 none（finishExpandToggle 先清滚动条，
      // 全屏矩形才能按无滚动条的视口量准）
      const first = layoutEl.getBoundingClientRect();
      document.body.appendChild(layoutEl);
      layoutEl.classList.add("is-expanded");
      finishExpandToggle(on);
      scheduleGraphResize();
      const last = layoutEl.getBoundingClientRect();
      const dx = first.left - last.left;
      const dy = first.top - last.top;
      const sx = first.width / Math.max(1, last.width);
      const sy = first.height / Math.max(1, last.height);
      layoutEl.style.transformOrigin = "top left";
      layoutEl.style.transition = "none";
      layoutEl.style.transform = `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;
      void layoutEl.getBoundingClientRect(); // 强制回流，起始值先生效
      layoutEl.style.transition = "transform 320ms var(--ease-ed)";
      layoutEl.style.transform = "";
      window.setTimeout(() => {
        layoutEl.style.transition = "";
        layoutEl.style.transformOrigin = "";
        expanding = false;
      }, 340);
    } else {
      if (!layoutOrigin) {
        expanding = false;
        return;
      }
      if (reduced) {
        const { parent, next } = layoutOrigin;
        if (next && next.parentNode === parent) {
          parent.insertBefore(layoutEl, next);
        } else {
          parent.appendChild(layoutEl);
        }
        layoutOrigin = null;
        layoutEl.classList.remove("is-expanded");
        finishExpandToggle(on);
        scheduleGraphResize();
        expanding = false;
        return;
      }
      // FLIP 还原：记录全屏矩形 → reparent 回原位 + 摘掉展开态 → 记录
      // 内联矩形 → 反向 transform 起跳飞回；is-closing 让遮罩同步淡出
      const first = layoutEl.getBoundingClientRect(); // 全屏矩形
      layoutEl.classList.add("is-closing");
      const { parent, next } = layoutOrigin;
      if (next && next.parentNode === parent) {
        parent.insertBefore(layoutEl, next);
      } else {
        parent.appendChild(layoutEl);
      }
      layoutOrigin = null;
      layoutEl.classList.remove("is-expanded");
      scheduleGraphResize();
      const last = layoutEl.getBoundingClientRect(); // 内联矩形
      const dx = first.left - last.left;
      const dy = first.top - last.top;
      const sx = first.width / Math.max(1, last.width);
      const sy = first.height / Math.max(1, last.height);
      layoutEl.style.transformOrigin = "top left";
      layoutEl.style.transition = "none";
      layoutEl.style.transform = `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;
      void layoutEl.getBoundingClientRect();
      layoutEl.style.transition = "transform 260ms var(--ease-ed)";
      layoutEl.style.transform = "";
      window.setTimeout(() => {
        layoutEl.style.transition = "";
        layoutEl.style.transformOrigin = "";
        layoutEl.classList.remove("is-closing");
        // aria / 图标 / body overflow 到飞回落地才还原，
        // overflow 保持 hidden 直到还原结束
        finishExpandToggle(on);
        expanding = false;
      }, 280);
    }
  }
  expandBtn?.addEventListener(
    "click",
    (e) => {
      e.stopPropagation();
      setExpanded(!layoutEl?.classList.contains("is-expanded"));
    },
    { signal: cleanupController.signal }
  );

  function linkEndIds(l: GraphLink): [string, string] {
    const s = resolveNode(l.source as never);
    const t = resolveNode(l.target as never);
    return [s?.id ?? "", t?.id ?? ""];
  }

  function neighborsOf(id: string): Set<string> {
    const out = new Set<string>([id]);
    for (const l of links) {
      const [sid, tid] = linkEndIds(l);
      if (sid === id) out.add(tid);
      if (tid === id) out.add(sid);
    }
    return out;
  }

  // 悬停/选中统一走同一条高亮逻辑：只压暗无关节点，不改变布局
  function refreshHighlight() {
    const focus = activeId ?? hoverId;
    const nb = focus ? neighborsOf(focus) : null;
    const dim = activeId ? 0.22 : 0.4;

    nodeEls.forEach((g) => {
      const id = g.dataset.id ?? "";
      const on = !nb || nb.has(id);
      g.style.opacity = on ? "1" : String(dim);
      g.classList.toggle("is-active", id === activeId);
      g.classList.toggle("is-hover", id === hoverId && id !== activeId);
    });

    linkEls.forEach((line, i) => {
      const [sid, tid] = linkEndIds(links[i]);
      const hot = !!focus && (sid === focus || tid === focus);
      // 被吞节点相关的连线沉到近隐（书虫进食中）
      const eaten = swallowedIds.has(sid) || swallowedIds.has(tid);
      // 无焦点：整网淡化；有焦点：关联线点亮、无关线压到近隐
      line.setAttribute(
        "opacity",
        eaten
          ? "0.05"
          : !nb
            ? isBare
              ? "1"
              : LINK_FADED_OPACITY
            : hot
              ? "1"
              : "0.12"
      );
      line.classList.toggle("is-hot", hot && !eaten);
    });
  }

  function clearActive() {
    activeId = null;
    refreshHighlight();
    closePanel();
  }

  function closePanel() {
    if (!panel) return;
    panel.classList.remove("is-open");
    panel.setAttribute("aria-hidden", "true");
    panel.innerHTML = "";
  }

  function buildPreview(n: GraphNode) {
    const wrap = document.createElement("div");
    wrap.className = "graph-detail-inner";

    const top = document.createElement("div");
    top.className = "graph-detail-top";

    const kind = document.createElement("span");
    kind.className = "graph-preview-kind";
    kind.textContent = kindLabel(n.kind);
    top.appendChild(kind);

    const close = document.createElement("button");
    close.type = "button";
    close.className = "graph-detail-close";
    close.setAttribute("aria-label", "关闭节点详情");
    close.innerHTML =
      '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>';
    top.appendChild(close);
    wrap.appendChild(top);

    const imgSrc = n.heroImage || n.avatar;
    if (imgSrc) {
      const img = document.createElement("img");
      img.src = imgSrc;
      img.alt = n.title;
      img.loading = "lazy";
      img.className = "graph-preview-img";
      wrap.appendChild(img);
    }

    const h = document.createElement("h3");
    h.className = "graph-preview-title";
    h.textContent = n.title;
    wrap.appendChild(h);

    if (n.excerpt) {
      const p = document.createElement("p");
      p.className = "graph-preview-excerpt";
      p.textContent = n.excerpt;
      wrap.appendChild(p);
    }

    // 关联节点：可直接点进去，省得在图上找
    const relIds = [...neighborsOf(n.id)].filter(
      (id) => id !== n.id && nodeById.has(id)
    );
    if (relIds.length) {
      const rel = document.createElement("div");
      rel.className = "graph-detail-rel";

      const head = document.createElement("p");
      head.className = "graph-rel-head";
      head.append("关联 ");
      const b = document.createElement("b");
      b.textContent = String(relIds.length);
      head.appendChild(b);
      head.append(" 个节点");
      rel.appendChild(head);

      const list = document.createElement("ul");
      list.className = "graph-rel-list";
      for (const id of relIds.slice(0, 8)) {
        const target = nodeById.get(id)!;
        const li = document.createElement("li");
        const chip = document.createElement("button");
        chip.type = "button";
        chip.className = "graph-rel-chip";
        chip.dataset.goto = id;
        chip.textContent = target.title;
        chip.title = `查看「${target.title}」`;
        li.appendChild(chip);
        list.appendChild(li);
      }
      rel.appendChild(list);
      wrap.appendChild(rel);
    }

    if (n.url && n.kind === "post") {
      const a = document.createElement("a");
      a.href = n.url;
      a.className = "graph-preview-link hover-underline";
      a.textContent = "阅读全文 →";
      wrap.appendChild(a);
    }
    return wrap;
  }

  function showDetail(n: GraphNode) {
    if (!panel) return;
    // 抽屉已经开着：内文 160ms 淡入，别让整块文字瞬换（首次打开用抽屉自身的滑入）
    const wasOpen = panel.classList.contains("is-open");
    panel.innerHTML = "";
    const inner = buildPreview(n);
    if (wasOpen) inner.classList.add("is-swapping");
    panel.appendChild(inner);
    panel.classList.add("is-open");
    panel.setAttribute("aria-hidden", "false");
  }

  function selectNode(id: string) {
    const n = nodeById.get(id);
    if (!n) return;
    activeId = id;
    refreshHighlight();
    showDetail(n);
    window.dispatchEvent(new CustomEvent("graph:select"));
  }

  panel?.addEventListener(
    "click",
    (e) => {
      const t = e.target as Element;
      if (t.closest(".graph-detail-close")) {
        const id = activeId;
        clearActive();
        if (id) nodeEls.find((g) => g.dataset.id === id)?.focus();
        return;
      }
      const chip = t.closest<HTMLElement>(".graph-rel-chip");
      if (chip?.dataset.goto) {
        selectNode(chip.dataset.goto);
        const target = nodeEls.find((g) => g.dataset.id === chip.dataset.goto);
        target?.focus();
      }
    },
    { signal: cleanupController.signal }
  );

  // 鼠标悬停：只做高亮提示，不打开抽屉
  nodeEls.forEach((g) => {
    g.addEventListener(
      "pointerenter",
      (e) => {
        if (e.pointerType !== "mouse" || dragNode) return;
        hoverId = g.dataset.id ?? null;
        refreshHighlight();
      },
      { signal: cleanupController.signal }
    );
    g.addEventListener(
      "pointerleave",
      (e) => {
        if (e.pointerType !== "mouse" || dragNode) return;
        if (hoverId === g.dataset.id) {
          hoverId = null;
          refreshHighlight();
        }
      },
      { signal: cleanupController.signal }
    );
    g.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          const id = g.dataset.id;
          if (!id) return;
          if (isBare && (nodeById.get(id)?.url ?? "")) {
            window.location.href = nodeById.get(id)!.url!;
            return;
          }
          if (activeId === id) {
            clearActive();
            g.focus();
          } else {
            selectNode(id);
            // 键盘打开详情后把焦点交给抽屉的关闭按钮，Tab 不会卡在节点列表里
            panel?.querySelector<HTMLElement>(".graph-detail-close")?.focus();
          }
        }
      },
      { signal: cleanupController.signal }
    );
  });

  document.addEventListener(
    "keydown",
    (e) => {
      if (e.key !== "Escape") return;
      if (layoutEl?.classList.contains("is-expanded")) {
        setExpanded(false);
        (expandBtn as HTMLElement | null)?.focus();
        return;
      }
      const id = activeId;
      clearActive();
      if (id) nodeEls.find((g) => g.dataset.id === id)?.focus();
    },
    { signal: cleanupController.signal }
  );

  // timeline selected something -> clear graph highlight
  window.addEventListener("timeline:select", clearActive, {
    signal: cleanupController.signal,
  });
  }

  // 模块每次会话只求值一次，但 VT 客户端换页会替换 DOM——旧实例由
  // astro:before-swap 的 cleanup 回收。这里在每次 astro:page-load（含首访）
  // 检查当前 DOM 是否有图谱挂载点：有则按 lazy 策略初始化新实例。
  // mount.dataset.inited 防止同一 DOM 实例被重复初始化（bfcache 恢复/重复事件）。
  const armGraph = () => {
    const mount = document.getElementById("graph-view");
    if (!mount || mount.dataset.inited === "1") return;
    mount.dataset.inited = "1";
    if (mount.dataset.lazy === "1") {
      // lazy 模式：等首屏空闲（或最长 2s 兜底）再初始化，d3-force 的动态
      // import 也随之推迟
      if (typeof requestIdleCallback === "function") {
        requestIdleCallback(() => void initGraph(), { timeout: 2000 });
      } else {
        window.setTimeout(() => void initGraph(), 1200);
      }
    } else {
      void initGraph();
    }
  };
  document.addEventListener("astro:page-load", armGraph);
  armGraph();
</script>
