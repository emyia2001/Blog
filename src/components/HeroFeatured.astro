---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, date, excerpt, heroImage } = post.data;
---

<section class="py-24 md:py-32">
  {heroImage ? (
    <div class="clip-reveal">
      <Image
        src={heroImage}
        alt={title}
        width={1200}
        height={675}
        class="w-full h-[50vh] md:h-[70vh] object-cover"
      />
      <div class="relative -mt-24 md:-mt-32 px-6">
        <div class="mx-auto max-w-3xl" style="background: var(--color-ed-bg); padding: 2rem;">
          <a href={`/blog/${post.id.replace(/\.mdx$/, "")}`} class="no-underline">
            <h1 class="font-serif text-4xl md:text-6xl tracking-tighter text-[var(--color-ed-fg)]">
              {title}
            </h1>
          </a>
          <p class="mt-4 text-sm md:text-base leading-relaxed text-[var(--color-ed-muted)] max-w-[55ch]">
            {excerpt}
          </p>
          <div class="mt-4 flex items-center gap-4 text-xs text-[var(--color-ed-subtle)]">
            <time datetime={date.toISOString()}>
              {date.toLocaleDateString("zh-CN", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
            <a
              href={`/blog/${post.id.replace(/\.mdx$/, "")}`}
              class="hover-underline ml-auto text-[var(--color-ed-muted)]"
            >
              阅读 &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p class="text-xs tracking-[0.05em] text-[var(--color-ed-muted)] mb-6">
        最新
      </p>
      <a href={`/blog/${post.id.replace(/\.mdx$/, "")}`} class="no-underline">
        <h1 class="font-serif text-5xl md:text-7xl tracking-tighter text-[var(--color-ed-fg)]">
          {title}
        </h1>
      </a>
      <p class="mt-6 text-base leading-relaxed text-[var(--color-ed-muted)] max-w-[55ch] mx-auto">
        {excerpt}
      </p>
      <div class="mt-6 flex items-center justify-center gap-4 text-xs text-[var(--color-ed-subtle)]">
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        <a
          href={`/blog/${post.id.replace(/\.mdx$/, "")}`}
          class="hover-underline text-[var(--color-ed-muted)]"
        >
          阅读 &rarr;
        </a>
      </div>
    </div>
  )}
</section>
