---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import CoverPlate from "../components/CoverPlate.astro";
import PrevNext from "../components/PrevNext.astro";
import MiniPlayer from "../components/MiniPlayer.astro";
import Giscus from "../components/Giscus.astro";
import Toc from "../components/Toc.astro";
import { readingTime } from "../utils/readingTime";
import { coverVariant } from "../utils/coverVariant";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, date, excerpt, heroImage, pullQuote, bgm, tags, dropCap } = post.data;
const { Content, headings: renderedHeadings } = await post.render();
const bodyText = String(post.body || "");
const readMin = readingTime(bodyText);

interface TocNode {
  depth: number;
  slug: string;
  text: string;
  children: TocNode[];
}

// 目录由正文标题构成（不含文章标题）：正文最浅的标题作为目录一级，
// 更深层级相对顺延。正文写 # 即一级，## 即二级，依此类推。
const buildTree = (nodes: TocNode[]): TocNode[] => {
  const root: TocNode[] = [];
  const stack: TocNode[] = [];
  for (const node of nodes) {
    while (stack.length && stack[stack.length - 1].depth >= node.depth) stack.pop();
    if (stack.length === 0) root.push(node);
    else stack[stack.length - 1].children.push(node);
    stack.push(node);
  }
  return root;
};

const tocFlat = renderedHeadings
  .filter((h) => h.depth >= 1 && h.depth <= 4)
  .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text, children: [] as TocNode[] }));
const tocMinDepth = tocFlat.reduce((m, h) => Math.min(m, h.depth), 6);
const tocTree: TocNode[] = buildTree(tocFlat);

const allPosts = await getCollection("posts");
const published = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = published.findIndex((p) => p.id === post.id);
const prev = idx < published.length - 1 ? published[idx + 1] : null;
const next = idx > 0 ? published[idx - 1] : null;

// Related posts (same tags, excluding current)
const related = published
  .filter(
    (p) =>
      p.id !== post.id &&
      p.data.tags.some((t) => tags.includes(t))
  )
  .slice(0, 3);
---

<BaseLayout title={title} description={excerpt} image={heroImage}>
  <div class="mx-auto max-w-7xl px-6 py-24 md:py-32">
    <div class="flex flex-col lg:grid lg:grid-cols-[minmax(0,1.7fr)_14rem] gap-10 lg:gap-12">
      <!-- Main article -->
      <article class="min-w-0 order-2 lg:order-1" data-pagefind-body>
        <header class="mb-12">
          <p class="page-kicker mb-4">
            ARTICLE · {tags[0] || "随笔"}
          </p>
          <h1 id="article-top" class="font-serif text-3xl md:text-5xl leading-tight text-[var(--color-ed-fg)]">
            {title}
          </h1>
          <div class="mt-4 flex items-center gap-3 text-xs text-[var(--color-ed-subtle)]">
            <time datetime={date.toISOString()}>
              {date.toLocaleDateString("zh-CN", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
            <span>&middot;</span>
            <span>{readMin} 分钟阅读</span>
          </div>
        </header>

        <figure class="mb-12">
          <CoverPlate
            title={title}
            eyebrow={tags[0] || "随笔"}
            date={date.toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
            image={heroImage}
            variant={coverVariant(post.id)}
            ratioClass="aspect-[16/9]"
          />
        </figure>

        {pullQuote && (
          <div class="pull-quote max-w-[45ch] mb-12">
            &ldquo;{pullQuote}&rdquo;
          </div>
        )}

        <div class={`prose max-w-none${dropCap ? " drop-cap" : ""}`}>
          <Content />
        </div>

        <div class="mt-16 pt-10 border-t border-[var(--color-ed-faint)]">
          <h2 class="font-serif text-2xl text-[var(--color-ed-fg)] mb-6">评论</h2>
          <Giscus />
        </div>

        <PrevNext prev={prev} next={next} />

        <!-- Tags (mobile only, at article end) -->
        {tags.length > 0 && (
          <div class="mt-16 pt-10 border-t border-[var(--color-ed-faint)] lg:hidden">
            <h3 class="text-xs tracking-[0.05em] text-[var(--color-ed-subtle)] mb-4">
              标签
            </h3>
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <a
                  href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}`}
                  class="text-xs uppercase tracking-[0.15em] text-[var(--color-ed-muted)] hover-underline"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )}
      </article>

      <!-- Sidebar -->
      <aside class="shrink-0 order-1 lg:order-2 flex flex-col">
        <div class="lg:sticky lg:top-24 space-y-10">
          <!-- Tags (desktop sidebar only; mobile version is at article end) -->
          {tags.length > 0 && (
            <div class="max-lg:hidden">
              <h3 class="text-xs tracking-[0.05em] text-[var(--color-ed-subtle)] mb-4">
                标签
              </h3>
              <div class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <a
                    href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}`}
                    class="text-xs uppercase tracking-[0.15em] text-[var(--color-ed-muted)] hover-underline"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Table of Contents -->
          {tocTree.length > 0 && (
            <div
              id="toc-panel"
              class="border-t border-[var(--color-ed-faint)] pt-6
                     max-lg:fixed max-lg:inset-y-0 max-lg:right-0 max-lg:z-50 max-lg:w-72
                     max-lg:border-l max-lg:border-[var(--color-ed-faint)]
                     max-lg:bg-[var(--color-ed-bg)] max-lg:p-8 max-lg:pt-12 max-lg:overflow-y-auto"
            >
              <div class="mb-5 flex items-center justify-between">
                <h3 class="text-xs tracking-[0.05em] text-[var(--color-ed-subtle)]">目录</h3>
                <button id="toc-close" class="hidden max-lg:block p-1 -mr-2" aria-label="关闭目录">
                  <span class="block font-serif text-2xl leading-none">&times;</span>
                </button>
              </div>
              <Toc items={tocTree} baseDepth={tocMinDepth} />
            </div>
          )}

          {/* Related posts */}
          {related.length > 0 && (
            <div class="max-lg:order-3">
              <h3 class="text-xs tracking-[0.05em] text-[var(--color-ed-subtle)] mb-4">
                相关文章
              </h3>
              <ul class="space-y-3">
                {related.map((p) => (
                  <li>
                    <a
                      href={`/blog/${p.id.replace(/\.mdx$/, "")}`}
                      class="block group"
                    >
                      <span class="font-serif text-sm text-[var(--color-ed-fg)] group-hover:text-[var(--color-ed-muted)] transition-colors">
                        {p.data.title}
                      </span>
                      <span class="block text-xs text-[var(--color-ed-subtle)] mt-0.5">
                        {p.data.date.toLocaleDateString("zh-CN", {
                          month: "short",
                          day: "numeric",
                          year: "numeric",
                        })}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </aside>
    </div>
  </div>

  {bgm?.src && <MiniPlayer src={bgm.src} title={bgm.title} />}

  <!-- Mobile TOC toggle (floating, opens a side drawer) -->
  <button
    id="toc-toggle"
    class="hidden max-lg:fixed max-lg:bottom-6 max-lg:right-6 max-lg:z-50 max-lg:inline-flex max-lg:h-11 max-lg:items-center max-lg:justify-center max-lg:gap-1.5 max-lg:rounded-full max-lg:px-4 max-lg:font-sans max-lg:text-sm max-lg:tracking-wide"
    style="background: var(--color-ed-fg); color: var(--color-ed-bg);"
    aria-label="打开目录"
  >
    目录
  </button>

  <!-- Mobile TOC backdrop -->
  <div
    id="toc-backdrop"
    class="hidden max-lg:fixed max-lg:inset-0 max-lg:z-40 max-lg:bg-black/20"
    aria-hidden="true"
  ></div>
</BaseLayout>

<script>
  // TOC collapse / expand (accordion)
  document.addEventListener("click", (e) => {
    const toggle = e.target.closest("[data-toc-toggle]");
    if (!toggle) return;
    const item = toggle.closest(".toc-item");
    if (!item) return;
    const collapsed = item.classList.toggle("is-collapsed");
    toggle.setAttribute("aria-expanded", String(!collapsed));
  });

  // Scroll spy for table of contents (multi-level: h2/h3/h4)
  const headings = document.querySelectorAll(".prose h2, .prose h3, .prose h4");
  const tocLinks = document.querySelectorAll("[data-toc]");
  if (headings.length && tocLinks.length) {
    const expandAncestors = (link) => {
      let item = link.closest(".toc-item");
      while (item) {
        item.classList.remove("is-collapsed");
        const t = item.querySelector(":scope > .toc-row > [data-toc-toggle]");
        if (t) t.setAttribute("aria-expanded", "true");
        item = item.parentElement ? item.parentElement.closest(".toc-item") : null;
      }
    };

    const activate = (id) => {
      tocLinks.forEach((l) => {
        l.classList.remove("toc-active");
        l.classList.remove("toc-active-ancestor");
      });
      let link = document.querySelector(`[data-toc="${id}"]`);
      while (link) {
        expandAncestors(link);
        link.classList.add("toc-active");
        const parent = link.getAttribute("data-toc-parent");
        link = parent ? document.querySelector(`[data-toc="${parent}"]`) : null;
        if (parent && link) link.classList.add("toc-active-ancestor");
      }
    };

    // Click: activate immediately
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const id = link.getAttribute("data-toc");
        if (id) activate(id);
      });
    });

    // Scroll: observer updates active
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            activate(entry.target.getAttribute("id"));
          }
        }
      },
      { rootMargin: "-80px 0px -60% 0px" }
    );
    headings.forEach((h) => observer.observe(h));
  }

  // Mobile TOC side drawer
  const tocToggle = document.getElementById("toc-toggle");
  const tocPanel = document.getElementById("toc-panel");
  const tocBackdrop = document.getElementById("toc-backdrop");
  const tocClose = document.getElementById("toc-close");

  function openToc() {
    tocPanel?.classList.add("toc-open");
    tocBackdrop?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }
  function closeToc() {
    tocPanel?.classList.remove("toc-open");
    tocBackdrop?.classList.add("hidden");
    document.body.style.overflow = "";
  }

  tocToggle?.addEventListener("click", () => {
    const isOpen = tocPanel?.classList.contains("toc-open");
    isOpen ? closeToc() : openToc();
  });
  tocClose?.addEventListener("click", closeToc);
  tocBackdrop?.addEventListener("click", closeToc);
  tocPanel?.querySelectorAll("[data-toc]").forEach((l) =>
    l.addEventListener("click", closeToc)
  );
</script>

<style>
  /* Mobile: TOC becomes a slide-in drawer from the right */
  @media (max-width: 1023px) {
    #toc-panel {
      transform: translateX(100%);
      transition: transform 0.3s ease;
    }
    #toc-panel.toc-open {
      transform: translateX(0);
    }
  }
</style>
