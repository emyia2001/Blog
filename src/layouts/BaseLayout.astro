---
import { ClientRouter } from "astro:transitions";
import { SITE_NAME, SITE_DESCRIPTION, SITE_URL, SITE_AVATAR } from "../consts";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import SearchModal from "../components/SearchModal.astro";
import "../styles/editorial.css";
import "../styles/fonts.css";

export interface Props {
  title: string;
  /** 每页应有独立描述：列表页/标签页都从这里传入，别再全部落到站点描述上 */
  description?: string;
  image?: string;
  /** 文章页传入：输出 og:type=article、article:* 与 BlogPosting 结构化数据 */
  article?: { publishedTime: Date; tags?: string[] };
  /** 不参与索引的页面（404 等）：不出 canonical、加 noindex */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  article,
  noindex = false,
} = Astro.props;

const fullTitle = `${title} — ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
// 分享图兜底用 PNG：微信 / X / Facebook 对 WebP 的 og:image 支持并不完整，
// 以前兜底到 touxiang.webp 会导致部分平台分享卡片没有图。
const ogImage = image || "/images/og-default.png";
const ogImageURL = new URL(ogImage, SITE_URL).href;
const twitterCard = image ? "summary_large_image" : "summary";
const ogType = article ? "article" : "website";

// 结构化数据：所有页面一条 WebSite，文章页再加一条 BlogPosting
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: SITE_URL,
    description: SITE_DESCRIPTION,
    inLanguage: "zh-CN",
  },
];
if (article) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    image: [ogImageURL],
    url: canonicalURL,
    mainEntityOfPage: canonicalURL,
    datePublished: article.publishedTime.toISOString(),
    dateModified: article.publishedTime.toISOString(),
    inLanguage: "zh-CN",
    author: { "@type": "Person", name: SITE_NAME, url: SITE_URL },
    publisher: {
      "@type": "Organization",
      name: SITE_NAME,
      logo: { "@type": "ImageObject", url: new URL(SITE_AVATAR, SITE_URL).href },
    },
    ...(article.tags?.length ? { keywords: article.tags.join(", ") } : {}),
  });
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 首屏动画开关：必须在 body 渲染前打上 .js，否则 .reveal 元素会闪一下 -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Icons & theme color -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <meta name="theme-color" content="#F9F8F6" />

    <!-- Font preload -->
    <link
      rel="preload"
      href="/fonts/playfair-display-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-sans-3-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={fullTitle} />
    {article && (
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    )}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Canonical（404 等 noindex 页面不出） -->
    {!noindex && <link rel="canonical" href={canonicalURL} />}

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href={`${SITE_URL}/rss.xml`}
    />

    <!-- 结构化数据 -->
    {jsonLd.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <!-- 中文衬线字体声明（约 214KB / 202 个 @font-face）不进阻塞样式表：
         由下面的脚本在建好 DOM 后再插入，首屏不被字体声明拖住；
         字体到货由 font-display: swap 接管，JS 关闭时走 <noscript> 里的常规 link。 -->
    <noscript>
      <link rel="stylesheet" href="/fonts/noto-serif-sc/400.css" />
      <link rel="stylesheet" href="/fonts/noto-serif-sc/700.css" />
    </noscript>

    <ClientRouter />
  </head>
  <body data-pagefind-ignore class="flex min-h-screen flex-col">
    <!-- 阅读进度条：砖红细线，页面里有 .ed-progress 容器时显示 -->
    <span class="ed-progress" aria-hidden="true"></span>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--color-ed-fg)] focus:text-[var(--color-ed-bg)] focus:text-sm">
      跳至主内容
    </a>
    <Nav />
    <SearchModal />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <script>
      // 中文衬线字体的分片 CSS 延后加载（约 214KB）：放进阻塞样式表会把首屏拖慢，
      // 这里在 DOM 就绪后追加，浏览器按正常优先级抓取。
      for (const href of [
        "/fonts/noto-serif-sc/400.css",
        "/fonts/noto-serif-sc/700.css",
      ]) {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = href;
        document.head.appendChild(link);
      }

      // One-click copy for code blocks (.code-block__copy is server-rendered by
      // the rehype plugin). Delegated so it survives View Transitions.
      document.addEventListener("click", async (e) => {
        const btn = (e.target as HTMLElement)?.closest?.(".code-block__copy");
        if (!btn) return;
        const block = btn.closest(".code-block");
        const code = block?.querySelector("pre.astro-code code");
        if (!code) return;
        const text = code.textContent ?? "";
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          ta.remove();
        }
        const label = btn.querySelector(".code-block__copy-label");
        const original = label?.textContent ?? "复制";
        btn.classList.add("is-copied");
        if (label) label.textContent = "已复制";
        window.setTimeout(() => {
          btn.classList.remove("is-copied");
          if (label) label.textContent = original;
        }, 1600);
      });

      // 滚动揭示：.reveal / .mask-reveal 进入视口后加 .is-visible（CSS 里做动画）。
      // 用单个 IntersectionObserver，并在 View Transitions 换页后重建（DOM 已换）。
      // rootMargin 底部内缩 6%，元素进入可视区下缘约 6% 时开始，滚动时不「追手」。
      let revealObserver: IntersectionObserver | null = null;

      function initReveal() {
        revealObserver?.disconnect();
        const els = Array.from(
          document.querySelectorAll<HTMLElement>(
            ".reveal:not(.is-visible), .mask-reveal:not(.is-visible)"
          )
        );
        if (!els.length) return;
        if (!("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              revealObserver?.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -6% 0px", threshold: 0.01 }
        );
        for (const el of els) {
          // 浏览器恢复滚动位置时，视口上方的元素不会触发回调，直接标记为已显示
          if (el.getBoundingClientRect().bottom < 0) {
            el.classList.add("is-visible");
            continue;
          }
          revealObserver.observe(el);
        }
      }

      document.addEventListener("astro:page-load", initReveal);
      initReveal();

      // ---- 全站共享动效：大标题逐字擦除 + 滚动进度条 ----
      // 标题元素带 data-char-wipe 即生效（首页报头、文章页报头）。
      function splitTitleChars() {
        const el = document.querySelector<HTMLElement>("[data-char-wipe]");
        if (!el || el.dataset.done) return;
        el.dataset.done = "1";
        const text = el.textContent ?? "";
        el.textContent = "";
        let i = 0;
        for (const ch of text) {
          const span = document.createElement("span");
          span.className = "char-reveal";
          span.style.setProperty("--char-i", String(i++));
          span.textContent = ch;
          el.appendChild(span);
        }
      }

      function updateProgress() {
        const bar = document.querySelector<HTMLElement>(".ed-progress");
        if (!bar) return;
        const max = document.documentElement.scrollHeight - innerHeight;
        bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
      }

      document.addEventListener("astro:page-load", () => {
        splitTitleChars();
        updateProgress();
      });
      addEventListener("scroll", updateProgress, { passive: true });
      splitTitleChars();
      updateProgress();
    </script>
  </body>
</html>
