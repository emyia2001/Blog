  .col-dialog__score-bar { grid-area: bar; position: relative; height: 2px; background: var(--color-ed-hairline); overflow: hidden; }
  .col-dialog__score-fill { position: absolute; inset: 0; width: 100%; background: var(--color-ed-accent); transform: scaleX(0); transform-origin: 0 50%; transition: transform 480ms var(--ease-ed); }

  /* 分节：小标签 + 细线 */
  .col-dialog__section { margin: 0 0 1.6rem; }
  .col-dialog__section[hidden] { display: none; }
  .col-dialog__label {
    display: flex; align-items: center; gap: 0.8rem;
    margin: 0 0 0.75rem;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
