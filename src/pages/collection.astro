---
import BaseLayout from "../layouts/BaseLayout.astro";
import { COLLECTION, COLLECTION_TOTAL } from "../data/collection";

// 本地封面（/images/covers/ 下）→ 构建期派生 WebP（scripts/gen-cover-variants.mjs
// 生成 480w/960w，见 .gitignore）。1080px 原图直接缩到 ~150px 卡片时，Chrome 对
// lazy 大图走低分辨率解码路径，分数缩放屏上发糊；贴近显示尺寸的派生图解码接近
// 1:1，任何 DSF 都清晰。外链图（网易云封面等）原样返回。
// 注意：这里刻意用字符串拼接而不是模板字面量——正则字面量（$/i 结尾）+ 带 ${}
// 插值的模板字面量同现于 frontmatter 时，astro 编译器的栅栏扫描会失效（泄漏 ---）。
const isLocalCover = (p: string) => p.startsWith("/images/covers/") && /\.(jpe?g|png)$/i.test(p);
const coverSrc = (path: string, width: number) => {
  if (!isLocalCover(path)) return path;
  return path.replace(/^(.*\/)([^/]+)\.(jpe?g|png)$/i, "$1gen/$2-" + width + "w.webp");
};
const coverSrcSet = (path: string) =>
  isLocalCover(path) ? coverSrc(path, 480) + " 480w, " + coverSrc(path, 960) + " 960w" : undefined;

// 与 Wenku8_Flutter 一致：奶白档案色 + 等距投影
const PAPER = [
  { cover: "#FEFDF8", ink: "#2A2620" }, // 奶白
  { cover: "#F4F1E8", ink: "#2A2620" }, // 象牙
  { cover: "#E9E2D2", ink: "#2A2620" }, // 沙
  { cover: "#D8CDB9", ink: "#241F18" }, // 石
  { cover: "#38342E", ink: "#EDE7D8" }, // 墨（少量）
];
const SHELF_KINDS = new Set(["books", "music"]);
const FILTERS = [
  { id: "all", label: "全部" },
  ...COLLECTION.map((c) => ({ id: c.id, label: c.label })),
];
---

<BaseLayout
  title="拾集"
  description="拾集：书籍与漫画摆在立体书架，音乐、电影与电视剧铺成封面墙。"
>
  <div class="page-shell">
    <header class="page-head reveal">
      <div class="page-head__row">
        <h1 class="page-head__title">拾集</h1>
        <span class="page-head__aside">{COLLECTION_TOTAL} 件收藏</span>
      </div>
    </header>

    <div class="col-filter reveal" style="--reveal-delay: 60ms" role="tablist" aria-label="筛选收藏">
      {FILTERS.map((f) => (
        <button type="button" class={`col-chip ${f.id === "all" ? "is-active" : ""}`} data-filter={f.id} role="tab" aria-selected={f.id === "all" ? "true" : "false"}>
          {f.label}
        </button>
      ))}
    </div>

    {COLLECTION.map((cat, ci) => {
      const isShelf = SHELF_KINDS.has(cat.id);
      const isAlbum = cat.id === "music";
      const ar = cat.id === "movies" || cat.id === "tv" ? "2 / 3" : "3 / 4";
      return (
        <section class="col-shelf reveal" data-section data-cat={cat.id} style={`--reveal-delay:${Math.min(ci * 60, 300)}ms`}>
          <div class="col-shelf__head">
            <span class="col-shelf__code">WK-{String(ci + 1).padStart(2, "0")}</span>
            <h2 class="col-shelf__label">{cat.label}</h2>
            <span class="col-shelf__rule" aria-hidden="true" />
            <span class="col-shelf__mark" aria-hidden="true" />
            <span class="col-shelf__count">{String(cat.items.length).padStart(2, "0")}</span>
          </div>

          {isShelf ? (
            <div class="col-bank" data-bank data-mode={cat.id === "music" ? "album" : "book"}>
              <button type="button" class="col-bank__nav col-bank__nav--prev" data-banknav="-1" aria-label="上一本">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M15 5l-7 7 7 7" /></svg>
              </button>
              <div class="col-bank__stage" data-stage>
                {cat.items.map((item, i) => {
                  const paper = PAPER[(ci * 2 + i) % PAPER.length];
                  const fileNo = `WK-${String(ci * 100 + i + 1).padStart(5, "0")}`;
                  return (
                    <>
                      <span class="vshadow" aria-hidden="true" />
                      <button
                        type="button"
                        class="vol"
                        style={`--paper:${paper.cover};--ink:${paper.ink}`}
                        data-cover data-cat={cat.label} data-title={item.title}
                        data-creator={item.creator} data-year={String(item.year)}
                        data-note={item.note} data-cover-color={paper.cover}
                        data-ink={paper.ink} data-code={fileNo} data-image={item.cover ?? ""}
                        data-kind={cat.id === "music" ? "album" : "book"}
                        data-desc-source={item.descSource ?? ""}
                        data-ref={item.link ?? ""}
                        data-desc={item.desc ?? ""}
                        data-tracks={JSON.stringify(item.tracks ?? [])}
                        data-en={cat.en}
                        data-rating={item.rating != null ? String(item.rating) : ""}
                        data-rating-count={item.ratingCount != null ? String(item.ratingCount) : ""}
                        data-rating-source={item.ratingSource ?? ""}
                        data-press={item.press ?? ""}
                        data-pubdate={item.pubdate ?? ""}
                        data-pages={item.pages != null ? String(item.pages) : ""}
                        aria-label={`${item.title}，${item.creator}，${item.year}${cat.id === "music" ? "，在网易云播放" : ""}`}
                      >
                        {cat.id !== "music" && (
                          <span class="vol__spine" aria-hidden="true">
                            <span class="vol__num">{String(i + 1).padStart(2, "0")}</span>
                            <span class="vol__stitle">{item.title}</span>
                            <span class="vol__dot" />
                          </span>
                        )}
                        <span class="vol__cover" aria-hidden="true">
                          {item.cover ? (
                            <img class="vol__img" src={coverSrc(item.cover, 480)} alt="" loading="lazy" />
                          ) : (
                            <span class="vol__text">
                              <span class="vol__ctitle">{item.title}</span>
                              <span class="vol__cby">{item.creator}</span>
                            </span>
                          )}
                          {item.cover && (
                            <>
                              <span class="vol__scrim" />
                              <span class="vol__albumtag">{fileNo}</span>
                              <span class="vol__ticks" />
                              <span class="vol__caption">
                                <span class="vol__cap-title">{item.title}</span>
                                <span class="vol__cap-by">{item.creator}{item.year ? ` · ${item.year}` : ""}{item.tracks && item.tracks.length > 1 ? ` · ${item.tracks.length} 首` : ""}</span>
                              </span>
                            </>
                          )}
                          <span class="vol__no">NO.{String(i + 1).padStart(3, "0")}</span>
                          <span class="vol__code">{fileNo}</span>
                        </span>
                      </button>
                    </>
                  );
                })}
              </div>
              <div class="col-bank__foot" data-bankfoot aria-live="polite"></div>
              <button type="button" class="col-bank__nav col-bank__nav--next" data-banknav="1" aria-label="下一本">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M9 5l7 7-7 7" /></svg>
              </button>
            </div>
          ) : isAlbum ? (
            <div class="col-albums" data-albums>
              <button type="button" class="col-albums__nav col-albums__nav--prev" data-albumnav="-1" aria-label="上一张专辑">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M15 5l-7 7 7 7" /></svg>
              </button>
              <div class="col-albums__track" data-albumtrack>
                {cat.items.map((item, i) => {
                  const paper = PAPER[(ci * 2 + i) % PAPER.length];
                  const fileNo = `WK-${String(ci * 100 + i + 1).padStart(5, "0")}`;
                  return (
                    <button type="button" class="album" style={`--cover:${paper.cover};--ink:${paper.ink}`}
                      data-cover data-cat={cat.label} data-title={item.title} data-creator={item.creator}
                      data-year={String(item.year)} data-note={item.note} data-cover-color={paper.cover}
                      data-ink={paper.ink} data-code={fileNo} data-image={item.cover ?? ""} aria-label={`${item.title}，${item.creator}，${item.year}`}>
                      <span class="album__cover">
                        {item.cover ? (
                            <img class="album__img" src={coverSrc(item.cover, 480)} srcset={coverSrcSet(item.cover)} sizes="(min-width: 768px) 150px, 40vw" alt="" loading="lazy" />
                        ) : (
                          <span class="album__fallback">{item.title}</span>
                        )}
                        <span class="album__code">{fileNo}</span>
                      </span>
                      <span class="album__meta">
                        <span class="album__title">{item.title}</span>
                        <span class="album__by">{item.creator}{item.year ? ` · ${item.year}` : ""}</span>
                      </span>
                    </button>
                  );
                })}
              </div>
              <button type="button" class="col-albums__nav col-albums__nav--next" data-albumnav="1" aria-label="下一张专辑">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M9 5l7 7-7 7" /></svg>
              </button>
            </div>
          ) : (
            <ul class="col-wall" data-wall data-kind={cat.id} style={`--ar:${ar}`}>
              {cat.items.map((item, i) => {
                const paper = PAPER[(ci * 2 + i) % PAPER.length];
                const fileNo = `WK-${String(ci * 100 + i + 1).padStart(5, "0")}`;
                return (
                  <li class="col-wallitem">
                    <button type="button" class="col-wallcard" style={`--cover:${paper.cover};--ink:${paper.ink}`}
                      data-cover data-cat={cat.label} data-title={item.title} data-creator={item.creator}
                      data-year={String(item.year)} data-note={item.note} data-cover-color={paper.cover}
                      data-ink={paper.ink} data-code={fileNo}
                      data-kind={cat.id === "movies" ? "film" : cat.id === "tv" ? "tv" : "book"}
                      data-en={cat.en} data-ref={item.link ?? ""} data-desc={item.desc ?? ""}
                      data-desc-source={item.descSource ?? ""}
                      data-rating={item.rating != null ? String(item.rating) : ""}
                      data-rating-count={item.ratingCount != null ? String(item.ratingCount) : ""}
                      data-rating-source={item.ratingSource ?? ""}
                      data-press={item.press ?? ""} data-pubdate={item.pubdate ?? ""} data-pages={item.pages ?? ""}
                      data-image={item.cover ?? ""}
                      aria-label={`${item.title}，${item.creator}，${item.year}`}>
                      <span class={`col-wallcard__cover${item.cover ? " has-img" : ""}`}>
                        {item.cover ? <img class="col-wallcard__img" src={coverSrc(item.cover, 480)} srcset={coverSrcSet(item.cover)} sizes="(min-width: 768px) 150px, 40vw" alt="" loading="lazy" /> : null}
                        <span class="col-wallcard__code">{fileNo}</span>
                        <span class="col-wallcard__title">{item.title}</span>
                        <span class="col-wallcard__by">{item.creator}</span>
                      </span>
                    </button>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      );
    })}
  </div>

  <dialog id="col-dialog" class="col-dialog" aria-labelledby="cd-title">
    <div class="col-dialog__panel">
      <div class="col-dialog__rail">
        <span class="col-dialog__code" id="cd-code"></span>
        <span class="col-dialog__railsep" aria-hidden="true"></span>
        <span class="col-dialog__cat" id="cd-cat"></span>
        <span class="col-dialog__en" id="cd-en"></span>
        <button type="button" class="col-dialog__close" data-close aria-label="关闭">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>

      <div class="col-dialog__inner">
        <aside class="col-dialog__aside">
          <div class="col-dialog__coverwrap">
            <span class="col-dialog__pad col-dialog__pad--tl" aria-hidden="true"></span>
            <span class="col-dialog__pad col-dialog__pad--tr" aria-hidden="true"></span>
            <span class="col-dialog__pad col-dialog__pad--bl" aria-hidden="true"></span>
            <span class="col-dialog__pad col-dialog__pad--br" aria-hidden="true"></span>
            <div class="col-dialog__cover" id="cd-cover" aria-hidden="true"><span class="col-dialog__cover-title" data-cd-cover-title></span></div>
          </div>
          <dl class="col-dialog__facts" id="cd-facts">
            <div class="col-dialog__fact" data-fact="press"><dt>出版</dt><dd id="cd-press"></dd></div>
            <div class="col-dialog__fact" data-fact="pubdate"><dt>年月</dt><dd id="cd-pubdate"></dd></div>
            <div class="col-dialog__fact" data-fact="pages"><dt>页数</dt><dd id="cd-pages"></dd></div>
          </dl>
        </aside>

        <div class="col-dialog__body">
          <h2 class="col-dialog__title" id="cd-title"></h2>
          <p class="col-dialog__by" id="cd-by"></p>

          <div class="col-dialog__score" id="cd-score" hidden>
            <span class="col-dialog__score-value" id="cd-score-value"></span>
            <span class="col-dialog__score-meta" id="cd-score-meta"></span>
            <span class="col-dialog__score-bar" aria-hidden="true"><span class="col-dialog__score-fill" id="cd-score-fill"></span></span>
          </div>

          <section class="col-dialog__section" id="cd-desc-wrap" hidden>
            <h3 class="col-dialog__label">简介</h3>
            <p class="col-dialog__desc" id="cd-desc"></p>
            <a class="col-dialog__src" id="cd-desc-src" target="_blank" rel="noopener noreferrer" hidden>简介来源 · 维基百科</a>
          </section>

          <section class="col-dialog__section" id="cd-note-wrap" hidden>
            <h3 class="col-dialog__label">短评</h3>
            <p class="col-dialog__note" id="cd-note"></p>
          </section>

          <section class="col-dialog__section" id="cd-tracks-wrap" hidden>
            <h3 class="col-dialog__label">曲目</h3>
            <ol class="col-dialog__tracks" id="cd-tracks"></ol>
          </section>

          <a class="col-dialog__ref" id="cd-ref" target="_blank" rel="noopener noreferrer" hidden>查看条目</a>
        </div>
      </div>

      <div class="col-dialog__foot">
        <span class="col-dialog__mark">拾集 · COLLECTION</span>
        <span class="col-dialog__esc">ESC 关闭</span>
      </div>
    </div>
  </dialog>
</BaseLayout>

<style>
  .col-filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 0.25rem 0 0.5rem; }
  .col-chip {
    font-family: var(--font-sans); font-size: 0.75rem; letter-spacing: 0.04em;
    padding: 0.42rem 0.9rem; border-radius: 999px;
    border: 1px solid rgba(28, 28, 28, 0.12);
    background: rgba(254, 253, 248, 0.55);
    -webkit-backdrop-filter: blur(10px) saturate(1.1); backdrop-filter: blur(10px) saturate(1.1);
    color: var(--color-ed-muted); cursor: pointer;
    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }
  .col-chip:hover { color: var(--color-ed-fg); border-color: rgba(28, 28, 28, 0.28); }
  .col-chip.is-active { background: var(--color-ed-fg); color: var(--color-ed-bg); border-color: var(--color-ed-fg); }

  /* 书架/专辑/封面墙内部用了 200~420 的 z-index（扇面抽书、悬停放大）：
     给分区建独立层叠上下文，避免这些元素压过吸顶导航和页面外框。 */
  .col-shelf { margin-top: 2.6rem; isolation: isolate; }
  .col-shelf:first-of-type { margin-top: 1.4rem; }
  /* 筛选切换：先淡出/收起，落定后才 hidden（JS 用内联 transition 驱动，
     避免和全局 .reveal 的 transition 抢属性）。淡出中不接受点击。 */
  .col-shelf[hidden] { display: none; }
  .col-shelf.is-filtering-out { pointer-events: none; }
  .col-shelf__head { display: flex; align-items: baseline; gap: 0.6rem; margin-bottom: 0.2rem; }
  .col-shelf__code, .col-shelf__count {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.5625rem; letter-spacing: 0.12em; color: var(--color-ed-subtle); font-variant-numeric: tabular-nums;
  }
  .col-shelf__label { margin: 0; font-family: var(--font-serif); font-size: 1.15rem; font-weight: 400; line-height: 1.2; color: var(--color-ed-fg); }
  .col-shelf__rule { flex: 1; height: 1px; background: var(--color-ed-hairline); align-self: center; }
  .col-shelf__mark { width: 3px; height: 3px; background: var(--color-ed-fg); align-self: center; }

  /* ===== 立体书架（等距扇面，520px 档案柜） ===== */
  .col-bank { position: relative; width: 100%; margin: 0.2rem auto 0; }
  .col-bank__stage { position: relative; width: 100%; height: 420px; overflow: hidden; }
  .vshadow {
    position: absolute; left: 0; top: 0;
    width: var(--FOOT, 100px); height: 16px;
    background: radial-gradient(ellipse at 32% center, rgba(90, 78, 56, 0.20), rgba(90, 78, 56, 0) 72%);
    filter: blur(2px); pointer-events: none; will-change: transform;
  }
  .vol {
    position: absolute; left: 0; top: 0;
    width: var(--FOOT, 100px); height: var(--H, 206px);
    border: 0; margin: 0; padding: 0; background: none;
    cursor: pointer; text-align: left;
    transform-origin: 0 0; will-change: transform;
  }
  .vol__spine {
    position: absolute; left: 0; top: 0;
    width: var(--S, 18px); height: var(--H, 206px);
    transform: matrix(1, 0.10, 0, 1, 0, 0); transform-origin: 0 0;
    background: #F2F0E9; color: #2A2620;
    box-shadow: inset 0 0 0 1px rgba(28, 28, 28, 0.10), inset -2px 0 3px -2px rgba(0, 0, 0, 0.22);
    overflow: hidden;
    display: flex; flex-direction: column; align-items: center;
    padding: 8px 0;
  }
  .vol__num { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 7px; letter-spacing: 0.04em; opacity: 0.55; }
  .vol__stitle {
    writing-mode: vertical-rl; text-orientation: mixed;
    font-family: var(--font-serif); font-size: 9px; line-height: 1.08; font-weight: 600;
    max-height: 76%; overflow: hidden; text-align: center;
    display: flex; align-items: center; justify-content: center; flex: 1; margin: 6px 0;
  }
  .vol__dot { width: 5px; height: 5px; border-radius: 50%; background: rgba(28, 28, 28, 0.32); }
  .vol__cover {
    position: absolute; left: var(--S, 18px); top: calc(var(--S, 18px) * 0.10);
    width: var(--C, 128px); height: var(--H, 206px);
    transform: matrix(0.66, -0.30, 0, 1, 0, 0); transform-origin: 0 0;
    background: var(--paper, #FEFDF8); color: var(--ink, #2A2620);
    box-shadow: inset 0 0 0 1px rgba(28, 28, 28, 0.09);
    transition: box-shadow 220ms var(--ease-ed), filter 220ms var(--ease-ed);
    overflow: hidden;
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 9px 9px 7px;
  }
  .vol__no { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 7px; letter-spacing: 0.08em; opacity: 0.55; }
  .vol__ctitle {
    font-family: var(--font-serif); font-size: 16px; line-height: 1.22;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .vol__cby { font-size: 9px; letter-spacing: 0.02em; opacity: 0.6; margin-top: 2px; }
  .vol__code { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 7px; letter-spacing: 0.06em; opacity: 0.5; padding-top: 4px; border-top: 1px solid rgba(28, 28, 28, 0.10); }
  .vol__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; display: block; }
  .vol__text { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: 10px; z-index: 1; }
  .vol__cover .vol__no { position: absolute; top: 7px; left: 7px; z-index: 2; background: rgba(254, 253, 248, 0.82); padding: 1px 5px; border-radius: 2px; }
  .vol__cover .vol__code { position: absolute; bottom: 7px; left: 7px; right: 7px; z-index: 2; background: rgba(254, 253, 248, 0.72); padding: 2px 5px; border-radius: 2px; border-top: 0; }
  .vol__scrim { position: absolute; left: 0; right: 0; bottom: 0; height: 56%; z-index: 1; pointer-events: none; background: linear-gradient(to top, rgba(10, 8, 6, 0.74), rgba(10, 8, 6, 0)); }
  .vol__albumtag { position: absolute; top: 7px; right: 7px; z-index: 2; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 7px; letter-spacing: 0.1em; color: #fff; background: rgba(0, 0, 0, 0.34); padding: 2px 6px; border-radius: 2px; -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
  .vol__caption { position: absolute; left: 9px; right: 9px; bottom: 9px; z-index: 2; display: flex; flex-direction: column; gap: 2px; color: #fff; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55); }
  .vol__cap-title { font-family: var(--font-serif); font-size: 11px; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vol__cap-by { font-size: 8px; letter-spacing: 0.02em; opacity: 0.86; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .col-bank[data-mode="album"] .vol__no, .col-bank[data-mode="album"] .vol__code { display: none; }
  .col-bank[data-mode="album"] .vol__cover { outline: 1px solid rgba(28, 28, 28, 0.18); outline-offset: 3px; }
  .vol__ticks {
    position: absolute; inset: 6px; z-index: 2; pointer-events: none; opacity: 0.72;
    --tick: rgba(255, 255, 255, 0.92);
    background:
      linear-gradient(var(--tick), var(--tick)) left top / 7px 1px no-repeat,
      linear-gradient(var(--tick), var(--tick)) left top / 1px 7px no-repeat,
      linear-gradient(var(--tick), var(--tick)) right top / 7px 1px no-repeat,
      linear-gradient(var(--tick), var(--tick)) right top / 1px 7px no-repeat,
      linear-gradient(var(--tick), var(--tick)) left bottom / 7px 1px no-repeat,
      linear-gradient(var(--tick), var(--tick)) left bottom / 1px 7px no-repeat,
      linear-gradient(var(--tick), var(--tick)) right bottom / 7px 1px no-repeat,
      linear-gradient(var(--tick), var(--tick)) right bottom / 1px 7px no-repeat;
  }
  .vol:focus-visible { outline: 1.5px solid var(--color-ed-accent); outline-offset: 4px; }
  .vol, .vshadow { transition: transform 520ms var(--ease-ed), filter 120ms ease; }
  /* 按压反馈：书架模式用亮度（书脊/封面带 matrix 基础 transform，不叠加 scale）；
     拖拽态由下方 is-drag 规则兜底 */
  .vol:active { filter: brightness(0.94); }
  /* 焦点高亮只跟「抬起」绑定：小屏中间那本是抬起的，所以给小屏；
     桌面端不默认抬起，也就不画环（悬停只做原有的放大/浮起）。 */
  @media (max-width: 1023px) {
    .vol.is-focus .vol__cover {
      box-shadow:
        0 0 0 1.5px var(--color-ed-accent),
        0 0 0 6px rgba(166, 58, 43, 0.1),
        0 24px 40px -22px rgba(30, 20, 10, 0.55);
    }
  }
  .col-bank.is-drag .vol, .col-bank.is-drag .vshadow { transition: none; }
  /* 拖拽中 :active 必然成立（按下即拖拽起点）：亮度按压不得在拖拽时闪动 */
  .col-bank.is-drag .vol:active { filter: none; }

  .col-bank__foot {
    min-height: 1.5rem; padding: 0 2.6rem;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.625rem; letter-spacing: 0.1em; color: var(--color-ed-subtle);
    text-align: center; font-variant-numeric: tabular-nums;
  }
  .col-bank__nav {
    position: absolute; top: 42%; z-index: 300;
    display: flex; align-items: center; justify-content: center;
    width: 2.1rem; height: 2.1rem; border-radius: 999px;
    border: 1px solid rgba(28, 28, 28, 0.14);
    background: rgba(254, 253, 248, 0.72);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    color: var(--color-ed-fg); cursor: pointer;
    transition: background-color 180ms ease, border-color 180ms ease, transform 120ms var(--ease-ed);
  }
  .col-bank__nav:hover { border-color: rgba(28, 28, 28, 0.35); }
  /* 按压反馈：按钮类，缩到 0.94 */
  .col-bank__nav:active { transform: scale(0.94); }
  .col-bank__nav svg { width: 0.95rem; height: 0.95rem; }
  .col-bank__nav--prev { left: -2px; }
  .col-bank__nav--next { right: -2px; }

  /* 去掉底部落地阴影 */
  .vshadow { display: none !important; }

  /* 音乐专辑：悬停浮出完整（去等距斜切）封面 */
  .col-bank[data-mode="album"] .vol__cover {
    transition: transform 260ms var(--ease-ed), box-shadow 260ms var(--ease-ed), filter 260ms var(--ease-ed);
    transform-origin: 50% 50%;
  }
  .col-bank[data-mode="album"] .vol:hover { z-index: 420 !important; }
  .col-bank[data-mode="album"] .vol:hover .vol__cover,
  .col-bank[data-mode="album"] .vol:focus-visible .vol__cover {
    z-index: 80;
  }
  .col-bank[data-mode="album"] .vol:focus-visible .vol__cover {
    transform: scale(1.14);
    box-shadow: 0 24px 42px -22px rgba(30, 20, 10, 0.5), inset 0 0 0 1px rgba(28, 28, 28, 0.14);
    filter: brightness(1.03);
  }
  /* 悬停位移收进 hover-gate：触屏不再粘滞缩放/阴影；置于 :active 按压规则之前保持原优先级 */
  @media (hover: hover) and (pointer: fine) {
    .col-bank[data-mode="album"] .vol:hover .vol__cover {
      transform: scale(1.14);
      box-shadow: 0 24px 42px -22px rgba(30, 20, 10, 0.5), inset 0 0 0 1px rgba(28, 28, 28, 0.14);
      filter: brightness(1.03);
    }
  }
  /* 专辑模式按压：封面从悬停的 1.14 缩回 0.98；与 :hover 同权级，必须排在其后才能按住时胜出 */
  .col-bank[data-mode="album"] .vol:active .vol__cover { transform: scale(0.98); }

  /* ===== 音乐专辑横向轮播（只借滚动动画，保留专辑封面样式） ===== */
  .col-albums { position: relative; }
  .col-albums__track {
    display: flex; gap: 18px;
    overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; -ms-overflow-style: none;
    padding: 14px 6px 18px;
    -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain;
  }
  .col-albums__track::-webkit-scrollbar { display: none; }
  .album {
    flex: 0 0 auto; width: 172px;
    border: 0; margin: 0; padding: 0; background: none; cursor: pointer;
    scroll-snap-align: center; text-align: left;
    display: block; text-decoration: none; color: inherit;
    transform-origin: bottom center; will-change: transform;
    /* 不要在这里加 transform 过渡：滚动时 JS 每帧写 transform，CSS 过渡会逐帧重启，
       结果是封面追不上指针、整体"飘"。滚动动画交给 scroll-snap + rAF。 */
  }
  .album__cover {
    position: relative; display: flex; flex-direction: column; justify-content: space-between;
    aspect-ratio: 1 / 1; padding: 14px 12px 12px; border-radius: 3px; color: var(--ink);
    background: linear-gradient(160deg, color-mix(in srgb, var(--cover) 96%, white), var(--cover));
    box-shadow: 0 12px 24px -18px rgba(60, 48, 30, 0.6), inset 0 0 0 1px rgba(28, 28, 28, 0.1);
    overflow: hidden;
  }
  .album__cover::before { content: ""; position: absolute; inset: 9px; border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); border-radius: 2px; pointer-events: none; }
  .album__code { position: relative; z-index: 1; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 0.5rem; letter-spacing: 0.1em; opacity: 0.5; }
  .album__title { position: relative; z-index: 1; font-family: var(--font-serif); font-size: 1.06rem; line-height: 1.28; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .album__by { position: relative; z-index: 1; font-size: 0.625rem; letter-spacing: 0.04em; opacity: 0.6; padding-top: 6px; border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .album:focus-visible { outline: 1.5px solid var(--color-ed-accent); outline-offset: 5px; }
  .album__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; display: block; }
  .album__fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-align: center; padding: 16px; font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.3; color: var(--ink); z-index: 1; }
  .album__code { position: absolute !important; top: 8px; left: 8px; background: rgba(254, 253, 248, 0.82); padding: 2px 6px; border-radius: 2px; z-index: 2; }
  .album__meta { display: block; margin-top: 8px; }
  .album__meta .album__title { display: block; font-family: var(--font-serif); font-size: 0.95rem; line-height: 1.3; color: var(--color-ed-fg); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .album__meta .album__by { display: block; margin-top: 2px; border-top: 0; padding-top: 0; font-size: 0.6875rem; letter-spacing: 0.02em; color: var(--color-ed-subtle); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .col-albums__nav {
    position: absolute; top: 44%; z-index: 20;
    display: flex; align-items: center; justify-content: center;
    width: 2.1rem; height: 2.1rem; border-radius: 999px;
    border: 1px solid rgba(28, 28, 28, 0.14);
    background: rgba(254, 253, 248, 0.72);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    color: var(--color-ed-fg); cursor: pointer;
    transition: background-color 180ms ease, border-color 180ms ease;
  }
  .col-albums__nav:hover { border-color: rgba(28, 28, 28, 0.35); }
  .col-albums__nav svg { width: 0.95rem; height: 0.95rem; }
  .col-albums__nav--prev { left: -4px; }
  .col-albums__nav--next { right: -4px; }

  /* ===== 封面墙 ===== */
  .col-wall { list-style: none; margin: 0.4rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); gap: 18px; }
  .col-wallitem { min-width: 0; }
  .col-wallcard { display: block; width: 100%; margin: 0; padding: 0; border: 0; background: none; cursor: pointer; text-align: left; }
  .col-wallcard__cover {
    position: relative; display: flex; flex-direction: column; justify-content: space-between;
    aspect-ratio: var(--ar, 3 / 4); padding: 14px 12px 12px; border-radius: 3px; color: var(--ink);
    background: linear-gradient(160deg, color-mix(in srgb, var(--cover) 96%, white), var(--cover));
    box-shadow: 0 10px 22px -18px rgba(60, 48, 30, 0.6), inset 0 0 0 1px rgba(28, 28, 28, 0.1);
    overflow: hidden; transition: transform 260ms var(--ease-ed), box-shadow 260ms var(--ease-ed);
  }
  .col-wallcard__cover::before { content: ""; position: absolute; inset: 8px; border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); border-radius: 1px; pointer-events: none; }
  .col-wallcard:focus-visible .col-wallcard__cover { transform: translateY(-4px); box-shadow: 0 18px 30px -18px rgba(60, 48, 30, 0.7), inset 0 0 0 1px rgba(28, 28, 28, 0.12); }
  /* 悬停位移收进 hover-gate：触屏不再粘滞浮起，:focus-visible 反馈留在门外 */
  @media (hover: hover) and (pointer: fine) {
    .col-wallcard:hover .col-wallcard__cover { transform: translateY(-4px); box-shadow: 0 18px 30px -18px rgba(60, 48, 30, 0.7), inset 0 0 0 1px rgba(28, 28, 28, 0.12); }
  }
  .col-wallcard__code { position: relative; z-index: 1; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 0.5rem; letter-spacing: 0.1em; opacity: 0.5; }
  .col-wallcard__title { position: relative; z-index: 1; font-family: var(--font-serif); font-size: 1.02rem; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .col-wallcard__by { position: relative; z-index: 1; font-size: 0.625rem; letter-spacing: 0.04em; opacity: 0.6; padding-top: 6px; border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .col-wallcard:focus-visible { outline: 1.5px solid var(--color-ed-accent); outline-offset: 5px; }

  /* 有真实海报时：图铺满，底部渐变压暗，文字反白 */
  .col-wallcard__img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; z-index: 0; display: block;
  }
  .col-wallcard__cover.has-img {
    background: #241f18;
    box-shadow: 0 14px 28px -18px rgba(60, 48, 30, 0.7), inset 0 0 0 1px rgba(28, 28, 28, 0.18);
  }
  .col-wallcard__cover.has-img::before { border-color: rgba(247, 243, 234, 0.28); }
  .col-wallcard__cover.has-img::after {
    content: ""; position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(to top, rgba(10, 8, 6, 0.82) 0%, rgba(10, 8, 6, 0.28) 36%, rgba(10, 8, 6, 0) 62%);
    pointer-events: none;
  }
  .col-wallcard__cover.has-img .col-wallcard__code,
  .col-wallcard__cover.has-img .col-wallcard__title,
  .col-wallcard__cover.has-img .col-wallcard__by { color: #f7f3ea; text-shadow: 0 1px 14px rgba(0, 0, 0, 0.45); }
  .col-wallcard__cover.has-img .col-wallcard__by { border-top-color: rgba(247, 243, 234, 0.32); }

  /* ===== 详情弹层（档案卡） ===== */
  /* 居中不依赖 UA 的 dialog{margin:auto}（会被 Tailwind preflight 的 *{margin:0} 干掉）：
     dialog 铺满视口当 flex 容器，外观、宽度与滚动都交给 .col-dialog__panel。 */
  .col-dialog {
    position: fixed; inset: 0; margin: 0; padding: 0;
    width: auto; height: auto; max-width: none; max-height: none;
    border: 0; background: transparent; color: var(--color-ed-fg);
    overflow: visible;
  }
  .col-dialog[open] { display: flex; align-items: center; justify-content: center; }

  .col-dialog__panel {
    position: relative;
    width: min(94vw, 58rem); max-height: 90vh; overflow: auto;
    background:
      linear-gradient(90deg, rgba(28, 28, 28, 0.045), rgba(28, 28, 28, 0) 32px),
      var(--color-ed-bg);
    border: 1px solid var(--color-ed-rule);
    border-top: 3px solid var(--color-ed-accent);
    box-shadow: 0 70px 140px -70px rgba(20, 14, 9, 0.7), 0 2px 0 rgba(28, 28, 28, 0.04);
    outline: 1px solid var(--color-ed-hairline);
    outline-offset: -12px;
    overscroll-behavior: contain;
    /* 开合是 transition 型状态切换：基础态即隐藏态，中途关闭可从当前位置平滑重定向 */
    opacity: 0;
    transform: translateY(18px) scale(0.962);
    transition:
      opacity 340ms var(--ease-ed),
      transform 340ms var(--ease-ed);
    will-change: opacity, transform;
  }
  .col-dialog::backdrop {
    background: radial-gradient(120% 120% at 50% 0%, rgba(28, 28, 28, 0.42), rgba(28, 28, 28, 0.66));
    backdrop-filter: blur(6px) saturate(0.9);
    -webkit-backdrop-filter: blur(6px) saturate(0.9);
  }

  /* 入场：背板先压暗，面板上浮+微放大，封面再晚一拍跟进 */
  .col-dialog[open]::backdrop { animation: col-dialog-backdrop-in 260ms ease-out both; }
  @keyframes col-dialog-backdrop-in { from { opacity: 0; } to { opacity: 1; } }
  .col-dialog[open] .col-dialog__panel {
    opacity: 1;
    transform: none;
  }
  /* 从 display:none 打开时 transition 没有起点，用 @starting-style 补上起始帧
    （不支持的环境降级为打开时瞬现，可接受） */
  @starting-style {
    .col-dialog[open] .col-dialog__panel {
      opacity: 0;
      transform: translateY(18px) scale(0.962);
    }
  }
  .col-dialog[open] .col-dialog__cover {
    animation: col-dialog-cover-in 460ms var(--ease-ed) 60ms both;
  }
  @keyframes col-dialog-cover-in {
    from { opacity: 0; translate: 0 10px; scale: 1.035; }
    to { opacity: 1; translate: 0 0; scale: 1; }
  }
  /* 退场：220ms 收回（transition 型，Esc 中途关闭可平滑重定向） */
  .col-dialog.is-closing::backdrop { animation: col-dialog-backdrop-out 220ms var(--ease-ed) both; }
  @keyframes col-dialog-backdrop-out { from { opacity: 1; } to { opacity: 0; } }
  .col-dialog.is-closing .col-dialog__panel {
    opacity: 0;
    transform: translateY(12px) scale(0.978);
    transition:
      opacity 220ms var(--ease-ed),
      transform 220ms var(--ease-ed);
  }
  .col-dialog.is-closing .col-dialog__cover { animation: none; }

  /* 顶部编号条：WK-00001 · 分类 · 英文 · 关闭 */
  .col-dialog__rail {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 1rem 1.4rem 1rem 2.5rem;
    border-bottom: 1px solid var(--color-ed-hairline);
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.5625rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-ed-subtle);
  }
  .col-dialog__code { color: var(--color-ed-fg); font-variant-numeric: tabular-nums; }
  .col-dialog__railsep { width: 1.1rem; height: 1px; background: var(--color-ed-rule); }
  .col-dialog__cat { color: var(--color-ed-accent); }
  .col-dialog__en { color: var(--color-ed-subtle); opacity: 0.7; letter-spacing: 0.22em; }
  .col-dialog__close {
    margin-left: auto;
    display: flex; align-items: center; justify-content: center;
    width: 2.4rem; height: 2.4rem; padding: 0;
    border: 1px solid var(--color-ed-hairline); border-radius: 999px;
    background: transparent; color: var(--color-ed-muted); cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease, transform 120ms var(--ease-ed);
  }
  .col-dialog__close:hover, .col-dialog__close:focus-visible {
    color: var(--color-ed-fg); border-color: var(--color-ed-rule);
    background: rgba(28, 28, 28, 0.04);
  }
  /* 按压反馈：按钮类，缩到 0.94 */
  .col-dialog__close:active { transform: scale(0.94); }
  .col-dialog__close svg { width: 1rem; height: 1rem; }

  /* 主体：左侧封面 + 出版信息，右侧文字档案 */
  .col-dialog__inner {
    display: grid; grid-template-columns: 236px minmax(0, 1fr);
    gap: 2.75rem; padding: 2rem 2.5rem 2.4rem;
  }
  .col-dialog__aside { display: flex; flex-direction: column; gap: 1.5rem; min-width: 0; }
  .col-dialog__coverwrap {
    position: relative; width: 100%; aspect-ratio: 3 / 4;
    perspective: 900px;
  }
  .col-dialog[data-kind="album"] .col-dialog__coverwrap { aspect-ratio: 1 / 1; }
  .col-dialog[data-kind="film"] .col-dialog__coverwrap,
  .col-dialog[data-kind="tv"] .col-dialog__coverwrap { aspect-ratio: 2 / 3; }
  .col-dialog__pad { position: absolute; z-index: 2; width: 50%; height: 50%; }
  .col-dialog__pad--tl { left: 0; top: 0; }
  .col-dialog__pad--tr { right: 0; top: 0; }
  .col-dialog__pad--bl { left: 0; bottom: 0; }
  .col-dialog__pad--br { right: 0; bottom: 0; }
  .col-dialog__cover {
    position: absolute; inset: 0; z-index: 1;
    display: flex; align-items: flex-end; padding: 1.2rem;
    border-radius: 2px; color: var(--ink, #2a2620);
    background: linear-gradient(160deg, color-mix(in srgb, var(--cover, #fefdf8) 96%, white), var(--cover, #fefdf8));
    box-shadow: 0 30px 46px -28px rgba(20, 14, 9, 0.6), inset 0 0 0 1px rgba(28, 28, 28, 0.12);
    overflow: hidden;
    /* 热区在上层，封面不接收指针，保证四角 hover 生效 */
    pointer-events: none;
    transform-style: preserve-3d;
    transition: transform 500ms var(--ease-ed), box-shadow 500ms var(--ease-ed);
  }
  .col-dialog__cover::before { content: ""; position: absolute; inset: 10px; border: 1px solid color-mix(in srgb, var(--ink, #2a2620) 20%, transparent); border-radius: 1px; pointer-events: none; }
  .col-dialog__cover::after { content: ""; position: absolute; inset: 0; box-shadow: inset 9px 0 18px -14px rgba(0, 0, 0, 0.6); pointer-events: none; }
  .col-dialog__cover-title { position: relative; z-index: 1; font-family: var(--font-serif); font-size: 1.4rem; line-height: 1.32; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  /* 音乐专辑：方形封面（去掉书脊暗部），播放按钮做成实心 CTA */
  .col-dialog[data-kind="album"] .col-dialog__cover { aspect-ratio: 1 / 1; }
  .col-dialog[data-kind="album"] .col-dialog__cover::after { display: none; }
  /* 专辑封面：鼠标移到哪个角，卡片就朝那个角凹进去（纯 CSS 兄弟选择器，无 JS） */
  .col-dialog[data-kind="album"] .col-dialog__pad { cursor: default; }
  .col-dialog[data-kind="album"] .col-dialog__pad--tl:hover ~ .col-dialog__cover {
    transform: rotateX(12deg) rotateY(-12deg);
    box-shadow: 16px 20px 36px rgba(20, 14, 9, 0.38), -10px -8px 26px rgba(166, 58, 43, 0.18), inset 0 0 0 1px rgba(28, 28, 28, 0.12);
  }
  .col-dialog[data-kind="album"] .col-dialog__pad--tr:hover ~ .col-dialog__cover {
    transform: rotateX(12deg) rotateY(12deg);
    box-shadow: -16px 20px 36px rgba(20, 14, 9, 0.38), 10px -8px 26px rgba(166, 58, 43, 0.18), inset 0 0 0 1px rgba(28, 28, 28, 0.12);
  }
  .col-dialog[data-kind="album"] .col-dialog__pad--bl:hover ~ .col-dialog__cover {
    transform: rotateX(-12deg) rotateY(-12deg);
    box-shadow: 16px -16px 36px rgba(20, 14, 9, 0.38), -10px 8px 26px rgba(166, 58, 43, 0.18), inset 0 0 0 1px rgba(28, 28, 28, 0.12);
  }
  .col-dialog[data-kind="album"] .col-dialog__pad--br:hover ~ .col-dialog__cover {
    transform: rotateX(-12deg) rotateY(12deg);
    box-shadow: -16px -16px 36px rgba(20, 14, 9, 0.38), 10px 8px 26px rgba(166, 58, 43, 0.18), inset 0 0 0 1px rgba(28, 28, 28, 0.12);
  }
  .col-dialog[data-kind="album"] .col-dialog__ref {
    border-color: var(--color-ed-accent);
    background: var(--color-ed-accent);
    color: var(--color-ed-bg);
  }
  .col-dialog[data-kind="album"] .col-dialog__ref:hover,
  .col-dialog[data-kind="album"] .col-dialog__ref:focus-visible {
    background: transparent;
    color: var(--color-ed-accent);
  }

  .col-dialog__facts { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 1.1rem; }
  .col-dialog__fact { display: flex; flex-direction: column; gap: 0.2rem; padding-top: 0.55rem; border-top: 1px solid var(--color-ed-hairline); }
  .col-dialog__fact[hidden] { display: none; }
  .col-dialog__fact dt {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.5rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-ed-subtle);
  }
  .col-dialog__fact dd { margin: 0; font-size: 0.8125rem; line-height: 1.5; color: var(--color-ed-fg); }

  .col-dialog__body { padding-top: 0.1rem; min-width: 0; }
  .col-dialog__title { margin: 0 0 0.6rem; font-family: var(--font-serif); font-size: clamp(1.75rem, 3vw, 2.35rem); line-height: 1.18; font-weight: 400; }
  .col-dialog__by {
    margin: 0 0 1.4rem; padding-bottom: 0.95rem;
