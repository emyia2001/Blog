  }
  .col-dialog__src:hover, .col-dialog__src:focus-visible { color: var(--color-ed-accent); border-color: currentColor; }
  .col-dialog__src[hidden] { display: none; }
  .col-dialog__note {
    position: relative; margin: 0; padding: 0.1rem 0 0.1rem 1.15rem;
    border-left: 2px solid var(--color-ed-accent);
    font-family: var(--font-serif); font-size: 1rem; line-height: 1.95;
    color: var(--color-ed-fg);
  }

  .col-dialog__ref {
    display: inline-flex; align-items: center; gap: 0.45rem;
    margin-top: 0.3rem; padding: 0.62rem 0.95rem;
    border: 1px solid var(--color-ed-rule);
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.625rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-ed-fg); text-decoration: none;
    transition: border-color 160ms ease, color 160ms ease, background-color 160ms ease;
  }
  .col-dialog__ref::after { content: "↗"; font-size: 0.9em; }
  .col-dialog__ref:hover, .col-dialog__ref:focus-visible { border-color: var(--color-ed-accent); color: var(--color-ed-accent); background: rgba(166, 58, 43, 0.05); }
  .col-dialog__ref[hidden] { display: none; }
  /* 曲目行由 JS 生成，Astro 的 scoped 属性加不到这些节点上，故用 :global 选择器 */
  .col-dialog__tracks { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.4rem; }
  .col-dialog__tracks :global(li) { display: flex; align-items: baseline; gap: 1.5rem; min-width: 0; }
  .col-dialog__tracks :global(.col-dialog__track-idx) {
    flex: none; width: 1.6rem;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.5625rem; letter-spacing: 0.08em; color: var(--color-ed-subtle);
    font-variant-numeric: tabular-nums;
  }
  .col-dialog__tracks :global(a) {
    flex: 1; min-width: 0; text-align: right;
    font-size: 0.9375rem; line-height: 1.6;
    color: var(--color-ed-fg); text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .col-dialog__tracks :global(a:hover),
  .col-dialog__tracks :global(a:focus-visible) {
    color: var(--color-ed-accent); border-color: color-mix(in srgb, var(--color-ed-accent) 45%, transparent);
  }

  /* 底部条：刊名 + 关闭提示 */
  .col-dialog__foot {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.85rem 2.5rem;
    border-top: 1px solid var(--color-ed-hairline);
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.5625rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-ed-subtle);
  }
  .col-dialog__mark { color: var(--color-ed-muted); }

  @media (max-width: 720px) {
    .col-bank__nav { display: none; }
    .col-wall { grid-template-columns: repeat(auto-fill, minmax(116px, 1fr)); gap: 14px; }
    .col-dialog__rail { padding: 0.8rem 1rem 0.8rem 1.4rem; }
    .col-dialog__en { display: none; }
    .col-dialog__inner { grid-template-columns: 1fr; gap: 1.25rem; padding: 1.1rem 1.4rem 1.6rem; }
    .col-dialog__aside { flex-direction: row; align-items: flex-start; gap: 1rem; }
    .col-dialog__coverwrap { width: 104px; flex: none; }
    .col-dialog__cover { padding: 0.6rem; }
    .col-dialog__cover-title { font-size: 0.8125rem; }
    .col-dialog__facts { flex: 1; gap: 0.7rem 0.9rem; }
    .col-dialog__title { font-size: 1.65rem; }
    .col-dialog__score-value { font-size: 2.4rem; }
    .col-dialog__foot { padding: 0.7rem 1.4rem; }
    .col-dialog__esc { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vol, .vshadow { transition: none; }
    /* 专辑封面：过渡与悬停缩放归零（位移动画 reduce 覆盖补漏） */
    .col-bank[data-mode="album"] .vol__cover { transition: none; }
    .col-bank[data-mode="album"] .vol:hover .vol__cover { transform: none; }
    .col-wallcard__cover { transition: none; }
    .col-wallcard:hover .col-wallcard__cover { transform: none; }
    .col-dialog__cover { transition: none; }
    /* 减少动态：评分条属状态指示，瞬时到位即可 */
    .col-dialog__score-fill { transition: none; }
    /* 减少动态：直接不倾斜，保留平面封面 */
    .col-dialog[data-kind="album"] .col-dialog__pad:hover ~ .col-dialog__cover { transform: none; }
    /* 减少动态：面板只留快速淡入淡出，位移全部去掉；背板动画直接禁用 */
    .col-dialog__panel,
    .col-dialog[open] .col-dialog__panel,
    .col-dialog.is-closing .col-dialog__panel {
      transform: none;
      transition: opacity 150ms linear;
    }
    .col-dialog[open]::backdrop,
    .col-dialog.is-closing::backdrop { animation: none; }
  }
</style>

<script>
  // ===== 立体书架：按 Wenku8_Flutter 的几何与物理 =====
  const DEPTH_X = 0.66, DEPTH_Y = -0.30, RADIUS = 1.48;

  type Bank = { root: HTMLElement; layout: () => void; step: (d: number) => void; refresh: () => void };
  const banks: Bank[] = [];

  function makeBank(root: HTMLElement): Bank {
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const foot = root.querySelector<HTMLElement>("[data-bankfoot]");
    const vols = Array.from(stage.querySelectorAll<HTMLElement>(".vol"));
    const shadows = Array.from(stage.querySelectorAll<HTMLElement>(".vshadow"));
    const n = vols.length;
    const mode = root.dataset.mode || "book";
    let S = 18, C = 128, H = 206, FOOT = S + C * DEPTH_X, BASEY = -C * DEPTH_Y + H * 0.6 + 12, PITCH = 30;
    let focus = Math.floor((n - 1) / 2);
    let dragging = false, lastX = 0, lastT = 0, vel = 0;
    let wheelAccum = 0; // 垂直滚轮累积量 → 攒够一格横移一档

    function measure() {
      const W = stage.clientWidth || 520;
      if (mode === "album") {
        // 专辑：方形封面，无书脊；沿用同样的扇面排布与抽出动画
        C = Math.max(120, Math.min(172, W * 0.15));
        S = 0;
        H = C;
        FOOT = C * DEPTH_X;
        BASEY = 46;
        PITCH = Math.max(44, Math.min(120, C * 0.55));
        stage.style.height = H + 96 + "px";
      } else {
        S = Math.max(14, Math.min(18, W * 0.043));
        C = Math.max(100, Math.min(128, W * 0.32));
        H = ((C - 20) * 166) / 118 + 54;
        FOOT = S + C * DEPTH_X;
        BASEY = -C * DEPTH_Y + H * 0.6 + 12;
        PITCH = Math.max(22, Math.min(150, (W - FOOT) / Math.max(1, n - 1)));
        stage.style.height = BASEY + H + 70 + "px";
      }
      stage.style.setProperty("--S", S + "px");
      stage.style.setProperty("--C", C + "px");
      stage.style.setProperty("--H", H + "px");
      stage.style.setProperty("--FOOT", FOOT + "px");
    }
    const railY = (_d: number) => 0; // 不要弧度：整排压平
    const weight = (d: number) => { const a = Math.abs(d); if (a >= RADIUS) return 0; const v = Math.cos((a / RADIUS) * Math.PI / 2); return v * v; };

    function layout() {
      const W = stage.clientWidth || 520;
      const cx = W / 2;
      vols.forEach((el, i) => {
        const d = i - focus;
        const w = weight(d);
        const lift = w * w * (3 - 2 * w);
        let ox: number, oy: number;
        // 桌面端默认不抬起中间那一本（悬停/点击仍可交互）；小屏保留抬起
        const liftK = window.matchMedia("(min-width: 1024px)").matches ? 0 : 1;
        if (mode === "album") {
          const pull = C * 0.30 * w * (1.24 - 0.24 * w);
          ox = -pull * DEPTH_X;
          oy = BASEY - H * 0.16 * lift * liftK;
        } else {
          const pull = C * 0.78 * w * (1.24 - 0.24 * w);
          ox = -pull * DEPTH_X;
          oy = BASEY + 0.30 * pull - H * 0.28 * lift * liftK;
        }
        const xSlot = cx - FOOT / 2 + d * PITCH;
        el.style.transform = `translate(${(xSlot + ox).toFixed(2)}px, ${(railY(d) + oy).toFixed(2)}px)`;
        el.style.zIndex = String(200 - Math.round(Math.abs(d) * 8));
        const sh = shadows[i];
        if (sh) {
          sh.style.transform = `translate(${xSlot.toFixed(2)}px, ${(railY(d) + BASEY + H - 6).toFixed(2)}px)`;
          sh.style.opacity = String(Math.max(0.15, 0.95 - Math.abs(d) * 0.08));
        }
      });
      const focusIdx = Math.max(0, Math.min(n - 1, Math.round(focus)));
      vols.forEach((el, i) => el.classList.toggle("is-focus", i === focusIdx));
      if (foot) {
        const el = vols[focusIdx];
        const t = el?.dataset.title ?? "";
        const a = el?.dataset.creator ?? "";
        foot.textContent = t ? `${String(Math.round(focus) + 1).padStart(2, "0")} / ${String(n).padStart(2, "0")}　${t} · ${a}` : "";
      }
    }

    function animateTo(t: number) {
      // 位置由 CSS transition 平滑过渡，只设置目标焦点
      focus = Math.max(0, Math.min(n - 1, t));
      layout();
    }

    function step(d: number) { animateTo(Math.round(focus) + d); }
    function refresh() { measure(); layout(); }

    let startX = 0, moved = false;
    stage.addEventListener("pointerdown", (e) => {
      dragging = true; moved = false; startX = e.clientX; lastX = e.clientX; lastT = performance.now(); vel = 0;
    });
    stage.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      if (!moved && Math.abs(e.clientX - startX) > 5) { moved = true; root.classList.add("is-drag"); }
      if (!moved) return;
      const now = performance.now();
      const dx = e.clientX - lastX;
      const dt = Math.max(1, now - lastT);
      vel = dx / dt;
      focus = Math.max(0, Math.min(n - 1, focus - dx / PITCH));
      layout();
      lastX = e.clientX; lastT = now;
    });
    const endDrag = (e?: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      root.classList.remove("is-drag");
      if (moved) {
        (window as any).__shelfSuppressClick = performance.now();
        const projected = focus - vel * 10;
        animateTo(Math.round(projected));
      } else if (e) {
        // 轻点：命中处找书，命中不到就取离指针最近的一本（等距斜面 bbox 可能偏）
        const hit = document.elementFromPoint(e.clientX, e.clientY) as HTMLElement | null;
        let cover = hit?.closest?.("[data-cover]") as HTMLElement | null;
        if (!cover) {
          let best: HTMLElement | null = null, bd = 1e9;
          vols.forEach((v) => {
            const r = v.getBoundingClientRect();
            const dx = Math.max(r.left - e.clientX, 0, e.clientX - r.right);
            const dy = Math.max(r.top - e.clientY, 0, e.clientY - r.bottom);
            const d = Math.hypot(dx, dy);
            if (d < bd) { bd = d; best = v; }
          });
          if (best && bd < 36) cover = best;
        }
        if (cover) { (window as any).__shelfSuppressClick = performance.now(); openDetail(cover); }
      }
    };
    stage.addEventListener("pointerup", (e) => endDrag(e));
    stage.addEventListener("pointercancel", () => endDrag());
    stage.addEventListener("wheel", (e) => {
      // 垂直滚轮 → 横向滑动（像手机上横着拖一样）：deltaY 累积，攒够一格翻一档；
      // deltaX（触控板横扫）维持原有逐档翻页。
      // 已到边界时放行默认滚动，页面继续纵滚、不把用户卡死在架子上。
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
        e.preventDefault();
        step(Math.sign(e.deltaX));
        return;
      }
      if (e.deltaY === 0) return;
      e.preventDefault();
      const atStart = focus <= 0 && e.deltaY < 0;
      const atEnd = focus >= n - 1 && e.deltaY > 0;
      if (atStart || atEnd) return; // 不 preventDefault，交给页面滚动
      wheelAccum += e.deltaY;
      const stepWidth = 53; // 一格档位的滚轮行程（约 3~4 行 standard notches）
      while (wheelAccum >= stepWidth) { step(1); wheelAccum -= stepWidth; }
      while (wheelAccum <= -stepWidth) { step(-1); wheelAccum += stepWidth; }
    }, { passive: false });
    root.querySelectorAll<HTMLElement>("[data-banknav]").forEach((btn) => {
      btn.addEventListener("click", () => step(Number(btn.dataset.banknav || "0")));
    });
    stage.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); step(1); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); step(-1); }
    });
    window.addEventListener("resize", () => { measure(); layout(); });

    return { root, layout, step, refresh };
  }

  function initBanks() {
    banks.length = 0;
    document.querySelectorAll<HTMLElement>("[data-bank]").forEach((root) => {
      const b = makeBank(root);
      banks.push(b);
      b.refresh();
    });
  }

  type Album = { root: HTMLElement; refresh: () => void };
  const albums: Album[] = [];
  function makeAlbums(root: HTMLElement): Album {
    const track = root.querySelector<HTMLElement>("[data-albumtrack]")!;
    let pending = false;
    function update() {
      const tr = track.getBoundingClientRect();
      const cx = tr.left + tr.width / 2;
      track.querySelectorAll<HTMLElement>(".album").forEach((it) => {
        const r = it.getBoundingClientRect();
        const d = Math.abs(r.left + r.width / 2 - cx);
        const range = Math.max(120, r.width * 1.5);
        let w = 0;
        if (d < range) w = 0.5 + 0.5 * Math.cos((d / range) * Math.PI);
        it.style.transform = `translateY(${(-6 * w).toFixed(2)}px) scale(${(1 + 0.06 * w).toFixed(3)})`;
        it.style.zIndex = String(Math.round(w * 100));
      });
    }
    track.addEventListener("scroll", () => {
      if (pending) return; pending = true;
      requestAnimationFrame(() => { pending = false; update(); });
    }, { passive: true });
    // 垂直滚轮 → 横向滑动（原生横滚容器）：平滑滚动一格；
    // 到边界时放行默认滚动，页面继续纵滚。触控板 deltaX 走浏览器原生横滚，不抢。
    track.addEventListener("wheel", (e) => {
      if (Math.abs(e.deltaX) >= Math.abs(e.deltaY) || e.deltaY === 0) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (maxScroll <= 0) return;
      const goingRight = e.deltaY > 0;
      const atStart = track.scrollLeft <= 0 && !goingRight;
      const atEnd = track.scrollLeft >= maxScroll - 1 && goingRight;
      if (atStart || atEnd) return;
      e.preventDefault();
      track.scrollBy({ left: goingRight ? 190 : -190, behavior: "smooth" });
    }, { passive: false });
    root.querySelectorAll<HTMLElement>("[data-albumnav]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const first = track.querySelector<HTMLElement>(".album");
        const pitch = first ? first.offsetWidth + 18 : 190;
        track.scrollBy({ left: Number(btn.dataset.albumnav || "0") * pitch, behavior: "smooth" });
      });
    });
    window.addEventListener("resize", update);
    return { root, refresh: update };
  }
  function initAlbums() {
    albums.length = 0;
    document.querySelectorAll<HTMLElement>("[data-albums]").forEach((root) => {
      const a = makeAlbums(root);
      albums.push(a);
      a.refresh();
    });
  }

  // ===== 筛选：淡出/收起 → 落定后再 hidden；按书架 30ms 交错 =====
  const FILTER_MS = 200;
  const FILTER_STAGGER = 30;
  const shelfTimers = new WeakMap<HTMLElement, number>();
  const colReduced = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // 用内联 transition 驱动：全局 .reveal 也给 .col-shelf 声明了 transition，
  // 走类名会和它抢属性；内联样式优先级更高，且随时可被下一次点击打断。
  function shelfToggle(sec: HTMLElement, show: boolean, delay: number) {
    const prev = shelfTimers.get(sec);
    if (prev) { window.clearTimeout(prev); shelfTimers.delete(sec); }
    const target = show ? "in" : "out";
    if (sec.dataset.shelfState === target && !sec.hidden === show) return;
    sec.dataset.shelfState = target;
    const st = sec.style;

    if (colReduced()) {
      st.transition = ""; st.transitionDelay = "";
      st.maxHeight = ""; st.overflow = ""; st.opacity = ""; st.transform = "";
      sec.classList.remove("is-filtering-out");
      sec.hidden = !show;
      return;
    }

    st.transition = `opacity ${FILTER_MS}ms var(--ease-ed), transform ${FILTER_MS}ms var(--ease-ed), max-height ${FILTER_MS}ms var(--ease-ed)`;
    st.transitionDelay = `${delay}ms`;

    if (show) {
      sec.hidden = false;
      st.overflow = "hidden";
      st.maxHeight = "0px";
      st.opacity = "0";
      st.transform = "translateY(4px)";
      void sec.offsetHeight; // 起始值生效后再改终点，过渡才会真的跑
      st.maxHeight = `${sec.scrollHeight}px`;
      st.opacity = "1";
      st.transform = "translateY(0)";
      shelfTimers.set(sec, window.setTimeout(() => {
        // 撤掉临时约束，避免裁掉悬停溢出
        st.maxHeight = ""; st.overflow = "";
        st.transition = ""; st.transitionDelay = "";
        shelfTimers.delete(sec);
      }, FILTER_MS + delay + 40));
    } else {
      sec.classList.add("is-filtering-out");
      st.overflow = "hidden";
      st.maxHeight = `${sec.offsetHeight}px`;
      void sec.offsetHeight;
      st.maxHeight = "0px";
      st.opacity = "0";
      st.transform = "translateY(4px)";
      shelfTimers.set(sec, window.setTimeout(() => {
        sec.hidden = true;
        sec.classList.remove("is-filtering-out");
        st.maxHeight = ""; st.overflow = ""; st.opacity = ""; st.transform = "";
        st.transition = ""; st.transitionDelay = "";
        shelfTimers.delete(sec);
      }, FILTER_MS + delay + 40));
    }
  }

  function refreshBanks() {
    banks.forEach((b) => { if (!b.root.closest<HTMLElement>("[data-section]")?.hidden) b.refresh(); });
    albums.forEach((a) => { if (!a.root.closest<HTMLElement>("[data-section]")?.hidden) a.refresh(); });
  }

  function initFilter() {
    const chips = Array.from(document.querySelectorAll<HTMLElement>("[data-filter]"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-section]"));
    sections.forEach((sec) => { if (!sec.hidden) sec.dataset.shelfState = "in"; });
    chips.forEach((chip) => {
      if (chip.dataset.filterBound === "1") return; // astro:page-load 会重复 init
      chip.dataset.filterBound = "1";
      chip.addEventListener("click", () => {
        const f = chip.dataset.filter || "all";
        chips.forEach((c) => { const on = c === chip; c.classList.toggle("is-active", on); c.setAttribute("aria-selected", on ? "true" : "false"); });
        sections.forEach((sec, i) => shelfToggle(sec, f === "all" || sec.dataset.cat === f, i * FILTER_STAGGER));
        // 新出现的段要立刻重算几何（隐藏段此时已 visible、只是 opacity 0）
        requestAnimationFrame(refreshBanks);
        window.setTimeout(refreshBanks, FILTER_MS + sections.length * FILTER_STAGGER + 60);
      });
    });
  }

  const dialog = () => document.getElementById("col-dialog") as HTMLDialogElement | null;
  let closeTimer = 0;
  // 关闭：先播 220ms 退场（.is-closing，transition 型），过渡结束再真正 close()。
  // transitionend 在中途被打断时不触发、子元素事件还会冒泡，改用与退场时长对齐的定时器收尾；
  // 连点关闭 / 后台标签页也都有兜底，不会卡住打不开。
  function closeDetail() {
    const dlg = dialog();
    if (!dlg || !dlg.open) return;
    if (colReduced()) { dlg.classList.remove("is-closing"); dlg.close(); return; }
    if (dlg.classList.contains("is-closing")) return;
    dlg.classList.add("is-closing");
    const finish = () => {
      window.clearTimeout(closeTimer);
      dlg.classList.remove("is-closing");
      if (dlg.open) dlg.close();
    };
    closeTimer = window.setTimeout(finish, 220);
  }

  function openDetail(btn: HTMLElement) {
    const dlg = dialog(); if (!dlg) return;
    const d = btn.dataset;
    const kind = d.kind ?? "book";
    const $ = (id: string) => document.getElementById(id);

    const code = $("cd-code");
    const cat = $("cd-cat");
    const en = $("cd-en");
    const title = $("cd-title");
    const by = $("cd-by");
    const cover = $("cd-cover");
    const coverTitle = cover?.querySelector<HTMLElement>("[data-cd-cover-title]");

    if (code) code.textContent = d.code ?? "";
    if (cat) cat.textContent = d.cat ?? "";
    if (en) en.textContent = d.en ?? "";
    if (title) title.textContent = d.title ?? "";
    if (by) {
      const yr = d.year && d.year !== "0" ? ` · ${d.year}` : "";
      by.textContent = `${d.creator ?? ""}${yr}`;
    }

    // 评分：大号数字 + 来源/人数 + 进度条（scaleX = 分值 × 10%）
    const score = $("cd-score");
    const scoreValue = $("cd-score-value");
    const scoreMeta = $("cd-score-meta");
    const scoreFill = $("cd-score-fill");
    const rating = d.rating ? Number(d.rating) : NaN;
    if (score) {
      const hasRating = Number.isFinite(rating) && rating > 0;
      score.hidden = !hasRating;
      if (hasRating) {
        if (scoreValue) scoreValue.textContent = rating.toFixed(1);
        if (scoreFill) scoreFill.style.transform = `scaleX(${Math.max(0.04, Math.min(1, rating * 10 / 100))})`;
        const source = (d.ratingSource ?? "").trim();
        const count = Number(d.ratingCount ?? 0);
        const countText = count >= 10000
          ? `${(count / 10000).toFixed(1).replace(/\.0$/, "")} 万人评价`
          : count > 0 ? `${count} 人评价` : "";
        if (scoreMeta) scoreMeta.textContent = [source, countText].filter(Boolean).join(" · ");
      }
    }

    // 事实行标签：书籍 / 电影 / 剧集各用一套说法
    const factLabels: Record<string, [string, string, string]> = {
      book: ["出版", "年月", "页数"],
      film: ["制片", "上映", "片长"],
      tv: ["制片", "首播", "集数"],
    };
    const labels = factLabels[kind] ?? factLabels.book;
    [["press", labels[0]], ["pubdate", labels[1]], ["pages", labels[2]]].forEach(([key, text]) => {
      const dt = dlg.querySelector(`[data-fact="${key}"] dt`);
      if (dt) dt.textContent = text;
    });

    // 出版信息：空字段整行隐藏，全空则隐藏整个列表
    const facts: Array<[string, string]> = [
      ["press", "cd-press"],
      ["pubdate", "cd-pubdate"],
      ["pages", "cd-pages"],
    ];
    let factCount = 0;
    for (const [key, id] of facts) {
      const row = dlg.querySelector<HTMLElement>(`[data-fact="${key}"]`);
      const dd = $(id);
      const text = ((d[key] as string | undefined) ?? "").trim();
      if (dd) dd.textContent = text;
      if (row) row.hidden = text === "";
      if (text !== "") factCount += 1;
    }
    const factsEl = $("cd-facts");
    if (factsEl) factsEl.hidden = factCount === 0;

    // 分节：简介 / 短评
    const descWrap = $("cd-desc-wrap");
    const desc = $("cd-desc");
    const descText = (d.desc ?? "").trim();
    if (desc) desc.textContent = descText;
    if (descWrap) descWrap.hidden = descText === "";
    const descSrc = $("cd-desc-src") as HTMLAnchorElement | null;
    if (descSrc) {
      const url = d.descSource ?? "";
      if (url) descSrc.href = url;
      descSrc.hidden = url === "";
    }

    const noteWrap = $("cd-note-wrap");
    const note = $("cd-note");
    const noteText = (d.note ?? "").trim();
    if (note) note.textContent = noteText;
    if (noteWrap) noteWrap.hidden = noteText === "";

    // 曲目：同一张专辑在歌单里的所有歌，逐首可点
    const tracksWrap = $("cd-tracks-wrap");
    const tracksEl = $("cd-tracks");
    if (tracksWrap && tracksEl) {
      let tracks: { id: number; name: string }[] = [];
      try { tracks = JSON.parse(d.tracks || "[]"); } catch { tracks = []; }
      tracksEl.replaceChildren(...tracks.map((t, i) => {
        const li = document.createElement("li");
        const idx = document.createElement("span");
        idx.className = "col-dialog__track-idx";
        idx.textContent = String(i + 1).padStart(2, "0");
        const a = document.createElement("a");
        a.href = `https://music.163.com/#/song?id=${t.id}`;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = t.name || "未命名曲目";
        li.append(idx, a);
        return li;
      }));
      tracksWrap.hidden = tracks.length === 0;
    }

    // 外链：有 link 才显示
    const isAlbum = kind === "album";
    const ref = $("cd-ref") as HTMLAnchorElement | null;
    if (ref) {
      const href = d.ref ?? "";
      if (href) {
        ref.href = href;
        ref.textContent = isAlbum
          ? "在网易云播放"
          : href.includes("douban.com") ? "豆瓣条目" : "查看来源";
      }
      ref.hidden = href === "";
    }

    if (cover) {
      if (d.image) {
        // 本地封面用 960w 派生图（弹层大图）；外链图原样
        const imgSrc = d.image.startsWith("/images/covers/") && /\.(jpe?g|png)$/i.test(d.image)
          ? d.image.replace(/^(.*\/)([^/]+)\.(jpe?g|png)$/i, "$1gen/$2-960w.webp")
          : d.image;
        cover.style.backgroundImage = `url("${imgSrc}")`;
        cover.style.backgroundSize = "cover";
        cover.style.backgroundPosition = "center";
      } else {
        cover.style.backgroundImage = "";
        cover.style.setProperty("--cover", d.coverColor ?? "#fefdf8");
        cover.style.setProperty("--ink", d.ink ?? "#2a2620");
      }
    }
    if (coverTitle) coverTitle.textContent = d.image ? "" : (d.title ?? "");

    dlg.dataset.kind = kind;

    if (!dlg.open) {
      dlg.classList.remove("is-closing");
      dlg.showModal();
    }
  }

  let bound = false;
  function bindOnce() {
    if (bound) return; bound = true;
    document.addEventListener("click", (e) => {
      const w = window as unknown as { __shelfSuppressClick?: number };
      if (w.__shelfSuppressClick && performance.now() - w.__shelfSuppressClick < 350) return;
      const target = e.target as HTMLElement | null; if (!target) return;
      if (target.closest("[data-close]")) { closeDetail(); return; }
      let cover = target.closest<HTMLElement>("[data-cover]");
      if (!cover) {
        const bank = target.closest<HTMLElement>("[data-bank]");
        if (bank) {
          const vols = Array.from(bank.querySelectorAll<HTMLElement>(".vol"));
          let best: HTMLElement | null = null, bd = 1e9;
          for (const v of vols) {
            const r = v.getBoundingClientRect();
            const dx = Math.max(r.left - e.clientX, 0, e.clientX - r.right);
            const dy = Math.max(r.top - e.clientY, 0, e.clientY - r.bottom);
            const d = Math.hypot(dx, dy);
            if (d < bd) { bd = d; best = v; }
          }
          if (best && bd < 44) cover = best;
        }
      }
      if (cover) openDetail(cover);
    });
    document.addEventListener("click", (e) => { const dlg = dialog(); if (dlg && dlg.open && e.target === dlg) closeDetail(); });
    document.addEventListener("astro:page-load", () => {
      initBanks(); initAlbums(); initFilter(); bindDialogEsc();
    });
    document.addEventListener("astro:before-swap", () => { banks.length = 0; dialog()?.close(); });
  }

  // Esc 也走同一条退场动画（cancel 事件不冒泡，直接绑在 dialog 上）
  function bindDialogEsc() {
    const dlg = dialog();
    if (!dlg || dlg.dataset.escBound === "1") return;
    dlg.dataset.escBound = "1";
    dlg.addEventListener("cancel", (e) => {
      if (!dlg.classList.contains("is-closing")) e.preventDefault();
      closeDetail();
    });
  }

  bindOnce();
  initBanks();
  initAlbums();
  initFilter();
  bindDialogEsc();
</script>
