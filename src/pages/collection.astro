    font-weight: 400; color: var(--color-ed-subtle);
  }
  .col-dialog__label::after { content: ""; flex: 1; height: 1px; background: var(--color-ed-hairline); }
  .col-dialog__desc { margin: 0; font-size: 0.9375rem; line-height: 1.95; color: var(--color-ed-muted); white-space: pre-line; }
  .col-dialog__src {
    display: inline-block; margin-top: 0.6rem;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.5625rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-ed-subtle); text-decoration: none;
