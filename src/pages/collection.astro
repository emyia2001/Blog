  /* 评分：大号衬线数字 + 来源/人数 + 细进度条 */
  .col-dialog__score {
    display: grid; grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: "value meta" "value bar";
    gap: 0.4rem 1.15rem; align-items: center;
