---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

// 日记：轻量独立的每日流水。date 为记录当天（必填），倒序展示。
// 不进图谱 / RSS / 搜索索引，仅个人记录；将来若迁 Ech0 可整体退役。
const entries = (await getCollection("diary"))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const rendered = await Promise.all(
  entries.map(async (e) => ({
    date: e.data.date,
    title: e.data.title,
    Content: (await e.render()).Content,
  }))
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
    weekday: "short",
  });
---

<BaseLayout title="日记">
  <section class="py-24 md:py-32 px-6">
    <div class="mx-auto max-w-2xl">
      <h1 class="font-serif text-3xl md:text-4xl tracking-tighter text-[var(--color-ed-fg)] mb-3">
        日记
      </h1>
      <p class="text-xs tracking-[0.3em] text-[var(--color-ed-muted)] mb-14">DIARY</p>

      {rendered.length > 0 ? (
        <div class="space-y-14">
          {rendered.map(({ date, title, Content }) => (
            <article class="border-b border-[var(--color-ed-faint)] pb-10">
              <h2 class="font-serif text-2xl text-[var(--color-ed-fg)]">
                {title ?? fmtDate(date)}
              </h2>
              <time
                datetime={date.toISOString()}
                class="mt-2 mb-6 block text-xs text-[var(--color-ed-subtle)] tabular-nums"
              >
                {fmtDate(date)}
              </time>
              <div class="prose">
                <Content />
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-[var(--color-ed-muted)]">还没有日记。</p>
      )}
    </div>
  </section>
</BaseLayout>
