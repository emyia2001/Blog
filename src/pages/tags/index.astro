---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagCloud from "../../components/TagCloud.astro";
---

<BaseLayout
  title="标签"
  description="按标签浏览文章：每个标签下是该主题的全部文章。"
>
  <div class="page-shell page-shell--medium">
    <header class="page-head">
      <div class="page-head__row">
        <h1 class="page-head__title">标签 <small>Tags</small></h1>
        <a href="/archive/" class="page-head__aside">归档 →</a>
      </div>
    </header>

    <section aria-labelledby="all-tags-label">
      <h2 class="sr-only" id="all-tags-label">全部标签</h2>
      <TagCloud />
    </section>
  </div>
</BaseLayout>
