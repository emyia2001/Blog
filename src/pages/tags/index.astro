---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagCloud from "../../components/TagCloud.astro";
---

<BaseLayout
  title="标签"
  description="按标签浏览文章：每个标签下是该主题的全部文章。"
>
  <div class="page-shell page-shell--medium">
    <header class="page-head">
      <div class="page-head__row">
        <h1 class="page-head__title">标签</h1>
        <a href="/archive/" class="page-head__aside">归档 <span class="aside-arrow">→</span></a>
      </div>
    </header>

    <section aria-labelledby="all-tags-label">
      <h2 class="sr-only" id="all-tags-label">全部标签</h2>
      <TagCloud />
    </section>
  </div>
</BaseLayout>

<style>
  /* 「归档 →」箭头：hover 时右移 2px，与归档 / 标签页同一条微交互（位移收进 hover-gate，
     :focus-visible 的键盘反馈留在门外） */
  .aside-arrow {
    display: inline-block;
    transition: transform 200ms var(--ease-ed);
  }

  .page-head__aside:focus-visible .aside-arrow {
    transform: translateX(2px);
  }

  @media (hover: hover) and (pointer: fine) {
    .page-head__aside:hover .aside-arrow {
      transform: translateX(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aside-arrow {
      transition: none;
    }

    .page-head__aside:hover .aside-arrow,
    .page-head__aside:focus-visible .aside-arrow {
      transform: none;
    }
  }
</style>
