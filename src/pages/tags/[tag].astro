---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { postPath, tagSlug } from "../../utils/urls";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const tagSet = new Set<string>();
  for (const post of allPosts) {
    if (post.data.draft) continue;
    for (const tag of post.data.tags) {
      tagSet.add(tag);
    }
  }
  return [...tagSet].map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const allPosts = await getCollection("posts");
const posts = allPosts
  .filter(
    (p) =>
      !p.data.draft &&
      p.data.tags.some((t) => tagSlug(t) === Astro.params.tag)
  )
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title={`#${tag}`}
  description={`标签「${tag}」下的全部文章（${posts.length} 篇）。`}
>
  <div class="page-shell page-shell--medium">
    <header class="page-head">
      <div class="page-head__row">
        <h1 class="page-head__title">#{tag} <small>Tag</small></h1>
        <a href="/tags/" class="page-head__aside">全部标签 →</a>
      </div>
      <p class="page-head__meta">{posts.length} 篇文章</p>
    </header>

    {posts.length > 0 ? (
      <ol class="entry-list">
        {posts.map((post, i) => (
          <li class="reveal" style={`--reveal-delay: ${Math.min(i, 5) * 50}ms`}>
            <a href={postPath(post)} class="entry-row">
              <span class="entry-row__no">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="entry-row__title">{post.data.title}</span>
              <span class="kind-chip entry-row__kind">文章</span>
              <time class="entry-row__date" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("zh-CN", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty-note">该标签下暂无文章。</p>
    )}
  </div>
</BaseLayout>
