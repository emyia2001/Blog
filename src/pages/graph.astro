---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import GraphView from "../components/GraphView.astro";
import { buildGraphData } from "../utils/graphData";

const [allPosts, allMoments] = await Promise.all([
  getCollection("posts"),
  getCollection("moments"),
]);

const graphData = buildGraphData(allPosts, allMoments);
const graphNodes = graphData.nodes;
const graphLinks = graphData.links;
const contentNodes = graphNodes.filter((n) => n.kind !== "self");
---

<BaseLayout title="图谱">
  <div class="mx-auto max-w-[1380px] px-6 md:px-8">
    <section class="pt-10 md:pt-16 pb-24">
      <div class="home-sec-head mb-10 mask-reveal">
        <h1 class="home-sec-title">
          关系图谱
          <small>Connections</small>
        </h1>
        <a href="/timeline/" class="home-sec-more">纪事时间线 →</a>
      </div>

      {graphNodes.length > 1 ? (
        <>
          <div class="graph-tall">
            <GraphView nodes={graphNodes} links={graphLinks} />
          </div>
          <div class="graph-meta">
            <p>
              共 <strong>{graphNodes.length}</strong> 个节点 ·
              <strong>{graphLinks.length}</strong> 条关联
            </p>
            <p>连线来自正文引用，或内容与作者、人物之间的归属关系。</p>
          </div>
        </>
      ) : (
        <p class="py-20 text-center text-[var(--color-ed-muted)]">
          暂无内容。
        </p>
      )}

      <noscript>
        <ul class="graph-fallback">
          {
            contentNodes.map((n) => (
              <li>
                {n.url ? <a href={n.url}>{n.title}</a> : <span>{n.title}</span>}
              </li>
            ))
          }
        </ul>
      </noscript>
    </section>
  </div>
</BaseLayout>

<style>
  /* 独立图谱页：画布更高，充分利用整页宽度；高度随视口自适应 */
  .graph-tall {
    --graph-h: clamp(26rem, 62vh, 42rem);
  }

  /* 手机上画布太窄，62vh 会拉成细长条：压到接近方形，图形不至于悬在中间 */
  @media (max-width: 640px) {
    .graph-tall {
      --graph-h: 27rem;
    }
  }

  .graph-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 0.9rem;
    color: var(--color-ed-subtle);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    line-height: 1.6;
  }
  .graph-meta p {
    margin: 0;
  }
  .graph-meta strong {
    color: var(--color-ed-fg);
    font-weight: 600;
  }

  /* JS 关闭时的降级：把节点列成清单，至少还能点进文章 */
  .graph-fallback {
    margin-top: 1.5rem;
    padding-left: 1rem;
    color: var(--color-ed-muted);
    font-size: 0.8125rem;
    line-height: 1.8;
  }
</style>
