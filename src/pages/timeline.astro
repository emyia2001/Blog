---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import MiniPlayer from "../components/MiniPlayer.astro";
import ImageLightbox from "../components/ImageLightbox.astro";
import { encryptContent } from "../utils/lockContent";
import { SITE_NAME, SITE_AVATAR } from "../consts";

// 纪事（moments）：person / event / diary 连续信息流，全部服务端直出。
// 右侧时间轴是目录（scroll-spy 高亮当前位置，点击滚动到对应条目）。
const allMoments = await getCollection("moments");

const publishedMoments = allMoments
  .filter((m) => !m.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 长文条目：feed 里只显示入口卡（标题 + 引文），点击原位展开完整阅读。
// 阈值可调（构建期判定）。
const LONG_BODY_LIMIT = 800;

// 引文：正文前两个非空段落合并（去 markdown 记号）——保证两行 clamp 永远
// 有溢出内容，渐隐截断的「未完」信号对所有长文稳定成立
const longQuote = (body: string | undefined) => {
  const paras = (body ?? "")
    .split(/\n\s*\n/)
    .map((b) =>
      b
        .split("\n")
        .map((l) => l.replace(/[#>*`\[\]!]|^- /g, "").trim())
        .filter(Boolean)
        .join(" "),
    )
    .filter(Boolean);
  const text = paras.slice(0, 2).join(" ");
  return text.length > 400 ? `${text.slice(0, 400)}…` : text;
};

type RenderedContent = Awaited<
  ReturnType<CollectionEntry<"posts">["render"]>
>["Content"];

type Kind = "person" | "event" | "diary";

const KIND_LABEL: Record<Kind, string> = {
  person: "人物",
  event: "事件",
  diary: "日记",
};

  // 无标题条目的轴点文本：正文首行截断（碎碎念日记、无标题事件通用）
  const diaryTeaser = (body: string | undefined) => {
  const firstLine = (body ?? "")
    .split("\n")
    .map((s) => s.replace(/[#>*`[\]!]|^- /g, "").trim())
    .find(Boolean);
  if (!firstLine) return "";
  return firstLine.length > 22 ? `${firstLine.slice(0, 22)}…` : firstLine;
};

// 所有内容统一预渲染全文；带 lock 的文章构建期加密正文，浏览器端用答案解密
interface FeedItem {
  id: string;
  /** 深链接锚点：由内容 id 去掉扩展名（稳定、可分享） */
  anchor: string;
  kind: Kind;
  entry: CollectionEntry<"moments">;
  Content?: RenderedContent; // 未加密才有明文 Content
  /** 长文条目：feed 只显示入口卡，点击原位展开 */
  long?: boolean;
  /** 长文引文（正文首行截断） */
  quote?: string;
  lock?: {
    question: string;
    ciphertext: string;
    salt: string;
    iv: string;
  };
}

const feed: FeedItem[] = await Promise.all(
  publishedMoments.map(async (m) => {
    const long = (m.body?.length ?? 0) > LONG_BODY_LIMIT;
    const base = {
      id: m.id,
      anchor: m.id.replace(/\.mdx?$/, ""),
      kind: m.data.type as Kind,
      entry: m,
      long,
      quote: long ? longQuote(m.body) : undefined,
    };
    if (m.data.lock?.answer) {
      // 加密正文（构建期）；明文不进产物
      const enc = encryptContent(String(m.body ?? ""), m.data.lock.answer);
      return {
        ...base,
        lock: {
          question: m.data.lock.question,
          ciphertext: enc.ciphertext,
          salt: enc.salt,
          iv: enc.iv,
        },
      };
    }
    return { ...base, Content: (await m.render()).Content };
  })
);

interface RailEntry {
  anchor: string;
  date: Date;
  kind: Kind;
  title: string;
  /** 无标题时轴点显示正文首行截断；person/event 恒为空 */
  teaser: string;
  label: string; // 轴点小标签：人物 / 事件 / 日记
  locked: boolean;
  hasBgm: boolean;
  /** 只在年份切换（或第一条）时显示年份，避免每行重复 */
  showYear: boolean;
}

// 时间轴目录条目：publishedMoments 已排序，与 feed 同序一一对应
const railEntries: RailEntry[] = publishedMoments.map((m) => ({
  anchor: m.id.replace(/\.mdx?$/, ""),
  date: m.data.date,
  kind: m.data.type as Kind,
  title: m.data.title ?? "",
  teaser: diaryTeaser(m.body),
  label: KIND_LABEL[m.data.type as Kind],
  locked: Boolean(m.data.lock?.answer),
  hasBgm: Boolean(m.data.bgm?.src),
  showYear: false,
}));

// 年份分组：降序排列时，第一条和每次跨年才标出年份
railEntries.forEach((entry, i) => {
  entry.showYear =
    i === 0 || entry.date.getFullYear() !== railEntries[i - 1].date.getFullYear();
});

const fmtLong = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
    weekday: "short",
  });

// 轴点日期：08.20（年份只在跨年时前缀显示，见上面的 showYear）
const fmtPoint = (d: Date) =>
  `${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
---

<BaseLayout title="动态" description="动态：碎碎念与生活流，按时间从近到远连续排列。">
  <div class="page-shell">
    <section>
      <header class="page-head">
        <div class="page-head__row">
          <h1 class="page-head__title">动态</h1>
        </div>
      </header>

      {railEntries.length > 0 ? (
        <div class="timeline-layout">
          <!-- 时间轴：手机端在正文上方横向滑动，桌面端是右侧竖轴 -->
          <aside id="view-timeline" class="timeline-rail" aria-label="动态时间线">
            <div class="tl-title-row">时间线</div>
            <ol class="tl-simple">
              {railEntries.map((entry, i) => (
                <li
                  id={entry.anchor}
                  class="timeline-point group"
                  data-kind={entry.kind}
                  data-index={i}
                  data-anchor={entry.anchor}
                  role="button"
                  tabindex="0"
                  aria-current={i === 0 ? "true" : undefined}
                  aria-controls={entry.anchor}
                  style={`--tl-i: ${i}`}
                >
                  {/* 段竖线：独立于可缩放内容，入场时逐段生长、悬停时本段高亮 */}
                  <span class="tl-seg" aria-hidden="true"></span>
                  {/* 圆点：圆心钉在竖线上，dock 放大时不随文字缩放，始终骑线 */}
                  <span class="tl-simple__dot" aria-hidden="true"></span>
                  <span class="tl-simple__body">
                    <time class="tl-simple__date" datetime={entry.date.toISOString()}>
                      {entry.showYear && (
                        <span class="tl-simple__year">{entry.date.getFullYear()}</span>
                      )}
                      {fmtPoint(entry.date)}
                    </time>
                    <span class="tl-title block font-serif text-sm leading-snug text-[var(--color-ed-fg)] transition-colors duration-300 group-hover:text-[var(--color-ed-accent)]">
                      {entry.title || entry.teaser || "日记"}
                    </span>
                    <span class="tl-simple__meta">
                      <span class="tl-simple__label">{entry.label}</span>
                      {entry.locked && (
                        <span class="tl-mark" title="需要答案解锁">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="4" y="10" width="16" height="10" rx="2"></rect>
                            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                          </svg>
                          <span class="sr-only">需要答案解锁</span>
                        </span>
                      )}
                      {entry.hasBgm && (
                        <span class="tl-mark" title="含背景音乐">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 18V5l11-2v13"></path>
                            <circle cx="6" cy="18" r="3"></circle>
                            <circle cx="17" cy="16" r="3"></circle>
                          </svg>
                          <span class="sr-only">含背景音乐</span>
                        </span>
                      )}
                    </span>
                  </span>
                </li>
              ))}
            </ol>
          </aside>

          <!-- 连续信息流：全部条目服务端直出，日记是无标题的碎碎念（占位更紧）。
               data-pagefind-body 让搜索只索引这个区域；日记按约定不进索引，
               加锁条目只有谜面与密文，也一并跳过。 -->
          <div id="timeline-feed" class="timeline-feed" data-pagefind-body>
            {feed.map((c, i) => (
              <>
                {railEntries[i].showYear && (
                  <div class="tl-year" aria-hidden="true">
                    {railEntries[i].date.getFullYear()}
                  </div>
                )}
                <article
                  id={c.anchor}
                  class:list={[
                    "tl-entry",
                    "reveal",
                    c.kind === "diary" && "tl-entry--diary",
                    c.long && "tl-entry--long",
                  ]}
                  data-pagefind-ignore={c.kind === "diary" ? "true" : undefined}
                >
                  <header class="tl-entry__head">
                    <span class="tl-entry__by">
                      <img
                        class="tl-entry__avatar"
                        src={SITE_AVATAR}
                        alt=""
                        width="28"
                        height="28"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="tl-entry__name">{SITE_NAME}</span>
                    </span>
                    <span class="tl-entry__meta">
                      {/* 右上角：自由标签（类似文章 tags）；固定类型不再上 feed */}
                      {(c.entry.data.tags?.length ?? 0) > 0 && (
                        <span class="tl-entry__kind">
                          {c.entry.data.tags!.join(" · ")}
                        </span>
                      )}
                    </span>
                  </header>
                  {/* 长文：标题+引文构成入口卡（整卡可点展开）；普通条目直接出标题 */}
                  {c.long ? (
                    <a
                      class="tl-long-head"
                      href={`/chronicle/${c.anchor}/`}
                      data-bgm={c.entry.data.bgm?.src ? "1" : undefined}
                      data-bgm-title={c.entry.data.bgm?.title ?? ""}
                    >
                      <span class="tl-long-text">
                        {c.entry.data.title && (
                          <h2 class="tl-entry__title">{c.entry.data.title}</h2>
                        )}
                        {c.quote && <p class="tl-long-quote">{c.quote}</p>}
                      </span>
                    </a>
                  ) : (
                    c.kind !== "diary" &&
                    c.entry.data.title && (
                      <h2 class="tl-entry__title">{c.entry.data.title}</h2>
                    )
                  )}
                  {/* BGM 曲目行仅在短条目显示；长文的配乐归详情页（悬浮播放器） */}
                  {!c.long && c.entry.data.bgm?.src && (
                    <div class="mt-4">
                      <MiniPlayer
                        src={c.entry.data.bgm.src}
                        title={c.entry.data.bgm.title}
                        gated={Boolean(c.lock)}
                        inline
                      />
                    </div>
                  )}
                  {!c.long && (
                    <>
                    {c.lock ? (
                    <div
                      class="lock-box mt-6"
                      data-lock-id={c.id}
                      data-ciphertext={c.lock.ciphertext}
                      data-salt={c.lock.salt}
                      data-iv={c.lock.iv}
                      data-pagefind-ignore="true"
                    >
                      <p class="lock-question">{c.lock.question}</p>
                      <div class="lock-row">
                        <input
                          type="text"
                          class="lock-input"
                          placeholder="输入答案解锁"
                          autocomplete="off"
                          aria-label="答案"
                        />
                        <button type="button" class="lock-btn">解锁</button>
                      </div>
                      <p class="lock-error" hidden>答案不对，再试试。</p>
                      <div class="lock-content prose mt-4" hidden></div>
                    </div>
                  ) : (
                    c.Content && (
                      <div class="prose mt-6">
                        <c.Content />
                      </div>
                    )
                  )}
                    </>
                  )}
                  {/* 互动行：本地点赞（无后端，状态存本机，不做假计数） */}
                  <footer class="tl-entry__foot">
                    <time class="tl-entry__foot-date" datetime={c.entry.data.date.toISOString()}>
                      {fmtLong(c.entry.data.date)}
                    </time>
                    <span class="tl-entry__actions">
                    <button
                      type="button"
                      class="tl-like"
                      data-like={c.anchor}
                      aria-pressed="false"
                      title="点赞（本机记忆）"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 20.7C7.4 17.4 3.5 14 3.5 9.9 3.5 7 5.7 5 8.2 5c1.6 0 3 .9 3.8 2.2C12.8 5.9 14.2 5 15.8 5c2.5 0 4.7 2 4.7 4.9 0 4.1-3.9 7.5-8.5 10.8z"></path>
                      </svg>
                      <span class="sr-only">点赞</span>
                    </button>
                    <button
                      type="button"
                      class="tl-comment"
                      data-comment={c.anchor}
                      aria-expanded="false"
                      aria-controls={`tl-comments-${c.anchor}`}
                      title="评论"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 11.5c0 4.1-4 7.5-9 7.5-1 0-2-.1-2.9-.4L4 20l1.2-3.6C3.8 15 3 13.3 3 11.5 3 7.4 7 4 12 4s9 3.4 9 7.5z"></path>
                      </svg>
                      <span class="sr-only">评论</span>
                    </button>
                    </span>
                  </footer>
                  <div class="tl-comments" id={`tl-comments-${c.anchor}`} data-term={c.anchor} data-pagefind-ignore hidden></div>
                </article>
              </>
            ))}
          </div>

          <!-- 长文配乐提示弹窗：首访点击入口卡时出现，强制停留 2s 后自动跳转 -->
          <div id="tl-bgm-modal" class="tl-bgm-modal" hidden>
            <div class="tl-bgm-modal__card">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l11-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="17" cy="16" r="3"></circle></svg>
              <span>这篇有背景音乐：<b data-bgm-title></b></span>
            </div>
          </div>
        </div>
      ) : (
        <p class="text-[var(--color-ed-muted)]">暂无内容。</p>
      )}
    </section>
  </div>
  <ImageLightbox />
</BaseLayout>

<style>
  /* 右栏区块小标题 */
  .tl-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ed-subtle);
  }
  .tl-title-row::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--color-ed-rule);
  }

  /* ================= 简约时间轴 =================
     结构：每 <li> 自带一段竖线 .tl-seg + 一个圆点 .tl-simple__dot。
     竖线分段 → 可逐段做入场生长与悬停高亮；圆点圆心钉在线上，dock 放大不脱线。 */
  .tl-simple {
    list-style: none;
    margin: 0;
    padding: 0 1.5rem 0 0.25rem; /* 右侧留余量：dock 放大时文字不被滚动条裁掉 */
    position: relative;
    height: 22rem;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
  }
  /* 时间线变量：线 X 坐标（1px 线，中心对齐）、dot 半径 */
  .tl-simple {
    --tl-line-x: 7.5px;
    --tl-dot-d: 9px;
  }
  .timeline-point {
    position: relative;
    display: flex;
    scroll-margin-top: 6rem;
    padding: 0.625rem 0 0.625rem 1.5rem; /* 左 padding 让位给线/点 */
    cursor: pointer;
    border-radius: 4px;
    /* 悬停/激活底色与边框（手机端卡片）都走同一条短过渡，避免硬切 */
    transition: background-color 160ms ease, border-color 160ms ease;
    /* 入场动画：整体淡入上移（delay 由 --tl-i 逐条错开） */
    opacity: 0;
    animation: tl-point-in 0.5s var(--ease-ed) forwards;
    animation-delay: calc(0.15s + min(var(--tl-i, 0), 7) * 0.04s);
  }
  @keyframes tl-point-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .timeline-point:hover {
    background: rgba(28, 28, 28, 0.03);
  }

  /* —— 每段竖线：默认透明，入场时逐段从顶生长；悬停/激活时本段点亮 —— */
  .tl-seg {
    position: absolute;
    left: calc(var(--tl-line-x) - 0.5px);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-ed-rule);
    transform: scaleY(0);
    transform-origin: top;
    animation: tl-seg-grow 0.5s var(--ease-ed) forwards;
    animation-delay: calc(0.15s + min(var(--tl-i, 0), 7) * 0.04s);
  }
  @keyframes tl-seg-grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* 极速换页：导航进入时点/线直接呈现，不做生长编排 */
  :global(html.nav-fast) .timeline-point {
    opacity: 1;
    animation: none;
    animation-delay: 0s;
  }
  :global(html.nav-fast) .tl-seg {
    animation: none;
    transform: none;
  }

  /* reduced-motion 下的时间轴入场：只淡不移（与上面 tl-point-in 配对） */
  @keyframes tl-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .timeline-point:hover .tl-seg {
    background: var(--color-ed-accent);
    opacity: 0.7;
  }
  .timeline-point.is-active .tl-seg {
    background: var(--color-ed-accent);
  }

  /* —— 圆点/方点：绝对定位，圆心精确钉在竖线上；放大以圆心为锚，不脱线 —— */
  .tl-simple__dot {
    position: absolute;
    left: calc(var(--tl-line-x) - var(--tl-dot-d) / 2);
    top: 0.9rem; /* 与首行文字（日期）大致齐平 */
    width: var(--tl-dot-d);
    height: var(--tl-dot-d);
    border-radius: 50%;
    border: 1px solid var(--color-ed-muted);
    background: var(--color-ed-bg);
    transform-origin: center;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
    pointer-events: none;
  }
  /* 日记节点用小方点以示区分 */
  .timeline-point[data-kind="diary"] .tl-simple__dot {
    border-radius: 2px;
  }
  .timeline-point:hover .tl-simple__dot {
    border-color: var(--color-ed-accent);
  }
  /* 悬停位移收进 hover-gate：触屏不再粘滞缩放/位移；置于 .is-active 状态规则之前保持原优先级 */
  @media (hover: hover) and (pointer: fine) {
    .timeline-point:hover .tl-simple__dot {
      transform: scale(1.25);
    }
    .timeline-point:hover .tl-simple__body {
      transform: translateX(4px);
    }
  }
  .timeline-point.is-active .tl-simple__dot {
    background: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
    transform: scale(1.15);
  }

  /* —— 可 dock 缩放的主体：只放大文字区，线与点保持骑线不动 —— */
  .tl-simple__body {
    flex: 1;
    min-width: 0;
    padding-bottom: 0.25rem;
    transform-origin: left center;
    transition: transform 160ms var(--ease-ed);
  }
  .timeline-point.is-active .tl-simple__body {
    transform: translateX(4px);
  }
  .tl-simple__date {
    display: block;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ed-subtle);
    letter-spacing: 0.06em;
  }
  .tl-simple__meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.15rem;
  }
  .tl-simple__label {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--color-ed-subtle);
    text-transform: uppercase;
  }
  .tl-mark {
    display: inline-flex;
    align-items: center;
    color: var(--color-ed-subtle);
  }
  .tl-mark svg {
    width: 0.625rem;
    height: 0.625rem;
  }
  /* 年份只在跨年时出现，避免每行重复 */
  .tl-simple__year {
    margin-right: 0.3rem;
    color: var(--color-ed-subtle);
  }
  .timeline-point.is-active .tl-title {
    color: var(--color-ed-accent);
  }
  /* 日记是流水，轴点上弱一档；人物/事件保持主级 */
  .timeline-point[data-kind="diary"] .tl-title {
    color: var(--color-ed-muted);
    font-size: 0.8125rem;
  }
  .timeline-point[data-kind="diary"].is-active .tl-title {
    color: var(--color-ed-accent);
  }
  /* 焦点环内缩：横轴/竖轴的 overflow 会裁掉外扩的 outline */
  .timeline-point:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: -2px;
  }

  /* —— 纪事内容解锁（加密文章）—— */
  .lock-box {
    position: relative;
    border: 1px dashed var(--color-ed-rule);
    padding: 1rem;
  }
  /* 解锁成功：边框闪一次砖红。用叠加层只动 opacity（不动 border-color），
     既符合「只动 transform/opacity」，也不触发逐帧重绘边框。 */
  .lock-box::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--color-ed-accent);
    pointer-events: none;
    opacity: 0;
  }
  .lock-box.is-unlocked::after {
    animation: lock-box-flash 400ms ease-out both;
  }
  @keyframes lock-box-flash {
    0% {
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  .lock-question {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-ed-fg);
    margin: 0 0 0.75rem;
  }
  .lock-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .lock-input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--color-ed-rule);
    background: transparent;
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
    color: var(--color-ed-fg);
  }
  .lock-input:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: 1px;
  }
  /* 答错：输入框轻抖一次（reduced-motion 下由媒体查询降级为无抖动） */
  .lock-input.is-shake {
    animation: lock-shake 260ms ease;
  }
  @keyframes lock-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    20% {
      transform: translateX(-3px);
