<script>
  import {
    GISCUS_REPO,
    GISCUS_REPO_ID,
    GISCUS_CATEGORY,
    GISCUS_CATEGORY_ID,
  } from "../consts";

  // ===== 纪事连续流 =====
  // 服务端已直出全部条目；本脚本只负责：
  //   1. 时间轴（目录）点击/键盘 → 平滑滚动到对应条目并写入 hash
  //   2. scroll-spy：滚动时高亮当前位置的轴点（rAF 节流，hash 用 replaceState 不污染历史）
  //   3. 加锁条目解密（见下方锁一节，lock-box 常驻 DOM）
  // View Transitions：脚本只执行一次，引用在事件发生时现查，状态挂 window 上。
  type TLState = { active: number | null; bound: boolean };
  const tlWindow = window as Window & { __timelineState?: TLState };
  const TL: TLState = (tlWindow.__timelineState ??= {
    active: null,
    bound: false,
  });
  const TL_MOBILE = window.matchMedia("(max-width: 1023px)");
  const TL_REDUCED = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const tlPoints = () =>
    Array.from(document.querySelectorAll<HTMLElement>(".timeline-point"));
  const tlEntries = () =>
    Array.from(document.querySelectorAll<HTMLElement>(".tl-entry"));

  function tlHash(): string {
    const raw = location.hash.replace(/^#/, "");
    try {
      return decodeURIComponent(raw);
    } catch {
      return raw;
    }
  }

  function tlSetHash(anchor: string, push: boolean) {
    if (!anchor || location.hash === `#${anchor}`) return;
    const url = `${location.pathname}${location.search}#${anchor}`;
    if (push) history.pushState(null, "", url);
    else history.replaceState(null, "", url);
  }

  function tlSetActive(index: number) {
    tlPoints().forEach((p, i) => {
      const on = i === index;
      p.classList.toggle("is-active", on);
      if (on) p.setAttribute("aria-current", "true");
      else p.removeAttribute("aria-current");
    });
  }

  // 对齐条目顶部（锚点语义）；已在位时不再抽动
  function tlScrollToEntry(article: HTMLElement) {
    const top = article.getBoundingClientRect().top + window.scrollY - 84;
    if (Math.abs(window.scrollY - Math.max(0, top)) < 4) return;
    window.scrollTo({
      top: Math.max(0, top),
      behavior: TL_REDUCED ? "auto" : "smooth",
    });
  }

  // 只滚时间轴自身：桌面向上下、手机向左右，不抢正文的滚动
  function tlRevealPoint(point: HTMLElement) {
    const scroller = point.closest<HTMLElement>(".tl-simple");
    if (!scroller) return;
    if (TL_MOBILE.matches) {
      const left = point.offsetLeft - 8;
      const right = left + point.offsetWidth;
      if (
        left < scroller.scrollLeft ||
        right > scroller.scrollLeft + scroller.clientWidth
      ) {
        scroller.scrollTo({
          left: Math.max(0, left),
          behavior: TL_REDUCED ? "auto" : "smooth",
        });
      }
      return;
    }
    const p = point.getBoundingClientRect();
    const box = scroller.getBoundingClientRect();
    if (p.top < box.top + 4) scroller.scrollTop += p.top - box.top - 8;
    else if (p.bottom > box.bottom - 4)
      scroller.scrollTop += p.bottom - box.bottom + 8;
  }

  // scroll-spy：以「顶部越过导航线下方」的最后一条为当前位置；触底时取最后一条。
  // 页面顶端不写 hash（保持 /timeline/ 干净），滚进正文后才用 replaceState 同步。
  // 程序化导航（轴点点击/深链接）的滚动期间暂停 spy——否则起步瞬间 spy 会把
  // 刚设置的高亮/hash 抢回落点之前的条目（observed：点日记却被改回事件）。
  let navQuiet = false;
  let navQuietTimer = 0;
  function tlBeginNav() {
    navQuiet = true;
    window.clearTimeout(navQuietTimer);
    navQuietTimer = window.setTimeout(() => {
      navQuiet = false;
    }, 1200);
    // scrollend（现代浏览器）在平滑滚动结束时立即解除抑制
    window.addEventListener(
      "scrollend",
      () => {
        navQuiet = false;
      },
      { once: true }
    );
  }

  function tlSpy() {
    if (navQuiet) return;
    const entries = tlEntries();
    if (entries.length === 0) return;
    let index = 0;
    for (let i = 0; i < entries.length; i++) {
      if (entries[i].getBoundingClientRect().top <= 100) index = i;
    }
    const doc = document.documentElement;
    if (window.innerHeight + window.scrollY >= doc.scrollHeight - 4) {
      index = entries.length - 1;
    }
    if (index === TL.active) return;
    TL.active = index;
    tlSetActive(index);
    const point = tlPoints()[index];
    if (point) {
      tlRevealPoint(point);
      if (window.scrollY > 40 || tlHash()) {
        tlSetHash(point.dataset.anchor ?? "", false);
      }
    }
  }

  let spyRaf = 0;
  function tlOnScroll() {
    if (spyRaf) return;
    spyRaf = window.requestAnimationFrame(() => {
      spyRaf = 0;
      tlSpy();
    });
  }

  // ===== 互动行：本地点赞（纯静态无后端，状态只存本机 localStorage）=====
  const LIKE_STORAGE_KEY = "snark_moment_likes";

  function loadLikes(): Record<string, number> {
    try {
      return JSON.parse(localStorage.getItem(LIKE_STORAGE_KEY) || "{}");
    } catch {
      return {};
    }
  }

  // 首屏/换页后恢复已点赞状态（aria-pressed 驱动样式）
  function tlRestoreLikes() {
    const likes = loadLikes();
    document.querySelectorAll<HTMLButtonElement>(".tl-like").forEach((btn) => {
      if (btn.dataset.like && likes[btn.dataset.like]) {
        btn.setAttribute("aria-pressed", "true");
      }
    });
  }

  // ===== 点赞聚合：Worker /api/likes（KV 计数），失败退回纯本地 =====
  // GET 拉全部聚合数 → ♥ 旁显示真实次数；POST 在点亮时记账（服务端按
  // IP 哈希 24h 去重，重复点赞返回当前数不重复计）。接口不可用就没有数字，
  // 红心行为照旧。
  let likeCounts: Record<string, number> | null = null;

  function updateLikeCount(btn: HTMLButtonElement) {
    const id = btn.dataset.like ?? "";
    if (!id) return;
    const n = likeCounts?.[id] ?? 0;
    let span = btn.querySelector<HTMLElement>(".tl-like__count");
    if (!span) {
      span = document.createElement("span");
      span.className = "tl-like__count";
      btn.appendChild(span);
    }
    if (n > 0) {
      span.textContent = String(n);
      span.hidden = false;
    } else {
      span.hidden = true;
    }
  }

  function fetchLikeCounts() {
    fetch("/api/likes")
      .then((r) => (r.ok ? r.json() : null))
      .then(
        (
          data: { ok?: boolean; likes?: Record<string, number> } | null
        ) => {
          if (!data?.likes) return;
          likeCounts = data.likes;
          document
            .querySelectorAll<HTMLButtonElement>(".tl-like")
            .forEach(updateLikeCount);
        }
      )
      .catch(() => {
        /* 聚合不可用：退回纯本地点赞 */
      });
  }

  function postLike(id: string, btn: HTMLButtonElement) {
    fetch("/api/likes", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ id }),
    })
      .then((r) => (r.ok ? r.json() : null))
      .then((data: { ok?: boolean; count?: number } | null) => {
        if (!data || typeof data.count !== "number") return;
        likeCounts = likeCounts ?? {};
        likeCounts[id] = data.count;
        updateLikeCount(btn);
      })
      .catch(() => {
        /* 记账失败：红心照旧，下次点赞会重试 */
      });
  }

  function tlLikeClick(e: MouseEvent) {
    const btn = (e.target as HTMLElement | null)?.closest?.(
      ".tl-like"
    ) as HTMLButtonElement | null;
    if (!btn || !btn.dataset.like) return;
    const liked = btn.getAttribute("aria-pressed") === "true";
    btn.setAttribute("aria-pressed", liked ? "false" : "true");
    if (!liked && !TL_REDUCED) {
      btn.classList.remove("is-pop");
      void btn.offsetWidth;
      btn.classList.add("is-pop");
    }
    const likes = loadLikes();
    if (liked) delete likes[btn.dataset.like];
    else {
      likes[btn.dataset.like] = 1;
      postLike(btn.dataset.like, btn);
    }
    try {
      localStorage.setItem(LIKE_STORAGE_KEY, JSON.stringify(likes));
    } catch {
      /* 隐私模式等存不进就当次会话有效 */
    }
  }

  // 目录导航：轴点 → 对应条目（点击 push hash，键盘/历史恢复只 replace）
  function tlGo(point: HTMLElement, push: boolean) {
    const article = document.getElementById(point.dataset.anchor ?? "");
    if (!article) return;
    const idx = Number(point.dataset.index ?? "-1");
    if (idx >= 0) {
      TL.active = idx;
      tlSetActive(idx);
    }
    tlSetHash(point.dataset.anchor ?? "", push);
    tlRevealPoint(point);
    tlBeginNav();
    tlScrollToEntry(article);
  }

  // ===== 长文入口卡：首访带 BGM 时弹窗提示、强制停留 2s 后再进入详情页 =====
  const BGM_HINT_KEY = "snark_bgm_hint_shown";

  function tlLongCardClick(e: MouseEvent) {
    const head = (e.target as HTMLElement | null)?.closest?.(
      ".tl-long-head"
    ) as HTMLAnchorElement | null;
    if (!head || head.dataset.bgm !== "1") return;
    if (localStorage.getItem(BGM_HINT_KEY)) return; // 只提示一次，之后直接跳
    e.preventDefault();
    const modal = document.getElementById("tl-bgm-modal");
    if (!modal) return;
    modal.querySelector("[data-bgm-title]").textContent =
      head.dataset.bgmTitle || "";
    modal.hidden = false;
    window.setTimeout(() => {
      localStorage.setItem(BGM_HINT_KEY, "1");
      modal.hidden = true;
      // 二次点击：flag 已置，拦截处理器放行，交由 Astro 路由接管跳转
      // （astro:transitions 的 navigate 在打包脚本里不可靠，实测静默失败）
      if (head.isConnected) head.click();
      else window.location.assign(head.getAttribute("href")!);
    }, 2000);
  }

  function tlClick(e: MouseEvent) {
    const point = (e.target as HTMLElement | null)?.closest?.(
      ".timeline-point"
    ) as HTMLElement | null;
    if (point) tlGo(point, true);
  }

  function tlKeydown(e: KeyboardEvent) {
    const target = e.target as HTMLElement | null;
    const point = target?.closest?.(".timeline-point") as HTMLElement | null;
    if (!point) return;
    const pts = tlPoints();
    const idx = Number(point.dataset.index ?? "-1");

    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      tlGo(point, true);
      return;
    }

    let next: number | null = null;
    if (e.key === "ArrowDown" || e.key === "ArrowRight")
      next = Math.min(pts.length - 1, idx + 1);
    else if (e.key === "ArrowUp" || e.key === "ArrowLeft")
      next = Math.max(0, idx - 1);
    else if (e.key === "Home") next = 0;
    else if (e.key === "End") next = pts.length - 1;
    if (next === null) return;

    e.preventDefault();
    pts[next]?.focus();
    if (pts[next]) tlGo(pts[next], false);
  }

  function tlHistory() {
    const entries = tlEntries();
    if (entries.length === 0) return;
    const hash = tlHash();
    // 后退到没有 hash 的初始状态：回到最新一条（页面顶部）
    if (!hash) {
      if (TL.active !== 0) {
        TL.active = 0;
        tlSetActive(0);
      }
      window.scrollTo({ top: 0, behavior: TL_REDUCED ? "auto" : "smooth" });
      return;
    }
    const target = entries.find((el) => el.id === hash);
    if (!target) return;
    const idx = entries.indexOf(target);
    if (idx !== TL.active) {
      TL.active = idx;
      tlSetActive(idx);
      tlRevealPoint(tlPoints()[idx]);
    }
    tlScrollToEntry(target);
  }

  function tlInit() {
    TL.active = null;
    const entries = tlEntries();
    if (entries.length === 0) return;
    tlRestoreLikes();
    tlBuildImageGrids();
    tlInitComments();
    const hash = tlHash();
    const target = hash ? entries.find((el) => el.id === hash) : undefined;
    if (target) {
      // 深链接进入：浏览器原生锚点滚动已落位，这里兜底一次并同步轴点高亮
      const idx = entries.indexOf(target);
      TL.active = idx;
      tlSetActive(idx);
      tlRevealPoint(tlPoints()[idx]);
      tlBeginNav();
      requestAnimationFrame(() => tlScrollToEntry(target));
      window.setTimeout(() => tlScrollToEntry(target), 180);
      return;
    }
    // 无深链接：默认高亮最新一条（页面顶部）
    tlSpy();
  }

  // ===== 纪事内容解锁（AES-GCM，答案解密）=====
  // 构建期已把带 lock 的正文加密成密文（明文不进产物）；浏览器端用答案经
  // PBKDF2 派生密钥解密，成功后在当前会话记忆，无需重复输入。
  const PBKDF2_ITERATIONS = 120000;
  const LOCK_STORAGE_KEY = "snark_locked_entries";

  function b64ToBuf(b64: string): ArrayBuffer {
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes.buffer as ArrayBuffer;
  }

  // 解密后的 markdown 原文做最简渲染：按空行分段 → <p>，单换行 → <br>
  function renderPlainMd(text: string): string {
    const blocks = text.split(/\n{2,}/).map((b) => b.trim()).filter(Boolean);
    if (blocks.length === 0) return "";
    return blocks
      .map((b) => `<p>${b.replace(/\n/g, "<br>")}</p>`)
      .join("");
  }

  async function decryptBlock(box: HTMLElement, answer: string): Promise<string | null> {
    const ciphertext = box.dataset.ciphertext ?? "";
    const salt = box.dataset.salt ?? "";
    const iv = box.dataset.iv ?? "";
    if (!ciphertext || !salt || !iv) return null;
    try {
      const enc = new TextEncoder();
      const saltBuf = b64ToBuf(salt);
      const ivBuf = b64ToBuf(iv);
      // 密文 = [GCM tag(16B) | ciphertext]，整体作为 AES-GCM 的 ciphertext 传入
      const combined = b64ToBuf(ciphertext);

      const keyMaterial = await crypto.subtle.importKey(
        "raw",
        enc.encode(answer.normalize("NFC").trim()),
        "PBKDF2",
        false,
        ["deriveKey"]
      );
      const key = await crypto.subtle.deriveKey(
        { name: "PBKDF2", salt: saltBuf, iterations: PBKDF2_ITERATIONS, hash: "SHA-256" },
        keyMaterial,
        { name: "AES-GCM", length: 256 },
        false,
        ["decrypt"]
      );
      const plain = await crypto.subtle.decrypt(
        { name: "AES-GCM", iv: ivBuf, tagLength: 128 },
        key,
        combined
      );
      return new TextDecoder().decode(plain);
    } catch {
      return null;
    }
  }

  // 会话记忆：记录已解锁条目的 id → 明文
  function loadLocks(): Record<string, string> {
    try {
      return JSON.parse(sessionStorage.getItem(LOCK_STORAGE_KEY) || "{}");
    } catch {
      return {};
    }
  }
  function saveLock(id: string, plain: string) {
    const locks = loadLocks();
    locks[id] = plain;
    sessionStorage.setItem(LOCK_STORAGE_KEY, JSON.stringify(locks));
  }

  // 解锁成功：锁行高度收起 220ms。max-height 必须从「量出来的实际高度」收到 0，
  // 直接写 auto → 0 不会产生过渡，所以先钉住起始高度、强制 reflow 再改终点。
  function collapseLockRow(box: HTMLElement, reduced: boolean) {
    const parts = [
      box.querySelector<HTMLElement>(".lock-question"),
      box.querySelector<HTMLElement>(".lock-row"),
    ].filter((el): el is HTMLElement => Boolean(el));
    const drop = () => {
      parts.forEach((el) => el.remove());
      box
        .querySelectorAll<HTMLElement>(".lock-input, .lock-btn")
        .forEach((el) => el.remove());
    };
    if (reduced || parts.length === 0) {
      drop();
      return;
    }
    parts.forEach((el) => {
      el.style.maxHeight = `${el.getBoundingClientRect().height}px`;
      el.style.overflow = "hidden";
    });
    void box.offsetHeight; // 强制 reflow：让起始高度生效后再改终点
    parts.forEach((el) => {
      el.style.transition =
        "max-height 220ms var(--ease-ed), opacity 160ms ease, margin-bottom 220ms var(--ease-ed)";
      el.style.maxHeight = "0px";
      el.style.opacity = "0";
      el.style.marginBottom = "0px";
    });
    window.setTimeout(drop, 240);
  }

  function fillLocked(box: HTMLElement, plain: string, animate = true) {
    const contentEl = box.querySelector<HTMLElement>(".lock-content");
    if (!contentEl) return;
    contentEl.innerHTML = renderPlainMd(plain);
    contentEl.hidden = false;
    const err = box.querySelector<HTMLElement>(".lock-error");
    if (err) {
      err.hidden = true;
      err.classList.remove("is-shown");
    }
    box.dataset.unlocked = "1";
    if (animate) {
      // 正文透明揭示（reduced-motion 下 CSS 降级为纯淡入）
      contentEl.classList.add("is-reveal");
      collapseLockRow(box, TL_REDUCED);
      // 边框闪一次砖红（CSS ::after 只动 opacity）
      box.classList.add("is-unlocked");
    } else {
      // 会话记忆恢复 / 首屏直出：不做揭示动画，直接落到终态
      contentEl.classList.remove("is-reveal");
      collapseLockRow(box, true);
      box.classList.remove("is-unlocked");
    }

    // 解锁成功后才放出本条纪事的 BGM：MiniPlayer 带 gated 标记时先隐藏、不自动播放，
    // 由这里显式启动（会话记忆恢复也走同一条路径）。
    const holder = box.closest("article") ?? box.parentElement;
    const player = holder?.querySelector("mini-player") as
      | (HTMLElement & { unlockPlay?: () => void })
      | null;
    player?.unlockPlay?.();
  }

  async function tryUnlock(box: HTMLElement) {
    // 已解锁 / 正在解密：忽略重复提交（PBKDF2 120k 有 100–300ms 空窗）
    if (box.dataset.unlocked === "1" || box.dataset.pending === "1") {
      return;
    }
    const id = box.dataset.lockId ?? "";
    const input = box.querySelector<HTMLInputElement>(".lock-input");
    const answer = input?.value ?? "";
    if (!answer) return;
    // 若已记忆则直接展示
    const memo = loadLocks();
    if (id && memo[id]) {
      fillLocked(box, memo[id]);
      return;
    }

    // pending：按钮禁用 + 文案「解锁中…」，min-width 保证宽度不抖
    const btn = box.querySelector<HTMLButtonElement>(".lock-btn");
    const err = box.querySelector<HTMLElement>(".lock-error");
    box.dataset.pending = "1";
    if (btn) {
      if (!btn.dataset.label) btn.dataset.label = btn.textContent ?? "解锁";
      btn.disabled = true;
      btn.textContent = "解锁中…";
    }
    if (input) input.readOnly = true;

    const plain = await decryptBlock(box, answer);

    delete box.dataset.pending;
    // 解密期间可能已换页 / 被解锁（元素脱离文档），先确认还在
    if (btn?.isConnected) {
      btn.disabled = false;
      btn.textContent = btn.dataset.label ?? "解锁";
    }
    if (input?.isConnected) input.readOnly = false;

    if (plain !== null) {
      if (id) saveLock(id, plain);
      fillLocked(box, plain);
    } else {
      if (err) {
        err.hidden = false;
        void err.offsetWidth; // 先让 display:block 生效（opacity 仍是 0），再淡入
        err.classList.add("is-shown");
      }
      // 输入框轻抖一次；reduced-motion 只保留错误文案淡入
      if (input && !TL_REDUCED) {
        input.classList.remove("is-shake");
        void input.offsetWidth;
        input.classList.add("is-shake");
      }
    }
  }

  // 事件委托：任意条目的 lock-box 都能触发解锁；Enter 提交
  function tlLockClick(e: MouseEvent) {
    const btn = (e.target as HTMLElement | null)?.closest?.(".lock-btn");
    if (!btn) return;
    e.preventDefault();
    const box = btn.closest<HTMLElement>(".lock-box");
    if (box) void tryUnlock(box);
  }
  function tlLockKeydown(e: KeyboardEvent) {
    if (e.key !== "Enter") return;
    const target = e.target as HTMLElement | null;
    if (!target?.classList?.contains("lock-input")) return;
    e.preventDefault();
    const box = target.closest<HTMLElement>(".lock-box");
    if (box) void tryUnlock(box);
  }

  // 初始加载：把已记忆的加密条目直接呈现（若页面含其 lock-box）
  document.querySelectorAll<HTMLElement>(".lock-box").forEach((box) => {
    const id = box.dataset.lockId ?? "";
    const locks = loadLocks();
    if (id && locks[id]) fillLocked(box, locks[id], false);
  });

  // ===== 条目评论：每条一个 giscus 讨论串（specific 映射，term=条目锚点）=====
  // 「有没有评论」用免鉴权 GitHub Discussions REST 探测（60 次/小时/IP，
  // sessionStorage 缓存 10 分钟）：有评论的条目直接展开，没有的点互动行按钮
  // 才注入 giscus（沿用全站「不点不请求 giscus.app」的首屏策略）。
  // 探测失败（限流/离线）则降级为全部「点按钮才加载」。
  const COMMENTS_CACHE_KEY = "snark_giscus_counts";
  const COMMENTS_CACHE_MS = 10 * 60 * 1000;

  async function fetchCommentCounts(): Promise<Record<string, number> | null> {
    try {
      const raw = sessionStorage.getItem(COMMENTS_CACHE_KEY);
      if (raw) {
        const cached = JSON.parse(raw) as { t?: number; d?: Record<string, number> };
        if (cached?.t && Date.now() - cached.t < COMMENTS_CACHE_MS && cached.d) {
          return cached.d;
        }
      }
    } catch {
      /* 缓存读不到就走网络 */
    }
    try {
      const res = await fetch(
        `https://api.github.com/repos/${GISCUS_REPO}/discussions?per_page=100`,
        { headers: { Accept: "application/vnd.github+json" } }
      );
      if (!res.ok) return null;
      const list = (await res.json()) as { title?: unknown; comments?: unknown }[];
      if (!Array.isArray(list)) return null;
      const counts: Record<string, number> = {};
      for (const d of list) {
        // giscus 的 specific 映射创建的讨论串，标题就是 term（条目锚点）
        if (typeof d.title === "string" && typeof d.comments === "number") {
          counts[d.title] = d.comments;
        }
      }
      try {
        sessionStorage.setItem(
          COMMENTS_CACHE_KEY,
          JSON.stringify({ t: Date.now(), d: counts })
        );
      } catch {
        /* 隐私模式存不进就每次现拉 */
      }
      return counts;
    } catch {
      return null;
    }
  }

  function loadEntryGiscus(container: HTMLElement) {
    if (container.dataset.loaded === "1") return;
    container.dataset.loaded = "1";
    // 主题走同源 endpoint /giscus-theme.css（与文章页评论同一套皮肤）
    const themeUrl = new URL("/giscus-theme.css", location.origin).href;
    const script = document.createElement("script");
    script.async = true;
    script.crossOrigin = "anonymous";
    const attrs: Record<string, string> = {
      "data-repo": GISCUS_REPO,
      "data-repo-id": GISCUS_REPO_ID,
      "data-category": GISCUS_CATEGORY,
      "data-category-id": GISCUS_CATEGORY_ID,
      "data-mapping": "specific",
      "data-term": container.dataset.term ?? "",
      "data-strict": "0",
      "data-reactions-enabled": "0",
      "data-emit-metadata": "0",
      "data-input-position": "bottom",
      "data-lang": "zh-CN",
      "data-loading": "lazy",
    };
    for (const [k, v] of Object.entries(attrs)) script.setAttribute(k, v);
    script.setAttribute("data-theme", themeUrl);
    script.src = "https://giscus.app/client.js";
    container.appendChild(script);
  }

  function showEntryComments(anchor: string, expand: boolean) {
    const container = document.getElementById(`tl-comments-${anchor}`);
    const btn = document.querySelector<HTMLButtonElement>(
      `.tl-comment[data-comment="${CSS.escape(anchor)}"]`
    );
    if (!container) return;
    container.hidden = !expand;
    if (expand) loadEntryGiscus(container);
    btn?.setAttribute("aria-expanded", expand ? "true" : "false");
  }

  function tlCommentClick(e: MouseEvent) {
    const btn = (e.target as HTMLElement | null)?.closest?.(
      ".tl-comment"
    ) as HTMLButtonElement | null;
    if (!btn?.dataset.comment) return;
    showEntryComments(
      btn.dataset.comment,
      btn.getAttribute("aria-expanded") !== "true"
    );
  }

  // 空闲 1.5s 后再探测评论数 / 拉取点赞聚合（不与首屏资源抢路）；
  // giscus 注入只发生在需要时
  function tlInitComments() {
    window.setTimeout(async () => {
      fetchLikeCounts();
      const counts = await fetchCommentCounts();
      if (!counts) return;
      document.querySelectorAll<HTMLElement>(".tl-comments").forEach((c) => {
        const term = c.dataset.term ?? "";
        if (term && (counts[term] ?? 0) > 0) showEntryComments(term, true);
      });
    }, 1500);
  }

  // ===== 九宫格：条目内连续图片重排为方格缩略图（点击走全站 lightbox）=====
  // 朋友圈式排版：同一 <p> 或相邻 <p> 的图片归为一组；1 图占 2/3 宽，
  // 2~3 图一行三列，4 图两行两列，5 图起一行三列。散落的单图保持原位不动。
  function tlBuildImageGrids() {
    document.querySelectorAll<HTMLElement>(".tl-entry .prose").forEach((prose) => {
      if (prose.dataset.gridDone === "1") return;
      prose.dataset.gridDone = "1";

      const isImgNode = (n: Node): n is HTMLImageElement =>
        n.nodeType === 1 && (n as HTMLElement).tagName === "IMG";
      // <p> 仅含一张图（其余是空白）→ 以 <p> 为组员；否则以 img 自身为组员
      const groupAnchor = (n: Node): Node | null => {
        if (isImgNode(n)) return n;
        if (n.nodeType !== 1) return null;
        const el = n as HTMLElement;
        if (el.tagName !== "P") return null;
        const children = Array.from(el.childNodes).filter(
          (c) => !(c.nodeType === 3 && !c.textContent?.trim())
        );
        return children.length === 1 && isImgNode(children[0]) ? el : null;
      };

      // 扫描子节点：连续的图片组员归为一组，中间遇到其他内容即断组
      type Group = { start: ChildNode; members: Node[]; imgs: HTMLImageElement[] };
      const groups: Group[] = [];
      let cur: Group | null = null;
      for (const child of Array.from(prose.childNodes)) {
        if (child.nodeType === 3 && !child.textContent?.trim()) continue; // 空白不断组
        const anchor = groupAnchor(child);
        if (anchor) {
          if (!cur) cur = { start: child, members: [], imgs: [] };
          cur.members.push(child);
          if (isImgNode(anchor)) cur.imgs.push(anchor);
          else anchor.childNodes.forEach((c) => isImgNode(c) && cur!.imgs.push(c));
        } else if (cur) {
          groups.push(cur);
          cur = null;
        }
      }
      if (cur) groups.push(cur);
      if (!groups.length) return;

      for (const g of groups) {
        if (g.imgs.length === 0) continue;
        const cols = g.imgs.length === 1 ? 1 : g.imgs.length === 4 ? 4 : 3;
        const grid = document.createElement("div");
        grid.className = "tl-grid";
        grid.dataset.cols = String(cols);
        g.start.parentElement!.insertBefore(grid, g.start);
        for (const img of g.imgs) {
          const cell = document.createElement("span");
          cell.className = "tl-cell";
          grid.appendChild(cell);
          cell.appendChild(img); // img 从 <p> 原位挪进方格
        }
        // 组员节点内容已搬空：删掉残留的空 <p>
        g.members.forEach((m) => {
          const el = m as HTMLElement;
          if (el.tagName === "P" && !el.textContent?.trim() && !el.querySelector("img")) {
            el.remove();
          }
        });
      }
    });
  }

  // ===== 一次性绑定（换页不重复绑），每次 page-load 重新初始化状态 =====
  if (!TL.bound) {
    TL.bound = true;
    // 捕获阶段：必须先于 Astro 路由的 bubble 监听 preventDefault，
    // 否则真实用户的点击会被 VT 先行导航、弹窗来不及出现
    document.addEventListener("click", tlLongCardClick, true);
    document.addEventListener("click", tlClick);
    document.addEventListener("keydown", tlKeydown);
    document.addEventListener("click", tlLikeClick);
    document.addEventListener("click", tlCommentClick);
    document.addEventListener("click", tlLockClick);
    document.addEventListener("keydown", tlLockKeydown);
    window.addEventListener("popstate", tlHistory);
    window.addEventListener("hashchange", tlHistory);
    window.addEventListener("scroll", tlOnScroll, { passive: true });
    document.addEventListener("astro:page-load", tlInit);
    document.addEventListener("astro:before-swap", () => {
      TL.active = null;
    });
  }
  tlInit();
</script>
