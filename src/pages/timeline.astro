---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import MiniPlayer from "../components/MiniPlayer.astro";
import GraphView from "../components/GraphView.astro";
import { buildGraphData } from "../utils/graphData";

const [allMoments, allPosts] = await Promise.all([
  getCollection("moments"),
  getCollection("posts"),
]);

const publishedMoments = allMoments
  .filter((m) => !m.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

type RenderedContent = Awaited<
  ReturnType<CollectionEntry<"posts">["render"]>
>["Content"];

// 所有内容统一预渲染全文（posts + moments）
interface RenderedAll {
  id: string;
  kind: "post" | "person" | "event";
  entry: CollectionEntry<"posts"> | CollectionEntry<"moments">;
  Content: RenderedContent;
}

const renderedAll = await Promise.all([
  ...publishedMoments.map(async (m) => ({
    id: m.id,
    kind: m.data.type as "person" | "event",
    entry: m,
    Content: (await m.render()).Content,
  })),
]);

const contentIndex = new Map(renderedAll.map((c, i) => [c.id, i]));

// Unify both collections into one timeline, newest first
interface TimelineEntry {
  date: Date;
  kind: "post" | "person" | "event";
  title: string;
  excerpt: string;
  url: string;
  contentIndex: number; // index into renderedAll
}

const entries: TimelineEntry[] = [
  ...publishedMoments.map((m) => ({
    date: m.data.date,
    kind: m.data.type as "person" | "event",
    title: m.data.title,
    excerpt: m.data.excerpt,
    url: "",
    contentIndex: contentIndex.get(m.id)!,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const formatDate = (d: Date, opts: Intl.DateTimeFormatOptions) =>
  d.toLocaleDateString("zh-CN", opts);

// Index of the first non-post entry, shown by default (posts navigate away)
const defaultIndex = entries.findIndex((e) => e.kind !== "post");
const defaultRendered =
  defaultIndex >= 0 ? renderedAll[entries[defaultIndex].contentIndex] : null;

// 关系图谱（posts + moments 全节点）
const graphData = buildGraphData(allPosts, allMoments);
const graphNodes = graphData.nodes;
const graphLinks = graphData.links;
---

<BaseLayout title="纪事">
  <div class="mx-auto max-w-[1380px] px-6 md:px-8">
    <section class="pt-10 md:pt-16">
      <h1
        class="font-serif text-3xl md:text-4xl tracking-tighter text-[var(--color-ed-fg)] mb-14"
      >
        纪事
      </h1>

      {entries.length > 0 ? (
        <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_320px] items-start">
          <!-- 左侧：选中的节点正文 -->
          <div
            id="timeline-detail"
            class="min-h-40"
            aria-live="polite"
            data-default-index={defaultIndex}
          >
            {defaultRendered && (
              <article class="border-t border-[var(--color-ed-faint)] pt-8 pb-4">
                <h2 class="font-serif text-2xl text-[var(--color-ed-fg)]">
                  {defaultRendered.entry.data.title}
                </h2>
                <p class="mt-2 text-xs text-[var(--color-ed-subtle)] tabular-nums">
                  {formatDate(defaultRendered.entry.data.date, {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </p>
                {defaultRendered.kind === "post" && (
                  <a
                    href={`/blog/${defaultRendered.id.replace(/\.mdx$/, "")}`}
                    class="mt-2 inline-block text-xs text-[var(--color-ed-fg)] hover-underline"
                  >
                    阅读全文
                  </a>
                )}
                {defaultRendered.kind === "person" && (
                  <span class="mt-3 inline-block border border-[var(--color-ed-faint)] px-2 py-0.5 text-[10px] tracking-[0.05em] text-[var(--color-ed-muted)]">
                    人物
                  </span>
                )}
                {defaultRendered.kind === "event" && (
                  <span class="mt-3 inline-block border border-[var(--color-ed-faint)] px-2 py-0.5 text-[10px] tracking-[0.05em] text-[var(--color-ed-muted)]">
                    事件
                  </span>
                )}
                {defaultRendered.kind !== "post" &&
                  defaultRendered.entry.data.bgm?.src && (
                    <div class="mt-4">
                      <MiniPlayer
                        src={defaultRendered.entry.data.bgm.src}
                        title={defaultRendered.entry.data.bgm.title}
                      />
                    </div>
                  )}
                <div class="prose mt-6">
                  <defaultRendered.Content />
                </div>
              </article>
            )}
          </div>

          <!-- 右侧固定栏：简约时间轴 + 关系图谱（时间轴正下方） -->
          <aside id="view-timeline" class="md:sticky md:top-24 min-w-0">
            <div class="tl-title-row mb-1">纪事轴</div>
            <ol class="tl-simple">
              {entries.map((entry, i) => {
                const label =
                  entry.kind === "person"
                    ? "人物"
                    : entry.kind === "post"
                      ? "文章"
                      : "事件";
                return (
                  <li
                    class="timeline-point group"
                    data-kind={entry.kind}
                    data-index={i}
                    data-url={entry.url}
                    data-content-index={entry.contentIndex}
                    role="button"
                    tabindex="0"
                    aria-expanded="false"
                  >
                    <span class="tl-simple__dot" aria-hidden="true"></span>
                    <span class="tl-simple__body">
                      <time class="tl-simple__date" datetime={entry.date.toISOString()}>
                        {formatDate(entry.date, { year: "numeric", month: "short" })}
                      </time>
                      <span class="tl-title block font-serif text-sm leading-snug text-[var(--color-ed-fg)] transition-colors duration-300 group-hover:text-[var(--color-ed-accent)]">
                        {entry.title}
                      </span>
                      <span class="tl-simple__label">{label}</span>
                    </span>
                  </li>
                );
              })}
            </ol>

            <!-- 关系图谱（时间轴正下方） -->
            {graphNodes.length > 1 && (
              <div class="mt-10 border-t border-[var(--color-ed-faint)] pt-6">
                <div class="tl-title-row mb-4">关系图谱</div>
                <GraphView nodes={graphNodes} links={graphLinks} />
                <ul class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[10px] text-[var(--color-ed-muted)]">
                  <li class="flex items-center gap-1.5">
                    <span class="inline-block h-2 w-2 rounded-full" style="background:var(--color-ed-fg)"></span>
                    我 / 文章
                  </li>
                  <li class="flex items-center gap-1.5">
                    <span class="inline-block h-2 w-2 rounded-full border" style="border-color:var(--color-ed-muted)"></span>
                    人物
                  </li>
                  <li class="flex items-center gap-1.5">
                    <span class="inline-block h-2 w-1.5 rotate-45" style="background:var(--color-ed-muted)"></span>
                    事件
                  </li>
                </ul>
              </div>
            )}
          </aside>
        </div>
      ) : (
        <p class="text-[var(--color-ed-muted)]">暂无内容。</p>
      )}
    </section>

    <!-- Hidden full-text contents (posts + moments), shared by both views -->
    <template id="content-templates">
      {
        renderedAll.map((c, idx) => (
          <div class="content-body" data-content-index={idx}>
            <article class="border-t border-[var(--color-ed-faint)] pt-8 pb-4">
              <h2 class="font-serif text-2xl text-[var(--color-ed-fg)]">
                {c.entry.data.title}
              </h2>
              <p class="mt-2 text-xs text-[var(--color-ed-subtle)] tabular-nums">
                {formatDate(c.entry.data.date, {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              {c.kind === "post" && (
                <a
                  href={`/blog/${c.id.replace(/\.mdx$/, "")}`}
                  class="mt-2 inline-block text-xs text-[var(--color-ed-fg)] hover-underline"
                >
                  阅读全文
                </a>
              )}
              {c.kind === "person" && (
                <span class="mt-3 inline-block border border-[var(--color-ed-faint)] px-2 py-0.5 text-[10px] tracking-[0.05em] text-[var(--color-ed-muted)]">
                  人物
                </span>
              )}
              {c.kind === "event" && (
                <span class="mt-3 inline-block border border-[var(--color-ed-faint)] px-2 py-0.5 text-[10px] tracking-[0.05em] text-[var(--color-ed-muted)]">
                  事件
                </span>
              )}
              {c.kind !== "post" && c.entry.data.bgm?.src && (
                <div class="mt-4">
                  <MiniPlayer
                    src={c.entry.data.bgm.src}
                    title={c.entry.data.bgm.title}
                  />
                </div>
              )}
              <div class="prose mt-6">
                <c.Content />
              </div>
            </article>
          </div>
        ))
      }
    </template>
  </div>
</BaseLayout>

<style>
  /* 右栏区块小标题（纪事轴 / 关系图谱） */
  .tl-title-row {
    font-size: 0.625rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-ed-subtle);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tl-title-row::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--color-ed-faint);
  }

  /* 简约时间轴：连续竖线 + 圆点 + 日期/标题 */
  .tl-simple {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* 贯穿竖线（用 ::before 画在左侧，穿过所有点的圆心） */
  .tl-simple::before {
    content: '';
    position: absolute;
    left: 3.5px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: rgba(28, 28, 28, 0.18);
  }
  .timeline-point {
    display: flex;
    gap: 0.875rem;
    padding: 0.625rem 0;
    cursor: pointer;
    border-radius: 4px;
    position: relative;
  }
  .timeline-point:hover {
    background: rgba(28, 28, 28, 0.03);
  }
  .tl-simple__dot {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    margin-top: 3px;
    border-radius: 50%;
    border: 1px solid var(--color-ed-muted);
    background: var(--color-ed-bg);
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .timeline-point:hover .tl-simple__dot {
    border-color: var(--color-ed-accent);
    transform: scale(1.25);
  }
  .timeline-point.is-active .tl-simple__dot {
    background: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
  }
  .tl-simple__body {
    flex: 1;
    min-width: 0;
    padding-bottom: 0.25rem;
  }
  .tl-simple__date {
    display: block;
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ed-subtle);
    letter-spacing: 0.06em;
  }
  .tl-simple__label {
    display: inline-block;
    margin-top: 0.125rem;
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    color: var(--color-ed-subtle);
    text-transform: uppercase;
  }
  .timeline-point.is-active .tl-title {
    color: var(--color-ed-accent);
  }
  .timeline-point:focus-visible {
    outline: 1px solid var(--color-ed-accent);
    outline-offset: 4px;
  }
</style>

<script>
  const points = Array.from(
    document.querySelectorAll<HTMLElement>(".timeline-point")
  );
  const detail = document.getElementById("timeline-detail");
  const template = document.getElementById(
    "content-templates"
  ) as HTMLTemplateElement | null;
  if (!detail || !template) throw new Error("timeline elements missing");

  const contentBodies = Array.from(
    template.content.querySelectorAll<HTMLElement>(".content-body")
  );

  let activeIndex: number | null = null;

  // First entry (non-post) is shown server-side; keep its point highlighted
  const initialIndex = Number(detail.dataset.defaultIndex ?? "-1");
  if (initialIndex >= 0) {
    activeIndex = initialIndex;
    setActive(initialIndex);
  }

  function renderPlaceholder() {
    detail.innerHTML = "";
  }

  function setActive(i: number | null) {
    points.forEach((p, idx) => {
      const on = idx === i;
      p.setAttribute("aria-expanded", String(on));
      p.classList.toggle("is-active", on);
    });
  }

  function selectPoint(el: HTMLElement, index: number) {
    if (activeIndex === index) {
      activeIndex = null;
      setActive(null);
      renderPlaceholder();
      return;
    }
    activeIndex = index;
    setActive(index);

    window.dispatchEvent(new CustomEvent("timeline:select"));

    const kind = el.dataset.kind;
    if (kind === "post") {
      const url = el.dataset.url;
      if (url) window.location.href = url;
      return;
    }

    // moment: clone its pre-rendered body into the detail area
    const contentIdx = Number(el.dataset.contentIndex);
    const body = contentBodies.find(
      (b) => b.dataset.contentIndex === String(contentIdx)
    );
    if (body) {
      detail.innerHTML = "";
      detail.appendChild(body.cloneNode(true) as HTMLElement);
    }
  }

  points.forEach((el, i) => {
    el.addEventListener("click", () => selectPoint(el, i));
    el.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        selectPoint(el, i);
      }
    });
  });
</script>
