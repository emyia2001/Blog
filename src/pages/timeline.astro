---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import MiniPlayer from "../components/MiniPlayer.astro";
import { encryptContent } from "../utils/lockContent";

// 纪事（moments）：person / event / diary 连续信息流，全部服务端直出。
// 右侧时间轴是目录（scroll-spy 高亮当前位置，点击滚动到对应条目）。
const allMoments = await getCollection("moments");

const publishedMoments = allMoments
  .filter((m) => !m.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

type RenderedContent = Awaited<
  ReturnType<CollectionEntry<"posts">["render"]>
>["Content"];

type Kind = "person" | "event" | "diary";

const KIND_LABEL: Record<Kind, string> = {
  person: "人物",
  event: "事件",
  diary: "日记",
};

// 日记不用标题（碎碎念）：轴点显示正文首行截断，替代「每条都叫日记」的重复兜底
const diaryTeaser = (body: string | undefined) => {
  const firstLine = (body ?? "")
    .split("\n")
    .map((s) => s.replace(/[#>*`[\]!]|^- /g, "").trim())
    .find(Boolean);
  if (!firstLine) return "";
  return firstLine.length > 22 ? `${firstLine.slice(0, 22)}…` : firstLine;
};

// 所有内容统一预渲染全文；带 lock 的文章构建期加密正文，浏览器端用答案解密
interface FeedItem {
  id: string;
  /** 深链接锚点：由内容 id 去掉扩展名（稳定、可分享） */
  anchor: string;
  kind: Kind;
  entry: CollectionEntry<"moments">;
  Content?: RenderedContent; // 未加密才有明文 Content
  lock?: {
    question: string;
    ciphertext: string;
    salt: string;
    iv: string;
  };
}

const feed: FeedItem[] = await Promise.all(
  publishedMoments.map(async (m) => {
    const base = {
      id: m.id,
      anchor: m.id.replace(/\.mdx?$/, ""),
      kind: m.data.type as Kind,
      entry: m,
    };
    if (m.data.lock?.answer) {
      // 加密正文（构建期）；明文不进产物
      const enc = encryptContent(String(m.body ?? ""), m.data.lock.answer);
      return {
        ...base,
        lock: {
          question: m.data.lock.question,
          ciphertext: enc.ciphertext,
          salt: enc.salt,
          iv: enc.iv,
        },
      };
    }
    return { ...base, Content: (await m.render()).Content };
  })
);

interface RailEntry {
  anchor: string;
  date: Date;
  kind: Kind;
  title: string;
  /** 日记无标题时的正文首行截断（碎碎念）；person/event 恒为空 */
  teaser: string;
  label: string; // 轴点小标签：人物 / 事件 / 日记
  locked: boolean;
  hasBgm: boolean;
  /** 只在年份切换（或第一条）时显示年份，避免每行重复 */
  showYear: boolean;
}

// 时间轴目录条目：publishedMoments 已排序，与 feed 同序一一对应
const railEntries: RailEntry[] = publishedMoments.map((m) => ({
  anchor: m.id.replace(/\.mdx?$/, ""),
  date: m.data.date,
  kind: m.data.type as Kind,
  title: m.data.title ?? "",
  teaser: m.data.type === "diary" ? diaryTeaser(m.body) : "",
  label: KIND_LABEL[m.data.type as Kind],
  locked: Boolean(m.data.lock?.answer),
  hasBgm: Boolean(m.data.bgm?.src),
  showYear: false,
}));

// 年份分组：降序排列时，第一条和每次跨年才标出年份
railEntries.forEach((entry, i) => {
  entry.showYear =
    i === 0 || entry.date.getFullYear() !== railEntries[i - 1].date.getFullYear();
});

const fmtLong = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
    weekday: "short",
  });

// 轴点日期：08.20（年份只在跨年时前缀显示，见上面的 showYear）
const fmtPoint = (d: Date) =>
  `${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
---

<BaseLayout title="纪事" description="纪事：人物、事件与日常碎念，按时间从近到远连续排列。">
  <div class="page-shell">
    <section>
      <header class="page-head">
        <div class="page-head__row">
          <h1 class="page-head__title">纪事</h1>
        </div>
      </header>

      {railEntries.length > 0 ? (
        <div class="timeline-layout">
          <!-- 时间轴：手机端在正文上方横向滑动，桌面端是右侧竖轴 -->
          <aside id="view-timeline" class="timeline-rail" aria-label="纪事时间线">
            <div class="tl-title-row">时间线</div>
            <ol class="tl-simple">
              {railEntries.map((entry, i) => (
                <li
                  id={entry.anchor}
                  class="timeline-point group"
                  data-kind={entry.kind}
                  data-index={i}
                  data-anchor={entry.anchor}
                  role="button"
                  tabindex="0"
                  aria-current={i === 0 ? "true" : undefined}
                  aria-controls={entry.anchor}
                  style={`--tl-i: ${i}`}
                >
                  {/* 段竖线：独立于可缩放内容，入场时逐段生长、悬停时本段高亮 */}
                  <span class="tl-seg" aria-hidden="true"></span>
                  {/* 圆点：圆心钉在竖线上，dock 放大时不随文字缩放，始终骑线 */}
                  <span class="tl-simple__dot" aria-hidden="true"></span>
                  <span class="tl-simple__body">
                    <time class="tl-simple__date" datetime={entry.date.toISOString()}>
                      {entry.showYear && (
                        <span class="tl-simple__year">{entry.date.getFullYear()}</span>
                      )}
                      {fmtPoint(entry.date)}
                    </time>
                    <span class="tl-title block font-serif text-sm leading-snug text-[var(--color-ed-fg)] transition-colors duration-300 group-hover:text-[var(--color-ed-accent)]">
                      {entry.title || entry.teaser || "日记"}
                    </span>
                    <span class="tl-simple__meta">
                      <span class="tl-simple__label">{entry.label}</span>
                      {entry.locked && (
                        <span class="tl-mark" title="需要答案解锁">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="4" y="10" width="16" height="10" rx="2"></rect>
                            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                          </svg>
                          <span class="sr-only">需要答案解锁</span>
                        </span>
                      )}
                      {entry.hasBgm && (
                        <span class="tl-mark" title="含背景音乐">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 18V5l11-2v13"></path>
                            <circle cx="6" cy="18" r="3"></circle>
                            <circle cx="17" cy="16" r="3"></circle>
                          </svg>
                          <span class="sr-only">含背景音乐</span>
                        </span>
                      )}
                    </span>
                  </span>
                </li>
              ))}
            </ol>
          </aside>

          <!-- 连续信息流：全部条目服务端直出，日记是无标题的碎碎念（占位更紧）。
               data-pagefind-body 让搜索只索引这个区域；日记按约定不进索引，
               加锁条目只有谜面与密文，也一并跳过。 -->
          <div id="timeline-feed" class="timeline-feed" data-pagefind-body>
            {feed.map((c, i) => (
              <>
                {railEntries[i].showYear && (
                  <div class="tl-year" aria-hidden="true">
                    {railEntries[i].date.getFullYear()}
                  </div>
                )}
                <article
                  id={c.anchor}
                  class:list={[
                    "tl-entry",
                    "reveal",
                    c.kind === "diary" && "tl-entry--diary",
                  ]}
                  data-pagefind-ignore={c.kind === "diary" ? "true" : undefined}
                >
                  <div class="tl-entry__meta">
                    <time class="tl-entry__date" datetime={c.entry.data.date.toISOString()}>
                      {fmtLong(c.entry.data.date)}
                    </time>
                    <span class="tl-entry__kind">{railEntries[i].label}</span>
                  </div>
                  {c.kind !== "diary" && (
                    <h2 class="tl-entry__title">
                      {c.entry.data.title ?? fmtLong(c.entry.data.date)}
                    </h2>
                  )}
                  {/* 引文行：person/event 的 excerpt 作为刊物式 lead，永远可见 */}
                  {c.kind !== "diary" && c.entry.data.excerpt && (
                    <p class="tl-entry__lead">{c.entry.data.excerpt}</p>
                  )}
                  {c.entry.data.bgm?.src && (
                    <div class="mt-4">
                      <MiniPlayer
                        src={c.entry.data.bgm.src}
                        title={c.entry.data.bgm.title}
                        gated={Boolean(c.lock)}
                        inline
                      />
                    </div>
                  )}
                  {c.lock ? (
                    <div
                      class="lock-box mt-6"
                      data-lock-id={c.id}
                      data-ciphertext={c.lock.ciphertext}
                      data-salt={c.lock.salt}
                      data-iv={c.lock.iv}
                      data-pagefind-ignore="true"
                    >
                      <p class="lock-question">{c.lock.question}</p>
                      <div class="lock-row">
                        <input
                          type="text"
                          class="lock-input"
                          placeholder="输入答案解锁"
                          autocomplete="off"
                          aria-label="答案"
                        />
                        <button type="button" class="lock-btn">解锁</button>
                      </div>
                      <p class="lock-error" hidden>答案不对，再试试。</p>
                      <div class="lock-content prose mt-4" hidden></div>
                    </div>
                  ) : (
                    c.Content && (
                      <div class="prose mt-6">
                        <c.Content />
                      </div>
                    )
                  )}
                </article>
              </>
            ))}
          </div>
        </div>
      ) : (
        <p class="text-[var(--color-ed-muted)]">暂无内容。</p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  /* 右栏区块小标题 */
  .tl-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ed-subtle);
  }
  .tl-title-row::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--color-ed-rule);
  }

  /* ================= 简约时间轴 =================
     结构：每 <li> 自带一段竖线 .tl-seg + 一个圆点 .tl-simple__dot。
     竖线分段 → 可逐段做入场生长与悬停高亮；圆点圆心钉在线上，dock 放大不脱线。 */
  .tl-simple {
    list-style: none;
    margin: 0;
    padding: 0 1.5rem 0 0.25rem; /* 右侧留余量：dock 放大时文字不被滚动条裁掉 */
    position: relative;
    height: 22rem;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
  }
  /* 时间线变量：线 X 坐标（1px 线，中心对齐）、dot 半径 */
  .tl-simple {
    --tl-line-x: 7.5px;
    --tl-dot-d: 9px;
  }
  .timeline-point {
    position: relative;
    display: flex;
    scroll-margin-top: 6rem;
    padding: 0.625rem 0 0.625rem 1.5rem; /* 左 padding 让位给线/点 */
    cursor: pointer;
    border-radius: 4px;
    /* 悬停/激活底色与边框（手机端卡片）都走同一条短过渡，避免硬切 */
    transition: background-color 160ms ease, border-color 160ms ease;
    /* 入场动画：整体淡入上移（delay 由 --tl-i 逐条错开） */
    opacity: 0;
    animation: tl-point-in 0.5s var(--ease-ed) forwards;
    animation-delay: calc(0.15s + min(var(--tl-i, 0), 7) * 0.04s);
  }
  @keyframes tl-point-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .timeline-point:hover {
    background: rgba(28, 28, 28, 0.03);
  }

  /* —— 每段竖线：默认透明，入场时逐段从顶生长；悬停/激活时本段点亮 —— */
  .tl-seg {
    position: absolute;
    left: calc(var(--tl-line-x) - 0.5px);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-ed-rule);
    transform: scaleY(0);
    transform-origin: top;
    animation: tl-seg-grow 0.5s var(--ease-ed) forwards;
    animation-delay: calc(0.15s + min(var(--tl-i, 0), 7) * 0.04s);
  }
  @keyframes tl-seg-grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* 极速换页：导航进入时点/线直接呈现，不做生长编排 */
  :global(html.nav-fast) .timeline-point {
    opacity: 1;
    animation: none;
    animation-delay: 0s;
  }
  :global(html.nav-fast) .tl-seg {
    animation: none;
    transform: none;
  }

  /* reduced-motion 下的时间轴入场：只淡不移（与上面 tl-point-in 配对） */
  @keyframes tl-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .timeline-point:hover .tl-seg {
    background: var(--color-ed-accent);
    opacity: 0.7;
  }
  .timeline-point.is-active .tl-seg {
    background: var(--color-ed-accent);
  }

  /* —— 圆点/方点：绝对定位，圆心精确钉在竖线上；放大以圆心为锚，不脱线 —— */
  .tl-simple__dot {
    position: absolute;
    left: calc(var(--tl-line-x) - var(--tl-dot-d) / 2);
    top: 0.9rem; /* 与首行文字（日期）大致齐平 */
    width: var(--tl-dot-d);
    height: var(--tl-dot-d);
    border-radius: 50%;
    border: 1px solid var(--color-ed-muted);
    background: var(--color-ed-bg);
    transform-origin: center;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
    pointer-events: none;
  }
  /* 日记节点用小方点以示区分 */
  .timeline-point[data-kind="diary"] .tl-simple__dot {
    border-radius: 2px;
  }
  .timeline-point:hover .tl-simple__dot {
    border-color: var(--color-ed-accent);
  }
  /* 悬停位移收进 hover-gate：触屏不再粘滞缩放/位移；置于 .is-active 状态规则之前保持原优先级 */
  @media (hover: hover) and (pointer: fine) {
    .timeline-point:hover .tl-simple__dot {
      transform: scale(1.25);
    }
    .timeline-point:hover .tl-simple__body {
      transform: translateX(4px);
    }
  }
  .timeline-point.is-active .tl-simple__dot {
    background: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
    transform: scale(1.15);
  }

  /* —— 可 dock 缩放的主体：只放大文字区，线与点保持骑线不动 —— */
  .tl-simple__body {
    flex: 1;
    min-width: 0;
    padding-bottom: 0.25rem;
    transform-origin: left center;
    transition: transform 160ms var(--ease-ed);
  }
  .timeline-point.is-active .tl-simple__body {
    transform: translateX(4px);
  }
  .tl-simple__date {
    display: block;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ed-subtle);
    letter-spacing: 0.06em;
  }
  .tl-simple__meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.15rem;
  }
  .tl-simple__label {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--color-ed-subtle);
    text-transform: uppercase;
  }
  .tl-mark {
    display: inline-flex;
    align-items: center;
    color: var(--color-ed-subtle);
  }
  .tl-mark svg {
    width: 0.625rem;
    height: 0.625rem;
  }
  /* 年份只在跨年时出现，避免每行重复 */
  .tl-simple__year {
    margin-right: 0.3rem;
    color: var(--color-ed-subtle);
  }
  .timeline-point.is-active .tl-title {
    color: var(--color-ed-accent);
  }
  /* 日记是流水，轴点上弱一档；人物/事件保持主级 */
  .timeline-point[data-kind="diary"] .tl-title {
    color: var(--color-ed-muted);
    font-size: 0.8125rem;
  }
  .timeline-point[data-kind="diary"].is-active .tl-title {
    color: var(--color-ed-accent);
  }
  /* 焦点环内缩：横轴/竖轴的 overflow 会裁掉外扩的 outline */
  .timeline-point:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: -2px;
  }

  /* —— 纪事内容解锁（加密文章）—— */
  .lock-box {
    position: relative;
    border: 1px dashed var(--color-ed-rule);
    padding: 1rem;
  }
  /* 解锁成功：边框闪一次砖红。用叠加层只动 opacity（不动 border-color），
     既符合「只动 transform/opacity」，也不触发逐帧重绘边框。 */
  .lock-box::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--color-ed-accent);
    pointer-events: none;
    opacity: 0;
  }
  .lock-box.is-unlocked::after {
    animation: lock-box-flash 400ms ease-out both;
  }
  @keyframes lock-box-flash {
    0% {
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  .lock-question {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-ed-fg);
    margin: 0 0 0.75rem;
  }
  .lock-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .lock-input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--color-ed-rule);
    background: transparent;
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
    color: var(--color-ed-fg);
  }
  .lock-input:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: 1px;
  }
  /* 答错：输入框轻抖一次（reduced-motion 下由媒体查询降级为无抖动） */
  .lock-input.is-shake {
    animation: lock-shake 260ms ease;
  }
  @keyframes lock-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    20% {
      transform: translateX(-3px);
    }
    45% {
      transform: translateX(3px);
    }
    70% {
      transform: translateX(-2px);
    }
    88% {
      transform: translateX(1px);
    }
  }
  .lock-btn {
    /* 锁定宽度：「解锁」→「解锁中…」时按钮不抖，输入框也不跟着跳 */
    min-width: 5.25rem;
    border: 1px solid var(--color-ed-fg);
    background: transparent;
    color: var(--color-ed-fg);
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: 0.85rem;
    transition: transform 120ms ease, background-color 160ms ease,
      color 160ms ease, opacity 160ms ease;
  }
  .lock-btn:hover:not(:disabled) {
    background: var(--color-ed-fg);
    color: var(--color-ed-bg);
  }
  .lock-btn:active:not(:disabled) {
    transform: scale(0.97);
  }
  /* PBKDF2 派生期间（约 100–300ms）禁止重复提交 */
  .lock-btn:disabled {
    cursor: progress;
    opacity: 0.55;
  }
  .lock-error {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--color-ed-accent);
    opacity: 0;
    transition: opacity 160ms ease;
  }
  .lock-error.is-shown {
    opacity: 1;
  }
  /* 解锁成功：正文淡入上移（透明揭示），与锁行收起的 220ms 并行 */
  .lock-content.is-reveal {
    animation: lock-content-in 320ms var(--ease-ed) both;
  }
  @keyframes lock-content-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* 时间轴入场：点/线不位移、不 stagger，快速淡入 */
    .timeline-point {
      opacity: 1;
      animation: tl-fade 160ms linear both;
      animation-delay: 0s;
    }
    .tl-seg {
      animation: none;
      transform: none;
    }
    .timeline-point:hover .tl-simple__dot {
      transform: none;
    }
    .timeline-point:hover .tl-simple__body,
    .timeline-point.is-active .tl-simple__body {
      transform: none;
    }
    .lock-box::after,
    .lock-box.is-unlocked::after {
      animation: none;
      opacity: 0;
    }
    .lock-content.is-reveal {
      animation: lock-content-fade 160ms linear both;
    }
    .lock-input.is-shake {
      animation: none;
    }
    .lock-btn {
      transition: none;
    }
    .lock-btn:active:not(:disabled) {
      transform: none;
    }
  }
  @keyframes lock-content-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* ===== 版面：桌面「左文右轴」，手机「横轴在上、正文在下」 ===== */
  .timeline-layout {
    display: grid;
    gap: 1.75rem;
  }
  .timeline-rail {
    min-width: 0;
  }
  .tl-simple {
    min-width: 0;
  }
  .timeline-feed {
    width: 100%;
    min-width: 0;
    /* 单列时也不要把正文拉成 50+ 字/行；桌面端在该列内居中 */
    max-width: 47rem;
    margin-inline: auto;
    padding-top: 0.5rem;
  }
  @media (min-width: 1024px) {
    .timeline-layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
      grid-template-areas: "feed rail";
      gap: 3rem;
      align-items: start;
    }
    .timeline-feed {
      grid-area: feed;
    }
    .timeline-rail {
      grid-area: rail;
      position: sticky;
      top: 6rem;
      min-width: 0;
    }
  }

  /* —— 连续信息流条目：正文直出、连续排布，日记（碎碎念）占位更紧 —— */
  .tl-entry {
    padding: 2.25rem 0 2.5rem;
    scroll-margin-top: 6rem;
  }
  /* 同一年内相邻条目之间一条发丝线；跨年由年份标分隔，不再加线 */
  .tl-entry + .tl-entry {
    border-top: 1px solid var(--color-ed-hairline);
  }
  .tl-entry__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .tl-entry__date {
    display: block;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ed-subtle);
    letter-spacing: 0.06em;
  }
  /* 类型：日期行右对齐小字（人物 / 事件 / 日记） */
  .tl-entry__kind {
    flex: none;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-ed-subtle);
  }
  .tl-entry__title {
    margin-top: 0.35rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--color-ed-fg);
  }
  /* 引文行：person/event 的 excerpt 作为刊物式 lead，永远可见 */
  .tl-entry__lead {
    margin: 0.9rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ed-muted);
  }
  /* 日记：无标题，正文直接跟在日期下 */
  .tl-entry--diary {
    padding-block: 1.75rem;
  }
  /* 年份标：serif 数字 + 延伸细线，跨年时给出呼吸位 */
  .tl-year {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-serif);
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: var(--color-ed-muted);
  }
  .tl-year::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--color-ed-rule);
  }

  @media (max-width: 1023px) {
    .timeline-layout {
      gap: 1.5rem;
    }
    .timeline-rail {
      width: 100%;
      max-width: 47rem;
      margin-inline: auto;
    }
    .tl-title-row {
      margin-bottom: 0.6rem;
    }
    /* 横轴：不再有 22rem 的嵌套滚动，改为整行横向滑动 */
    .tl-simple {
      display: flex;
      gap: 0.55rem;
      height: auto;
      padding: 0.15rem 0.15rem 0.7rem;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x proximity;
      overscroll-behavior-x: contain;
    }
    .timeline-point {
      flex: 0 0 auto;
      width: 11.5rem;
      padding: 0.7rem 0.8rem;
      border: 1px solid var(--color-ed-hairline);
      border-radius: 3px;
      scroll-snap-align: start;
    }
    .timeline-point.is-active {
      border-color: var(--color-ed-accent);
      background: rgba(166, 58, 43, 0.04);
    }
    .tl-seg,
    .tl-simple__dot {
      display: none;
    }
    .tl-simple__body {
      padding-bottom: 0;
    }
    .tl-simple__date {
      font-size: 0.6875rem;
    }
    .timeline-point .tl-title {
      font-size: 0.875rem;
    }
    .timeline-point[data-kind="diary"] .tl-title {
      font-size: 0.8125rem;
    }
    /* 手机端条目占位同步收紧 */
    .tl-entry {
      padding-block: 1.75rem;
    }
    .tl-entry--diary {
      padding-block: 1.25rem;
    }
  }
</style>

<script>
  // ===== 纪事连续流 =====
  // 服务端已直出全部条目；本脚本只负责：
  //   1. 时间轴（目录）点击/键盘 → 平滑滚动到对应条目并写入 hash
  //   2. scroll-spy：滚动时高亮当前位置的轴点（rAF 节流，hash 用 replaceState 不污染历史）
  //   3. 加锁条目解密（见下方锁一节，lock-box 常驻 DOM）
  // View Transitions：脚本只执行一次，引用在事件发生时现查，状态挂 window 上。
  type TLState = { active: number | null; bound: boolean };
  const tlWindow = window as Window & { __timelineState?: TLState };
  const TL: TLState = (tlWindow.__timelineState ??= {
    active: null,
    bound: false,
  });
  const TL_MOBILE = window.matchMedia("(max-width: 1023px)");
  const TL_REDUCED = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const tlPoints = () =>
    Array.from(document.querySelectorAll<HTMLElement>(".timeline-point"));
  const tlEntries = () =>
    Array.from(document.querySelectorAll<HTMLElement>(".tl-entry"));

  function tlHash(): string {
    const raw = location.hash.replace(/^#/, "");
    try {
      return decodeURIComponent(raw);
    } catch {
      return raw;
    }
  }

  function tlSetHash(anchor: string, push: boolean) {
    if (!anchor || location.hash === `#${anchor}`) return;
    const url = `${location.pathname}${location.search}#${anchor}`;
    if (push) history.pushState(null, "", url);
    else history.replaceState(null, "", url);
  }

  function tlSetActive(index: number) {
    tlPoints().forEach((p, i) => {
      const on = i === index;
      p.classList.toggle("is-active", on);
      if (on) p.setAttribute("aria-current", "true");
      else p.removeAttribute("aria-current");
    });
  }

  // 对齐条目顶部（锚点语义）；已在位时不再抽动
  function tlScrollToEntry(article: HTMLElement) {
    const top = article.getBoundingClientRect().top + window.scrollY - 84;
    if (Math.abs(window.scrollY - Math.max(0, top)) < 4) return;
    window.scrollTo({
      top: Math.max(0, top),
      behavior: TL_REDUCED ? "auto" : "smooth",
    });
  }

  // 只滚时间轴自身：桌面向上下、手机向左右，不抢正文的滚动
  function tlRevealPoint(point: HTMLElement) {
    const scroller = point.closest<HTMLElement>(".tl-simple");
    if (!scroller) return;
    if (TL_MOBILE.matches) {
      const left = point.offsetLeft - 8;
      const right = left + point.offsetWidth;
      if (
        left < scroller.scrollLeft ||
        right > scroller.scrollLeft + scroller.clientWidth
      ) {
        scroller.scrollTo({
          left: Math.max(0, left),
          behavior: TL_REDUCED ? "auto" : "smooth",
        });
      }
      return;
    }
    const p = point.getBoundingClientRect();
    const box = scroller.getBoundingClientRect();
    if (p.top < box.top + 4) scroller.scrollTop += p.top - box.top - 8;
    else if (p.bottom > box.bottom - 4)
      scroller.scrollTop += p.bottom - box.bottom + 8;
  }

  // scroll-spy：以「顶部越过导航线下方」的最后一条为当前位置；触底时取最后一条。
  // 页面顶端不写 hash（保持 /timeline/ 干净），滚进正文后才用 replaceState 同步。
  // 程序化导航（轴点点击/深链接）的滚动期间暂停 spy——否则起步瞬间 spy 会把
  // 刚设置的高亮/hash 抢回落点之前的条目（observed：点日记却被改回事件）。
  let navQuiet = false;
  let navQuietTimer = 0;
  function tlBeginNav() {
    navQuiet = true;
    window.clearTimeout(navQuietTimer);
    navQuietTimer = window.setTimeout(() => {
      navQuiet = false;
    }, 1200);
    // scrollend（现代浏览器）在平滑滚动结束时立即解除抑制
    window.addEventListener(
      "scrollend",
      () => {
        navQuiet = false;
      },
      { once: true }
    );
  }

  function tlSpy() {
    if (navQuiet) return;
    const entries = tlEntries();
    if (entries.length === 0) return;
    let index = 0;
    for (let i = 0; i < entries.length; i++) {
      if (entries[i].getBoundingClientRect().top <= 100) index = i;
    }
    const doc = document.documentElement;
    if (window.innerHeight + window.scrollY >= doc.scrollHeight - 4) {
      index = entries.length - 1;
    }
    if (index === TL.active) return;
    TL.active = index;
    tlSetActive(index);
    const point = tlPoints()[index];
    if (point) {
      tlRevealPoint(point);
      if (window.scrollY > 40 || tlHash()) {
        tlSetHash(point.dataset.anchor ?? "", false);
      }
    }
  }

  let spyRaf = 0;
  function tlOnScroll() {
    if (spyRaf) return;
    spyRaf = window.requestAnimationFrame(() => {
      spyRaf = 0;
      tlSpy();
    });
  }

  // 目录导航：轴点 → 对应条目（点击 push hash，键盘/历史恢复只 replace）
  function tlGo(point: HTMLElement, push: boolean) {
    const article = document.getElementById(point.dataset.anchor ?? "");
    if (!article) return;
    const idx = Number(point.dataset.index ?? "-1");
    if (idx >= 0) {
      TL.active = idx;
      tlSetActive(idx);
    }
    tlSetHash(point.dataset.anchor ?? "", push);
    tlRevealPoint(point);
    tlBeginNav();
    tlScrollToEntry(article);
  }

  function tlClick(e: MouseEvent) {
    const point = (e.target as HTMLElement | null)?.closest?.(
      ".timeline-point"
    ) as HTMLElement | null;
    if (point) tlGo(point, true);
  }

  function tlKeydown(e: KeyboardEvent) {
    const target = e.target as HTMLElement | null;
    const point = target?.closest?.(".timeline-point") as HTMLElement | null;
    if (!point) return;
    const pts = tlPoints();
    const idx = Number(point.dataset.index ?? "-1");

    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      tlGo(point, true);
      return;
    }

    let next: number | null = null;
    if (e.key === "ArrowDown" || e.key === "ArrowRight")
      next = Math.min(pts.length - 1, idx + 1);
    else if (e.key === "ArrowUp" || e.key === "ArrowLeft")
      next = Math.max(0, idx - 1);
    else if (e.key === "Home") next = 0;
    else if (e.key === "End") next = pts.length - 1;
    if (next === null) return;

    e.preventDefault();
    pts[next]?.focus();
    if (pts[next]) tlGo(pts[next], false);
  }

  function tlHistory() {
    const entries = tlEntries();
    if (entries.length === 0) return;
    const hash = tlHash();
    // 后退到没有 hash 的初始状态：回到最新一条（页面顶部）
    if (!hash) {
      if (TL.active !== 0) {
        TL.active = 0;
        tlSetActive(0);
      }
      window.scrollTo({ top: 0, behavior: TL_REDUCED ? "auto" : "smooth" });
      return;
    }
    const target = entries.find((el) => el.id === hash);
    if (!target) return;
    const idx = entries.indexOf(target);
    if (idx !== TL.active) {
      TL.active = idx;
      tlSetActive(idx);
      tlRevealPoint(tlPoints()[idx]);
    }
    tlScrollToEntry(target);
  }

  function tlInit() {
    TL.active = null;
    const entries = tlEntries();
    if (entries.length === 0) return;
    const hash = tlHash();
    const target = hash ? entries.find((el) => el.id === hash) : undefined;
    if (target) {
      // 深链接进入：浏览器原生锚点滚动已落位，这里兜底一次并同步轴点高亮
      const idx = entries.indexOf(target);
      TL.active = idx;
      tlSetActive(idx);
      tlRevealPoint(tlPoints()[idx]);
      tlBeginNav();
      requestAnimationFrame(() => tlScrollToEntry(target));
      window.setTimeout(() => tlScrollToEntry(target), 180);
      return;
    }
    // 无深链接：默认高亮最新一条（页面顶部）
    tlSpy();
  }

  // ===== 纪事内容解锁（AES-GCM，答案解密）=====
  // 构建期已把带 lock 的正文加密成密文（明文不进产物）；浏览器端用答案经
  // PBKDF2 派生密钥解密，成功后在当前会话记忆，无需重复输入。
  const PBKDF2_ITERATIONS = 120000;
  const LOCK_STORAGE_KEY = "snark_locked_entries";

  function b64ToBuf(b64: string): ArrayBuffer {
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes.buffer as ArrayBuffer;
  }

  // 解密后的 markdown 原文做最简渲染：按空行分段 → <p>，单换行 → <br>
  function renderPlainMd(text: string): string {
    const blocks = text.split(/\n{2,}/).map((b) => b.trim()).filter(Boolean);
    if (blocks.length === 0) return "";
    return blocks
      .map((b) => `<p>${b.replace(/\n/g, "<br>")}</p>`)
      .join("");
  }

  async function decryptBlock(box: HTMLElement, answer: string): Promise<string | null> {
    const ciphertext = box.dataset.ciphertext ?? "";
    const salt = box.dataset.salt ?? "";
    const iv = box.dataset.iv ?? "";
    if (!ciphertext || !salt || !iv) return null;
    try {
      const enc = new TextEncoder();
      const saltBuf = b64ToBuf(salt);
      const ivBuf = b64ToBuf(iv);
      // 密文 = [GCM tag(16B) | ciphertext]，整体作为 AES-GCM 的 ciphertext 传入
      const combined = b64ToBuf(ciphertext);

      const keyMaterial = await crypto.subtle.importKey(
        "raw",
        enc.encode(answer.normalize("NFC").trim()),
        "PBKDF2",
        false,
        ["deriveKey"]
      );
      const key = await crypto.subtle.deriveKey(
        { name: "PBKDF2", salt: saltBuf, iterations: PBKDF2_ITERATIONS, hash: "SHA-256" },
        keyMaterial,
        { name: "AES-GCM", length: 256 },
        false,
        ["decrypt"]
      );
      const plain = await crypto.subtle.decrypt(
        { name: "AES-GCM", iv: ivBuf, tagLength: 128 },
        key,
        combined
      );
      return new TextDecoder().decode(plain);
    } catch {
      return null;
    }
  }

  // 会话记忆：记录已解锁条目的 id → 明文
  function loadLocks(): Record<string, string> {
    try {
      return JSON.parse(sessionStorage.getItem(LOCK_STORAGE_KEY) || "{}");
    } catch {
      return {};
    }
  }
  function saveLock(id: string, plain: string) {
    const locks = loadLocks();
    locks[id] = plain;
    sessionStorage.setItem(LOCK_STORAGE_KEY, JSON.stringify(locks));
  }

  // 解锁成功：锁行高度收起 220ms。max-height 必须从「量出来的实际高度」收到 0，
  // 直接写 auto → 0 不会产生过渡，所以先钉住起始高度、强制 reflow 再改终点。
  function collapseLockRow(box: HTMLElement, reduced: boolean) {
    const parts = [
      box.querySelector<HTMLElement>(".lock-question"),
      box.querySelector<HTMLElement>(".lock-row"),
    ].filter((el): el is HTMLElement => Boolean(el));
    const drop = () => {
      parts.forEach((el) => el.remove());
      box
        .querySelectorAll<HTMLElement>(".lock-input, .lock-btn")
        .forEach((el) => el.remove());
    };
    if (reduced || parts.length === 0) {
      drop();
      return;
    }
    parts.forEach((el) => {
      el.style.maxHeight = `${el.getBoundingClientRect().height}px`;
      el.style.overflow = "hidden";
    });
    void box.offsetHeight; // 强制 reflow：让起始高度生效后再改终点
    parts.forEach((el) => {
      el.style.transition =
        "max-height 220ms var(--ease-ed), opacity 160ms ease, margin-bottom 220ms var(--ease-ed)";
      el.style.maxHeight = "0px";
      el.style.opacity = "0";
      el.style.marginBottom = "0px";
    });
    window.setTimeout(drop, 240);
  }

  function fillLocked(box: HTMLElement, plain: string, animate = true) {
    const contentEl = box.querySelector<HTMLElement>(".lock-content");
    if (!contentEl) return;
    contentEl.innerHTML = renderPlainMd(plain);
    contentEl.hidden = false;
    const err = box.querySelector<HTMLElement>(".lock-error");
    if (err) {
      err.hidden = true;
      err.classList.remove("is-shown");
    }
    box.dataset.unlocked = "1";
    if (animate) {
      // 正文透明揭示（reduced-motion 下 CSS 降级为纯淡入）
      contentEl.classList.add("is-reveal");
      collapseLockRow(box, TL_REDUCED);
      // 边框闪一次砖红（CSS ::after 只动 opacity）
      box.classList.add("is-unlocked");
    } else {
      // 会话记忆恢复 / 首屏直出：不做揭示动画，直接落到终态
      contentEl.classList.remove("is-reveal");
      collapseLockRow(box, true);
      box.classList.remove("is-unlocked");
    }

    // 解锁成功后才放出本条纪事的 BGM：MiniPlayer 带 gated 标记时先隐藏、不自动播放，
    // 由这里显式启动（会话记忆恢复也走同一条路径）。
    const holder = box.closest("article") ?? box.parentElement;
    const player = holder?.querySelector("mini-player") as
      | (HTMLElement & { unlockPlay?: () => void })
      | null;
    player?.unlockPlay?.();
  }

  async function tryUnlock(box: HTMLElement) {
    // 已解锁 / 正在解密：忽略重复提交（PBKDF2 120k 有 100–300ms 空窗）
    if (box.dataset.unlocked === "1" || box.dataset.pending === "1") {
      return;
    }
    const id = box.dataset.lockId ?? "";
    const input = box.querySelector<HTMLInputElement>(".lock-input");
    const answer = input?.value ?? "";
    if (!answer) return;
    // 若已记忆则直接展示
    const memo = loadLocks();
    if (id && memo[id]) {
      fillLocked(box, memo[id]);
      return;
    }

    // pending：按钮禁用 + 文案「解锁中…」，min-width 保证宽度不抖
    const btn = box.querySelector<HTMLButtonElement>(".lock-btn");
    const err = box.querySelector<HTMLElement>(".lock-error");
    box.dataset.pending = "1";
    if (btn) {
      if (!btn.dataset.label) btn.dataset.label = btn.textContent ?? "解锁";
      btn.disabled = true;
      btn.textContent = "解锁中…";
    }
    if (input) input.readOnly = true;

    const plain = await decryptBlock(box, answer);

    delete box.dataset.pending;
    // 解密期间可能已换页 / 被解锁（元素脱离文档），先确认还在
    if (btn?.isConnected) {
      btn.disabled = false;
      btn.textContent = btn.dataset.label ?? "解锁";
    }
    if (input?.isConnected) input.readOnly = false;

    if (plain !== null) {
      if (id) saveLock(id, plain);
      fillLocked(box, plain);
    } else {
      if (err) {
        err.hidden = false;
        void err.offsetWidth; // 先让 display:block 生效（opacity 仍是 0），再淡入
        err.classList.add("is-shown");
      }
      // 输入框轻抖一次；reduced-motion 只保留错误文案淡入
      if (input && !TL_REDUCED) {
        input.classList.remove("is-shake");
        void input.offsetWidth;
        input.classList.add("is-shake");
      }
    }
  }

  // 事件委托：任意条目的 lock-box 都能触发解锁；Enter 提交
  function tlLockClick(e: MouseEvent) {
    const btn = (e.target as HTMLElement | null)?.closest?.(".lock-btn");
    if (!btn) return;
    e.preventDefault();
    const box = btn.closest<HTMLElement>(".lock-box");
    if (box) void tryUnlock(box);
  }
  function tlLockKeydown(e: KeyboardEvent) {
    if (e.key !== "Enter") return;
    const target = e.target as HTMLElement | null;
    if (!target?.classList?.contains("lock-input")) return;
    e.preventDefault();
    const box = target.closest<HTMLElement>(".lock-box");
    if (box) void tryUnlock(box);
  }

  // 初始加载：把已记忆的加密条目直接呈现（若页面含其 lock-box）
  document.querySelectorAll<HTMLElement>(".lock-box").forEach((box) => {
    const id = box.dataset.lockId ?? "";
    const locks = loadLocks();
    if (id && locks[id]) fillLocked(box, locks[id], false);
  });

  // ===== 一次性绑定（换页不重复绑），每次 page-load 重新初始化状态 =====
  if (!TL.bound) {
    TL.bound = true;
    document.addEventListener("click", tlClick);
    document.addEventListener("keydown", tlKeydown);
    document.addEventListener("click", tlLockClick);
    document.addEventListener("keydown", tlLockKeydown);
    window.addEventListener("popstate", tlHistory);
    window.addEventListener("hashchange", tlHistory);
    window.addEventListener("scroll", tlOnScroll, { passive: true });
    document.addEventListener("astro:page-load", tlInit);
    document.addEventListener("astro:before-swap", () => {
      TL.active = null;
    });
  }
  tlInit();
</script>
