  .lock-btn {
    /* 锁定宽度：「解锁」→「解锁中…」时按钮不抖，输入框也不跟着跳 */
    min-width: 5.25rem;
    border: 1px solid var(--color-ed-fg);
    background: transparent;
    color: var(--color-ed-fg);
    padding: 0.5rem 1rem;
