---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import MiniPlayer from "../components/MiniPlayer.astro";
import { encryptContent } from "../utils/lockContent";

// 纪事（moments）：person / event / diary 三类统一成一条时间线
const allMoments = await getCollection("moments");

const publishedMoments = allMoments
  .filter((m) => !m.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

type RenderedContent = Awaited<
  ReturnType<CollectionEntry<"posts">["render"]>
>["Content"];

type Kind = "person" | "event" | "diary";

const KIND_LABEL: Record<Kind, string> = {
  person: "人物",
  event: "事件",
  diary: "日记",
};

// 所有内容统一预渲染全文；带 lock 的文章构建期加密正文，浏览器端用答案解密
interface RenderedAll {
  id: string;
  kind: Kind;
  entry: CollectionEntry<"moments">;
  Content?: RenderedContent; // 未加密才有明文 Content
  lock?: {
    question: string;
    ciphertext: string;
    salt: string;
    iv: string;
  };
}

const renderedAll: RenderedAll[] = await Promise.all(
  publishedMoments.map(async (m) => {
    const base = { id: m.id, kind: m.data.type as Kind, entry: m };
    if (m.data.lock?.answer) {
      // 加密正文（构建期）；明文不进产物
      const enc = encryptContent(String(m.body ?? ""), m.data.lock.answer);
      return {
        ...base,
        lock: {
          question: m.data.lock.question,
          ciphertext: enc.ciphertext,
          salt: enc.salt,
          iv: enc.iv,
        },
      };
    }
    return { ...base, Content: (await m.render()).Content };
  })
);

const contentIndex = new Map(renderedAll.map((c, i) => [c.id, i]));

interface TimelineEntry {
  date: Date;
  kind: Kind;
  title: string;
  label: string; // 轴点小标签：人物 / 事件 / 日记
  contentIndex: number;
}

const entries: TimelineEntry[] = publishedMoments
  .map((m) => ({
    date: m.data.date,
    kind: m.data.type as Kind,
    title: m.data.title ?? "", // diary 可无标题，轴点用日期兜底（模板处理）
    label: KIND_LABEL[m.data.type as Kind],
    contentIndex: contentIndex.get(m.id)!,
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const formatDate = (d: Date, opts: Intl.DateTimeFormatOptions) =>
  d.toLocaleDateString("zh-CN", opts);

const fmtLong = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
    weekday: "short",
  });

const fmtShort = (d: Date) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "short" });

// 默认展开最新一条（轴点默认高亮它）
const defaultRendered =
  entries.length > 0 ? renderedAll[entries[0].contentIndex] : null;
---

<BaseLayout title="纪事">
  <div class="mx-auto max-w-[1380px] px-6 md:px-8">
    <section class="pt-10 md:pt-16">
      <h1
        class="font-serif text-3xl md:text-4xl tracking-tighter text-[var(--color-ed-fg)] mb-8"
      >
        纪事
      </h1>

      {entries.length > 0 ? (
        <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_320px] items-start">
          <!-- 左侧：选中的节点正文 -->
          <div
            id="timeline-detail"
            class="min-h-40"
            aria-live="polite"
            data-default-index="0"
          >
            {defaultRendered && (
              <article class="border-t border-[var(--color-ed-faint)] pt-8 pb-4">
                <h2 class="font-serif text-2xl text-[var(--color-ed-fg)]">
                  {defaultRendered.entry.data.title ??
                    fmtLong(defaultRendered.entry.data.date)}
                </h2>
                <p class="mt-2 text-xs text-[var(--color-ed-subtle)] tabular-nums">
                  {fmtLong(defaultRendered.entry.data.date)}
                </p>
                {defaultRendered.kind === "person" && (
                  <span class="mt-3 inline-block border border-[var(--color-ed-faint)] px-2 py-0.5 text-[10px] tracking-[0.05em] text-[var(--color-ed-muted)]">
                    人物
                  </span>
                )}
                {defaultRendered.kind === "event" && (
                  <span class="mt-3 inline-block border border-[var(--color-ed-faint)] px-2 py-0.5 text-[10px] tracking-[0.05em] text-[var(--color-ed-muted)]">
                    事件
                  </span>
                )}
                {defaultRendered.kind === "diary" && (
                  <span class="mt-3 inline-block border border-[var(--color-ed-faint)] px-2 py-0.5 text-[10px] tracking-[0.05em] text-[var(--color-ed-muted)]">
                    日记
                  </span>
                )}
                {defaultRendered.entry.data.bgm?.src && (
                  <div class="mt-4">
                    <MiniPlayer
                      src={defaultRendered.entry.data.bgm.src}
                      title={defaultRendered.entry.data.bgm.title}
                    />
                  </div>
                )}
                {defaultRendered.lock ? (
                  <div
                    class="lock-box mt-6"
                    data-lock-id={defaultRendered.id}
                    data-ciphertext={defaultRendered.lock.ciphertext}
                    data-salt={defaultRendered.lock.salt}
                    data-iv={defaultRendered.lock.iv}
                  >
                    <p class="lock-question">{defaultRendered.lock.question}</p>
                    <div class="lock-row">
                      <input
                        type="text"
                        class="lock-input"
                        placeholder="输入答案解锁"
                        autocomplete="off"
                        aria-label="答案"
                      />
                      <button type="button" class="lock-btn">解锁</button>
                    </div>
                    <p class="lock-error" hidden>答案不对，再试试。</p>
                    <div class="lock-content prose mt-4" hidden></div>
                  </div>
                ) : (
                  defaultRendered.Content && (
                    <div class="prose mt-6">
                      <defaultRendered.Content />
                    </div>
                  )
                )}
              </article>
            )}
          </div>

          <!-- 右侧固定栏：简约时间轴 -->
          <aside id="view-timeline" class="md:sticky md:top-24 min-w-0">
            <div class="tl-title-row mb-1">时间线</div>
            <ol class="tl-simple">
              {entries.map((entry, i) => (
                <li
                  class="timeline-point group"
                  data-kind={entry.kind}
                  data-index={i}
                  data-content-index={entry.contentIndex}
                  role="button"
                  tabindex="0"
                  aria-expanded="false"
                  style={`--tl-i: ${i}`}
                >
                  {/* 段竖线：独立于可缩放内容，入场时逐段生长、悬停时本段高亮 */}
                  <span class="tl-seg" aria-hidden="true"></span>
                  {/* 圆点：圆心钉在竖线上，dock 放大时不随文字缩放，始终骑线 */}
                  <span class="tl-simple__dot" aria-hidden="true"></span>
                  <span class="tl-simple__body">
                    <time class="tl-simple__date" datetime={entry.date.toISOString()}>
                      {fmtShort(entry.date)}
                    </time>
                    <span class="tl-title block font-serif text-sm leading-snug text-[var(--color-ed-fg)] transition-colors duration-300 group-hover:text-[var(--color-ed-accent)]">
                      {entry.title || "日记"}
                    </span>
                    <span class="tl-simple__label">{entry.label}</span>
                  </span>
                </li>
              ))}
            </ol>
          </aside>
        </div>
      ) : (
        <p class="text-[var(--color-ed-muted)]">暂无内容。</p>
      )}
    </section>

    <!-- Hidden full-text contents (moments + diary), cloned into detail area on click -->
    <template id="content-templates">
      {
        renderedAll.map((c, idx) => (
          <div class="content-body" data-content-index={idx}>
            <article class="border-t border-[var(--color-ed-faint)] pt-8 pb-4">
              <h2 class="font-serif text-2xl text-[var(--color-ed-fg)]">
                {c.entry.data.title ?? fmtLong(c.entry.data.date)}
              </h2>
              <p class="mt-2 text-xs text-[var(--color-ed-subtle)] tabular-nums">
                {fmtLong(c.entry.data.date)}
              </p>
              {c.kind === "person" && (
                <span class="mt-3 inline-block border border-[var(--color-ed-faint)] px-2 py-0.5 text-[10px] tracking-[0.05em] text-[var(--color-ed-muted)]">
                  人物
                </span>
              )}
              {c.kind === "event" && (
                <span class="mt-3 inline-block border border-[var(--color-ed-faint)] px-2 py-0.5 text-[10px] tracking-[0.05em] text-[var(--color-ed-muted)]">
                  事件
                </span>
              )}
              {c.kind === "diary" && (
                <span class="mt-3 inline-block border border-[var(--color-ed-faint)] px-2 py-0.5 text-[10px] tracking-[0.05em] text-[var(--color-ed-muted)]">
                  日记
                </span>
              )}
              {c.entry.data.bgm?.src && (
                <div class="mt-4">
                  <MiniPlayer
                    src={c.entry.data.bgm.src}
                    title={c.entry.data.bgm.title}
                  />
                </div>
              )}
              {c.lock ? (
                <div
                  class="lock-box mt-6"
                  data-lock-id={c.id}
                  data-ciphertext={c.lock.ciphertext}
                  data-salt={c.lock.salt}
                  data-iv={c.lock.iv}
                >
                  <p class="lock-question">{c.lock.question}</p>
                  <div class="lock-row">
                    <input
                      type="text"
                      class="lock-input"
                      placeholder="输入答案解锁"
                      autocomplete="off"
                      aria-label="答案"
                    />
                    <button type="button" class="lock-btn">解锁</button>
                  </div>
                  <p class="lock-error" hidden>答案不对，再试试。</p>
                  <div class="lock-content prose mt-4" hidden></div>
                </div>
              ) : (
                c.Content && (
                  <div class="prose mt-6">
                    <c.Content />
                  </div>
                )
              )}
            </article>
          </div>
        ))
      }
    </template>
  </div>
</BaseLayout>

<style>
  /* 右栏区块小标题 */
  .tl-title-row {
    font-size: 0.625rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-ed-subtle);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tl-title-row::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--color-ed-faint);
  }

  /* ================= 简约时间轴 =================
     结构：每 <li> 自带一段竖线 .tl-seg + 一个圆点 .tl-simple__dot。
     竖线分段 → 可逐段做入场生长与悬停高亮；圆点圆心钉在线上，dock 放大不脱线。 */
  .tl-simple {
    list-style: none;
    margin: 0;
    padding: 0 1.5rem 0 0.25rem; /* 右侧留余量：dock 放大时文字不被滚动条裁掉 */
    position: relative;
    height: 22rem;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
  }
  /* 时间线变量：线 X 坐标（1px 线，中心对齐）、dot 半径 */
  .tl-simple {
    --tl-line-x: 7.5px;
    --tl-dot-d: 9px;
  }
  .timeline-point {
    position: relative;
    display: flex;
    padding: 0.625rem 0 0.625rem 1.5rem; /* 左 padding 让位给线/点 */
    cursor: pointer;
    border-radius: 4px;
    /* 入场动画：整体淡入上移（delay 由 --tl-i 逐条错开） */
    opacity: 0;
    animation: tl-point-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(0.25s + var(--tl-i, 0) * 0.09s);
  }
  @keyframes tl-point-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .timeline-point:hover {
    background: rgba(28, 28, 28, 0.03);
  }

  /* —— 每段竖线：默认透明，入场时逐段从顶生长；悬停/激活时本段点亮 —— */
  .tl-seg {
    position: absolute;
    left: calc(var(--tl-line-x) - 0.5px);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-ed-faint);
    transform: scaleY(0);
    transform-origin: top;
    animation: tl-seg-grow 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(0.25s + var(--tl-i, 0) * 0.09s);
  }
  @keyframes tl-seg-grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  .timeline-point:hover .tl-seg {
    background: var(--color-ed-accent);
    opacity: 0.7;
  }
  .timeline-point.is-active .tl-seg {
    background: var(--color-ed-accent);
  }

  /* —— 圆点/方点：绝对定位，圆心精确钉在竖线上；放大以圆心为锚，不脱线 —— */
  .tl-simple__dot {
    position: absolute;
    left: calc(var(--tl-line-x) - var(--tl-dot-d) / 2);
    top: 0.9rem; /* 与首行文字（日期）大致齐平 */
    width: var(--tl-dot-d);
    height: var(--tl-dot-d);
    border-radius: 50%;
    border: 1px solid var(--color-ed-muted);
    background: var(--color-ed-bg);
    transform-origin: center;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
    pointer-events: none;
  }
  /* 日记节点用小方点以示区分 */
  .timeline-point[data-kind="diary"] .tl-simple__dot {
    border-radius: 2px;
  }
  .timeline-point:hover .tl-simple__dot {
    border-color: var(--color-ed-accent);
    transform: scale(1.25);
  }
  .timeline-point.is-active .tl-simple__dot {
    background: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
    transform: scale(1.15);
  }

  /* —— 可 dock 缩放的主体：只放大文字区，线与点保持骑线不动 —— */
  .tl-simple__body {
    flex: 1;
    min-width: 0;
    padding-bottom: 0.25rem;
    transform-origin: left center;
    transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .timeline-point.is-dock-hot .tl-simple__body {
    z-index: 3;
  }
  .tl-simple__date {
    display: block;
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ed-subtle);
    letter-spacing: 0.06em;
  }
  .tl-simple__label {
    display: inline-block;
    margin-top: 0.125rem;
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    color: var(--color-ed-subtle);
    text-transform: uppercase;
  }
  .timeline-point.is-active .tl-title {
    color: var(--color-ed-accent);
  }
  .timeline-point:focus-visible {
    outline: 1px solid var(--color-ed-accent);
    outline-offset: 4px;
  }

  /* —— 纪事内容解锁（加密文章）—— */
  .lock-box {
    border: 1px dashed var(--color-ed-faint);
    padding: 1rem;
  }
  .lock-question {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-ed-fg);
    margin: 0 0 0.75rem;
  }
  .lock-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .lock-input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--color-ed-faint);
    background: transparent;
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
    color: var(--color-ed-fg);
  }
  .lock-input:focus {
    outline: 1px solid var(--color-ed-accent);
    outline-offset: 1px;
  }
  .lock-btn {
    border: 1px solid var(--color-ed-fg);
    background: transparent;
    color: var(--color-ed-fg);
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: 0.85rem;
  }
  .lock-btn:hover {
    background: var(--color-ed-fg);
    color: var(--color-ed-bg);
  }
  .lock-error {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--color-ed-accent);
  }
</style>

<script>
  // ===== 纪事时间线交互 =====
  // 点击切换详情采用 document 级事件委托：兼容 ViewTransitions 换页后节点被替换、
  // 以及脚本重入的情况，避免“点了没反应”。
  const detail = document.getElementById("timeline-detail");
  const template = document.getElementById("content-templates");
  if (!detail || !template) {
    console.warn("timeline elements missing");
  } else {
    const contentBodies = Array.from(
      template.content.querySelectorAll<HTMLElement>(".content-body")
    );

    let activeIndex: number | null = null;

    // 服务端默认已展开最新一条（轴点 index 0）
    const initialIndex = Number(detail.dataset.defaultIndex ?? "0");
    activeIndex = initialIndex;

    function setActive(i: number | null) {
      const points = document.querySelectorAll<HTMLElement>(".timeline-point");
      points.forEach((p, idx) => {
        const on = idx === i;
        p.setAttribute("aria-expanded", String(on));
        p.classList.toggle("is-active", on);
      });
    }
    setActive(activeIndex);

    function selectPoint(el: HTMLElement) {
      const index = Number(el.dataset.index ?? "-1");
      if (Number.isNaN(index) || index < 0) return;
      if (activeIndex === index) {
        activeIndex = null;
        setActive(null);
        detail.innerHTML = "";
        return;
      }
      activeIndex = index;
      setActive(index);

      const contentIdx = Number(el.dataset.contentIndex);
      const body = contentBodies.find(
        (b) => b.dataset.contentIndex === String(contentIdx)
      );
      if (body) {
        detail.innerHTML = "";
        detail.appendChild(body.cloneNode(true) as HTMLElement);
      }
    }

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      const point = target?.closest?.(".timeline-point");
      if (point) selectPoint(point as HTMLElement);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      const target = e.target as HTMLElement | null;
      const point = target?.closest?.(".timeline-point");
      if (point) {
        e.preventDefault();
        selectPoint(point as HTMLElement);
      }
    });
  }

  // ===== mac dock 鱼眼动画（右侧时间轴）=====
  // 鼠标在轴上移动时，靠近光标的条目放大、邻近条目次级放大，离开复位。
  const axis = document.querySelector<HTMLElement>(".tl-simple");
  const dockItems = Array.from(
    document.querySelectorAll<HTMLElement>(".timeline-point")
  );
  if (axis && dockItems.length > 0) {
    const MAX_SCALE = 1.45; // 最近条目最大放大
    const NEIGHBOR_SCALE = 1.18; // 相邻条目次级放大
    const EFFECT_RADIUS = 120; // 影响半径 px（超出则不变形）
    let raf = 0;

    function applyDock(clientY: number | null) {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        dockItems.forEach((item) => {
          // 只缩放文字主体 .tl-simple__body：竖线与圆点保持原位，圆点始终骑线
          const body = item.querySelector<HTMLElement>(".tl-simple__body");
          const rect = item.getBoundingClientRect();
          if (clientY === null || !body) {
            if (body) body.style.transform = "";
            item.classList.remove("is-dock-hot");
            return;
          }
          const itemCenterY = rect.top + rect.height / 2;
          const dist = Math.abs(clientY - itemCenterY);
          let scale = 1;
          if (dist < EFFECT_RADIUS) {
            // 距离越近放大越多：1 → MAX_SCALE 平滑衰减
            scale = 1 + (MAX_SCALE - 1) * Math.pow(1 - dist / EFFECT_RADIUS, 1.6);
            scale = Math.min(scale, MAX_SCALE);
            if (scale > NEIGHBOR_SCALE) {
              item.classList.add("is-dock-hot");
            } else {
              item.classList.remove("is-dock-hot");
            }
          } else {
            item.classList.remove("is-dock-hot");
          }
          body.style.transform =
            scale > 1.0001 ? `scale(${scale.toFixed(3)})` : "";
        });
      });
    }

    axis.addEventListener("mousemove", (e) => applyDock(e.clientY));
    axis.addEventListener("mouseleave", () => applyDock(null));
  }

  // ===== 纪事内容解锁（AES-GCM，答案解密）=====
  // 构建期已把带 lock 的正文加密成密文（明文不进产物）；浏览器端用答案经
  // PBKDF2 派生密钥解密，成功后在当前会话记忆，无需重复输入。
  const PBKDF2_ITERATIONS = 120000;
  const LOCK_STORAGE_KEY = "snark_locked_entries";

  function b64ToBuf(b64: string): ArrayBuffer {
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes.buffer as ArrayBuffer;
  }

  // 解密后的 markdown 原文做最简渲染：按空行分段 → <p>，单换行 → <br>
  function renderPlainMd(text: string): string {
    const blocks = text.split(/\n{2,}/).map((b) => b.trim()).filter(Boolean);
    if (blocks.length === 0) return "";
    return blocks
      .map((b) => `<p>${b.replace(/\n/g, "<br>")}</p>`)
      .join("");
  }

  async function decryptBlock(box: HTMLElement, answer: string): Promise<string | null> {
    const ciphertext = box.dataset.ciphertext ?? "";
    const salt = box.dataset.salt ?? "";
    const iv = box.dataset.iv ?? "";
    if (!ciphertext || !salt || !iv) return null;
    try {
      const enc = new TextEncoder();
      const saltBuf = b64ToBuf(salt);
      const ivBuf = b64ToBuf(iv);
      // 密文 = [GCM tag(16B) | ciphertext]，整体作为 AES-GCM 的 ciphertext 传入
      const combined = b64ToBuf(ciphertext);

      const keyMaterial = await crypto.subtle.importKey(
        "raw",
        enc.encode(answer.normalize("NFC").trim()),
        "PBKDF2",
        false,
        ["deriveKey"]
      );
      const key = await crypto.subtle.deriveKey(
        { name: "PBKDF2", salt: saltBuf, iterations: PBKDF2_ITERATIONS, hash: "SHA-256" },
        keyMaterial,
        { name: "AES-GCM", length: 256 },
        false,
        ["decrypt"]
      );
      const plain = await crypto.subtle.decrypt(
        { name: "AES-GCM", iv: ivBuf, tagLength: 128 },
        key,
        combined
      );
      return new TextDecoder().decode(plain);
    } catch {
      return null;
    }
  }

  // 会话记忆：记录已解锁条目的 id → 明文
  function loadLocks(): Record<string, string> {
    try {
      return JSON.parse(sessionStorage.getItem(LOCK_STORAGE_KEY) || "{}");
    } catch {
      return {};
    }
  }
  function saveLock(id: string, plain: string) {
    const locks = loadLocks();
    locks[id] = plain;
    sessionStorage.setItem(LOCK_STORAGE_KEY, JSON.stringify(locks));
  }

  function fillLocked(box: HTMLElement, plain: string) {
    const contentEl = box.querySelector<HTMLElement>(".lock-content");
    if (!contentEl) return;
    contentEl.innerHTML = renderPlainMd(plain);
    contentEl.hidden = false;
    box.querySelector(".lock-input")?.remove();
    box.querySelector(".lock-btn")?.remove();
    box.querySelector(".lock-question")?.remove();
    if (box.querySelector(".lock-error")) box.querySelector(".lock-error")!.hidden = true;
  }

  async function tryUnlock(box: HTMLElement) {
    const id = box.dataset.lockId ?? "";
    const input = box.querySelector<HTMLInputElement>(".lock-input");
    const answer = input?.value ?? "";
    if (!answer) return;
    // 若已记忆则直接展示
    const memo = loadLocks();
    if (id && memo[id]) {
      fillLocked(box, memo[id]);
      return;
    }
    const plain = await decryptBlock(box, answer);
    const err = box.querySelector<HTMLElement>(".lock-error");
    if (plain !== null) {
      if (id) saveLock(id, plain);
      fillLocked(box, plain);
    } else if (err) {
      err.hidden = false;
    }
  }

  // 事件委托：克隆进详情区的 lock-box 也能触发解锁；Enter/空格提交
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest?.(".lock-btn");
    if (btn) {
      e.preventDefault();
      const box = btn.closest<HTMLElement>(".lock-box");
      if (box) tryUnlock(box);
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Enter") return;
    const target = e.target as HTMLElement | null;
    if (target?.classList?.contains("lock-input")) {
      e.preventDefault();
      const box = target.closest<HTMLElement>(".lock-box");
      if (box) tryUnlock(box);
    }
  });

  // 初始加载：把已记忆的加密条目直接呈现（若页面含其 lock-box）
  document.querySelectorAll<HTMLElement>(".lock-box").forEach((box) => {
    const id = box.dataset.lockId ?? "";
    const locks = loadLocks();
    if (id && locks[id]) fillLocked(box, locks[id]);
  });
</script>
