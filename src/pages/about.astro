</style>

<script>
  import {
    GISCUS_REPO,
    GISCUS_REPO_ID,
    GISCUS_CATEGORY,
    GISCUS_CATEGORY_ID,
  } from "../consts";

  // ===== 纪事连续流 =====
  // 服务端已直出全部条目；本脚本只负责：
  //   1. 时间轴（目录）点击/键盘 → 平滑滚动到对应条目并写入 hash
  //   2. scroll-spy：滚动时高亮当前位置的轴点（rAF 节流，hash 用 replaceState 不污染历史）
  //   3. 加锁条目解密（见下方锁一节，lock-box 常驻 DOM）
  // View Transitions：脚本只执行一次，引用在事件发生时现查，状态挂 window 上。
  type TLState = { active: number | null; bound: boolean };
  const tlWindow = window as Window & { __timelineState?: TLState };
  const TL: TLState = (tlWindow.__timelineState ??= {
    active: null,
    bound: false,
  });
  const TL_MOBILE = window.matchMedia("(max-width: 1023px)");
  const TL_REDUCED = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const tlPoints = () =>
    Array.from(document.querySelectorAll<HTMLElement>(".timeline-point"));
  const tlEntries = () =>
    Array.from(document.querySelectorAll<HTMLElement>(".tl-entry"));

  function tlHash(): string {
    const raw = location.hash.replace(/^#/, "");
    try {
      return decodeURIComponent(raw);
    } catch {
      return raw;
    }
  }

  function tlSetHash(anchor: string, push: boolean) {
    if (!anchor || location.hash === `#${anchor}`) return;
    const url = `${location.pathname}${location.search}#${anchor}`;
    if (push) history.pushState(null, "", url);
    else history.replaceState(null, "", url);
  }

  function tlSetActive(index: number) {
    tlPoints().forEach((p, i) => {
      const on = i === index;
      p.classList.toggle("is-active", on);
      if (on) p.setAttribute("aria-current", "true");
      else p.removeAttribute("aria-current");
    });
  }

  // 对齐条目顶部（锚点语义）；已在位时不再抽动
  function tlScrollToEntry(article: HTMLElement) {
    const top = article.getBoundingClientRect().top + window.scrollY - 84;
    if (Math.abs(window.scrollY - Math.max(0, top)) < 4) return;
    window.scrollTo({
      top: Math.max(0, top),
      behavior: TL_REDUCED ? "auto" : "smooth",
    });
  }

  // 只滚时间轴自身：桌面向上下、手机向左右，不抢正文的滚动
  function tlRevealPoint(point: HTMLElement) {
    const scroller = point.closest<HTMLElement>(".tl-simple");
    if (!scroller) return;
    if (TL_MOBILE.matches) {
      const left = point.offsetLeft - 8;
      const right = left + point.offsetWidth;
      if (
        left < scroller.scrollLeft ||
        right > scroller.scrollLeft + scroller.clientWidth
      ) {
        scroller.scrollTo({
          left: Math.max(0, left),
          behavior: TL_REDUCED ? "auto" : "smooth",
        });
      }
      return;
    }
    const p = point.getBoundingClientRect();
    const box = scroller.getBoundingClientRect();
    if (p.top < box.top + 4) scroller.scrollTop += p.top - box.top - 8;
    else if (p.bottom > box.bottom - 4)
      scroller.scrollTop += p.bottom - box.bottom + 8;
  }

  // scroll-spy：以「顶部越过导航线下方」的最后一条为当前位置；触底时取最后一条。
  // 页面顶端不写 hash（保持 /about/ 干净），滚进正文后才用 replaceState 同步。
  // 程序化导航（轴点点击/深链接）的滚动期间暂停 spy——否则起步瞬间 spy 会把
  // 刚设置的高亮/hash 抢回落点之前的条目（observed：点日记却被改回事件）。
  let navQuiet = false;
  let navQuietTimer = 0;
  function tlBeginNav() {
    navQuiet = true;
    window.clearTimeout(navQuietTimer);
    navQuietTimer = window.setTimeout(() => {
      navQuiet = false;
    }, 1200);
    // scrollend（现代浏览器）在平滑滚动结束时立即解除抑制
    window.addEventListener(
      "scrollend",
      () => {
        navQuiet = false;
      },
      { once: true }
    );
  }

  function tlSpy() {
    if (navQuiet) return;
    const entries = tlEntries();
    if (entries.length === 0) return;
    let index = 0;
    for (let i = 0; i < entries.length; i++) {
      if (entries[i].getBoundingClientRect().top <= 100) index = i;
    }
    const doc = document.documentElement;
    if (window.innerHeight + window.scrollY >= doc.scrollHeight - 4) {
      index = entries.length - 1;
    }
    if (index === TL.active) return;
    TL.active = index;
    tlSetActive(index);
    const point = tlPoints()[index];
    if (point) {
      tlRevealPoint(point);
      // 页面顶端不写 hash；「feed」是重定向落点（动态区），保留它不被条目锚点顶掉
      const h = tlHash();
      if (window.scrollY > 40 || (h && h !== "feed")) {
        tlSetHash(point.dataset.anchor ?? "", false);
      }
    }
  }

  let spyRaf = 0;
  function tlOnScroll() {
    if (spyRaf) return;
    spyRaf = window.requestAnimationFrame(() => {
      spyRaf = 0;
      tlSpy();
    });
  }

  // ===== 互动行：本地点赞（纯静态无后端，状态只存本机 localStorage）=====
  const LIKE_STORAGE_KEY = "snark_moment_likes";

  function loadLikes(): Record<string, number> {
    try {
      return JSON.parse(localStorage.getItem(LIKE_STORAGE_KEY) || "{}");
    } catch {
      return {};
    }
  }

  // 首屏/换页后恢复已点赞状态（aria-pressed 驱动样式）
  function tlRestoreLikes() {
    const likes = loadLikes();
    document.querySelectorAll<HTMLButtonElement>(".tl-like").forEach((btn) => {
      if (btn.dataset.like && likes[btn.dataset.like]) {
        btn.setAttribute("aria-pressed", "true");
      }
    });
  }

  // ===== 点赞聚合：Worker /api/likes（KV 计数），失败退回纯本地 =====
  // GET 拉全部聚合数 → ♥ 旁显示真实次数；POST 在点亮时记账（服务端按
  // IP 哈希 24h 去重，重复点赞返回当前数不重复计）。接口不可用就没有数字，
  // 红心行为照旧。
  let likeCounts: Record<string, number> | null = null;

  function updateLikeCount(btn: HTMLButtonElement) {
    const id = btn.dataset.like ?? "";
    if (!id) return;
    const n = likeCounts?.[id] ?? 0;
    let span = btn.querySelector<HTMLElement>(".tl-like__count");
    if (!span) {
      span = document.createElement("span");
      span.className = "tl-like__count";
      btn.appendChild(span);
    }
    if (n > 0) {
      span.textContent = String(n);
      span.hidden = false;
    } else {
      span.hidden = true;
    }
  }

  function fetchLikeCounts() {
    fetch("/api/likes")
      .then((r) => (r.ok ? r.json() : null))
      .then(
        (
          data: { ok?: boolean; likes?: Record<string, number> } | null
        ) => {
          if (!data?.likes) return;
          likeCounts = data.likes;
          document
            .querySelectorAll<HTMLButtonElement>(".tl-like")
            .forEach(updateLikeCount);
        }
      )
      .catch(() => {
        /* 聚合不可用：退回纯本地点赞 */
      });
  }

  function postLike(id: string, btn: HTMLButtonElement) {
    fetch("/api/likes", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ id }),
    })
      .then((r) => (r.ok ? r.json() : null))
      .then((data: { ok?: boolean; count?: number } | null) => {
        if (!data || typeof data.count !== "number") return;
        likeCounts = likeCounts ?? {};
        likeCounts[id] = data.count;
        updateLikeCount(btn);
      })
      .catch(() => {
        /* 记账失败：红心照旧，下次点赞会重试 */
      });
  }

  function tlLikeClick(e: MouseEvent) {
    const btn = (e.target as HTMLElement | null)?.closest?.(
      ".tl-like"
    ) as HTMLButtonElement | null;
    if (!btn || !btn.dataset.like) return;
    const liked = btn.getAttribute("aria-pressed") === "true";
    btn.setAttribute("aria-pressed", liked ? "false" : "true");
    if (!liked && !TL_REDUCED) {
      btn.classList.remove("is-pop");
      void btn.offsetWidth;
      btn.classList.add("is-pop");
    }
    const likes = loadLikes();
    if (liked) delete likes[btn.dataset.like];
    else {
      likes[btn.dataset.like] = 1;
      postLike(btn.dataset.like, btn);
    }
    try {
      localStorage.setItem(LIKE_STORAGE_KEY, JSON.stringify(likes));
    } catch {
      /* 隐私模式等存不进就当次会话有效 */
    }
  }

  // 目录导航：轴点 → 对应条目（点击 push hash，键盘/历史恢复只 replace）
  function tlGo(point: HTMLElement, push: boolean) {
    const article = document.getElementById(point.dataset.anchor ?? "");
    if (!article) return;
    const idx = Number(point.dataset.index ?? "-1");
    if (idx >= 0) {
      TL.active = idx;
      tlSetActive(idx);
    }
    tlSetHash(point.dataset.anchor ?? "", push);
    tlRevealPoint(point);
    tlBeginNav();
    tlScrollToEntry(article);
  }

  function tlClick(e: MouseEvent) {
    const point = (e.target as HTMLElement | null)?.closest?.(
      ".timeline-point"
    ) as HTMLElement | null;
    if (point) tlGo(point, true);
  }

  function tlKeydown(e: KeyboardEvent) {
    const target = e.target as HTMLElement | null;
    const point = target?.closest?.(".timeline-point") as HTMLElement | null;
    if (!point) return;
    const pts = tlPoints();
    const idx = Number(point.dataset.index ?? "-1");

    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      tlGo(point, true);
      return;
    }

    let next: number | null = null;
    if (e.key === "ArrowDown" || e.key === "ArrowRight")
      next = Math.min(pts.length - 1, idx + 1);
    else if (e.key === "ArrowUp" || e.key === "ArrowLeft")
      next = Math.max(0, idx - 1);
    else if (e.key === "Home") next = 0;
    else if (e.key === "End") next = pts.length - 1;
    if (next === null) return;

    e.preventDefault();
    pts[next]?.focus();
    if (pts[next]) tlGo(pts[next], false);
  }

  function tlHistory() {
    const entries = tlEntries();
    if (entries.length === 0) return;
    const hash = tlHash();
    // 后退到没有 hash 的初始状态：回到最新一条（页面顶部）
    if (!hash) {
      if (TL.active !== 0) {
        TL.active = 0;
        tlSetActive(0);
      }
      window.scrollTo({ top: 0, behavior: TL_REDUCED ? "auto" : "smooth" });
      return;
    }
    const target = entries.find((el) => el.id === hash);
    if (!target) return;
    const idx = entries.indexOf(target);
    if (idx !== TL.active) {
      TL.active = idx;
      tlSetActive(idx);
      tlRevealPoint(tlPoints()[idx]);
    }
    tlScrollToEntry(target);
  }

  function tlInit() {
    TL.active = null;
    const entries = tlEntries();
    if (entries.length === 0) return;
    tlRestoreLikes();
    tlBuildImageGrids();
    tlInitComments();
    const hash = tlHash();
    const target = hash ? entries.find((el) => el.id === hash) : undefined;
    if (target) {
      // 深链接进入：浏览器原生锚点滚动已落位，这里兜底一次并同步轴点高亮
      const idx = entries.indexOf(target);
      TL.active = idx;
      tlSetActive(idx);
      tlRevealPoint(tlPoints()[idx]);
      tlBeginNav();
      requestAnimationFrame(() => tlScrollToEntry(target));
      window.setTimeout(() => tlScrollToEntry(target), 180);
      return;
    }
    // 非条目锚点（如 /timeline 重定向落点 #feed）：加载期布局会重排（图片九宫格），
    // 原生锚点滚动常落空，这里等重排后兜底滚到位
    if (hash) {
      const anchorEl = document.getElementById(hash);
      if (anchorEl) {
        window.setTimeout(
          () =>
            anchorEl.scrollIntoView({
              behavior: TL_REDUCED ? "auto" : "smooth",
              block: "start",
            }),
          220,
        );
      }
    }
    // 无深链接：默认高亮最新一条（页面顶部）
    tlSpy();
  }

  // ===== 纪事内容解锁（AES-GCM，答案解密）=====
  // 构建期已把带 lock 的正文加密成密文（明文不进产物）；浏览器端用答案经
  // PBKDF2 派生密钥解密，成功后在当前会话记忆，无需重复输入。
  const PBKDF2_ITERATIONS = 120000;
  const LOCK_STORAGE_KEY = "snark_locked_entries";

  function b64ToBuf(b64: string): ArrayBuffer {
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes.buffer as ArrayBuffer;
  }

  // 解密后的 markdown 原文做最简渲染：按空行分段 → <p>，单换行 → <br>
  function renderPlainMd(text: string): string {
    const blocks = text.split(/\n{2,}/).map((b) => b.trim()).filter(Boolean);
    if (blocks.length === 0) return "";
    return blocks
      .map((b) => `<p>${b.replace(/\n/g, "<br>")}</p>`)
      .join("");
  }

  async function decryptBlock(box: HTMLElement, answer: string): Promise<string | null> {
    const ciphertext = box.dataset.ciphertext ?? "";
    const salt = box.dataset.salt ?? "";
    const iv = box.dataset.iv ?? "";
    if (!ciphertext || !salt || !iv) return null;
    try {
      const enc = new TextEncoder();
      const saltBuf = b64ToBuf(salt);
      const ivBuf = b64ToBuf(iv);
      // 密文 = [GCM tag(16B) | ciphertext]，整体作为 AES-GCM 的 ciphertext 传入
      const combined = b64ToBuf(ciphertext);

      const keyMaterial = await crypto.subtle.importKey(
        "raw",
        enc.encode(answer.normalize("NFC").trim()),
        "PBKDF2",
        false,
        ["deriveKey"]
      );
      const key = await crypto.subtle.deriveKey(
        { name: "PBKDF2", salt: saltBuf, iterations: PBKDF2_ITERATIONS, hash: "SHA-256" },
        keyMaterial,
        { name: "AES-GCM", length: 256 },
        false,
        ["decrypt"]
      );
      const plain = await crypto.subtle.decrypt(
        { name: "AES-GCM", iv: ivBuf, tagLength: 128 },
        key,
        combined
      );
      return new TextDecoder().decode(plain);
    } catch {
      return null;
    }
  }

  // 会话记忆：记录已解锁条目的 id → 明文
  function loadLocks(): Record<string, string> {
    try {
      return JSON.parse(sessionStorage.getItem(LOCK_STORAGE_KEY) || "{}");
    } catch {
      return {};
    }
  }
  function saveLock(id: string, plain: string) {
    const locks = loadLocks();
    locks[id] = plain;
    sessionStorage.setItem(LOCK_STORAGE_KEY, JSON.stringify(locks));
  }

  // 解锁成功：锁行高度收起 220ms。max-height 必须从「量出来的实际高度」收到 0，
  // 直接写 auto → 0 不会产生过渡，所以先钉住起始高度、强制 reflow 再改终点。
  function collapseLockRow(box: HTMLElement, reduced: boolean) {
    const parts = [
      box.querySelector<HTMLElement>(".lock-question"),
      box.querySelector<HTMLElement>(".lock-row"),
    ].filter((el): el is HTMLElement => Boolean(el));
    const drop = () => {
      parts.forEach((el) => el.remove());
      box
        .querySelectorAll<HTMLElement>(".lock-input, .lock-btn")
        .forEach((el) => el.remove());
    };
    if (reduced || parts.length === 0) {
      drop();
      return;
    }
    parts.forEach((el) => {
      el.style.maxHeight = `${el.getBoundingClientRect().height}px`;
      el.style.overflow = "hidden";
    });
    void box.offsetHeight; // 强制 reflow：让起始高度生效后再改终点
    parts.forEach((el) => {
      el.style.transition =
        "max-height 220ms var(--ease-ed), opacity 160ms ease, margin-bottom 220ms var(--ease-ed)";
      el.style.maxHeight = "0px";
      el.style.opacity = "0";
      el.style.marginBottom = "0px";
    });
    window.setTimeout(drop, 240);
  }

  function fillLocked(box: HTMLElement, plain: string, animate = true) {
    const contentEl = box.querySelector<HTMLElement>(".lock-content");
    if (!contentEl) return;
    contentEl.innerHTML = renderPlainMd(plain);
    contentEl.hidden = false;
    const err = box.querySelector<HTMLElement>(".lock-error");
    if (err) {
      err.hidden = true;
      err.classList.remove("is-shown");
    }
    box.dataset.unlocked = "1";
    if (animate) {
      // 正文透明揭示（reduced-motion 下 CSS 降级为纯淡入）
      contentEl.classList.add("is-reveal");
      collapseLockRow(box, TL_REDUCED);
      // 边框闪一次砖红（CSS ::after 只动 opacity）
      box.classList.add("is-unlocked");
    } else {
      // 会话记忆恢复 / 首屏直出：不做揭示动画，直接落到终态
      contentEl.classList.remove("is-reveal");
      collapseLockRow(box, true);
      box.classList.remove("is-unlocked");
    }

    // 解锁成功后才放出本条纪事的 BGM：MiniPlayer 带 gated 标记时先隐藏、不自动播放，
    // 由这里显式启动（会话记忆恢复也走同一条路径）。
    const holder = box.closest("article") ?? box.parentElement;
    const player = holder?.querySelector("mini-player") as
      | (HTMLElement & { unlockPlay?: () => void })
      | null;
    player?.unlockPlay?.();
  }

  async function tryUnlock(box: HTMLElement) {
    // 已解锁 / 正在解密：忽略重复提交（PBKDF2 120k 有 100–300ms 空窗）
    if (box.dataset.unlocked === "1" || box.dataset.pending === "1") {
      return;
    }
    const id = box.dataset.lockId ?? "";
    const input = box.querySelector<HTMLInputElement>(".lock-input");
    const answer = input?.value ?? "";
    if (!answer) return;
    // 若已记忆则直接展示
    const memo = loadLocks();
    if (id && memo[id]) {
      fillLocked(box, memo[id]);
      return;
    }

    // pending：按钮禁用 + 文案「解锁中…」，min-width 保证宽度不抖
    const btn = box.querySelector<HTMLButtonElement>(".lock-btn");
    const err = box.querySelector<HTMLElement>(".lock-error");
    box.dataset.pending = "1";
    if (btn) {
      if (!btn.dataset.label) btn.dataset.label = btn.textContent ?? "解锁";
      btn.disabled = true;
      btn.textContent = "解锁中…";
    }
    if (input) input.readOnly = true;

    const plain = await decryptBlock(box, answer);

    delete box.dataset.pending;
    // 解密期间可能已换页 / 被解锁（元素脱离文档），先确认还在
    if (btn?.isConnected) {
      btn.disabled = false;
      btn.textContent = btn.dataset.label ?? "解锁";
    }
    if (input?.isConnected) input.readOnly = false;

    if (plain !== null) {
      if (id) saveLock(id, plain);
      fillLocked(box, plain);
    } else {
      if (err) {
        err.hidden = false;
        void err.offsetWidth; // 先让 display:block 生效（opacity 仍是 0），再淡入
        err.classList.add("is-shown");
      }
      // 输入框轻抖一次；reduced-motion 只保留错误文案淡入
      if (input && !TL_REDUCED) {
        input.classList.remove("is-shake");
        void input.offsetWidth;
        input.classList.add("is-shake");
      }
    }
  }

  // 事件委托：任意条目的 lock-box 都能触发解锁；Enter 提交
  function tlLockClick(e: MouseEvent) {
    const btn = (e.target as HTMLElement | null)?.closest?.(".lock-btn");
    if (!btn) return;
    e.preventDefault();
    const box = btn.closest<HTMLElement>(".lock-box");
    if (box) void tryUnlock(box);
  }
  function tlLockKeydown(e: KeyboardEvent) {
    if (e.key !== "Enter") return;
    const target = e.target as HTMLElement | null;
    if (!target?.classList?.contains("lock-input")) return;
    e.preventDefault();
    const box = target.closest<HTMLElement>(".lock-box");
    if (box) void tryUnlock(box);
  }

  // 初始加载：把已记忆的加密条目直接呈现（若页面含其 lock-box）
  document.querySelectorAll<HTMLElement>(".lock-box").forEach((box) => {
    const id = box.dataset.lockId ?? "";
    const locks = loadLocks();
    if (id && locks[id]) fillLocked(box, locks[id], false);
  });

  // ===== 条目评论：每条一个 giscus 讨论串（specific 映射，term=条目锚点）=====
  // 「有没有评论」用免鉴权 GitHub Discussions REST 探测（60 次/小时/IP，
  // sessionStorage 缓存 10 分钟）：有评论的条目直接展开，没有的点互动行按钮
  // 才注入 giscus（沿用全站「不点不请求 giscus.app」的首屏策略）。
  // 探测失败（限流/离线）则降级为全部「点按钮才加载」。
  const COMMENTS_CACHE_KEY = "snark_giscus_counts";
  const COMMENTS_CACHE_MS = 10 * 60 * 1000;

  async function fetchCommentCounts(): Promise<Record<string, number> | null> {
    try {
      const raw = sessionStorage.getItem(COMMENTS_CACHE_KEY);
      if (raw) {
        const cached = JSON.parse(raw) as { t?: number; d?: Record<string, number> };
        if (cached?.t && Date.now() - cached.t < COMMENTS_CACHE_MS && cached.d) {
          return cached.d;
        }
      }
    } catch {
      /* 缓存读不到就走网络 */
    }
    try {
      const res = await fetch(
        `https://api.github.com/repos/${GISCUS_REPO}/discussions?per_page=100`,
        { headers: { Accept: "application/vnd.github+json" } }
      );
      if (!res.ok) return null;
      const list = (await res.json()) as { title?: unknown; comments?: unknown }[];
      if (!Array.isArray(list)) return null;
      const counts: Record<string, number> = {};
      for (const d of list) {
        // giscus 的 specific 映射创建的讨论串，标题就是 term（条目锚点）
        if (typeof d.title === "string" && typeof d.comments === "number") {
          counts[d.title] = d.comments;
        }
      }
      try {
        sessionStorage.setItem(
          COMMENTS_CACHE_KEY,
          JSON.stringify({ t: Date.now(), d: counts })
        );
      } catch {
        /* 隐私模式存不进就每次现拉 */
      }
      return counts;
    } catch {
      return null;
    }
  }

  function loadEntryGiscus(container: HTMLElement) {
    if (container.dataset.loaded === "1") return;
    container.dataset.loaded = "1";
    // 主题走同源 endpoint /giscus-theme.css（与文章页评论同一套皮肤）
    const themeUrl = new URL("/giscus-theme.css", location.origin).href;
    const script = document.createElement("script");
    script.async = true;
    script.crossOrigin = "anonymous";
    const attrs: Record<string, string> = {
      "data-repo": GISCUS_REPO,
      "data-repo-id": GISCUS_REPO_ID,
      "data-category": GISCUS_CATEGORY,
      "data-category-id": GISCUS_CATEGORY_ID,
      "data-mapping": "specific",
      "data-term": container.dataset.term ?? "",
      "data-strict": "0",
      "data-reactions-enabled": "0",
      "data-emit-metadata": "0",
      "data-input-position": "bottom",
      "data-lang": "zh-CN",
      "data-loading": "lazy",
    };
    for (const [k, v] of Object.entries(attrs)) script.setAttribute(k, v);
    script.setAttribute("data-theme", themeUrl);
    script.src = "https://giscus.app/client.js";
    container.appendChild(script);
  }

  function showEntryComments(anchor: string, expand: boolean) {
    const container = document.getElementById(`tl-comments-${anchor}`);
    const btn = document.querySelector<HTMLButtonElement>(
      `.tl-comment[data-comment="${CSS.escape(anchor)}"]`
    );
    if (!container) return;
    container.hidden = !expand;
    if (expand) loadEntryGiscus(container);
    btn?.setAttribute("aria-expanded", expand ? "true" : "false");
  }

  function tlCommentClick(e: MouseEvent) {
    const btn = (e.target as HTMLElement | null)?.closest?.(
      ".tl-comment"
    ) as HTMLButtonElement | null;
    if (!btn?.dataset.comment) return;
    showEntryComments(
      btn.dataset.comment,
      btn.getAttribute("aria-expanded") !== "true"
    );
  }

  // 空闲 1.5s 后再探测评论数 / 拉取点赞聚合（不与首屏资源抢路）；
  // giscus 注入只发生在需要时
  function tlInitComments() {
    window.setTimeout(async () => {
      fetchLikeCounts();
      const counts = await fetchCommentCounts();
      if (!counts) return;
      document.querySelectorAll<HTMLElement>(".tl-comments").forEach((c) => {
        const term = c.dataset.term ?? "";
        if (term && (counts[term] ?? 0) > 0) showEntryComments(term, true);
      });
    }, 1500);
  }

  // ===== 九宫格：条目内连续图片重排为方格缩略图（点击走全站 lightbox）=====
  // 朋友圈式排版：同一 <p> 或相邻 <p> 的图片归为一组；1 图占 2/3 宽，
  // 2~3 图一行三列，4 图两行两列，5 图起一行三列。散落的单图保持原位不动。
  function tlBuildImageGrids() {
    document.querySelectorAll<HTMLElement>(".tl-entry .prose").forEach((prose) => {
      if (prose.dataset.gridDone === "1") return;
      prose.dataset.gridDone = "1";

      const isImgNode = (n: Node): n is HTMLImageElement =>
        n.nodeType === 1 && (n as HTMLElement).tagName === "IMG";
      // <p> 仅含一张图（其余是空白）→ 以 <p> 为组员；否则以 img 自身为组员
      const groupAnchor = (n: Node): Node | null => {
        if (isImgNode(n)) return n;
        if (n.nodeType !== 1) return null;
        const el = n as HTMLElement;
        if (el.tagName !== "P") return null;
        const children = Array.from(el.childNodes).filter(
          (c) => !(c.nodeType === 3 && !c.textContent?.trim())
        );
        return children.length === 1 && isImgNode(children[0]) ? el : null;
      };

      // 扫描子节点：连续的图片组员归为一组，中间遇到其他内容即断组
      type Group = { start: ChildNode; members: Node[]; imgs: HTMLImageElement[] };
      const groups: Group[] = [];
      let cur: Group | null = null;
      for (const child of Array.from(prose.childNodes)) {
        if (child.nodeType === 3 && !child.textContent?.trim()) continue; // 空白不断组
        const anchor = groupAnchor(child);
        if (anchor) {
          if (!cur) cur = { start: child, members: [], imgs: [] };
          cur.members.push(child);
          if (isImgNode(anchor)) cur.imgs.push(anchor);
          else anchor.childNodes.forEach((c) => isImgNode(c) && cur!.imgs.push(c));
        } else if (cur) {
          groups.push(cur);
          cur = null;
        }
      }
      if (cur) groups.push(cur);
      if (!groups.length) return;

      for (const g of groups) {
        if (g.imgs.length === 0) continue;
        const cols = g.imgs.length === 1 ? 1 : g.imgs.length === 4 ? 4 : 3;
        const grid = document.createElement("div");
        grid.className = "tl-grid";
        grid.dataset.cols = String(cols);
        g.start.parentElement!.insertBefore(grid, g.start);
        for (const img of g.imgs) {
          const cell = document.createElement("span");
          cell.className = "tl-cell";
          grid.appendChild(cell);
          cell.appendChild(img); // img 从 <p> 原位挪进方格
        }
        // 组员节点内容已搬空：删掉残留的空 <p>
        g.members.forEach((m) => {
          const el = m as HTMLElement;
          if (el.tagName === "P" && !el.textContent?.trim() && !el.querySelector("img")) {
            el.remove();
          }
        });
      }
    });
  }

  // ===== 一次性绑定（换页不重复绑），每次 page-load 重新初始化状态 =====
  if (!TL.bound) {
    TL.bound = true;
    document.addEventListener("click", tlClick);
    document.addEventListener("keydown", tlKeydown);
    document.addEventListener("click", tlLikeClick);
    document.addEventListener("click", tlCommentClick);
    document.addEventListener("click", tlLockClick);
    document.addEventListener("keydown", tlLockKeydown);
    window.addEventListener("popstate", tlHistory);
    window.addEventListener("hashchange", tlHistory);
    window.addEventListener("scroll", tlOnScroll, { passive: true });
    document.addEventListener("astro:page-load", tlInit);
    document.addEventListener("astro:before-swap", () => {
      TL.active = null;
    });
  }
  tlInit();
</script>

<script>
  // ===== 关于页 dock（macOS 风格）：视图切换（关于/动态/拾集）+ 邻近放大 + 点击弹跳。
  // 视图 = data-view（about/feed/collection），URL hash 跟随（#feed / #collection / 空）；
  // VT 换页安全：astro:page-load 重设视图；全局监听只绑一次（每帧重查 DOM）。
  type AboutView = "about" | "feed" | "collection";

  function viewFromHash(hash: string): AboutView {
    const h = decodeURIComponent(hash.replace(/^#/, ""));
    if (h === "collection") return "collection";
    // #feed、动态条目锚点（#moment-xxx）以及其他 hash 都归动态视图
    return h ? "feed" : "about";
  }

  const VIEW_TITLE: Record<AboutView, string> = {
    about: "关于",
    feed: "动态",
    collection: "拾集",
  };

  function applyAboutView(view: AboutView) {
    const layout = document.querySelector<HTMLElement>(".about-layout");
    if (!layout) return;
    layout.dataset.view = view;
    document.querySelectorAll<HTMLElement>("[data-dock-view]").forEach((item) => {
      item.classList.toggle("is-active", item.dataset.dockView === view);
      item.setAttribute("aria-pressed", item.dataset.dockView === view ? "true" : "false");
    });
    // 页头标题跟视图走（移动端三块堆叠，固定「关于」）；拾集计数只在拾集视图显示
    const mobile = window.matchMedia("(max-width: 767px)").matches;
    const title = document.querySelector<HTMLElement>("[data-view-title]");
    if (title) title.textContent = mobile ? VIEW_TITLE.about : VIEW_TITLE[view];
    const aside = document.querySelector<HTMLElement>("[data-view-aside]");
    if (aside) aside.hidden = mobile || view !== "collection";
    // 拾集书架在隐藏时无法测量宽度：切换后抛一次 resize 让书架脚本重排
    window.dispatchEvent(new Event("resize"));
  }

  // 强制瞬时滚动：html 上全局 scroll-behavior:smooth 会把 auto 也变平滑
  function instantScrollTop() {
    const html = document.documentElement;
    const prev = html.style.scrollBehavior;
    html.style.scrollBehavior = "auto";
    window.scrollTo(0, 0);
    html.style.scrollBehavior = prev;
  }

  let dockGlobalBound = false;

  function initAboutDock() {
    const dock = document.querySelector<HTMLElement>(".about-dock");
    if (!dock) return;

    // 按当前 hash 重新校准视图（VT 返回本页时 DOM 被替换）
    applyAboutView(viewFromHash(location.hash));

    // 点击 dock：切视图 + 同步 hash + 回顶 + 弹跳
    dock.querySelectorAll<HTMLButtonElement>("[data-dock-view]").forEach((btn) => {
      if (btn.dataset.dockBound) return;
      btn.dataset.dockBound = "1";
      btn.addEventListener("click", () => {
        btn.classList.remove("is-bounce");
        void btn.offsetWidth; // 重置动画，连点可重播
        btn.classList.add("is-bounce");
        btn.addEventListener(
          "animationend",
          () => btn.classList.remove("is-bounce"),
          { once: true },
        );
        const view = (btn.dataset.dockView ?? "about") as AboutView;
        applyAboutView(view);
        const url = view === "about" ? location.pathname : `${location.pathname}#${view}`;
        history.replaceState(null, "", url);
        instantScrollTop();
      });
    });

    // 邻近放大：指针距图标中心越近图标越大（1 → 1.3，二次衰减）。
    // 不按 pointer 类型守卫：触屏上指针远离时缩放保持 1，行为等价。
    if (!dockGlobalBound) {
      dockGlobalBound = true;
      const MAX = 0.3;
      const RANGE = 90;
      let raf = 0;
      let px = -9999;
      let py = -9999;
      const frame = () => {
        raf = 0;
        // 每帧重查（VT 换页会替换 DOM）；每个 dock 项按自身距离独立放大
        document.querySelectorAll<HTMLElement>(".about-dock__item").forEach((item) => {
          const r = item.getBoundingClientRect();
          const d = Math.hypot(px - (r.left + r.width / 2), py - (r.top + r.height / 2));
          const t = Math.max(0, 1 - d / RANGE);
          item.style.setProperty("--dock-scale", (1 + MAX * t * t).toFixed(3));
        });
      };
      window.addEventListener(
        "pointermove",
        (e) => {
          px = e.clientX;
          py = e.clientY;
          if (!raf) raf = requestAnimationFrame(frame);
        },
        { passive: true },
      );
      // 前进/后退修改 hash 时同步视图
      window.addEventListener("hashchange", () => applyAboutView(viewFromHash(location.hash)));
    }
  }

  document.addEventListener("astro:page-load", initAboutDock);
  initAboutDock();
</script>

<script>
  // ===== 立体书架：按 Wenku8_Flutter 的几何与物理 =====
  const DEPTH_X = 0.66, DEPTH_Y = -0.30, RADIUS = 1.48;

  type Bank = { root: HTMLElement; layout: () => void; step: (d: number) => void; refresh: () => void };
  const banks: Bank[] = [];

  function makeBank(root: HTMLElement): Bank {
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const foot = root.querySelector<HTMLElement>("[data-bankfoot]");
    const vols = Array.from(stage.querySelectorAll<HTMLElement>(".vol"));
    const shadows = Array.from(stage.querySelectorAll<HTMLElement>(".vshadow"));
    const n = vols.length;
    const mode = root.dataset.mode || "book";
    let S = 18, C = 128, H = 206, FOOT = S + C * DEPTH_X, BASEY = -C * DEPTH_Y + H * 0.6 + 12, PITCH = 30;
    let focus = Math.floor((n - 1) / 2);
    let dragging = false, lastX = 0, lastT = 0, vel = 0;
    let wheelAccum = 0; // 垂直滚轮累积量 → 攒够一格横移一档

    function measure() {
      const W = stage.clientWidth || 520;
      if (mode === "album") {
        // 专辑：方形封面，无书脊；沿用同样的扇面排布与抽出动画
        C = Math.max(120, Math.min(172, W * 0.15));
        S = 0;
        H = C;
        FOOT = C * DEPTH_X;
        BASEY = 46;
        PITCH = Math.max(44, Math.min(120, C * 0.55));
        stage.style.height = H + 96 + "px";
      } else {
        S = Math.max(14, Math.min(18, W * 0.043));
        C = Math.max(100, Math.min(128, W * 0.32));
        H = ((C - 20) * 166) / 118 + 54;
        FOOT = S + C * DEPTH_X;
        BASEY = -C * DEPTH_Y + H * 0.6 + 12;
        PITCH = Math.max(22, Math.min(150, (W - FOOT) / Math.max(1, n - 1)));
        stage.style.height = BASEY + H + 70 + "px";
      }
      stage.style.setProperty("--S", S + "px");
      stage.style.setProperty("--C", C + "px");
      stage.style.setProperty("--H", H + "px");
      stage.style.setProperty("--FOOT", FOOT + "px");
    }
    const railY = (_d: number) => 0; // 不要弧度：整排压平
    const weight = (d: number) => { const a = Math.abs(d); if (a >= RADIUS) return 0; const v = Math.cos((a / RADIUS) * Math.PI / 2); return v * v; };

    function layout() {
      const W = stage.clientWidth || 520;
      const cx = W / 2;
      vols.forEach((el, i) => {
        const d = i - focus;
        const w = weight(d);
        const lift = w * w * (3 - 2 * w);
        let ox: number, oy: number;
        // 桌面端默认不抬起中间那一本（悬停/点击仍可交互）；小屏保留抬起
        const liftK = window.matchMedia("(min-width: 1024px)").matches ? 0 : 1;
        if (mode === "album") {
          const pull = C * 0.30 * w * (1.24 - 0.24 * w);
          ox = -pull * DEPTH_X;
          oy = BASEY - H * 0.16 * lift * liftK;
        } else {
          const pull = C * 0.78 * w * (1.24 - 0.24 * w);
          ox = -pull * DEPTH_X;
          oy = BASEY + 0.30 * pull - H * 0.28 * lift * liftK;
        }
        const xSlot = cx - FOOT / 2 + d * PITCH;
        el.style.transform = `translate(${(xSlot + ox).toFixed(2)}px, ${(railY(d) + oy).toFixed(2)}px)`;
        el.style.zIndex = String(200 - Math.round(Math.abs(d) * 8));
        const sh = shadows[i];
        if (sh) {
          sh.style.transform = `translate(${xSlot.toFixed(2)}px, ${(railY(d) + BASEY + H - 6).toFixed(2)}px)`;
          sh.style.opacity = String(Math.max(0.15, 0.95 - Math.abs(d) * 0.08));
        }
      });
      const focusIdx = Math.max(0, Math.min(n - 1, Math.round(focus)));
      vols.forEach((el, i) => el.classList.toggle("is-focus", i === focusIdx));
      if (foot) {
        const el = vols[focusIdx];
        const t = el?.dataset.title ?? "";
        const a = el?.dataset.creator ?? "";
        foot.textContent = t ? `${String(Math.round(focus) + 1).padStart(2, "0")} / ${String(n).padStart(2, "0")}　${t} · ${a}` : "";
      }
    }

    function animateTo(t: number) {
      // 位置由 CSS transition 平滑过渡，只设置目标焦点
      focus = Math.max(0, Math.min(n - 1, t));
      layout();
    }

    function step(d: number) { animateTo(Math.round(focus) + d); }
    function refresh() { measure(); layout(); }

    let startX = 0, moved = false;
    stage.addEventListener("pointerdown", (e) => {
      dragging = true; moved = false; startX = e.clientX; lastX = e.clientX; lastT = performance.now(); vel = 0;
    });
    stage.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      if (!moved && Math.abs(e.clientX - startX) > 5) { moved = true; root.classList.add("is-drag"); }
      if (!moved) return;
      const now = performance.now();
      const dx = e.clientX - lastX;
      const dt = Math.max(1, now - lastT);
      vel = dx / dt;
      focus = Math.max(0, Math.min(n - 1, focus - dx / PITCH));
      layout();
      lastX = e.clientX; lastT = now;
    });
    const endDrag = (e?: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      root.classList.remove("is-drag");
      if (moved) {
        (window as any).__shelfSuppressClick = performance.now();
        const projected = focus - vel * 10;
        animateTo(Math.round(projected));
      } else if (e) {
        // 轻点：命中处找书，命中不到就取离指针最近的一本（等距斜面 bbox 可能偏）
        const hit = document.elementFromPoint(e.clientX, e.clientY) as HTMLElement | null;
        let cover = hit?.closest?.("[data-cover]") as HTMLElement | null;
        if (!cover) {
          let best: HTMLElement | null = null, bd = 1e9;
          vols.forEach((v) => {
            const r = v.getBoundingClientRect();
            const dx = Math.max(r.left - e.clientX, 0, e.clientX - r.right);
            const dy = Math.max(r.top - e.clientY, 0, e.clientY - r.bottom);
            const d = Math.hypot(dx, dy);
            if (d < bd) { bd = d; best = v; }
          });
          if (best && bd < 36) cover = best;
        }
        if (cover) { (window as any).__shelfSuppressClick = performance.now(); openDetail(cover); }
      }
    };
    stage.addEventListener("pointerup", (e) => endDrag(e));
    stage.addEventListener("pointercancel", () => endDrag());
    stage.addEventListener("wheel", (e) => {
      // 垂直滚轮 → 横向滑动（像手机上横着拖一样）：deltaY 累积，攒够一格翻一档；
      // deltaX（触控板横扫）维持原有逐档翻页。
      // 已到边界时放行默认滚动，页面继续纵滚、不把用户卡死在架子上。
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
        e.preventDefault();
        step(Math.sign(e.deltaX));
        return;
      }
      if (e.deltaY === 0) return;
      e.preventDefault();
      const atStart = focus <= 0 && e.deltaY < 0;
      const atEnd = focus >= n - 1 && e.deltaY > 0;
      if (atStart || atEnd) return; // 不 preventDefault，交给页面滚动
      wheelAccum += e.deltaY;
      const stepWidth = 53; // 一格档位的滚轮行程（约 3~4 行 standard notches）
      while (wheelAccum >= stepWidth) { step(1); wheelAccum -= stepWidth; }
      while (wheelAccum <= -stepWidth) { step(-1); wheelAccum += stepWidth; }
    }, { passive: false });
    root.querySelectorAll<HTMLElement>("[data-banknav]").forEach((btn) => {
      btn.addEventListener("click", () => step(Number(btn.dataset.banknav || "0")));
    });
    stage.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); step(1); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); step(-1); }
    });
    window.addEventListener("resize", () => { measure(); layout(); });

    return { root, layout, step, refresh };
  }

  function initBanks() {
    banks.length = 0;
    document.querySelectorAll<HTMLElement>("[data-bank]").forEach((root) => {
      const b = makeBank(root);
      banks.push(b);
      b.refresh();
    });
  }

  type Album = { root: HTMLElement; refresh: () => void };
  const albums: Album[] = [];
  function makeAlbums(root: HTMLElement): Album {
    const track = root.querySelector<HTMLElement>("[data-albumtrack]")!;
    let pending = false;
    function update() {
      const tr = track.getBoundingClientRect();
      const cx = tr.left + tr.width / 2;
      track.querySelectorAll<HTMLElement>(".album").forEach((it) => {
        const r = it.getBoundingClientRect();
        const d = Math.abs(r.left + r.width / 2 - cx);
        const range = Math.max(120, r.width * 1.5);
        let w = 0;
        if (d < range) w = 0.5 + 0.5 * Math.cos((d / range) * Math.PI);
        it.style.transform = `translateY(${(-6 * w).toFixed(2)}px) scale(${(1 + 0.06 * w).toFixed(3)})`;
        it.style.zIndex = String(Math.round(w * 100));
      });
    }
    track.addEventListener("scroll", () => {
      if (pending) return; pending = true;
      requestAnimationFrame(() => { pending = false; update(); });
    }, { passive: true });
    // 垂直滚轮 → 横向滑动（原生横滚容器）：平滑滚动一格；
    // 到边界时放行默认滚动，页面继续纵滚。触控板 deltaX 走浏览器原生横滚，不抢。
    track.addEventListener("wheel", (e) => {
      if (Math.abs(e.deltaX) >= Math.abs(e.deltaY) || e.deltaY === 0) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (maxScroll <= 0) return;
      const goingRight = e.deltaY > 0;
      const atStart = track.scrollLeft <= 0 && !goingRight;
      const atEnd = track.scrollLeft >= maxScroll - 1 && goingRight;
      if (atStart || atEnd) return;
      e.preventDefault();
      track.scrollBy({ left: goingRight ? 190 : -190, behavior: "smooth" });
    }, { passive: false });
    root.querySelectorAll<HTMLElement>("[data-albumnav]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const first = track.querySelector<HTMLElement>(".album");
        const pitch = first ? first.offsetWidth + 18 : 190;
        track.scrollBy({ left: Number(btn.dataset.albumnav || "0") * pitch, behavior: "smooth" });
      });
    });
    window.addEventListener("resize", update);
    return { root, refresh: update };
  }
  function initAlbums() {
    albums.length = 0;
    document.querySelectorAll<HTMLElement>("[data-albums]").forEach((root) => {
      const a = makeAlbums(root);
      albums.push(a);
      a.refresh();
    });
  }

  // ===== 筛选：淡出/收起 → 落定后再 hidden；按书架 30ms 交错 =====
  const FILTER_MS = 200;
  const FILTER_STAGGER = 30;
  const shelfTimers = new WeakMap<HTMLElement, number>();
  const colReduced = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // 用内联 transition 驱动：全局 .reveal 也给 .col-shelf 声明了 transition，
  // 走类名会和它抢属性；内联样式优先级更高，且随时可被下一次点击打断。
  function shelfToggle(sec: HTMLElement, show: boolean, delay: number) {
    const prev = shelfTimers.get(sec);
    if (prev) { window.clearTimeout(prev); shelfTimers.delete(sec); }
    const target = show ? "in" : "out";
    if (sec.dataset.shelfState === target && !sec.hidden === show) return;
    sec.dataset.shelfState = target;
    const st = sec.style;

    if (colReduced()) {
      st.transition = ""; st.transitionDelay = "";
      st.maxHeight = ""; st.overflow = ""; st.opacity = ""; st.transform = "";
      sec.classList.remove("is-filtering-out");
      sec.hidden = !show;
      return;
    }

    st.transition = `opacity ${FILTER_MS}ms var(--ease-ed), transform ${FILTER_MS}ms var(--ease-ed), max-height ${FILTER_MS}ms var(--ease-ed)`;
    st.transitionDelay = `${delay}ms`;

    if (show) {
      sec.hidden = false;
      st.overflow = "hidden";
      st.maxHeight = "0px";
      st.opacity = "0";
      st.transform = "translateY(4px)";
      void sec.offsetHeight; // 起始值生效后再改终点，过渡才会真的跑
      st.maxHeight = `${sec.scrollHeight}px`;
      st.opacity = "1";
      st.transform = "translateY(0)";
      shelfTimers.set(sec, window.setTimeout(() => {
        // 撤掉临时约束，避免裁掉悬停溢出
        st.maxHeight = ""; st.overflow = "";
        st.transition = ""; st.transitionDelay = "";
        shelfTimers.delete(sec);
      }, FILTER_MS + delay + 40));
    } else {
      sec.classList.add("is-filtering-out");
      st.overflow = "hidden";
      st.maxHeight = `${sec.offsetHeight}px`;
      void sec.offsetHeight;
      st.maxHeight = "0px";
      st.opacity = "0";
      st.transform = "translateY(4px)";
      shelfTimers.set(sec, window.setTimeout(() => {
        sec.hidden = true;
        sec.classList.remove("is-filtering-out");
        st.maxHeight = ""; st.overflow = ""; st.opacity = ""; st.transform = "";
        st.transition = ""; st.transitionDelay = "";
        shelfTimers.delete(sec);
      }, FILTER_MS + delay + 40));
    }
  }

  function refreshBanks() {
    banks.forEach((b) => { if (!b.root.closest<HTMLElement>("[data-section]")?.hidden) b.refresh(); });
    albums.forEach((a) => { if (!a.root.closest<HTMLElement>("[data-section]")?.hidden) a.refresh(); });
  }

  function initFilter() {
    const chips = Array.from(document.querySelectorAll<HTMLElement>("[data-filter]"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-section]"));
    sections.forEach((sec) => { if (!sec.hidden) sec.dataset.shelfState = "in"; });
    chips.forEach((chip) => {
      if (chip.dataset.filterBound === "1") return; // astro:page-load 会重复 init
      chip.dataset.filterBound = "1";
      chip.addEventListener("click", () => {
        const f = chip.dataset.filter || "all";
        chips.forEach((c) => { const on = c === chip; c.classList.toggle("is-active", on); c.setAttribute("aria-selected", on ? "true" : "false"); });
        sections.forEach((sec, i) => shelfToggle(sec, f === "all" || sec.dataset.cat === f, i * FILTER_STAGGER));
        // 新出现的段要立刻重算几何（隐藏段此时已 visible、只是 opacity 0）
        requestAnimationFrame(refreshBanks);
        window.setTimeout(refreshBanks, FILTER_MS + sections.length * FILTER_STAGGER + 60);
      });
    });
  }

  const dialog = () => document.getElementById("col-dialog") as HTMLDialogElement | null;
  let closeTimer = 0;
  // 关闭：先播 220ms 退场（.is-closing，transition 型），过渡结束再真正 close()。
  // transitionend 在中途被打断时不触发、子元素事件还会冒泡，改用与退场时长对齐的定时器收尾；
  // 连点关闭 / 后台标签页也都有兜底，不会卡住打不开。
  function closeDetail() {
    const dlg = dialog();
    if (!dlg || !dlg.open) return;
    if (colReduced()) { dlg.classList.remove("is-closing"); dlg.close(); return; }
    if (dlg.classList.contains("is-closing")) return;
    dlg.classList.add("is-closing");
    const finish = () => {
      window.clearTimeout(closeTimer);
      dlg.classList.remove("is-closing");
      if (dlg.open) dlg.close();
    };
    closeTimer = window.setTimeout(finish, 220);
  }

  function openDetail(btn: HTMLElement) {
    const dlg = dialog(); if (!dlg) return;
    const d = btn.dataset;
    const kind = d.kind ?? "book";
    const $ = (id: string) => document.getElementById(id);

    const code = $("cd-code");
    const cat = $("cd-cat");
    const en = $("cd-en");
    const title = $("cd-title");
    const by = $("cd-by");
    const cover = $("cd-cover");
    const coverTitle = cover?.querySelector<HTMLElement>("[data-cd-cover-title]");

    if (code) code.textContent = d.code ?? "";
    if (cat) cat.textContent = d.cat ?? "";
    if (en) en.textContent = d.en ?? "";
    if (title) title.textContent = d.title ?? "";
    if (by) {
      const yr = d.year && d.year !== "0" ? ` · ${d.year}` : "";
      by.textContent = `${d.creator ?? ""}${yr}`;
    }

    // 评分：大号数字 + 来源/人数 + 进度条（scaleX = 分值 × 10%）
    const score = $("cd-score");
    const scoreValue = $("cd-score-value");
    const scoreMeta = $("cd-score-meta");
    const scoreFill = $("cd-score-fill");
    const rating = d.rating ? Number(d.rating) : NaN;
    if (score) {
      const hasRating = Number.isFinite(rating) && rating > 0;
      score.hidden = !hasRating;
      if (hasRating) {
        if (scoreValue) scoreValue.textContent = rating.toFixed(1);
        if (scoreFill) scoreFill.style.transform = `scaleX(${Math.max(0.04, Math.min(1, rating * 10 / 100))})`;
        const source = (d.ratingSource ?? "").trim();
        const count = Number(d.ratingCount ?? 0);
        const countText = count >= 10000
          ? `${(count / 10000).toFixed(1).replace(/\.0$/, "")} 万人评价`
          : count > 0 ? `${count} 人评价` : "";
        if (scoreMeta) scoreMeta.textContent = [source, countText].filter(Boolean).join(" · ");
      }
    }

    // 事实行标签：书籍 / 电影 / 剧集各用一套说法
    const factLabels: Record<string, [string, string, string]> = {
      book: ["出版", "年月", "页数"],
      film: ["制片", "上映", "片长"],
      tv: ["制片", "首播", "集数"],
    };
    const labels = factLabels[kind] ?? factLabels.book;
    [["press", labels[0]], ["pubdate", labels[1]], ["pages", labels[2]]].forEach(([key, text]) => {
      const dt = dlg.querySelector(`[data-fact="${key}"] dt`);
      if (dt) dt.textContent = text;
    });

    // 出版信息：空字段整行隐藏，全空则隐藏整个列表
    const facts: Array<[string, string]> = [
      ["press", "cd-press"],
      ["pubdate", "cd-pubdate"],
      ["pages", "cd-pages"],
    ];
    let factCount = 0;
    for (const [key, id] of facts) {
      const row = dlg.querySelector<HTMLElement>(`[data-fact="${key}"]`);
      const dd = $(id);
      const text = ((d[key] as string | undefined) ?? "").trim();
      if (dd) dd.textContent = text;
      if (row) row.hidden = text === "";
      if (text !== "") factCount += 1;
    }
    const factsEl = $("cd-facts");
    if (factsEl) factsEl.hidden = factCount === 0;

    // 分节：简介 / 短评
    const descWrap = $("cd-desc-wrap");
    const desc = $("cd-desc");
    const descText = (d.desc ?? "").trim();
    if (desc) desc.textContent = descText;
    if (descWrap) descWrap.hidden = descText === "";
    const descSrc = $("cd-desc-src") as HTMLAnchorElement | null;
    if (descSrc) {
      const url = d.descSource ?? "";
      if (url) descSrc.href = url;
      descSrc.hidden = url === "";
    }

    const noteWrap = $("cd-note-wrap");
    const note = $("cd-note");
    const noteText = (d.note ?? "").trim();
    if (note) note.textContent = noteText;
    if (noteWrap) noteWrap.hidden = noteText === "";

    // 曲目：同一张专辑在歌单里的所有歌，逐首可点
    const tracksWrap = $("cd-tracks-wrap");
    const tracksEl = $("cd-tracks");
    if (tracksWrap && tracksEl) {
      let tracks: { id: number; name: string }[] = [];
      try { tracks = JSON.parse(d.tracks || "[]"); } catch { tracks = []; }
      tracksEl.replaceChildren(...tracks.map((t, i) => {
        const li = document.createElement("li");
        const idx = document.createElement("span");
        idx.className = "col-dialog__track-idx";
        idx.textContent = String(i + 1).padStart(2, "0");
        const a = document.createElement("a");
        a.href = `https://music.163.com/#/song?id=${t.id}`;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = t.name || "未命名曲目";
        li.append(idx, a);
        return li;
      }));
      tracksWrap.hidden = tracks.length === 0;
    }

    // 外链：有 link 才显示
    const isAlbum = kind === "album";
    const ref = $("cd-ref") as HTMLAnchorElement | null;
    if (ref) {
      const href = d.ref ?? "";
      if (href) {
        ref.href = href;
        ref.textContent = isAlbum
          ? "在网易云播放"
          : href.includes("douban.com") ? "豆瓣条目" : "查看来源";
      }
      ref.hidden = href === "";
    }

    if (cover) {
      if (d.image) {
        // 本地封面用 960w 派生图（弹层大图）；外链图原样
        const imgSrc = d.image.startsWith("/images/covers/") && /\.(jpe?g|png)$/i.test(d.image)
          ? d.image.replace(/^(.*\/)([^/]+)\.(jpe?g|png)$/i, "$1gen/$2-960w.webp")
          : d.image;
        cover.style.backgroundImage = `url("${imgSrc}")`;
        cover.style.backgroundSize = "cover";
        cover.style.backgroundPosition = "center";
      } else {
        cover.style.backgroundImage = "";
        cover.style.setProperty("--cover", d.coverColor ?? "#fefdf8");
        cover.style.setProperty("--ink", d.ink ?? "#2a2620");
      }
    }
    if (coverTitle) coverTitle.textContent = d.image ? "" : (d.title ?? "");

    dlg.dataset.kind = kind;

    if (!dlg.open) {
      dlg.classList.remove("is-closing");
      dlg.showModal();
    }
  }

  let bound = false;
  function bindOnce() {
    if (bound) return; bound = true;
    document.addEventListener("click", (e) => {
      const w = window as unknown as { __shelfSuppressClick?: number };
      if (w.__shelfSuppressClick && performance.now() - w.__shelfSuppressClick < 350) return;
      const target = e.target as HTMLElement | null; if (!target) return;
      if (target.closest("[data-close]")) { closeDetail(); return; }
      let cover = target.closest<HTMLElement>("[data-cover]");
      if (!cover) {
        const bank = target.closest<HTMLElement>("[data-bank]");
        if (bank) {
          const vols = Array.from(bank.querySelectorAll<HTMLElement>(".vol"));
          let best: HTMLElement | null = null, bd = 1e9;
          for (const v of vols) {
            const r = v.getBoundingClientRect();
            const dx = Math.max(r.left - e.clientX, 0, e.clientX - r.right);
            const dy = Math.max(r.top - e.clientY, 0, e.clientY - r.bottom);
            const d = Math.hypot(dx, dy);
            if (d < bd) { bd = d; best = v; }
          }
          if (best && bd < 44) cover = best;
        }
      }
      if (cover) openDetail(cover);
    });
    document.addEventListener("click", (e) => { const dlg = dialog(); if (dlg && dlg.open && e.target === dlg) closeDetail(); });
    document.addEventListener("astro:page-load", () => {
      initBanks(); initAlbums(); initFilter(); bindDialogEsc();
    });
    document.addEventListener("astro:before-swap", () => { banks.length = 0; dialog()?.close(); });
  }

  // Esc 也走同一条退场动画（cancel 事件不冒泡，直接绑在 dialog 上）
  function bindDialogEsc() {
    const dlg = dialog();
    if (!dlg || dlg.dataset.escBound === "1") return;
    dlg.dataset.escBound = "1";
    dlg.addEventListener("cancel", (e) => {
      if (!dlg.classList.contains("is-closing")) e.preventDefault();
      closeDetail();
    });
  }

  bindOnce();
  initBanks();
  initAlbums();
  initFilter();
  bindDialogEsc();
</script>

<script>
  // ===== 动态视图：时间线阅读进度 =====
  // 基线是浅色发丝线，滚动时 ::after 进度线（2px 墨色）从顶部画下来——
  // 滚到哪条数据，轴线就加深加粗到哪；当前条目的节点同步点亮（.is-current）。
  let tlProgressRaf = 0;

  function updateTimelineProgress() {
    tlProgressRaf = 0;
    const feed = document.getElementById("timeline-feed");
    if (!feed) return;
    if (getComputedStyle(feed).display === "none") return; // 非动态视图时跳过
    const rect = feed.getBoundingClientRect();
    const mid = window.innerHeight * 0.5;
    const p = Math.min(Math.max((mid - rect.top) / Math.max(1, rect.height), 0), 1);
    feed.style.setProperty("--tl-progress", p.toFixed(4));
    // 当前条目 = 最后一个顶边越过视口中线的
    let current: Element | null = null;
    feed.querySelectorAll(".tl-entry").forEach((el) => {
      if (el.getBoundingClientRect().top <= mid) current = el;
    });
    feed.querySelectorAll(".tl-entry").forEach((el) => {
      el.classList.toggle("is-current", el === current);
    });
  }

  function scheduleTlProgress() {
    if (!tlProgressRaf) tlProgressRaf = requestAnimationFrame(updateTimelineProgress);
  }

  const tlProgressWindow = window as Window & { __tlProgressBound?: boolean };
  if (!tlProgressWindow.__tlProgressBound) {
    tlProgressWindow.__tlProgressBound = true;
    window.addEventListener("scroll", scheduleTlProgress, { passive: true });
    window.addEventListener("resize", scheduleTlProgress, { passive: true });
    // VT 换页 / 视图切换（dock 切到动态时会派发 resize）后重新计算
    document.addEventListener("astro:page-load", scheduleTlProgress);
  }
  scheduleTlProgress();
</script>
