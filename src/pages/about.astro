---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PersonalCard from "../components/PersonalCard.astro";
import GraphView from "../components/GraphView.astro";
import { SITE_NAME, SITE_DESCRIPTION, SITE_AVATAR, SITE_SOCIAL } from "../consts";

const [allPosts, allMoments] = await Promise.all([
  getCollection("posts"),
  getCollection("moments"),
]);

const publishedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const publishedMoments = allMoments
  .filter((m) => !m.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

type RenderedContent = Awaited<
  ReturnType<CollectionEntry<"posts">["render"]>
>["Content"];

interface RenderedAll {
  id: string;
  kind: "post" | "person" | "event";
  entry: CollectionEntry<"posts"> | CollectionEntry<"moments">;
  Content: RenderedContent;
}

const renderedAll = await Promise.all([
  ...publishedPosts.map(async (p) => ({
    id: p.id,
    kind: "post" as const,
    entry: p,
    Content: (await p.render()).Content,
  })),
  ...publishedMoments.map(async (m) => ({
    id: m.id,
    kind: m.data.type as "person" | "event",
    entry: m,
    Content: (await m.render()).Content,
  })),
]);

const contentIndex = new Map(renderedAll.map((c, i) => [c.id, i]));

// Graph data
const WIKI_LINK_RE = /\[\[([^\]]+)\]\]/g;

interface GraphNode {
  id: string;
  kind: "post" | "person" | "event" | "self";
  title: string;
  url: string;
  contentIndex: number;
  avatar?: string;
}

interface GraphLink {
  source: string;
  target: string;
}

const selfNode: GraphNode = {
  id: "self",
  kind: "self",
  title: "我",
  url: "",
  contentIndex: -1,
  avatar: SITE_AVATAR,
  excerpt: SITE_DESCRIPTION,
};

const graphContent = renderedAll.filter(
  (c) => c.entry.data.graph?.enabled !== false
);

const graphNodes: GraphNode[] = [
  selfNode,
  ...graphContent.map((c) => ({
    id: c.id,
    kind: c.kind,
    title: c.entry.data.graph?.name ?? c.entry.data.title,
    url: c.kind === "post" ? `/blog/${c.id.replace(/\.mdx$/, "")}` : "",
    contentIndex: contentIndex.get(c.id)!,
    avatar: c.entry.data.graph?.avatar,
    excerpt: c.entry.data.excerpt,
    heroImage: c.entry.data.heroImage,
  })),
];

// 关联锚点：优先用 graph.name，同时保留原始 title 以便旧链接仍可匹配
const titleToNode = new Map<string, GraphNode>();
for (const n of graphNodes) titleToNode.set(n.title, n);
for (const c of graphContent) {
  const t = c.entry.data.title;
  if (!titleToNode.has(t)) {
    const node = graphNodes.find((n) => n.id === c.id);
    if (node) titleToNode.set(t, node);
  }
}

const graphLinks: GraphLink[] = [];
const seenLinks = new Set<string>();

for (const n of graphNodes) {
  if (n.id === "self") continue;
  const key = ["self", n.id].sort().join("|");
  seenLinks.add(key);
  graphLinks.push({ source: "self", target: n.id });
}

for (const c of graphContent) {
  const body = String(c.entry.body ?? "");
  const refs = Array.from(body.matchAll(WIKI_LINK_RE), (m) => m[1]);
  for (const refTitle of refs) {
    const target = titleToNode.get(refTitle);
    if (!target) continue;
    if (target.id === c.id) continue;
    const key = [c.id, target.id].sort().join("|");
    if (seenLinks.has(key)) continue;
    seenLinks.add(key);
    graphLinks.push({ source: c.id, target: target.id });
  }
}
---

<BaseLayout title="关于">
  <section class="py-24 md:py-32 px-6">
    <div class="mx-auto max-w-4xl">
      <div class="flex flex-col md:flex-row gap-12 md:gap-16 items-start">
        <div class="w-full md:w-64 shrink-0">
          <PersonalCard
            name="SNARK"
            bio="随笔 · 技术 · 生活"
            avatar={SITE_AVATAR}
            socialLinks={SITE_SOCIAL}
          />
        </div>

        <div class="flex-1 min-w-0">
          <blockquote class="font-serif text-3xl md:text-4xl italic text-[var(--color-ed-muted)] leading-snug mb-10">
            "留给自己的孤岛。"
          </blockquote>

          <div class="space-y-6 text-sm md:text-base leading-relaxed text-[var(--color-ed-muted)]">
            <p>
              这里是 <strong class="text-[var(--color-ed-fg)] font-semibold">{SITE_NAME}</strong>——主要记录一些随笔、反思和笔记的个人空间，
              创建这个博客的原因是因为随着年龄增长，曾经的兴趣爱好和生活方式都发生了变化，并且发现自己记忆已经不足以完整记下曾经发生的事和已经走散了的朋友
              所以想要有一个地方来记录这些变化。
            </p>
          </div>
        </div>
      </div>

      <!-- 关系图谱 -->
      {graphNodes.length > 1 && (
        <div class="mt-24 pt-12 border-t border-[var(--color-ed-faint)]">
          <div class="mb-8">
            <p class="font-sans text-xs tracking-[0.28em] uppercase text-[var(--color-ed-subtle)] mb-2">Connections</p>
          </div>
          <GraphView nodes={graphNodes} links={graphLinks} />
          <ul class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-[var(--color-ed-muted)]">
            <li class="flex items-center gap-2"><span class="inline-block h-2.5 w-2.5 rounded-full" style="background:var(--color-ed-fg)"></span>我 / 文章</li>
            <li class="flex items-center gap-2"><span class="inline-block h-2.5 w-2.5 rounded-full border" style="border-color:var(--color-ed-muted)"></span>人物</li>
            <li class="flex items-center gap-2"><span class="inline-block h-2.5 w-2.5 rotate-45" style="background:var(--color-ed-muted)"></span>事件</li>
          </ul>
        </div>
      )}

    </div>
  </section>
</BaseLayout>
