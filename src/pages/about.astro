<style>
  /* ===== 关于页布局：左侧 dock 轨道 + 右侧内容（移动端单列、无 dock） ===== */
  .about-layout {
    display: block;
  }
  /* 视图切换：dock 选中哪个视图就只显示哪个（关于为默认），其余 display:none。
     选择器带 .about-layout 前缀（0,2,0），否则会被后面同权重的 .about-hero{display:flex} 盖掉 */
  .about-layout .about-view {
    display: none;
  }
  .about-layout[data-view="about"] .about-view--about,
  .about-layout[data-view="feed"] .about-view--feed,
  .about-layout[data-view="collection"] .about-view--collection {
    display: block;
  }
  /* 移动端没有 dock：三块依次展示（回到合并前的连续阅读体验） */
  @media (max-width: 767px) {
    .about-layout .about-view {
      display: block;
    }
  }
  @media (min-width: 768px) {
    .about-layout {
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr);
      gap: clamp(1rem, 2.5vw, 2rem);
      align-items: start;
    }
    /* dock 已改为 fixed（视口垂直居中）：主内容显式占第二列 */
    .about-main {
      grid-column: 2;
    }
  }

  /* --- 左侧 dock：macOS 风格 —— 磨砂悬浮面板 + 邻近放大（--dock-scale 由脚本按
        指针距离写入）+ 悬停提示条（面板右侧）+ 运行小圆点 + 点击弹跳 --- */
  .about-dock {
    display: none;
  }
  @media (min-width: 768px) {
    .about-dock {
      /* macOS 位置：贴在视口最左侧、垂直居中，浮在页面留白上 */
      position: fixed;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      width: fit-content;
      padding: 8px;
      border: 1px solid rgba(28, 28, 28, 0.08);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.55);
      -webkit-backdrop-filter: blur(14px) saturate(1.6);
      backdrop-filter: blur(14px) saturate(1.6);
      box-shadow:
        0 1px 2px rgba(28, 28, 28, 0.05),
        0 16px 40px -24px rgba(28, 28, 28, 0.35);
    }
  }
  .about-dock__item {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--color-ed-muted);
    cursor: pointer;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }
  .about-dock__item:hover,
  .about-dock__item:focus-visible {
    background: rgba(28, 28, 28, 0.05);
    color: var(--color-ed-fg);
  }
  .about-dock__item:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: 2px;
  }
  .about-dock__item svg {
    display: block;
    width: 20px;
    height: 20px;
    transform: scale(var(--dock-scale, 1));
    will-change: transform;
  }
  /* 悬停提示条（macOS tooltip 式，出现在面板右侧） */
  .about-dock__label {
    position: absolute;
    left: calc(100% + 12px);
    top: 50%;
    transform: translate(-4px, -50%);
    padding: 4px 10px;
    border-radius: 7px;
    background: rgba(28, 28, 28, 0.9);
    color: var(--color-ed-bg);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 160ms ease,
      transform 220ms var(--ease-ed);
    z-index: 6;
  }
  .about-dock__item:hover .about-dock__label,
  .about-dock__item:focus-visible .about-dock__label {
    opacity: 1;
    transform: translate(0, -50%);
  }
  .about-dock__item.is-active {
    color: var(--color-ed-accent);
  }
  /* 点击弹跳（macOS 图标弹跳；用 translate 属性与放大 scale 互不覆盖） */
  .about-dock__item.is-bounce svg {
    animation: dock-bounce 520ms var(--ease-ed);
  }
  @keyframes dock-bounce {
    0%,
    100% {
      translate: 0 0;
    }
    35% {
      translate: 0 -6px;
    }
    65% {
      translate: 0 0;
    }
    82% {
      translate: 0 -2px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-dock__item,
    .about-dock__label {
      transition: none;
    }
    .about-dock__item.is-bounce svg {
      animation: none;
    }
  }

  /* ===== 关于区：扉页式身份带（头像 + 名字/简介/社交一行带过；
     统计与热力图由首页关于卡承载，此处不重复） ===== */
  .about-hero {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .about-hero__avatar {
    flex: none;
    width: 84px;
    height: 84px;
    border-radius: 9999px;
    object-fit: cover;
    box-shadow: 0 12px 32px -18px rgba(28, 28, 28, 0.25);
  }
  .about-hero__text {
    min-width: 0;
  }
  .about-hero__name {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    letter-spacing: 0.04em;
  }
  .about-hero__bio {
    margin-top: 0.375rem;
    color: var(--color-ed-muted);
    line-height: 1.7;
  }
  .about-hero__socials {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  @media (max-width: 559px) {
    .about-hero {
      gap: 1rem;
    }
    .about-hero__avatar {
      width: 64px;
      height: 64px;
    }
  }
  /* 关于视图：自述（衬线、保留换行）+ 站点档案数字行 */
  .about-story {
    max-width: 36rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 2.05;
    white-space: pre-line;
  }
  /* 关于视图：桌面端在页头与页脚之间垂直居中（内容短，避免下方一大片空白；
     移动端三块堆叠，不居中） */
  @media (min-width: 768px) {
    .about-layout[data-view="about"] .about-view--about {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc(100svh - 22rem);
    }
  }

  /* 关于视图双栏：主列（身份带 + 自述）| 右窄栏（站点档案） */
  .about-about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    max-width: 62rem;
    margin-inline: auto;
    align-items: start;
  }
  @media (max-width: 767px) {
    .about-about-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .about-rail-title {
    margin-bottom: 0.75rem;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: var(--color-ed-subtle);
  }
  .about-facts {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
  }
  .about-facts__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .about-facts__row dt {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-ed-subtle);
  }
  .about-facts__row dd {
    margin: 0;
    color: var(--color-ed-fg);
  }
  .about-soc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--color-ed-hairline);
    border-radius: 9999px;
    background: #fff;
    color: var(--color-ed-muted);
    transition:
      color 180ms ease,
      border-color 180ms ease,
      transform 180ms var(--ease-ed);
  }
  .about-soc:hover {
    color: var(--color-ed-accent);
    border-color: var(--color-ed-rule-strong);
    transform: translateY(-1px);
  }

  /* ===== 视图区块容器（标题由 page-head 承担，随视图切换） ===== */
  .about-feed-sec {
    margin-top: 0;
    scroll-margin-top: 84px;
  }

  /* 右栏区块小标题 */
  .tl-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ed-subtle);
  }
  .tl-title-row::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--color-ed-rule);
  }

  /* ================= 简约时间轴 =================
     结构：每 <li> 自带一段竖线 .tl-seg + 一个圆点 .tl-simple__dot。
     竖线分段 → 可逐段做入场生长与悬停高亮；圆点圆心钉在线上，dock 放大不脱线。 */
  .tl-simple {
    list-style: none;
    margin: 0;
    padding: 0 1.5rem 0 0.25rem; /* 右侧留余量：dock 放大时文字不被滚动条裁掉 */
    position: relative;
    height: 22rem;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
  }
  /* 时间线变量：线 X 坐标（1px 线，中心对齐）、dot 半径 */
  .tl-simple {
    --tl-line-x: 7.5px;
    --tl-dot-d: 9px;
  }
  .timeline-point {
    position: relative;
    display: flex;
    scroll-margin-top: 6rem;
    padding: 0.625rem 0 0.625rem 1.5rem; /* 左 padding 让位给线/点 */
    cursor: pointer;
    border-radius: 4px;
    /* 悬停/激活底色与边框（手机端卡片）都走同一条短过渡，避免硬切 */
    transition: background-color 160ms ease, border-color 160ms ease;
    /* 入场动画：整体淡入上移（delay 由 --tl-i 逐条错开） */
    opacity: 0;
    animation: tl-point-in 0.5s var(--ease-ed) forwards;
    animation-delay: calc(0.15s + min(var(--tl-i, 0), 7) * 0.04s);
  }
  @keyframes tl-point-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .timeline-point:hover {
    background: rgba(28, 28, 28, 0.03);
  }

  /* —— 每段竖线：默认透明，入场时逐段从顶生长；悬停/激活时本段点亮 —— */
  .tl-seg {
    position: absolute;
    left: calc(var(--tl-line-x) - 0.5px);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-ed-rule);
    transform: scaleY(0);
    transform-origin: top;
    animation: tl-seg-grow 0.5s var(--ease-ed) forwards;
    animation-delay: calc(0.15s + min(var(--tl-i, 0), 7) * 0.04s);
  }
  @keyframes tl-seg-grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* 极速换页：导航进入时点/线直接呈现，不做生长编排 */
  :global(html.nav-fast) .timeline-point {
    opacity: 1;
    animation: none;
    animation-delay: 0s;
  }
  :global(html.nav-fast) .tl-seg {
    animation: none;
    transform: none;
  }

  /* reduced-motion 下的时间轴入场：只淡不移（与上面 tl-point-in 配对） */
  @keyframes tl-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .timeline-point:hover .tl-seg {
    background: var(--color-ed-accent);
    opacity: 0.7;
  }
  .timeline-point.is-active .tl-seg {
    background: var(--color-ed-accent);
  }

  /* —— 圆点/方点：绝对定位，圆心精确钉在竖线上；放大以圆心为锚，不脱线 —— */
  .tl-simple__dot {
    position: absolute;
    left: calc(var(--tl-line-x) - var(--tl-dot-d) / 2);
    top: 0.9rem; /* 与首行文字（日期）大致齐平 */
    width: var(--tl-dot-d);
    height: var(--tl-dot-d);
    border-radius: 50%;
    border: 1px solid var(--color-ed-muted);
    background: var(--color-ed-bg);
    transform-origin: center;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
    pointer-events: none;
  }
  /* 日记节点用小方点以示区分 */
  .timeline-point[data-kind="diary"] .tl-simple__dot {
    border-radius: 2px;
  }
  .timeline-point:hover .tl-simple__dot {
    border-color: var(--color-ed-accent);
  }
  /* 悬停位移收进 hover-gate：触屏不再粘滞缩放/位移；置于 .is-active 状态规则之前保持原优先级 */
  @media (hover: hover) and (pointer: fine) {
    .timeline-point:hover .tl-simple__dot {
      transform: scale(1.25);
    }
    .timeline-point:hover .tl-simple__body {
      transform: translateX(4px);
    }
  }
  .timeline-point.is-active .tl-simple__dot {
    background: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
    transform: scale(1.15);
  }

  /* —— 可 dock 缩放的主体：只放大文字区，线与点保持骑线不动 —— */
  .tl-simple__body {
    flex: 1;
    min-width: 0;
    padding-bottom: 0.25rem;
    transform-origin: left center;
    transition: transform 160ms var(--ease-ed);
  }
  .timeline-point.is-active .tl-simple__body {
    transform: translateX(4px);
  }
  .tl-simple__date {
    display: block;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ed-subtle);
    letter-spacing: 0.06em;
  }
  .tl-simple__meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.15rem;
  }
  .tl-simple__label {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--color-ed-subtle);
    text-transform: uppercase;
  }
  .tl-mark {
    display: inline-flex;
    align-items: center;
    color: var(--color-ed-subtle);
  }
  .tl-mark svg {
    width: 0.625rem;
    height: 0.625rem;
  }
  /* 年份只在跨年时出现，避免每行重复 */
  .tl-simple__year {
    margin-right: 0.3rem;
    color: var(--color-ed-subtle);
  }
  .timeline-point.is-active .tl-title {
    color: var(--color-ed-accent);
  }
  /* 日记是流水，轴点上弱一档；人物/事件保持主级 */
  .timeline-point[data-kind="diary"] .tl-title {
    color: var(--color-ed-muted);
    font-size: 0.8125rem;
  }
  .timeline-point[data-kind="diary"].is-active .tl-title {
    color: var(--color-ed-accent);
  }
  /* 焦点环内缩：横轴/竖轴的 overflow 会裁掉外扩的 outline */
  .timeline-point:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: -2px;
  }

  /* —— 纪事内容解锁（加密文章）—— */
  .lock-box {
    position: relative;
    border: 1px dashed var(--color-ed-rule);
    padding: 1rem;
  }
  /* 解锁成功：边框闪一次砖红。用叠加层只动 opacity（不动 border-color），
     既符合「只动 transform/opacity」，也不触发逐帧重绘边框。 */
  .lock-box::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--color-ed-accent);
    pointer-events: none;
    opacity: 0;
  }
  .lock-box.is-unlocked::after {
    animation: lock-box-flash 400ms ease-out both;
  }
  @keyframes lock-box-flash {
    0% {
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  .lock-question {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-ed-fg);
    margin: 0 0 0.75rem;
  }
  .lock-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .lock-input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--color-ed-rule);
    background: transparent;
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
    color: var(--color-ed-fg);
  }
  .lock-input:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: 1px;
  }
  /* 答错：输入框轻抖一次（reduced-motion 下由媒体查询降级为无抖动） */
  .lock-input.is-shake {
    animation: lock-shake 260ms ease;
  }
  @keyframes lock-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    20% {
      transform: translateX(-3px);
    }
    45% {
      transform: translateX(3px);
    }
    70% {
      transform: translateX(-2px);
    }
    88% {
      transform: translateX(1px);
    }
  }
  .lock-btn {
    /* 锁定宽度：「解锁」→「解锁中…」时按钮不抖，输入框也不跟着跳 */
    min-width: 5.25rem;
    border: 1px solid var(--color-ed-fg);
    background: transparent;
    color: var(--color-ed-fg);
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: 0.85rem;
    transition: transform 120ms ease, background-color 160ms ease,
      color 160ms ease, opacity 160ms ease;
  }
  .lock-btn:hover:not(:disabled) {
    background: var(--color-ed-fg);
    color: var(--color-ed-bg);
  }
  .lock-btn:active:not(:disabled) {
    transform: scale(0.97);
  }
  /* PBKDF2 派生期间（约 100–300ms）禁止重复提交 */
  .lock-btn:disabled {
    cursor: progress;
    opacity: 0.55;
  }
  .lock-error {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--color-ed-accent);
    opacity: 0;
    transition: opacity 160ms ease;
  }
  .lock-error.is-shown {
    opacity: 1;
  }
  /* 解锁成功：正文淡入上移（透明揭示），与锁行收起的 220ms 并行 */
  .lock-content.is-reveal {
    animation: lock-content-in 320ms var(--ease-ed) both;
  }
  @keyframes lock-content-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* 时间轴入场：点/线不位移、不 stagger，快速淡入 */
    .timeline-point {
      opacity: 1;
      animation: tl-fade 160ms linear both;
      animation-delay: 0s;
    }
    .tl-seg {
      animation: none;
      transform: none;
    }
    .timeline-point:hover .tl-simple__dot {
      transform: none;
    }
    .timeline-point:hover .tl-simple__body,
    .timeline-point.is-active .tl-simple__body {
      transform: none;
    }
    .lock-box::after,
    .lock-box.is-unlocked::after {
      animation: none;
      opacity: 0;
    }
    .lock-content.is-reveal {
      animation: lock-content-fade 160ms linear both;
    }
    .lock-input.is-shake {
      animation: none;
    }
    .lock-btn {
      transition: none;
    }
    .lock-btn:active:not(:disabled) {
      transform: none;
    }
  }
  @keyframes lock-content-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* ===== 版面：桌面「左文右轴」，手机「横轴在上、正文在下」 ===== */
  .timeline-layout {
    display: grid;
    gap: 1.75rem;
  }
  .timeline-rail {
    min-width: 0;
  }
  .tl-simple {
    min-width: 0;
  }
  .timeline-feed {
    width: 100%;
    min-width: 0;
    /* 单列时也不要把正文拉成 50+ 字/行；桌面端在该列内居中 */
    max-width: 47rem;
    margin-inline: auto;
    padding-top: 0.5rem;
    /* 参考 flowersink /life：条目挂在一条竖线上（线在左侧凹槽，节点随条目） */
    position: relative;
    padding-left: 44px;
  }
  .timeline-feed::before {
    content: "";
    position: absolute;
    left: 14px;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 1px;
    background: var(--color-ed-hairline); /* 默认浅色：阅读进度线叠在上面加深 */
    pointer-events: none;
  }
  /* 阅读进度线：随滚动加粗加深（高度 = --tl-progress × 全程），滚到哪条数据线就画到哪 */
  .timeline-feed::after {
    content: "";
    position: absolute;
    left: 13.5px;
    top: 0.75rem;
    width: 2px;
    height: calc((100% - 1.5rem) * var(--tl-progress, 0));
    background: var(--color-ed-fg);
    border-radius: 1px;
    pointer-events: none;
  }
  /* 条目节点：钉在竖线上，对齐条目头像/byline 行 */
  .tl-entry::before {
    content: "";
    position: absolute;
    left: -34.5px;
    top: 2.8rem;
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    background: var(--color-ed-bg);
    border: 1.2px solid var(--color-ed-fg);
    box-sizing: border-box;
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      transform 240ms var(--ease-ed);
  }
  .tl-entry:hover::before {
    border-color: var(--color-ed-accent);
  }
  /* 滚到当前条目：节点实心点亮 + 微微放大 */
  .tl-entry.is-current::before {
    background: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
    transform: scale(1.18);
  }
  /* 月标题：实心节点钉在轴线上（位移合并在 .tl-month 原规则里） */
  .tl-month::before {
    content: "";
    position: absolute;
    left: 10px;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 9999px;
    background: var(--color-ed-fg);
    box-sizing: border-box;
  }
  @media (max-width: 767px) {
    .timeline-feed {
      padding-left: 30px;
    }
    .timeline-feed::before {
      left: 8px;
    }
    .tl-entry::before {
      left: -26.5px;
      top: 2.5rem;
    }
    .tl-month {
      margin-left: -30px;
      padding-left: 30px;
    }
    .tl-month::before {
      left: 4px;
    }
    .timeline-feed::after {
      left: 7.5px;
    }
  }
  @media (min-width: 1024px) {
    .timeline-layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "feed";
    }
    .timeline-feed {
      grid-area: feed;
    }
  }

  /* —— 连续信息流条目：正文直出、连续排布，日记（碎碎念）占位更紧 —— */
  .tl-entry {
    position: relative;
    padding: 2.25rem 0 2.5rem;
    scroll-margin-top: 6rem;
  }
  /* 条目分隔线：虚线（呼应锁盒/流水语义），rule 色阶比发丝线明显一档 */
  .tl-entry + .tl-entry {
    border-top: 1px dashed var(--color-ed-rule);
  }
  /* —— 条目头：朋友圈式，头像 + 站名在左，日期 + 类型在右 —— */
  .tl-entry__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .tl-entry__by {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }
  .tl-entry__avatar {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-ed-rule);
    background: var(--color-ed-bg);
  }
  .tl-entry__name {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    color: var(--color-ed-fg);
  }
  .tl-entry__meta {
    margin-left: auto;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    min-width: 0;
  }
  /* 类型：日期行右对齐小字（人物 / 事件 / 日记） */
  .tl-entry__kind {
    flex: none;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-ed-subtle);
  }
  /* —— 互动行：日期在左，点赞/评论在右 —— */
  .tl-entry__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1.25rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--color-ed-hairline);
  }
  .tl-entry__foot-date {
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ed-subtle);
    letter-spacing: 0.06em;
  }
  .tl-entry__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .tl-like,
  .tl-comment {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.4rem;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--color-ed-subtle);
    -webkit-tap-highlight-color: transparent;
    transition: color 160ms ease;
  }
  .tl-like svg,
  .tl-comment svg {
    width: 1rem;
    height: 1rem;
    transition: fill 160ms ease;
  }
  /* ♥ 旁的聚合计数（运行时创建，同样 :global；接口不可用时无数字） */
  :global(.tl-like__count) {
    margin-left: 0.05rem;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .tl-like:hover,
  .tl-comment:hover {
    color: var(--color-ed-accent);
  }
  /* 评论按钮：评论区展开时保持点亮 */
  .tl-comment[aria-expanded="true"] {
    color: var(--color-ed-accent);
  }
  .tl-like[aria-pressed="true"] {
    color: var(--color-ed-accent);
  }
  .tl-like[aria-pressed="true"] svg {
    fill: currentColor;
  }
  /* 点赞瞬间：爱心爆一下（只动 transform） */
  .tl-like.is-pop svg {
    animation: tl-like-pop 360ms var(--ease-ed);
  }
  @keyframes tl-like-pop {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.35);
    }
    100% {
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tl-like.is-pop svg {
      animation: none;
    }
  }

  /* —— 长文入口卡：标题+引文整卡可点，正文原位展开 —— */
  .tl-long-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .tl-long-head:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: -2px;
  }
  .tl-entry--long:hover .tl-entry__title {
    color: var(--color-ed-accent);
  }
  .tl-long-text {
    min-width: 0;
  }
  .tl-long-quote {
    margin: 0.9rem 0 0;
    /* 与正文排版统一：无衬线、同字号、2em 首行缩进 */
    font-size: 1rem;
    line-height: 1.8;
    text-indent: 2em;
    color: var(--color-ed-muted);
    /* 两行截断：一眼看出内容未完，需点进详情页 */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    position: relative;
  }
  /* 末行渐隐：比省略号更明确的「未完」信号 */
  .tl-long-quote::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 6rem;
    height: 1.8em;
    background: linear-gradient(to right, transparent, var(--color-ed-bg));
    pointer-events: none;
  }
  /* 末行渐隐：比省略号更明确的「未完」信号 */
  .tl-long-quote::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 6rem;
    height: 1.7em;
    background: linear-gradient(to right, transparent, var(--color-ed-bg));
    pointer-events: none;
  }

  /* —— 条目评论区：每条一个 giscus 讨论串，虚线顶线与分隔线同语言 —— */
  .tl-comments {
    margin-top: 1.25rem;
    border-top: 1px dashed var(--color-ed-rule);
    padding-top: 0.75rem;
    min-height: 3rem;
  }
  .tl-comments[hidden] {
    display: none;
  }

  /* —— 九宫格缩略图：朋友圈式方格，点击放大走全站 lightbox ——
     （.tl-grid/.tl-cell 由运行时脚本生成，没有 astro-cid，必须 :global）—— */
  :global(.tl-grid) {
    display: grid;
    gap: 2px;
    margin: 1rem 0;
    /* 方格定宽 160px，按行自动换列（手机端自然降为每行两枚） */
    grid-template-columns: repeat(auto-fill, 160px);
  }
  :global(.tl-cell) {
    display: block;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 3px;
    /* 浅色底 + 发丝线描边：方格有边界，但留白不深 */
    background: var(--color-ed-bg);
    border: 1px solid var(--color-ed-hairline);
  }
  :global(.tl-cell img) {
    display: block;
    width: 100%;
    height: 100%;
    /* 完整缩略显示（不裁剪）：不足方格的部分留纸色底 */
    object-fit: contain;
    cursor: zoom-in;
  }
  .tl-entry__title {
    margin-top: 0.35rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--color-ed-fg);
  }
  /* 日记：无标题，正文直接跟在日期下 */
  .tl-entry--diary {
    padding-block: 1.75rem;
  }
  /* 月标题：serif 大字 + 英文小字（参考 flowersink /life 的年月标题） */
  .tl-month {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-left: -44px;
    padding-left: 44px;
    padding-top: 1.5rem;
  }
  .tl-month__label {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    letter-spacing: 0.02em;
    color: var(--color-ed-fg);
  }
  .tl-month__en {
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    color: var(--color-ed-subtle);
  }

  @media (max-width: 1023px) {
    .timeline-layout {
      gap: 1.5rem;
    }
    .timeline-rail {
      width: 100%;
      max-width: 47rem;
      margin-inline: auto;
    }
    .tl-title-row {
      margin-bottom: 0.6rem;
    }
    /* 横轴：不再有 22rem 的嵌套滚动，改为整行横向滑动 */
    .tl-simple {
      display: flex;
      gap: 0.55rem;
      height: auto;
      padding: 0.15rem 0.15rem 0.7rem;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x proximity;
      overscroll-behavior-x: contain;
    }
    .timeline-point {
      flex: 0 0 auto;
      width: 11.5rem;
      padding: 0.7rem 0.8rem;
      border: 1px solid var(--color-ed-hairline);
      border-radius: 3px;
      scroll-snap-align: start;
    }
    .timeline-point.is-active {
      border-color: var(--color-ed-accent);
      background: rgba(166, 58, 43, 0.04);
    }
    .tl-seg,
    .tl-simple__dot {
      display: none;
    }
    .tl-simple__body {
      padding-bottom: 0;
    }
    .tl-simple__date {
      font-size: 0.6875rem;
    }
    .timeline-point .tl-title {
      font-size: 0.875rem;
    }
    .timeline-point[data-kind="diary"] .tl-title {
      font-size: 0.8125rem;
    }
    /* 手机端条目占位同步收紧 */
    .tl-entry {
      padding-block: 1.75rem;
    }
    .tl-entry--diary {
      padding-block: 1.25rem;
    }
  }


  /* ===== 拾集样式（原 collection.astro 迁入）===== */
  .col-filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 0.25rem 0 0.5rem; }
  .col-chip {
    font-family: var(--font-sans); font-size: 0.75rem; letter-spacing: 0.04em;
    padding: 0.42rem 0.9rem; border-radius: 999px;
    border: 1px solid rgba(28, 28, 28, 0.12);
    background: rgba(254, 253, 248, 0.55);
    -webkit-backdrop-filter: blur(10px) saturate(1.1); backdrop-filter: blur(10px) saturate(1.1);
    color: var(--color-ed-muted); cursor: pointer;
    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }
  .col-chip:hover { color: var(--color-ed-fg); border-color: rgba(28, 28, 28, 0.28); }
  .col-chip.is-active { background: var(--color-ed-fg); color: var(--color-ed-bg); border-color: var(--color-ed-fg); }

  /* 书架/专辑/封面墙内部用了 200~420 的 z-index（扇面抽书、悬停放大）：
     给分区建独立层叠上下文，避免这些元素压过吸顶导航和页面外框。 */
  .col-shelf { margin-top: 2.6rem; isolation: isolate; }
  .col-shelf:first-of-type { margin-top: 1.4rem; }
  /* 筛选切换：先淡出/收起，落定后才 hidden（JS 用内联 transition 驱动，
     避免和全局 .reveal 的 transition 抢属性）。淡出中不接受点击。 */
  .col-shelf[hidden] { display: none; }
  .col-shelf.is-filtering-out { pointer-events: none; }
  .col-shelf__head { display: flex; align-items: baseline; gap: 0.6rem; margin-bottom: 0.2rem; }
  .col-shelf__code, .col-shelf__count {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.5625rem; letter-spacing: 0.12em; color: var(--color-ed-subtle); font-variant-numeric: tabular-nums;
  }
  .col-shelf__label { margin: 0; font-family: var(--font-serif); font-size: 1.15rem; font-weight: 400; line-height: 1.2; color: var(--color-ed-fg); }
  .col-shelf__rule { flex: 1; height: 1px; background: var(--color-ed-hairline); align-self: center; }
  .col-shelf__mark { width: 3px; height: 3px; background: var(--color-ed-fg); align-self: center; }

  /* ===== 立体书架（等距扇面，520px 档案柜） ===== */
  .col-bank { position: relative; width: 100%; margin: 0.2rem auto 0; }
  .col-bank__stage { position: relative; width: 100%; height: 420px; overflow: hidden; }
  .vshadow {
    position: absolute; left: 0; top: 0;
    width: var(--FOOT, 100px); height: 16px;
    background: radial-gradient(ellipse at 32% center, rgba(90, 78, 56, 0.20), rgba(90, 78, 56, 0) 72%);
    filter: blur(2px); pointer-events: none; will-change: transform;
  }
  .vol {
    position: absolute; left: 0; top: 0;
    width: var(--FOOT, 100px); height: var(--H, 206px);
    border: 0; margin: 0; padding: 0; background: none;
    cursor: pointer; text-align: left;
    transform-origin: 0 0; will-change: transform;
  }
  .vol__spine {
    position: absolute; left: 0; top: 0;
    width: var(--S, 18px); height: var(--H, 206px);
    transform: matrix(1, 0.10, 0, 1, 0, 0); transform-origin: 0 0;
    background: #F2F0E9; color: #2A2620;
    box-shadow: inset 0 0 0 1px rgba(28, 28, 28, 0.10), inset -2px 0 3px -2px rgba(0, 0, 0, 0.22);
    overflow: hidden;
    display: flex; flex-direction: column; align-items: center;
    padding: 8px 0;
  }
  .vol__num { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 7px; letter-spacing: 0.04em; opacity: 0.55; }
  .vol__stitle {
    writing-mode: vertical-rl; text-orientation: mixed;
    font-family: var(--font-serif); font-size: 9px; line-height: 1.08; font-weight: 600;
    max-height: 76%; overflow: hidden; text-align: center;
    display: flex; align-items: center; justify-content: center; flex: 1; margin: 6px 0;
  }
  .vol__dot { width: 5px; height: 5px; border-radius: 50%; background: rgba(28, 28, 28, 0.32); }
  .vol__cover {
    position: absolute; left: var(--S, 18px); top: calc(var(--S, 18px) * 0.10);
    width: var(--C, 128px); height: var(--H, 206px);
    transform: matrix(0.66, -0.30, 0, 1, 0, 0); transform-origin: 0 0;
    background: var(--paper, #FEFDF8); color: var(--ink, #2A2620);
    box-shadow: inset 0 0 0 1px rgba(28, 28, 28, 0.09);
    transition: box-shadow 220ms var(--ease-ed), filter 220ms var(--ease-ed);
    overflow: hidden;
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 9px 9px 7px;
  }
  .vol__no { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 7px; letter-spacing: 0.08em; opacity: 0.55; }
  .vol__ctitle {
    font-family: var(--font-serif); font-size: 16px; line-height: 1.22;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .vol__cby { font-size: 9px; letter-spacing: 0.02em; opacity: 0.6; margin-top: 2px; }
  .vol__code { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 7px; letter-spacing: 0.06em; opacity: 0.5; padding-top: 4px; border-top: 1px solid rgba(28, 28, 28, 0.10); }
  .vol__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; display: block; }
  .vol__text { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: 10px; z-index: 1; }
  .vol__cover .vol__no { position: absolute; top: 7px; left: 7px; z-index: 2; background: rgba(254, 253, 248, 0.82); padding: 1px 5px; border-radius: 2px; }
  .vol__cover .vol__code { position: absolute; bottom: 7px; left: 7px; right: 7px; z-index: 2; background: rgba(254, 253, 248, 0.72); padding: 2px 5px; border-radius: 2px; border-top: 0; }
  .vol__scrim { position: absolute; left: 0; right: 0; bottom: 0; height: 56%; z-index: 1; pointer-events: none; background: linear-gradient(to top, rgba(10, 8, 6, 0.74), rgba(10, 8, 6, 0)); }
  .vol__albumtag { position: absolute; top: 7px; right: 7px; z-index: 2; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 7px; letter-spacing: 0.1em; color: #fff; background: rgba(0, 0, 0, 0.34); padding: 2px 6px; border-radius: 2px; -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
  .vol__caption { position: absolute; left: 9px; right: 9px; bottom: 9px; z-index: 2; display: flex; flex-direction: column; gap: 2px; color: #fff; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55); }
  .vol__cap-title { font-family: var(--font-serif); font-size: 11px; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vol__cap-by { font-size: 8px; letter-spacing: 0.02em; opacity: 0.86; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .col-bank[data-mode="album"] .vol__no, .col-bank[data-mode="album"] .vol__code { display: none; }
  .col-bank[data-mode="album"] .vol__cover { outline: 1px solid rgba(28, 28, 28, 0.18); outline-offset: 3px; }
  .vol__ticks {
    position: absolute; inset: 6px; z-index: 2; pointer-events: none; opacity: 0.72;
    --tick: rgba(255, 255, 255, 0.92);
    background:
      linear-gradient(var(--tick), var(--tick)) left top / 7px 1px no-repeat,
      linear-gradient(var(--tick), var(--tick)) left top / 1px 7px no-repeat,
      linear-gradient(var(--tick), var(--tick)) right top / 7px 1px no-repeat,
      linear-gradient(var(--tick), var(--tick)) right top / 1px 7px no-repeat,
      linear-gradient(var(--tick), var(--tick)) left bottom / 7px 1px no-repeat,
      linear-gradient(var(--tick), var(--tick)) left bottom / 1px 7px no-repeat,
      linear-gradient(var(--tick), var(--tick)) right bottom / 7px 1px no-repeat,
      linear-gradient(var(--tick), var(--tick)) right bottom / 1px 7px no-repeat;
  }
  .vol:focus-visible { outline: 1.5px solid var(--color-ed-accent); outline-offset: 4px; }
  .vol, .vshadow { transition: transform 520ms var(--ease-ed), filter 120ms ease; }
  /* 按压反馈：书架模式用亮度（书脊/封面带 matrix 基础 transform，不叠加 scale）；
     拖拽态由下方 is-drag 规则兜底 */
  .vol:active { filter: brightness(0.94); }
  /* 焦点高亮只跟「抬起」绑定：小屏中间那本是抬起的，所以给小屏；
     桌面端不默认抬起，也就不画环（悬停只做原有的放大/浮起）。 */
  @media (max-width: 1023px) {
    .vol.is-focus .vol__cover {
      box-shadow:
        0 0 0 1.5px var(--color-ed-accent),
        0 0 0 6px rgba(166, 58, 43, 0.1),
        0 24px 40px -22px rgba(30, 20, 10, 0.55);
    }
  }
  .col-bank.is-drag .vol, .col-bank.is-drag .vshadow { transition: none; }
  /* 拖拽中 :active 必然成立（按下即拖拽起点）：亮度按压不得在拖拽时闪动 */
  .col-bank.is-drag .vol:active { filter: none; }

  .col-bank__foot {
    min-height: 1.5rem; padding: 0 2.6rem;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.625rem; letter-spacing: 0.1em; color: var(--color-ed-subtle);
    text-align: center; font-variant-numeric: tabular-nums;
  }
  .col-bank__nav {
    position: absolute; top: 42%; z-index: 300;
    display: flex; align-items: center; justify-content: center;
    width: 2.1rem; height: 2.1rem; border-radius: 999px;
    border: 1px solid rgba(28, 28, 28, 0.14);
    background: rgba(254, 253, 248, 0.72);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    color: var(--color-ed-fg); cursor: pointer;
    transition: background-color 180ms ease, border-color 180ms ease, transform 120ms var(--ease-ed);
  }
  .col-bank__nav:hover { border-color: rgba(28, 28, 28, 0.35); }
  /* 按压反馈：按钮类，缩到 0.94 */
  .col-bank__nav:active { transform: scale(0.94); }
  .col-bank__nav svg { width: 0.95rem; height: 0.95rem; }
  .col-bank__nav--prev { left: -2px; }
  .col-bank__nav--next { right: -2px; }

  /* 去掉底部落地阴影 */
  .vshadow { display: none !important; }

  /* 音乐专辑：悬停浮出完整（去等距斜切）封面 */
  .col-bank[data-mode="album"] .vol__cover {
    transition: transform 260ms var(--ease-ed), box-shadow 260ms var(--ease-ed), filter 260ms var(--ease-ed);
    transform-origin: 50% 50%;
  }
  .col-bank[data-mode="album"] .vol:hover { z-index: 420 !important; }
  .col-bank[data-mode="album"] .vol:hover .vol__cover,
  .col-bank[data-mode="album"] .vol:focus-visible .vol__cover {
    z-index: 80;
  }
  .col-bank[data-mode="album"] .vol:focus-visible .vol__cover {
    transform: scale(1.14);
    box-shadow: 0 24px 42px -22px rgba(30, 20, 10, 0.5), inset 0 0 0 1px rgba(28, 28, 28, 0.14);
    filter: brightness(1.03);
  }
  /* 悬停位移收进 hover-gate：触屏不再粘滞缩放/阴影；置于 :active 按压规则之前保持原优先级 */
  @media (hover: hover) and (pointer: fine) {
    .col-bank[data-mode="album"] .vol:hover .vol__cover {
      transform: scale(1.14);
      box-shadow: 0 24px 42px -22px rgba(30, 20, 10, 0.5), inset 0 0 0 1px rgba(28, 28, 28, 0.14);
      filter: brightness(1.03);
    }
  }
  /* 专辑模式按压：封面从悬停的 1.14 缩回 0.98；与 :hover 同权级，必须排在其后才能按住时胜出 */
  .col-bank[data-mode="album"] .vol:active .vol__cover { transform: scale(0.98); }

  /* ===== 音乐专辑横向轮播（只借滚动动画，保留专辑封面样式） ===== */
  .col-albums { position: relative; }
  .col-albums__track {
    display: flex; gap: 18px;
    overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; -ms-overflow-style: none;
    padding: 14px 6px 18px;
    -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain;
  }
  .col-albums__track::-webkit-scrollbar { display: none; }
  .album {
    flex: 0 0 auto; width: 172px;
    border: 0; margin: 0; padding: 0; background: none; cursor: pointer;
    scroll-snap-align: center; text-align: left;
    display: block; text-decoration: none; color: inherit;
    transform-origin: bottom center; will-change: transform;
    /* 不要在这里加 transform 过渡：滚动时 JS 每帧写 transform，CSS 过渡会逐帧重启，
       结果是封面追不上指针、整体"飘"。滚动动画交给 scroll-snap + rAF。 */
  }
  .album__cover {
    position: relative; display: flex; flex-direction: column; justify-content: space-between;
    aspect-ratio: 1 / 1; padding: 14px 12px 12px; border-radius: 3px; color: var(--ink);
    background: linear-gradient(160deg, color-mix(in srgb, var(--cover) 96%, white), var(--cover));
    box-shadow: 0 12px 24px -18px rgba(60, 48, 30, 0.6), inset 0 0 0 1px rgba(28, 28, 28, 0.1);
    overflow: hidden;
  }
  .album__cover::before { content: ""; position: absolute; inset: 9px; border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); border-radius: 2px; pointer-events: none; }
  .album__code { position: relative; z-index: 1; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 0.5rem; letter-spacing: 0.1em; opacity: 0.5; }
  .album__title { position: relative; z-index: 1; font-family: var(--font-serif); font-size: 1.06rem; line-height: 1.28; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .album__by { position: relative; z-index: 1; font-size: 0.625rem; letter-spacing: 0.04em; opacity: 0.6; padding-top: 6px; border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .album:focus-visible { outline: 1.5px solid var(--color-ed-accent); outline-offset: 5px; }
  .album__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; display: block; }
  .album__fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-align: center; padding: 16px; font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.3; color: var(--ink); z-index: 1; }
  .album__code { position: absolute !important; top: 8px; left: 8px; background: rgba(254, 253, 248, 0.82); padding: 2px 6px; border-radius: 2px; z-index: 2; }
  .album__meta { display: block; margin-top: 8px; }
  .album__meta .album__title { display: block; font-family: var(--font-serif); font-size: 0.95rem; line-height: 1.3; color: var(--color-ed-fg); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .album__meta .album__by { display: block; margin-top: 2px; border-top: 0; padding-top: 0; font-size: 0.6875rem; letter-spacing: 0.02em; color: var(--color-ed-subtle); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .col-albums__nav {
    position: absolute; top: 44%; z-index: 20;
    display: flex; align-items: center; justify-content: center;
    width: 2.1rem; height: 2.1rem; border-radius: 999px;
    border: 1px solid rgba(28, 28, 28, 0.14);
    background: rgba(254, 253, 248, 0.72);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    color: var(--color-ed-fg); cursor: pointer;
    transition: background-color 180ms ease, border-color 180ms ease;
  }
  .col-albums__nav:hover { border-color: rgba(28, 28, 28, 0.35); }
  .col-albums__nav svg { width: 0.95rem; height: 0.95rem; }
  .col-albums__nav--prev { left: -4px; }
  .col-albums__nav--next { right: -4px; }

  /* ===== 封面墙 ===== */
  .col-wall { list-style: none; margin: 0.4rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); gap: 18px; }
  .col-wallitem { min-width: 0; }
  .col-wallcard { display: block; width: 100%; margin: 0; padding: 0; border: 0; background: none; cursor: pointer; text-align: left; }
  .col-wallcard__cover {
    position: relative; display: flex; flex-direction: column; justify-content: space-between;
    aspect-ratio: var(--ar, 3 / 4); padding: 14px 12px 12px; border-radius: 3px; color: var(--ink);
    background: linear-gradient(160deg, color-mix(in srgb, var(--cover) 96%, white), var(--cover));
    box-shadow: 0 10px 22px -18px rgba(60, 48, 30, 0.6), inset 0 0 0 1px rgba(28, 28, 28, 0.1);
    overflow: hidden; transition: transform 260ms var(--ease-ed), box-shadow 260ms var(--ease-ed);
  }
  .col-wallcard__cover::before { content: ""; position: absolute; inset: 8px; border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); border-radius: 1px; pointer-events: none; }
  .col-wallcard:focus-visible .col-wallcard__cover { transform: translateY(-4px); box-shadow: 0 18px 30px -18px rgba(60, 48, 30, 0.7), inset 0 0 0 1px rgba(28, 28, 28, 0.12); }
  /* 悬停位移收进 hover-gate：触屏不再粘滞浮起，:focus-visible 反馈留在门外 */
  @media (hover: hover) and (pointer: fine) {
    .col-wallcard:hover .col-wallcard__cover { transform: translateY(-4px); box-shadow: 0 18px 30px -18px rgba(60, 48, 30, 0.7), inset 0 0 0 1px rgba(28, 28, 28, 0.12); }
  }
  .col-wallcard__code { position: relative; z-index: 1; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 0.5rem; letter-spacing: 0.1em; opacity: 0.5; }
  .col-wallcard__title { position: relative; z-index: 1; font-family: var(--font-serif); font-size: 1.02rem; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .col-wallcard__by { position: relative; z-index: 1; font-size: 0.625rem; letter-spacing: 0.04em; opacity: 0.6; padding-top: 6px; border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .col-wallcard:focus-visible { outline: 1.5px solid var(--color-ed-accent); outline-offset: 5px; }

  /* 有真实海报时：图铺满，底部渐变压暗，文字反白 */
  .col-wallcard__img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; z-index: 0; display: block;
  }
  .col-wallcard__cover.has-img {
    background: #241f18;
    box-shadow: 0 14px 28px -18px rgba(60, 48, 30, 0.7), inset 0 0 0 1px rgba(28, 28, 28, 0.18);
  }
  .col-wallcard__cover.has-img::before { border-color: rgba(247, 243, 234, 0.28); }
  .col-wallcard__cover.has-img::after {
    content: ""; position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(to top, rgba(10, 8, 6, 0.82) 0%, rgba(10, 8, 6, 0.28) 36%, rgba(10, 8, 6, 0) 62%);
    pointer-events: none;
  }
  .col-wallcard__cover.has-img .col-wallcard__code,
  .col-wallcard__cover.has-img .col-wallcard__title,
  .col-wallcard__cover.has-img .col-wallcard__by { color: #f7f3ea; text-shadow: 0 1px 14px rgba(0, 0, 0, 0.45); }
  .col-wallcard__cover.has-img .col-wallcard__by { border-top-color: rgba(247, 243, 234, 0.32); }

  /* ===== 详情弹层（档案卡） ===== */
  /* 居中不依赖 UA 的 dialog{margin:auto}（会被 Tailwind preflight 的 *{margin:0} 干掉）：
     dialog 铺满视口当 flex 容器，外观、宽度与滚动都交给 .col-dialog__panel。 */
  .col-dialog {
    position: fixed; inset: 0; margin: 0; padding: 0;
    width: auto; height: auto; max-width: none; max-height: none;
    border: 0; background: transparent; color: var(--color-ed-fg);
    overflow: visible;
  }
  .col-dialog[open] { display: flex; align-items: center; justify-content: center; }

  .col-dialog__panel {
    position: relative;
    width: min(94vw, 58rem); max-height: 90vh; overflow: auto;
    background:
      linear-gradient(90deg, rgba(28, 28, 28, 0.045), rgba(28, 28, 28, 0) 32px),
      var(--color-ed-bg);
    border: 1px solid var(--color-ed-rule);
    border-top: 3px solid var(--color-ed-accent);
    box-shadow: 0 70px 140px -70px rgba(20, 14, 9, 0.7), 0 2px 0 rgba(28, 28, 28, 0.04);
    outline: 1px solid var(--color-ed-hairline);
    outline-offset: -12px;
    overscroll-behavior: contain;
    /* 开合是 transition 型状态切换：基础态即隐藏态，中途关闭可从当前位置平滑重定向 */
    opacity: 0;
    transform: translateY(18px) scale(0.962);
    transition:
      opacity 340ms var(--ease-ed),
      transform 340ms var(--ease-ed);
    will-change: opacity, transform;
  }
  .col-dialog::backdrop {
    background: radial-gradient(120% 120% at 50% 0%, rgba(28, 28, 28, 0.42), rgba(28, 28, 28, 0.66));
    backdrop-filter: blur(6px) saturate(0.9);
    -webkit-backdrop-filter: blur(6px) saturate(0.9);
