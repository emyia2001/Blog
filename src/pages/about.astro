---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import MiniPlayer from "../components/MiniPlayer.astro";
import ImageLightbox from "../components/ImageLightbox.astro";
import { Icon } from "astro-icon/components";
import { encryptContent } from "../utils/lockContent";
import {
  SITE_NAME,
  SITE_AVATAR,
  SITE_DESCRIPTION,
  SITE_SOCIAL,
  SITE_CREATED,
  SITE_STORY,
} from "../consts";
import { COLLECTION, COLLECTION_TOTAL } from "../data/collection";

// 关于视图「站点档案」数字（与首页关于卡同源）
const publishedPosts = (await getCollection("posts")).filter((p) => !p.data.draft);
const now = new Date();
const daysNum = Math.floor((now.getTime() - SITE_CREATED.getTime()) / 86400000) + 1;
const createdYm = `${SITE_CREATED.getFullYear()}.${String(SITE_CREATED.getMonth() + 1).padStart(2, "0")}`;

// 纪事（moments）：person / event / diary 连续信息流，全部服务端直出。
// 右侧时间轴是目录（scroll-spy 高亮当前位置，点击滚动到对应条目）。
const allMoments = await getCollection("moments");

const publishedMoments = allMoments
  .filter((m) => !m.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 长文条目：feed 里只显示入口卡（标题 + 引文），点击原位展开完整阅读。
// 阈值可调（构建期判定）。
const LONG_BODY_LIMIT = 800;

// 引文：正文前两个非空段落合并（去 markdown 记号）——保证两行 clamp 永远
// 有溢出内容，渐隐截断的「未完」信号对所有长文稳定成立
const longQuote = (body: string | undefined) => {
  const paras = (body ?? "")
    .split(/\n\s*\n/)
    .map((b) =>
      b
        .split("\n")
        .map((l) => l.replace(/[#>*`\[\]!]|^- /g, "").trim())
        .filter(Boolean)
        .join(" "),
    )
    .filter(Boolean);
  const text = paras.slice(0, 2).join(" ");
  return text.length > 400 ? `${text.slice(0, 400)}…` : text;
};

type RenderedContent = Awaited<
  ReturnType<CollectionEntry<"posts">["render"]>
>["Content"];

type Kind = "person" | "event" | "diary";

const KIND_LABEL: Record<Kind, string> = {
  person: "人物",
  event: "事件",
  diary: "日记",
};

  // 无标题条目的轴点文本：正文首行截断（碎碎念日记、无标题事件通用）
  const diaryTeaser = (body: string | undefined) => {
  const firstLine = (body ?? "")
    .split("\n")
    .map((s) => s.replace(/[#>*`[\]!]|^- /g, "").trim())
    .find(Boolean);
  if (!firstLine) return "";
  return firstLine.length > 22 ? `${firstLine.slice(0, 22)}…` : firstLine;
};

// 所有内容统一预渲染全文；带 lock 的文章构建期加密正文，浏览器端用答案解密
interface FeedItem {
  id: string;
  /** 深链接锚点：由内容 id 去掉扩展名（稳定、可分享） */
  anchor: string;
  kind: Kind;
  entry: CollectionEntry<"moments">;
  Content?: RenderedContent; // 未加密才有明文 Content
  /** 长文条目：feed 只显示入口卡，点击原位展开 */
  long?: boolean;
  /** 长文引文（正文首行截断） */
  quote?: string;
  lock?: {
    question: string;
    ciphertext: string;
    salt: string;
    iv: string;
  };
}

const feed: FeedItem[] = await Promise.all(
  publishedMoments.map(async (m) => {
    const long = (m.body?.length ?? 0) > LONG_BODY_LIMIT;
    const base = {
      id: m.id,
      anchor: m.id.replace(/\.mdx?$/, ""),
      kind: m.data.type as Kind,
      entry: m,
      long,
      quote: long ? longQuote(m.body) : undefined,
    };
    if (m.data.lock?.answer) {
      // 加密正文（构建期）；明文不进产物
      const enc = encryptContent(String(m.body ?? ""), m.data.lock.answer);
      return {
        ...base,
        lock: {
          question: m.data.lock.question,
          ciphertext: enc.ciphertext,
          salt: enc.salt,
          iv: enc.iv,
        },
      };
    }
    return { ...base, Content: (await m.render()).Content };
  })
);

interface RailEntry {
  anchor: string;
  date: Date;
  kind: Kind;
  title: string;
  /** 无标题时轴点显示正文首行截断；person/event 恒为空 */
  teaser: string;
  label: string; // 轴点小标签：人物 / 事件 / 日记
  locked: boolean;
  hasBgm: boolean;
  /** 只在年月切换（或第一条）时显示月份标题，避免重复 */
  showMonth: boolean;
}

// 时间轴目录条目：publishedMoments 已排序，与 feed 同序一一对应
const railEntries: RailEntry[] = publishedMoments.map((m) => ({
  anchor: m.id.replace(/\.mdx?$/, ""),
  date: m.data.date,
  kind: m.data.type as Kind,
  title: m.data.title ?? "",
  teaser: diaryTeaser(m.body),
  label: KIND_LABEL[m.data.type as Kind],
  locked: Boolean(m.data.lock?.answer),
  hasBgm: Boolean(m.data.bgm?.src),
  showMonth: false,
}));

// 月份分组：降序排列时，第一条和每次跨年或跨月才出月标题
railEntries.forEach((entry, i) => {
  const prev = railEntries[i - 1];
  entry.showMonth =
    i === 0 ||
    entry.date.getFullYear() !== prev.date.getFullYear() ||
    entry.date.getMonth() !== prev.date.getMonth();
});

// 月标题的英文小字（参考 flowersink /life 的年月标题版式）
const MONTH_EN = [
  "JANUARY", "FEBRUARY", "MARCH", "APRIL", "MAY", "JUNE",
  "JULY", "AUGUST", "SEPTEMBER", "OCTOBER", "NOVEMBER", "DECEMBER",
];

const fmtLong = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
    weekday: "short",
  });


// ===== 拾集数据助手（原 collection.astro 迁入）=====
// 本地封面（/images/covers/ 下）→ 构建期派生 WebP（scripts/gen-cover-variants.mjs
// 生成 480w/960w，见 .gitignore）。1080px 原图直接缩到 ~150px 卡片时，Chrome 对
// lazy 大图走低分辨率解码路径，分数缩放屏上发糊；贴近显示尺寸的派生图解码接近
// 1:1，任何 DSF 都清晰。外链图（网易云封面等）原样返回。
// 注意：这里刻意用字符串拼接而不是模板字面量——正则字面量（$/i 结尾）+ 带 ${}
// 插值的模板字面量同现于 frontmatter 时，astro 编译器的栅栏扫描会失效（泄漏 ---）。
const isLocalCover = (p: string) => p.startsWith("/images/covers/") && /\.(jpe?g|png)$/i.test(p);
const coverSrc = (path: string, width: number) => {
  if (!isLocalCover(path)) return path;
  return path.replace(/^(.*\/)([^/]+)\.(jpe?g|png)$/i, "$1gen/$2-" + width + "w.webp");
};
const coverSrcSet = (path: string) =>
  isLocalCover(path) ? coverSrc(path, 480) + " 480w, " + coverSrc(path, 960) + " 960w" : undefined;

// 与 Wenku8_Flutter 一致：奶白档案色 + 等距投影
const PAPER = [
  { cover: "#FEFDF8", ink: "#2A2620" }, // 奶白
  { cover: "#F4F1E8", ink: "#2A2620" }, // 象牙
  { cover: "#E9E2D2", ink: "#2A2620" }, // 沙
  { cover: "#D8CDB9", ink: "#241F18" }, // 石
  { cover: "#38342E", ink: "#EDE7D8" }, // 墨（少量）
];
const SHELF_KINDS = new Set(["books", "music"]);
const FILTERS = [
  { id: "all", label: "全部" },
  ...COLLECTION.map((c) => ({ id: c.id, label: c.label })),
];
---

<BaseLayout title="关于" description={SITE_DESCRIPTION}>
  <div class="page-shell">
    <section>
      <header class="page-head">
        <div class="page-head__row">
          <h1 class="page-head__title" data-view-title>关于</h1>
          <span class="page-head__aside" data-view-aside hidden>{COLLECTION_TOTAL} 件收藏</span>
        </div>
      </header>

      <!-- 左侧 dock（桌面端，macOS 风格）= 视图切换器：关于 / 动态 / 拾集——一次只显示一个区，
           贴近视口左缘。首屏视图由紧跟其后的内联脚本按 hash 预置（重定向/深链接落点正确） -->
      <div class="about-layout" data-view="about">
        <aside class="about-dock" aria-label="页面视图切换">
          <button
            type="button"
            class="about-dock__item"
            data-dock-view="about"
            aria-label="关于视图"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="8" r="3.5"></circle>
              <path d="M5 19.5c1.3-3.3 3.9-5 7-5s5.7 1.7 7 5"></path>
            </svg>
            <span class="about-dock__label" aria-hidden="true">关于</span>
          </button>
          <button
            type="button"
            class="about-dock__item"
            data-dock-view="feed"
            aria-label="动态视图"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9c2.5-3.5 6-3.5 9 0s6.5 3.5 9 0"></path>
              <path d="M3 15c2.5-3.5 6-3.5 9 0s6.5 3.5 9 0"></path>
            </svg>
            <span class="about-dock__label" aria-hidden="true">动态</span>
          </button>
          <button
            type="button"
            class="about-dock__item"
            data-dock-view="collection"
            aria-label="拾集视图"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19h16"></path>
              <path d="M7 19V6.5h4V19"></path>
              <path d="M14 19V10h3.5v9"></path>
            </svg>
            <span class="about-dock__label" aria-hidden="true">拾集</span>
          </button>
        </aside>

        <!-- 首屏视图预置：必须在模块脚本执行前按 hash 定好 data-view，
             否则动态条目深链接（#moment-xxx）会在隐藏视图里算错滚动位置 -->
        <script is:inline>
          (function () {
            var h = decodeURIComponent(location.hash.replace(/^#/, ""));
            var v = h === "collection" ? "collection" : h ? "feed" : "about";
            var layout = document.querySelector(".about-layout");
            if (layout) layout.setAttribute("data-view", v);
            document.querySelectorAll("[data-dock-view]").forEach(function (b) {
              b.classList.toggle("is-active", b.getAttribute("data-dock-view") === v);
            });
            // 移动端无 dock、三块堆叠：页头固定「关于」
            var mobile = window.matchMedia("(max-width: 767px)").matches;
            var title = document.querySelector("[data-view-title]");
            if (title) {
              title.textContent = mobile
                ? "关于"
                : v === "collection" ? "拾集" : v === "feed" ? "动态" : "关于";
            }
            var aside = document.querySelector("[data-view-aside]");
            if (aside) aside.hidden = mobile || v !== "collection";
          })();
        </script>

        <div class="about-main">
          <!-- 关于视图：双栏（主列 = 身份带 + 自述 | 右窄栏 = 站点档案） -->
          <div class="about-view about-view--about">
          <div class="about-about-grid">
          <div class="about-about-main">
          <div class="about-hero reveal">
            <img
              class="about-hero__avatar"
              src={SITE_AVATAR}
              alt={SITE_NAME}
              width="256"
              height="256"
            />
            <div class="about-hero__text">
              <p class="about-hero__name">{SITE_NAME}</p>
              <p class="about-hero__bio">{SITE_DESCRIPTION}</p>
              <div class="about-hero__socials">
                {SITE_SOCIAL.map((s) => (
                  <a
                    class="about-soc"
                    href={s.href}
                    target={s.href.startsWith("#") ? undefined : "_blank"}
                    rel={s.href.startsWith("#") ? undefined : "noopener noreferrer"}
                    aria-label={s.label}
                    title={s.label}
                  >
                    <Icon name={s.icon} class="w-4 h-4" aria-hidden="true" />
                  </a>
                ))}
                <a class="about-soc" href="/rss.xml" aria-label="RSS" title="RSS">
                  <Icon name="mdi:rss" class="w-4 h-4" aria-hidden="true" />
                </a>
              </div>
            </div>
          </div>

          {SITE_STORY.trim().length > 0 && (
            <p class="about-story reveal">{SITE_STORY}</p>
          )}
          </div>

          <aside class="about-about-rail reveal" aria-label="站点档案">
            <p class="about-rail-title">站点档案</p>
            <dl class="about-facts">
              <div class="about-facts__row">
                <dt>创站</dt>
                <dd>{createdYm}</dd>
              </div>
              <div class="about-facts__row">
                <dt>运行</dt>
                <dd>{daysNum} 天</dd>
              </div>
              <div class="about-facts__row">
                <dt>文章</dt>
                <dd>{publishedPosts.length} 篇</dd>
              </div>
              <div class="about-facts__row">
                <dt>动态</dt>
                <dd>{publishedMoments.length} 条</dd>
              </div>
              <div class="about-facts__row">
                <dt>收藏</dt>
                <dd>{COLLECTION_TOTAL} 件</dd>
              </div>
            </dl>
          </aside>
          </div>
          </div>

      <!-- 动态视图：原 /timeline 连续信息流整体迁入（id=feed 供重定向与深链接） -->
      <section id="feed" class="about-feed-sec about-view about-view--feed" aria-label="动态">

      {railEntries.length > 0 ? (
                <div class="timeline-layout">

          <!-- 连续信息流：全部条目服务端直出，日记是无标题的碎碎念（占位更紧）。
               data-pagefind-body 让搜索只索引这个区域；日记按约定不进索引，
               加锁条目只有谜面与密文，也一并跳过。 -->
          <div id="timeline-feed" class="timeline-feed" data-pagefind-body>
            {feed.map((c, i) => (
              <>
                {railEntries[i].showMonth && (
                  <div class="tl-month" aria-hidden="true">
                    <span class="tl-month__label">
                      {railEntries[i].date.getFullYear()}年{railEntries[i].date.getMonth() + 1}月
                    </span>
                    <span class="tl-month__en">{MONTH_EN[railEntries[i].date.getMonth()]}</span>
                  </div>
                )}
                <article
                  id={c.anchor}
                  class:list={[
                    "tl-entry",
                    "reveal",
                    c.kind === "diary" && "tl-entry--diary",
                    c.long && "tl-entry--long",
                  ]}
                  data-pagefind-ignore={c.kind === "diary" ? "true" : undefined}
                >
                  <header class="tl-entry__head">
                    <span class="tl-entry__by">
                      <img
                        class="tl-entry__avatar"
                        src={SITE_AVATAR}
                        alt=""
                        width="28"
                        height="28"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="tl-entry__name">{SITE_NAME}</span>
                    </span>
                    <span class="tl-entry__meta">
                      {/* 右上角：自由标签（类似文章 tags）；固定类型不再上 feed */}
                      {(c.entry.data.tags?.length ?? 0) > 0 && (
                        <span class="tl-entry__kind">
                          {c.entry.data.tags!.join(" · ")}
                        </span>
                      )}
                    </span>
                  </header>
                  {/* 长文：标题+引文构成入口卡（整卡可点展开）；普通条目直接出标题 */}
                  {c.long ? (
                    <a class="tl-long-head" href={`/chronicle/${c.anchor}/`}>
                      <span class="tl-long-text">
                        {c.entry.data.title && (
                          <h2 class="tl-entry__title">{c.entry.data.title}</h2>
                        )}
                        {c.quote && <p class="tl-long-quote">{c.quote}</p>}
                      </span>
                    </a>
                  ) : (
                    c.kind !== "diary" &&
                    c.entry.data.title && (
                      <h2 class="tl-entry__title">{c.entry.data.title}</h2>
                    )
                  )}
                  {/* BGM 曲目行仅在短条目显示；长文的配乐归详情页（悬浮播放器） */}
                  {!c.long && c.entry.data.bgm?.src && (
                    <div class="mt-4">
                      <MiniPlayer
                        src={c.entry.data.bgm.src}
                        title={c.entry.data.bgm.title}
                        gated={Boolean(c.lock)}
                        inline
                      />
                    </div>
                  )}
                  {!c.long && (
                    <>
                    {c.lock ? (
                    <div
                      class="lock-box mt-6"
                      data-lock-id={c.id}
                      data-ciphertext={c.lock.ciphertext}
                      data-salt={c.lock.salt}
                      data-iv={c.lock.iv}
                      data-pagefind-ignore="true"
                    >
                      <p class="lock-question">{c.lock.question}</p>
                      <div class="lock-row">
                        <input
                          type="text"
                          class="lock-input"
                          placeholder="输入答案解锁"
                          autocomplete="off"
                          aria-label="答案"
                        />
                        <button type="button" class="lock-btn">解锁</button>
                      </div>
                      <p class="lock-error" hidden>答案不对，再试试。</p>
                      <div class="lock-content prose mt-4" hidden></div>
                    </div>
                  ) : (
                    c.Content && (
                      <div class="prose mt-6">
                        <c.Content />
                      </div>
                    )
                  )}
                    </>
                  )}
                  {/* 互动行：本地点赞（无后端，状态存本机，不做假计数） */}
                  <footer class="tl-entry__foot">
                    <time class="tl-entry__foot-date" datetime={c.entry.data.date.toISOString()}>
                      {fmtLong(c.entry.data.date)}
                    </time>
                    <span class="tl-entry__actions">
                    {/* 音乐标记：长文配乐归详情页，这里只做提示（短条目已有曲目行） */}
                    {c.long && c.entry.data.bgm?.src && (
                      <span class="tl-mark" title="含背景音乐">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M9 18V5l11-2v13"></path>
                          <circle cx="6" cy="18" r="3"></circle>
                          <circle cx="17" cy="16" r="3"></circle>
                        </svg>
                        <span class="sr-only">含背景音乐</span>
                      </span>
                    )}
                    <button
                      type="button"
                      class="tl-like"
                      data-like={c.anchor}
                      aria-pressed="false"
                      title="点赞（本机记忆）"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 20.7C7.4 17.4 3.5 14 3.5 9.9 3.5 7 5.7 5 8.2 5c1.6 0 3 .9 3.8 2.2C12.8 5.9 14.2 5 15.8 5c2.5 0 4.7 2 4.7 4.9 0 4.1-3.9 7.5-8.5 10.8z"></path>
                      </svg>
                      <span class="sr-only">点赞</span>
                    </button>
                    <button
                      type="button"
                      class="tl-comment"
                      data-comment={c.anchor}
                      aria-expanded="false"
                      aria-controls={`tl-comments-${c.anchor}`}
                      title="评论"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 11.5c0 4.1-4 7.5-9 7.5-1 0-2-.1-2.9-.4L4 20l1.2-3.6C3.8 15 3 13.3 3 11.5 3 7.4 7 4 12 4s9 3.4 9 7.5z"></path>
                      </svg>
                      <span class="sr-only">评论</span>
                    </button>
                    </span>
                  </footer>
                  <div class="tl-comments" id={`tl-comments-${c.anchor}`} data-term={c.anchor} data-pagefind-ignore hidden></div>
                </article>
              </>
            ))}
          </div>

        </div>
      ) : (
        <p class="text-[var(--color-ed-muted)]">暂无内容。</p>
      )}
      </section>

        <!-- 拾集视图：原 /collection 页整体迁入（id=collection 供重定向与深链接） -->
        <section id="collection" class="about-feed-sec about-collection-sec about-view about-view--collection" aria-label="拾集">

    <div class="col-filter reveal" style="--reveal-delay: 60ms" role="tablist" aria-label="筛选收藏">
      {FILTERS.map((f) => (
        <button type="button" class={`col-chip ${f.id === "all" ? "is-active" : ""}`} data-filter={f.id} role="tab" aria-selected={f.id === "all" ? "true" : "false"}>
          {f.label}
        </button>
      ))}
    </div>

    {COLLECTION.map((cat, ci) => {
      const isShelf = SHELF_KINDS.has(cat.id);
      const isAlbum = cat.id === "music";
      const ar = cat.id === "movies" || cat.id === "tv" ? "2 / 3" : "3 / 4";
      return (
        <section class="col-shelf reveal" data-section data-cat={cat.id} style={`--reveal-delay:${Math.min(ci * 60, 300)}ms`}>
          <div class="col-shelf__head">
            <span class="col-shelf__code">WK-{String(ci + 1).padStart(2, "0")}</span>
            <h2 class="col-shelf__label">{cat.label}</h2>
            <span class="col-shelf__rule" aria-hidden="true" />
            <span class="col-shelf__mark" aria-hidden="true" />
            <span class="col-shelf__count">{String(cat.items.length).padStart(2, "0")}</span>
          </div>

          {isShelf ? (
            <div class="col-bank" data-bank data-mode={cat.id === "music" ? "album" : "book"}>
              <button type="button" class="col-bank__nav col-bank__nav--prev" data-banknav="-1" aria-label="上一本">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M15 5l-7 7 7 7" /></svg>
              </button>
              <div class="col-bank__stage" data-stage>
                {cat.items.map((item, i) => {
                  const paper = PAPER[(ci * 2 + i) % PAPER.length];
                  const fileNo = `WK-${String(ci * 100 + i + 1).padStart(5, "0")}`;
                  return (
                    <>
                      <span class="vshadow" aria-hidden="true" />
                      <button
                        type="button"
                        class="vol"
                        style={`--paper:${paper.cover};--ink:${paper.ink}`}
                        data-cover data-cat={cat.label} data-title={item.title}
                        data-creator={item.creator} data-year={String(item.year)}
                        data-note={item.note} data-cover-color={paper.cover}
                        data-ink={paper.ink} data-code={fileNo} data-image={item.cover ?? ""}
                        data-kind={cat.id === "music" ? "album" : "book"}
                        data-desc-source={item.descSource ?? ""}
                        data-ref={item.link ?? ""}
                        data-desc={item.desc ?? ""}
                        data-tracks={JSON.stringify(item.tracks ?? [])}
                        data-en={cat.en}
                        data-rating={item.rating != null ? String(item.rating) : ""}
                        data-rating-count={item.ratingCount != null ? String(item.ratingCount) : ""}
                        data-rating-source={item.ratingSource ?? ""}
                        data-press={item.press ?? ""}
                        data-pubdate={item.pubdate ?? ""}
                        data-pages={item.pages != null ? String(item.pages) : ""}
                        aria-label={`${item.title}，${item.creator}，${item.year}${cat.id === "music" ? "，在网易云播放" : ""}`}
                      >
                        {cat.id !== "music" && (
                          <span class="vol__spine" aria-hidden="true">
                            <span class="vol__num">{String(i + 1).padStart(2, "0")}</span>
                            <span class="vol__stitle">{item.title}</span>
                            <span class="vol__dot" />
                          </span>
                        )}
                        <span class="vol__cover" aria-hidden="true">
                          {item.cover ? (
                            <img class="vol__img" src={coverSrc(item.cover, 480)} alt="" loading="lazy" />
                          ) : (
                            <span class="vol__text">
                              <span class="vol__ctitle">{item.title}</span>
                              <span class="vol__cby">{item.creator}</span>
                            </span>
                          )}
                          {item.cover && (
                            <>
                              <span class="vol__scrim" />
                              <span class="vol__albumtag">{fileNo}</span>
                              <span class="vol__ticks" />
                              <span class="vol__caption">
                                <span class="vol__cap-title">{item.title}</span>
                                <span class="vol__cap-by">{item.creator}{item.year ? ` · ${item.year}` : ""}{item.tracks && item.tracks.length > 1 ? ` · ${item.tracks.length} 首` : ""}</span>
                              </span>
                            </>
                          )}
                          <span class="vol__no">NO.{String(i + 1).padStart(3, "0")}</span>
                          <span class="vol__code">{fileNo}</span>
                        </span>
                      </button>
                    </>
                  );
                })}
              </div>
              <div class="col-bank__foot" data-bankfoot aria-live="polite"></div>
              <button type="button" class="col-bank__nav col-bank__nav--next" data-banknav="1" aria-label="下一本">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M9 5l7 7-7 7" /></svg>
              </button>
            </div>
          ) : isAlbum ? (
            <div class="col-albums" data-albums>
              <button type="button" class="col-albums__nav col-albums__nav--prev" data-albumnav="-1" aria-label="上一张专辑">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M15 5l-7 7 7 7" /></svg>
              </button>
              <div class="col-albums__track" data-albumtrack>
                {cat.items.map((item, i) => {
                  const paper = PAPER[(ci * 2 + i) % PAPER.length];
                  const fileNo = `WK-${String(ci * 100 + i + 1).padStart(5, "0")}`;
                  return (
                    <button type="button" class="album" style={`--cover:${paper.cover};--ink:${paper.ink}`}
                      data-cover data-cat={cat.label} data-title={item.title} data-creator={item.creator}
                      data-year={String(item.year)} data-note={item.note} data-cover-color={paper.cover}
                      data-ink={paper.ink} data-code={fileNo} data-image={item.cover ?? ""} aria-label={`${item.title}，${item.creator}，${item.year}`}>
                      <span class="album__cover">
                        {item.cover ? (
                            <img class="album__img" src={coverSrc(item.cover, 480)} srcset={coverSrcSet(item.cover)} sizes="(min-width: 768px) 150px, 40vw" alt="" loading="lazy" />
                        ) : (
                          <span class="album__fallback">{item.title}</span>
                        )}
                        <span class="album__code">{fileNo}</span>
                      </span>
                      <span class="album__meta">
                        <span class="album__title">{item.title}</span>
                        <span class="album__by">{item.creator}{item.year ? ` · ${item.year}` : ""}</span>
                      </span>
                    </button>
                  );
                })}
              </div>
              <button type="button" class="col-albums__nav col-albums__nav--next" data-albumnav="1" aria-label="下一张专辑">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M9 5l7 7-7 7" /></svg>
              </button>
            </div>
          ) : (
            <ul class="col-wall" data-wall data-kind={cat.id} style={`--ar:${ar}`}>
              {cat.items.map((item, i) => {
                const paper = PAPER[(ci * 2 + i) % PAPER.length];
                const fileNo = `WK-${String(ci * 100 + i + 1).padStart(5, "0")}`;
                return (
                  <li class="col-wallitem">
                    <button type="button" class="col-wallcard" style={`--cover:${paper.cover};--ink:${paper.ink}`}
                      data-cover data-cat={cat.label} data-title={item.title} data-creator={item.creator}
                      data-year={String(item.year)} data-note={item.note} data-cover-color={paper.cover}
                      data-ink={paper.ink} data-code={fileNo}
                      data-kind={cat.id === "movies" ? "film" : cat.id === "tv" ? "tv" : "book"}
                      data-en={cat.en} data-ref={item.link ?? ""} data-desc={item.desc ?? ""}
                      data-desc-source={item.descSource ?? ""}
                      data-rating={item.rating != null ? String(item.rating) : ""}
                      data-rating-count={item.ratingCount != null ? String(item.ratingCount) : ""}
                      data-rating-source={item.ratingSource ?? ""}
                      data-press={item.press ?? ""} data-pubdate={item.pubdate ?? ""} data-pages={item.pages ?? ""}
                      data-image={item.cover ?? ""}
                      aria-label={`${item.title}，${item.creator}，${item.year}`}>
                      <span class={`col-wallcard__cover${item.cover ? " has-img" : ""}`}>
                        {item.cover ? <img class="col-wallcard__img" src={coverSrc(item.cover, 480)} srcset={coverSrcSet(item.cover)} sizes="(min-width: 768px) 150px, 40vw" alt="" loading="lazy" /> : null}
                        <span class="col-wallcard__code">{fileNo}</span>
                        <span class="col-wallcard__title">{item.title}</span>
                        <span class="col-wallcard__by">{item.creator}</span>
                      </span>
                    </button>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      );
    })}
        </section>

