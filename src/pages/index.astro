---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { readingTime } from "../utils/readingTime";
import ContributionHeatmap from "../components/ContributionHeatmap.astro";
import { fetchContributions } from "../utils/contributions";
import { postPath } from "../utils/urls";
import {
  SITE_NAME,
  SITE_AVATAR,
  SITE_SOCIAL,
  SITE_CREATED,
} from "../consts";

// GitHub 贡献热力图（构建时取数；失败留空不影响首页）
const { grid: contribGrid, total: contribTotal } =
  await fetchContributions().catch(() => ({ grid: [], total: null }));

const [allPosts, allMoments] = await Promise.all([
  getCollection("posts"),
  getCollection("moments"),
]);

const published = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const moments = allMoments
  .filter((m) => !m.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// featured 生效规则：有置顶就取置顶里最新的一篇，否则取最新一篇。
// 这样 CMS 里那个「置顶」开关不再是点了没效果的摆设。
const featuredPosts = published.filter((p) => p.data.featured);
const heroPost = featuredPosts[0] ?? published[0];
// 近期笔墨：报头已展示最新一篇，列表从第 2 篇开始排
const listPosts = published.slice(1, 6);

// 创站坚持天数
const now = new Date();
const daysNum = Math.floor((now.getTime() - SITE_CREATED.getTime()) / 86400000) + 1;

// --- journal helpers ---
const fmtMonthDay = (d: Date) =>
  d.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" });
const fmtYearMonth = (d: Date) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit" });

---

<BaseLayout title="首页">
  <div class="mx-auto max-w-[1380px] px-6 md:px-8">
    <!-- ===== 双栏主区：左列（报头头条 + 近期笔墨） | 右列（关于/纪事/标签，贴顶） ===== -->
    <div class="home-layout">
      <!-- 左列 -->
      <div class="min-w-0">
        {heroPost && (
          <header class="home-masthead">
            <span class="home-masthead__rail" aria-hidden="true">
              {SITE_NAME}
            </span>
            <div class="home-masthead__body">
              <div class="home-masthead__topline" aria-hidden="true"></div>
              <div class="home-kicker ed-in" style="--d: 120ms">
                <span class="home-kicker__label">最新文章</span>
              </div>
              <a href={postPath(heroPost)} class="no-underline">
                <h1 class="home-masthead__title" data-char-wipe>{heroPost.data.title}</h1>
              </a>
              {heroPost.data.excerpt && (
                <p class="home-masthead__dek ed-in" style="--d: 640ms">{heroPost.data.excerpt}</p>
              )}
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-[var(--color-ed-subtle)] ed-in" style="--d: 760ms">
                <span>{readingTime(String(heroPost.body || ""))} 分钟阅读</span>
                {heroPost.data.tags?.length > 0 && (
                  <>
                    <span class="text-[var(--color-ed-sep)]" aria-hidden="true">·</span>
                    <span>{heroPost.data.tags.join(" · ")}</span>
                  </>
                )}
              </div>
            </div>
          </header>
        )}

        <div class="home-sec-head mask-reveal">
          <span class="home-sec-title">
            近期笔墨
            <small>Recent Writing</small>
          </span>
          <a href="/archive/" class="home-sec-more">全部文章 →</a>
        </div>

        {published.length === 0 ? (
          <p class="py-24 text-center font-serif text-2xl text-[var(--color-ed-muted)]">
            暂无文章。
          </p>
        ) : (
          listPosts.map((post, i) => (
            <a
              href={postPath(post)}
              class="home-post-row reveal"
              style={`--reveal-delay: ${i * 60}ms`}
            >
              <span class="home-post-body">
                <span class="home-post-title">{post.data.title}</span>
                {post.data.excerpt && (
                  <span class="home-post-excerpt">{post.data.excerpt}</span>
                )}
              </span>
              <span class="home-post-meta">
                {fmtMonthDay(post.data.date)}
                <br />
                {readingTime(String(post.body || ""))} 分钟
              </span>
            </a>
          ))
        )}
      </div>

      <!-- 右侧独立栏 -->
      <aside class="home-side">
        <!-- 关于 -->
        <div class="home-side-card reveal">
          <div class="home-side-label">关于 · About</div>
          <div class="home-about-head">
            <img
              class="home-about-avatar"
              src={SITE_AVATAR}
              alt={SITE_NAME}
              width={256}
              height={256}
            />
            <div class="min-w-0">
              <span class="home-about-name">{SITE_NAME}</span>
            </div>
          </div>
          <div class="home-about-stats">
            <div class="home-stat">
              <span class="home-stat__num">{published.length}</span>
              <span class="home-stat__label">文章</span>
            </div>
            <div class="home-stat">
              <span class="home-stat__num">{moments.length}</span>
              <span class="home-stat__label">纪事</span>
            </div>
            <div class="home-stat">
              <span class="home-stat__num">{daysNum}</span>
              <span class="home-stat__label">天</span>
            </div>
          </div>
          <div class="home-about-heatmap mb-3">
            <ContributionHeatmap grid={contribGrid} total={contribTotal} />
          </div>
          <div class="home-about-socials">
            {SITE_SOCIAL.map((s) => (
              <a
                class="home-soc"
                href={s.href}
                target={s.href.startsWith("#") ? undefined : "_blank"}
                rel={s.href.startsWith("#") ? undefined : "noopener noreferrer"}
                aria-label={s.label}
                title={s.label}
              >
                <Icon name={s.icon} class="w-4 h-4" aria-hidden="true" />
              </a>
            ))}
            <a class="home-soc" href="/rss.xml" aria-label="RSS" title="RSS">
              <Icon name="mdi:rss" class="w-4 h-4" aria-hidden="true" />
            </a>
          </div>
        </div>

        <!-- 纪事 -->
        {moments.length > 0 && (
          <div class="home-side-card reveal" style="--reveal-delay: 80ms">
            <div class="home-side-label">纪事 · Moments</div>
            {moments.slice(0, 4).map((m) => (
              <a href="/timeline/" class="home-moment-line">
                <span class="home-moment-dot" aria-hidden="true"></span>
                <span class="home-moment-title">
                  {m.data.title ?? m.data.date.toISOString().slice(0, 10)}
                </span>
                <span class="home-moment-date">
                  {fmtYearMonth(m.data.date)}
                </span>
              </a>
            ))}
          </div>
        )}
      </aside>
    </div>
  </div>

  <!-- 逐字擦除与进度条脚本已上移至 BaseLayout（全站共享） -->
</BaseLayout>

