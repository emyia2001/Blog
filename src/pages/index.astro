---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { readingTime } from "../utils/readingTime";
import ContributionHeatmap from "../components/ContributionHeatmap.astro";
import { fetchContributions } from "../utils/contributions";
import {
  SITE_NAME,
  SITE_AVATAR,
  SITE_SOCIAL,
  SITE_CREATED,
} from "../consts";

// GitHub 贡献热力图（构建时取数；失败留空不影响首页）
const { grid: contribGrid, total: contribTotal } =
  await fetchContributions().catch(() => ({ grid: [], total: null }));

const [allPosts, allMoments] = await Promise.all([
  getCollection("posts"),
  getCollection("moments"),
]);

const published = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const moments = allMoments
  .filter((m) => !m.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const heroPost = published[0];
// 近期笔墨：报头已展示最新一篇，列表从第 2 篇开始排
const listPosts = published.slice(1, 6);

// 创站坚持天数
const now = new Date();
const daysNum = Math.floor((now.getTime() - SITE_CREATED.getTime()) / 86400000) + 1;

// --- journal helpers ---
const postUrl = (id: string) => `/blog/${id.replace(/\.mdx$/, "")}`;
const fmtMonthDay = (d: Date) =>
  d.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" });
const fmtYearMonth = (d: Date) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit" });

// Issue numbering: 最新一篇 = 本期（第 N 期）
const vol = String(Math.max(published.length, 1)).padStart(2, "0");
// 每篇文章的固定刊号（倒序：最新 01）
const issueOf = (id: string) =>
  String(published.findIndex((p) => p.id === id) + 1).padStart(2, "0");

// 标签计数
const tagCounts = new Map<string, number>();
for (const p of published) for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
const sortedTags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);

const daysStr = String(daysNum).padStart(2, "0");
---

<script is:inline>
  // Must run before .reveal / .char-reveal / .mask-reveal elements render
  document.documentElement.classList.add("js");
</script>

<BaseLayout title="首页">
  <div class="mx-auto max-w-[1380px] px-6 md:px-8">
    <!-- ===== 双栏主区：左列（报头头条 + 近期笔墨） | 右列（关于/纪事/标签，贴顶） ===== -->
    <div class="home-layout">
      <!-- 左列 -->
      <main class="min-w-0">
        {heroPost && (
          <header class="home-masthead">
            <div class="home-kicker">
              本期头条 · Current Issue
              <span class="home-kicker__vol">Vol. {vol} · 创站第 {daysStr} 天</span>
            </div>
            <a href={postUrl(heroPost.id)} class="no-underline">
              <h1 class="home-masthead__title">{heroPost.data.title}</h1>
            </a>
            {heroPost.data.excerpt && (
              <p class="home-masthead__dek">{heroPost.data.excerpt}</p>
            )}
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-[var(--color-ed-subtle)]">
              <span>{readingTime(String(heroPost.body || ""))} 分钟阅读</span>
              {heroPost.data.tags?.length > 0 && (
                <>
                  <span class="text-[var(--color-ed-faint)]" aria-hidden="true">·</span>
                  <span>{heroPost.data.tags.join(" · ")}</span>
                </>
              )}
            </div>
            <a href={postUrl(heroPost.id)} class="home-masthead__cta">
              阅读本期 →
            </a>
          </header>
        )}

        <div class="home-sec-head">
          <span class="home-sec-title">
            近期笔墨
            <small>Recent Writing</small>
          </span>
          <a href="/archive" class="home-sec-more">全部文章 →</a>
        </div>

        {published.length === 0 ? (
          <p class="py-24 text-center font-serif text-2xl text-[var(--color-ed-muted)]">
            暂无文章。
          </p>
        ) : (
          listPosts.map((post) => (
            <a href={postUrl(post.id)} class="home-post-row">
              <span class="home-post-no">{issueOf(post.id)}</span>
              <span class="home-post-body">
                <span class="home-post-title">{post.data.title}</span>
                {post.data.excerpt && (
                  <span class="home-post-excerpt">{post.data.excerpt}</span>
                )}
              </span>
              <span class="home-post-meta">
                {fmtMonthDay(post.data.date)}
                <br />
                {readingTime(String(post.body || ""))} 分钟
              </span>
            </a>
          ))
        )}
      </main>

      <!-- 右侧独立栏 -->
      <aside class="home-side">
        <!-- 关于 -->
        <div class="home-side-card">
          <div class="home-side-label">关于 · About</div>
          <div class="home-about-head">
            <img
              class="home-about-avatar"
              src={SITE_AVATAR}
              alt={SITE_NAME}
            />
            <div class="min-w-0">
              <span class="home-about-name">{SITE_NAME}</span>
              <span class="home-about-tag">在数字缝隙里写字</span>
            </div>
          </div>
          <p class="home-about-bio">
            这里是 <strong class="font-semibold text-[var(--color-ed-fg)]">{SITE_NAME}</strong>
            ——主要记录一些随笔、反思和笔记的个人空间。创建这个博客，是因为随着年龄增长，
            曾经的兴趣爱好和生活方式都发生了变化，记忆已不足以完整记下发生过的事与走散的朋友，
            所以想有一个地方来记录这些变化。
          </p>
          <div class="home-about-stats">
            <div class="home-stat">
              <span class="home-stat__num">{published.length}</span>
              <span class="home-stat__label">文章</span>
            </div>
            <div class="home-stat">
              <span class="home-stat__num">{moments.length}</span>
              <span class="home-stat__label">纪事</span>
            </div>
            <div class="home-stat">
              <span class="home-stat__num">{daysNum}</span>
              <span class="home-stat__label">天</span>
            </div>
          </div>
          <div class="home-about-heatmap mb-3">
            <ContributionHeatmap grid={contribGrid} total={contribTotal} />
          </div>
          <div class="home-about-socials">
            {SITE_SOCIAL.map((s) => (
              <a
                class="home-soc"
                href={s.href}
                target={s.href.startsWith("#") ? undefined : "_blank"}
                rel={s.href.startsWith("#") ? undefined : "noopener noreferrer"}
                aria-label={s.label}
                title={s.label}
              >
                <Icon name={s.icon} class="w-4 h-4" aria-hidden="true" />
              </a>
            ))}
            <a class="home-soc" href="/rss.xml" aria-label="RSS" title="RSS">
              <Icon name="mdi:rss" class="w-4 h-4" aria-hidden="true" />
            </a>
          </div>
        </div>

        <!-- 纪事 -->
        {moments.length > 0 && (
          <div class="home-side-card">
            <div class="home-side-label">纪事 · Moments</div>
            {moments.slice(0, 4).map((m) => (
              <a href="/timeline" class="home-moment-line">
                <span class="home-moment-dot" aria-hidden="true"></span>
                <span class="home-moment-title">{m.data.title}</span>
                <span class="home-moment-date">
                  {fmtYearMonth(m.data.date)}
                </span>
              </a>
            ))}
            <div class="mt-2 text-right">
              <a href="/timeline" class="home-sec-more">纪事时间线 →</a>
            </div>
          </div>
        )}

        <!-- 标签 -->
        {sortedTags.length > 0 && (
          <div class="home-side-card">
            <div class="home-side-label">标签 · Tags</div>
            <div class="flex flex-wrap gap-2">
              {sortedTags.map(([tag, count]) => (
                <a
                  href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}`}
                  class="home-tag"
                >
                  {tag}
                  <b>{count}</b>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>

    <p class="home-signoff">—— 慢慢写。</p>
  </div>
</BaseLayout>

<script>
  // Scroll reveal: fades (.reveal) and clip wipes (.mask-reveal) on enter
  const revealEls = document.querySelectorAll(".reveal, .mask-reveal");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add("is-visible"));
  }
</script>
