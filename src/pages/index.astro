---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { readingTime } from "../utils/readingTime";
import ContributionHeatmap from "../components/ContributionHeatmap.astro";
import { fetchContributions } from "../utils/contributions";
import { postPath } from "../utils/urls";
import {
  SITE_NAME,
  SITE_AVATAR,
  SITE_SOCIAL,
  SITE_CREATED,
} from "../consts";

// GitHub 贡献热力图（构建时取数；失败留空不影响首页）
const { grid: contribGrid, total: contribTotal } =
  await fetchContributions().catch(() => ({ grid: [], total: null }));

const [allPosts, allMoments] = await Promise.all([
  getCollection("posts"),
  getCollection("moments"),
]);

const published = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const moments = allMoments
  .filter((m) => !m.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// featured 生效规则：有置顶就取置顶里最新的一篇，否则取最新一篇。
// 这样 CMS 里那个「置顶」开关不再是点了没效果的摆设。
const featuredPosts = published.filter((p) => p.data.featured);
const heroPost = featuredPosts[0] ?? published[0];
// 近期笔墨：报头已展示最新一篇，列表从第 2 篇开始排
const listPosts = published.slice(1, 6);

// 创站坚持天数
const now = new Date();
const daysNum = Math.floor((now.getTime() - SITE_CREATED.getTime()) / 86400000) + 1;

// --- journal helpers ---
const fmtMonthDay = (d: Date) =>
  d.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" });
const fmtYearMonth = (d: Date) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit" });

---

<BaseLayout title="首页">
  <div class="mx-auto max-w-[1380px] px-6 md:px-8">
    <!-- ===== 双栏主区：左列（报头头条 + 近期笔墨） | 右列（关于/纪事/标签，贴顶） ===== -->
    <div class="home-layout">
      <!-- 左列 -->
      <div class="min-w-0">
        {heroPost && (
          <header class="home-masthead">
            <div class="home-masthead__body">
              <div class="home-masthead__topline" aria-hidden="true"></div>
              <a href={postPath(heroPost)} class="no-underline">
                <h1 class="home-masthead__title" data-char-wipe>{heroPost.data.title}</h1>
              </a>
              {heroPost.data.excerpt && (
                <p class="home-masthead__dek ed-in" style="--d: 420ms">{heroPost.data.excerpt}</p>
              )}
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-[var(--color-ed-subtle)] ed-in" style="--d: 520ms">
                <span>{readingTime(String(heroPost.body || ""))} 分钟阅读</span>
                {heroPost.data.tags?.length > 0 && (
                  <>
                    <span class="text-[var(--color-ed-sep)]" aria-hidden="true">·</span>
                    <span>{heroPost.data.tags.join(" · ")}</span>
                  </>
                )}
              </div>
            </div>
          </header>
        )}

        <div class="home-sec-head mask-reveal">
          <h2 class="home-sec-title">近期笔墨</h2>
          <a href="/archive/" class="home-sec-more">全部文章 →</a>
        </div>

        {published.length === 0 ? (
          <p class="py-24 text-center font-serif text-2xl text-[var(--color-ed-muted)]">
            暂无文章。
          </p>
        ) : (
          listPosts.map((post, i) => (
            <a
              href={postPath(post)}
              class="home-post-row reveal"
              style={`--reveal-delay: ${Math.min(i * 60, 300)}ms`}
            >
              <span class="home-post-body">
                <span class="home-post-title">{post.data.title}</span>
                {post.data.excerpt && (
                  <span class="home-post-excerpt">{post.data.excerpt}</span>
                )}
              </span>
              <span class="home-post-meta">
                {fmtMonthDay(post.data.date)}
                <br />
                {readingTime(String(post.body || ""))} 分钟
              </span>
            </a>
          ))
        )}
      </div>

      <!-- 右侧独立栏 -->
      <aside class="home-side">
        <!-- 关于 -->
        <div class="home-side-card reveal">
          <div class="home-about-head">
            <img
              class="home-about-avatar"
              src={SITE_AVATAR}
              alt={SITE_NAME}
              width={256}
              height={256}
            />
            <div class="min-w-0">
              <span class="home-about-name">{SITE_NAME}</span>
            </div>
          </div>
          <div class="home-about-stats">
            <div class="home-stat">
              <span class="home-stat__num" data-count-to={published.length}>{published.length}</span>
              <span class="home-stat__label">文章</span>
            </div>
            <div class="home-stat">
              <span class="home-stat__num" data-count-to={moments.length}>{moments.length}</span>
              <span class="home-stat__label">纪事</span>
            </div>
            <div class="home-stat">
              <span class="home-stat__num" data-count-to={daysNum}>{daysNum}</span>
              <span class="home-stat__label">天</span>
            </div>
          </div>
          <div class="home-about-heatmap mb-3">
            <ContributionHeatmap grid={contribGrid} total={contribTotal} />
          </div>
          <div class="home-about-socials">
            {SITE_SOCIAL.map((s) => (
              <a
                class="home-soc"
                href={s.href}
                target={s.href.startsWith("#") ? undefined : "_blank"}
                rel={s.href.startsWith("#") ? undefined : "noopener noreferrer"}
                aria-label={s.label}
                title={s.label}
              >
                <Icon name={s.icon} class="w-4 h-4" aria-hidden="true" />
              </a>
            ))}
            <a class="home-soc" href="/rss.xml" aria-label="RSS" title="RSS">
              <Icon name="mdi:rss" class="w-4 h-4" aria-hidden="true" />
            </a>
          </div>
        </div>

        <!-- 纪事 -->
        {moments.length > 0 && (
          <div class="home-side-card reveal" style="--reveal-delay: 80ms">
            <h2 class="home-side-label">纪事</h2>
            {moments.slice(0, 4).map((m) => (
              <a href="/timeline/" class="home-moment-line">
                <span class="home-moment-dot" aria-hidden="true"></span>
                <span class="home-moment-title">
                  {m.data.title ?? m.data.date.toISOString().slice(0, 10)}
                </span>
                <span class="home-moment-date">
                  {fmtYearMonth(m.data.date)}
                </span>
              </a>
            ))}
          </div>
        )}
      </aside>
    </div>
  </div>

  <!-- 逐字擦除与进度条脚本已上移至 BaseLayout（全站共享） -->
</BaseLayout>

<script>
  // ===== 首页统计数字 count-up =====
  // 目标值走 data-count-to（不解析文本，避免把「天」之类的单位混进数字）。
  // View Transitions：脚本每次换页会重新执行，监听只绑一次，状态挂 window。
  const homeWindow = window as Window & { __homeCountBound?: boolean };

  // 复用全站动效令牌 --ease-ed（cubic-bezier），而不是另起一条曲线
  const easeFromToken = () => {
    const fallback = (t: number) => 1 - Math.pow(1 - t, 4);
    const raw = getComputedStyle(document.documentElement)
      .getPropertyValue("--ease-ed")
      .trim();
    const m = /cubic-bezier\(\s*([\d.-]+)\s*,\s*([\d.-]+)\s*,\s*([\d.-]+)\s*,\s*([\d.-]+)\s*\)/.exec(raw);
    if (!m) return fallback;
    const [x1, y1, x2, y2] = m.slice(1, 5).map(Number);
    if ([x1, y1, x2, y2].some((n) => !Number.isFinite(n))) return fallback;

    const cx = 3 * x1;
    const bx = 3 * (x2 - x1) - cx;
    const ax = 1 - cx - bx;
    const cy = 3 * y1;
    const by = 3 * (y2 - y1) - cy;
    const ay = 1 - cy - by;
    const sampleX = (t: number) => ((ax * t + bx) * t + cx) * t;
    const sampleY = (t: number) => ((ay * t + by) * t + cy) * t;

    return (t: number) => {
      // 二分反解 x → t，再取 y
      let lo = 0;
      let hi = 1;
      let mid = t;
      for (let i = 0; i < 10; i++) {
        mid = (lo + hi) / 2;
        if (sampleX(mid) < t) lo = mid;
        else hi = mid;
      }
      return sampleY(mid);
    };
  };

  function initHomeStats() {
    const nums = Array.from(
      document.querySelectorAll<HTMLElement>(".home-stat__num[data-count-to]")
    );
    if (!nums.length) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const run = (el: HTMLElement) => {
      if (el.dataset.counted === "1") return;
      el.dataset.counted = "1";
      const target = Number(el.dataset.countTo);
      if (!Number.isFinite(target)) return;
      if (reduce) {
        el.textContent = String(target);
        return;
      }
      const ease = easeFromToken();
      const started = performance.now();
      const dur = 900;
      el.textContent = "0";
      const tick = (now: number) => {
        const p = Math.min((now - started) / dur, 1);
        el.textContent = String(Math.round(ease(p) * target));
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = String(target);
      };
      requestAnimationFrame(tick);
    };

    if (reduce || !("IntersectionObserver" in window)) {
      nums.forEach(run);
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io.unobserve(entry.target);
          run(entry.target as HTMLElement);
        }
      },
      { threshold: 0.6 }
    );

    for (const el of nums) {
      if (el.dataset.counted === "1") continue;
      const rect = el.getBoundingClientRect();
      // 已在视口里：立刻跑，避免「先显示终值再跳回 0」的闪动
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        run(el);
        continue;
      }
      // 视口外：先归零（看不见，不会闪），滚到位再计数
      el.textContent = "0";
      io.observe(el);
    }
  }

  if (!homeWindow.__homeCountBound) {
    homeWindow.__homeCountBound = true;
    document.addEventListener("astro:page-load", initHomeStats);
  }
  initHomeStats();
</script>

<style>
  /* 计数滚动时数字宽度会跳动，等宽数字让三栏不抖 */
  .home-stat__num {
    font-variant-numeric: tabular-nums;
  }
</style>

