---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="搜索">
  <section class="py-24 md:py-32 px-6">
    <div class="mx-auto max-w-2xl">
      <h1 class="font-serif text-3xl md:text-4xl tracking-tighter text-[var(--color-ed-fg)] mb-12">
        搜索
      </h1>

      <input
        type="search"
        id="search-input"
        placeholder="搜索文章…"
        class="w-full px-4 py-3 text-sm border border-[var(--color-ed-faint)] bg-transparent text-[var(--color-ed-fg)] placeholder:text-[var(--color-ed-subtle)] focus:outline-none focus:border-[var(--color-ed-fg)] transition-colors mb-8"
      />

      <div id="search-results">
        <p class="text-sm text-[var(--color-ed-muted)]">
          开发模式下搜索不可用，请运行 <code class="text-xs bg-[var(--color-ed-faint)] px-1.5 py-0.5">npm run build && npm run preview</code>。
        </p>
      </div>

      <noscript>
        <p class="text-sm text-[var(--color-ed-muted)]">
          全文搜索需要启用 JavaScript。
        </p>
      </noscript>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById("search-input") as HTMLInputElement;
  const results = document.getElementById("search-results");
  if (!input || !results) throw new Error("search elements missing");

  function loadSearch() {
    const script = document.createElement("script");
    script.src = "/pagefind/pagefind.js";
    script.onload = async () => {
      const pf = (window as any).Pagefind;
      if (!pf) return;
      await pf.init();
      results.innerHTML = "";

      let debounce: ReturnType<typeof setTimeout>;
      input.addEventListener("input", () => {
        clearTimeout(debounce);
        debounce = setTimeout(async () => {
          const query = input.value.trim();
          if (!query) {
            results.innerHTML = "";
            return;
          }

          const search = await pf.search(query);
          if (!search.results.length) {
            results.innerHTML =
              '<p class="text-sm text-[var(--color-ed-muted)]">未找到结果。</p>';
            return;
          }

          const html: string[] = [];
          for (const result of search.results) {
            const data = await result.data();
            html.push(
              `<a href="${data.url}" class="block border-b border-[var(--color-ed-faint)] py-6 no-underline group">
                <h2 class="font-serif text-lg text-[var(--color-ed-fg)] group-hover:text-[var(--color-ed-muted)] transition-colors">
                  ${data.meta?.title || "无标题"}
                </h2>
                <p class="mt-1 text-xs text-[var(--color-ed-subtle)] line-clamp-2">
                  ${data.excerpt || ""}
                </p>
              </a>`
            );
          }
          results.innerHTML = html.join("");
        }, 300);
      });
    };
    script.onerror = () => {
      // Pagefind not available (dev mode)
    };
    document.head.appendChild(script);
  }

  loadSearch();
</script>
