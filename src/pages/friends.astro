---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import {
  SITE_NAME,
  SITE_URL,
  SITE_AVATAR,
  SITE_DESCRIPTION,
} from "../consts";
import { FRIENDS } from "../data/friends";
import FriendTreeDialog from "../components/FriendTreeDialog.astro";
import Giscus from "../components/Giscus.astro";

const avatarUrl = new URL(SITE_AVATAR, SITE_URL).href;
const bare = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
const friendItems = FRIENDS.map((f) => ({
  name: f.name,
  url: f.url,
  host: bare(f.url),
  desc: f.desc,
  avatar: f.avatar ?? null,
}));

// 双向（对方也链了本站）排前，单向排后
const mutualFriends = FRIENDS.filter((f) => f.mutual);
const oneWayFriends = FRIENDS.filter((f) => !f.mutual);
---

<BaseLayout title="友链" description="友链：独立博客之间的互相推荐与交换。">
  <div class="page-shell page-shell--medium">
    <header class="page-head">
      <div class="page-head__row">
        <h1 class="page-head__title">友链</h1>
        <div class="page-head__asides">
          <span class="bark-status" id="bark-hint" aria-live="polite"></span>
          <button
            type="button"
            id="bark-push"
            class="friend-apply-btn"
            aria-label="申请友链 · 推送提醒给站长"
            title="推送提醒给站长（每人每天一次）"
          >
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <g transform="rotate(-45 6.5 17.5)">
                <rect x="1.5" y="15" width="10" height="5" rx="2.5"></rect>
              </g>
              <g transform="rotate(45 12 12)">
                <rect x="7" y="9.5" width="10" height="5" rx="2.5"></rect>
              </g>
              <g transform="rotate(-45 17.5 6.5)">
                <rect x="12.5" y="4" width="10" height="5" rx="2.5"></rect>
              </g>
            </svg>
            <span class="btn-text">提醒站长</span>
          </button>
        </div>
      </div>
    </header>

    <section class="mb-14" aria-labelledby="site-info-label">
      <h2 class="section-label section-label--plain" id="site-info-label">本站信息</h2>

      <dl class="friend-info">
        <div>
          <dt>名称</dt>
          <dd>{SITE_NAME}</dd>
        </div>
        <div>
          <dt>头像</dt>
          <dd>{bare(avatarUrl)}</dd>
        </div>
        <div>
          <dt>地址</dt>
          <dd>{bare(SITE_URL)}</dd>
        </div>
        <div class="friend-info__wide">
          <dt>简介</dt>
          <dd>{SITE_DESCRIPTION}</dd>
        </div>
      </dl>

    </section>

    <section class="mb-14" aria-labelledby="mutual-label">
      <h2 class="section-label section-label--plain" id="mutual-label">双向友链</h2>

      {mutualFriends.length > 0 ? (
        <ul class="friend-grid" data-friend-grid>
          {mutualFriends.map((friend, i) => (
            <li class="friend-item reveal" style={`--reveal-delay: ${Math.min(i * 60, 300)}ms`}>
              <button
                type="button"
                class="friend-card"
                data-friend-select={i}
                aria-haspopup="dialog"
              >
                {friend.avatar ? (
                  <img
                    class="friend-avatar"
                    src={friend.avatar}
                    alt=""
                    width="44"
                    height="44"
                    loading="lazy"
                  />
                ) : (
                  <span class="friend-avatar friend-avatar--fallback" aria-hidden="true">
                    {friend.name.slice(0, 1)}
                  </span>
                )}
                <span class="friend-body">
                  <span class="friend-name">{friend.name}</span>
                  {friend.desc && <span class="friend-desc">{friend.desc}</span>}
                  <span class="friend-host">{bare(friend.url)}</span>
                </span>
                <span class="friend-qr" aria-hidden="true">
                  <Icon name="mdi:qrcode" />
                </span>
                <span class="sr-only">打开二维码</span>
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-note">暂无，欢迎交换。</p>
      )}
    </section>

    <section aria-labelledby="oneway-label">
      <h2 class="section-label section-label--plain" id="oneway-label">单向友链</h2>

      {oneWayFriends.length > 0 ? (
        <ul class="friend-grid" data-friend-grid>
          {oneWayFriends.map((friend, i) => (
            <li class="friend-item reveal" style={`--reveal-delay: ${Math.min(i * 60, 300)}ms`}>
              <button
                type="button"
                class="friend-card"
                data-friend-select={i + mutualFriends.length}
                aria-haspopup="dialog"
              >
                {friend.avatar ? (
                  <img
                    class="friend-avatar"
                    src={friend.avatar}
                    alt=""
                    width="44"
                    height="44"
                    loading="lazy"
                  />
                ) : (
                  <span class="friend-avatar friend-avatar--fallback" aria-hidden="true">
                    {friend.name.slice(0, 1)}
                  </span>
                )}
                <span class="friend-body">
                  <span class="friend-name">{friend.name}</span>
                  {friend.desc && <span class="friend-desc">{friend.desc}</span>}
                  <span class="friend-host">{bare(friend.url)}</span>
                </span>
                <span class="friend-qr" aria-hidden="true">
                  <Icon name="mdi:qrcode" />
                </span>
                <span class="sr-only">打开二维码</span>
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-note">暂无。</p>
      )}
    </section>

    <section class="mb-14" aria-labelledby="friends-comments-label">
      <h2 class="section-label section-label--plain" id="friends-comments-label">
        友链留言
      </h2>
      <p class="comments-note">
        想交换友链？在这里留下你的站点名称、地址与一句话简介即可（需 GitHub 登录，天然免垃圾评论）。
      </p>
      <Giscus />
    </section>
  </div>

  <FriendTreeDialog
    friends={friendItems}
    siteName={SITE_NAME}
    siteUrl={SITE_URL}
    siteDesc={SITE_DESCRIPTION}
    siteAvatar={SITE_AVATAR}
  />
</BaseLayout>

<style>
  .friend-item {
    position: relative;
  }

  .friend-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .friend-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    padding: 1.1rem 1.15rem;
    border: 0;
    border-radius: 4px;
    background: rgba(28, 28, 28, 0.035);
    font: inherit;
    text-align: left;
    color: var(--color-ed-fg);
    cursor: pointer;
    transition: background-color 180ms ease;
  }
  .friend-card:hover,
  .friend-card:focus-visible {
    background: rgba(166, 58, 43, 0.07);
  }
  .friend-card:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: -2px;
  }
  .friend-card:hover .friend-name,
  .friend-card:focus-visible .friend-name {
    color: var(--color-ed-accent);
  }
  .friend-card:hover .friend-qr,
  .friend-card:focus-visible .friend-qr {
    color: var(--color-ed-accent);
    opacity: 1;
  }

  .friend-avatar {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
    background: rgba(28, 28, 28, 0.06);
  }
  .friend-avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--color-ed-muted);
  }

  .friend-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .friend-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.4;
    transition: color 180ms ease;
  }
  .friend-desc {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-ed-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .friend-host {
    overflow-wrap: anywhere;
    font-size: 0.6875rem;
    color: var(--color-ed-subtle);
  }

  /* 卡片右侧的二维码提示：让人知道点开是二维码，而不是直接跳走 */
  .friend-qr {
    margin-left: auto;
    align-self: center;
    flex: none;
    color: var(--color-ed-subtle);
    opacity: 0.5;
    transition: color 180ms ease, opacity 180ms ease;
  }
  .friend-qr :global(svg) {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
  }

  .friend-info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.95rem 2.5rem;
    margin: 0;
    padding: 1.3rem 1.35rem;
    border-radius: 4px;
    background: rgba(28, 28, 28, 0.035);
  }
  .friend-info > div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .friend-info__wide {
    grid-column: 1 / -1;
  }
  .friend-info dt {
    flex: 0 0 2.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-ed-subtle);
  }
  .friend-info dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 0.8125rem;
    color: var(--color-ed-fg);
  }

  @media (max-width: 640px) {
    .friend-grid,
    .friend-info {
      grid-template-columns: 1fr;
    }
  }

  /* 申请友链：页头右侧按钮，链条图标悬停轻晃 */
  .page-head__asides {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-shrink: 0;
  }
  .bark-status {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .friend-apply-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: transparent;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--fg);
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }
  .friend-apply-btn:hover:not([aria-disabled="true"]),
  .friend-apply-btn:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(166, 58, 43, 0.05);
  }
  .friend-apply-btn:hover:not([aria-disabled="true"]) svg {
    animation: chain-swing 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .friend-apply-btn[aria-disabled="true"] {
    color: var(--subtle);
    border-color: var(--hairline);
    cursor: default;
    background: rgba(28, 28, 28, 0.03);
  }
  .friend-apply-btn svg {
    transform-origin: center;
  }
  @keyframes chain-swing {
    0% {
      transform: rotate(0);
    }
    25% {
      transform: rotate(9deg);
    }
    50% {
      transform: rotate(-7deg);
    }
    75% {
      transform: rotate(4deg);
    }
    100% {
      transform: rotate(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .friend-apply-btn:hover svg {
      animation: none;
    }
  }

  /* 友链留言（Giscus）：说明行 + 评论区 */
  .comments-note {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--muted);
  }
</style>

<script>
  // Bark 推送：点击 → POST /api/bark（Worker 限每人每天一次 + 转发到站长 Bark）。
  // 推送成功/当日已提醒则禁用按钮；失败（502/503）可重试。
  // KV 是最终一致（跨边缘读不到刚写的记录），秒级双击会在服务端漏过——
  // 浏览器侧再用 localStorage 记当日已提醒，双保险。模块级委托，VT 换页安全
  const BARK_LS = "friend-bark:last-day";
  const barkDay = () =>
    new Date().toLocaleDateString("sv-SE", { timeZone: "Asia/Shanghai" });

  const setStatus = (msg: string) => {
    const hint = document.getElementById("bark-hint");
    if (hint) hint.textContent = msg;
  };
  const applyDisable = (btnText: string) => {
    const btn = document.getElementById("bark-push");
    const text = btn?.querySelector(".btn-text");
    btn?.setAttribute("aria-disabled", "true");
    if (text) text.textContent = btnText;
  };

  document.addEventListener("astro:page-load", () => {
    // 当日已提醒过：进页面就禁用按钮（KV 传播延迟时的客户端兜底）
    if (localStorage.getItem(BARK_LS) === barkDay()) {
      applyDisable("已提醒过啦");
      setStatus("每人每天一次，明天再来提醒我吧。");
    }
  });

  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element).closest?.(
      "#bark-push"
    ) as HTMLButtonElement | null;
    if (!btn || btn.dataset.busy === "1" || btn.getAttribute("aria-disabled") === "true") {
      return;
    }
    const text = btn.querySelector(".btn-text");
    btn.dataset.busy = "1";
    if (text) text.textContent = "推送中…";
    try {
      const res = await fetch("/api/bark", { method: "POST" });
      const data = (await res.json().catch(() => ({}))) as { error?: string };
      if (res.ok) {
        localStorage.setItem(BARK_LS, barkDay());
        applyDisable("已提醒 ✓");
        setStatus("提醒已送达站长手机；记得到 GitHub 提交申请。");
      } else if (data.error === "daily_cap") {
        localStorage.setItem(BARK_LS, barkDay());
        applyDisable("名额已满");
        setStatus("今天的提醒额度已被领完，明天再来吧。");
      } else if (res.status === 429 || data.error === "already_sent") {
        localStorage.setItem(BARK_LS, barkDay());
        applyDisable("已提醒过啦");
        setStatus("每人每天一次，明天再来提醒我吧。");
      } else {
        if (text) text.textContent = "提醒站长";
        setStatus("推送暂时失败，请到 GitHub 直接提申请。");
      }
    } catch {
      if (text) text.textContent = "提醒站长";
      setStatus("网络异常，请稍后再试。");
    } finally {
      btn.dataset.busy = "0";
    }
  });
</script>

