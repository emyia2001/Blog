---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import {
  SITE_NAME,
  SITE_URL,
  SITE_AVATAR,
  SITE_DESCRIPTION,
} from "../consts";
import { FRIENDS } from "../data/friends";
import FriendTreeDialog from "../components/FriendTreeDialog.astro";

const avatarUrl = new URL(SITE_AVATAR, SITE_URL).href;
const bare = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
const friendItems = FRIENDS.map((f) => ({
  name: f.name,
  url: f.url,
  host: bare(f.url),
  desc: f.desc,
  avatar: f.avatar ?? null,
}));
---

<BaseLayout title="友链" description="友链：独立博客之间的互相推荐与交换。">
  <div class="page-shell page-shell--medium">
    <header class="page-head">
      <div class="page-head__row">
        <h1 class="page-head__title">友链</h1>
      </div>
    </header>

    <section class="mb-14" aria-labelledby="site-info-label">
      <h2 class="section-label section-label--plain" id="site-info-label">本站信息</h2>

      <dl class="friend-info">
        <div>
          <dt>名称</dt>
          <dd>{SITE_NAME}</dd>
        </div>
        <div>
          <dt>地址</dt>
          <dd>{bare(SITE_URL)}</dd>
        </div>
        <div>
          <dt>头像</dt>
          <dd>{bare(avatarUrl)}</dd>
        </div>
        <div class="friend-info__wide">
          <dt>简介</dt>
          <dd>{SITE_DESCRIPTION}</dd>
        </div>
      </dl>

    </section>

    <button
      type="button"
      id="bark-push"
      class="bark-chime"
      aria-label="申请友链 · 拉一下推送提醒给站长"
    >
      <span class="bark-chime__string" aria-hidden="true"></span>
      <span class="bark-chime__body">
        <svg
          class="bark-chime__bell"
          viewBox="0 0 24 30"
          width="22"
          height="28"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M12 2C7.6 2 5 5.4 5 10.5V16h14v-5.5C19 5.4 16.4 2 12 2Z"></path>
          <path d="M5 16h14"></path>
        </svg>
        <span class="bark-chime__clapper" aria-hidden="true"></span>
        <span class="bark-chime__tanzaku" id="bark-hint" aria-live="polite">
          申请友链
        </span>
      </span>
    </button>

    {FRIENDS.length > 0 && (
      <section aria-labelledby="friends-label">
        <h2 class="sr-only" id="friends-label">友链</h2>

        <ul class="friend-grid" data-friend-grid>
          {FRIENDS.map((friend, i) => (
            <li class="friend-item reveal" style={`--reveal-delay: ${Math.min(i * 60, 300)}ms`}>
              <button
                type="button"
                class="friend-card"
                data-friend-select={i}
                aria-haspopup="dialog"
              >
                {friend.avatar ? (
                  <img
                    class="friend-avatar"
                    src={friend.avatar}
                    alt=""
                    width="44"
                    height="44"
                    loading="lazy"
                  />
                ) : (
                  <span class="friend-avatar friend-avatar--fallback" aria-hidden="true">
                    {friend.name.slice(0, 1)}
                  </span>
                )}
                <span class="friend-body">
                  <span class="friend-name">{friend.name}</span>
                  {friend.desc && <span class="friend-desc">{friend.desc}</span>}
                  <span class="friend-host">{bare(friend.url)}</span>
                </span>
                <span class="friend-qr" aria-hidden="true">
                  <Icon name="mdi:qrcode" />
                </span>
                <span class="sr-only">打开二维码</span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <FriendTreeDialog
    friends={friendItems}
    siteName={SITE_NAME}
    siteUrl={SITE_URL}
    siteDesc={SITE_DESCRIPTION}
    siteAvatar={SITE_AVATAR}
  />
</BaseLayout>

<style>
  .friend-item {
    position: relative;
  }

  .friend-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .friend-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    padding: 1.1rem 1.15rem;
    border: 0;
    border-radius: 4px;
    background: rgba(28, 28, 28, 0.035);
    font: inherit;
    text-align: left;
    color: var(--color-ed-fg);
    cursor: pointer;
    transition: background-color 180ms ease;
  }
  .friend-card:hover,
  .friend-card:focus-visible {
    background: rgba(166, 58, 43, 0.07);
  }
  .friend-card:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: -2px;
  }
  .friend-card:hover .friend-name,
  .friend-card:focus-visible .friend-name {
    color: var(--color-ed-accent);
  }
  .friend-card:hover .friend-qr,
  .friend-card:focus-visible .friend-qr {
    color: var(--color-ed-accent);
    opacity: 1;
  }

  .friend-avatar {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
    background: rgba(28, 28, 28, 0.06);
  }
  .friend-avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--color-ed-muted);
  }

  .friend-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .friend-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.4;
    transition: color 180ms ease;
  }
  .friend-desc {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-ed-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .friend-host {
    overflow-wrap: anywhere;
    font-size: 0.6875rem;
    color: var(--color-ed-subtle);
  }

  /* 卡片右侧的二维码提示：让人知道点开是二维码，而不是直接跳走 */
  .friend-qr {
    margin-left: auto;
    align-self: center;
    flex: none;
    color: var(--color-ed-subtle);
    opacity: 0.5;
    transition: color 180ms ease, opacity 180ms ease;
  }
  .friend-qr :global(svg) {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
  }

  .friend-info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.95rem 2.5rem;
    margin: 0;
    padding: 1.3rem 1.35rem;
    border-radius: 4px;
    background: rgba(28, 28, 28, 0.035);
  }
  .friend-info > div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .friend-info__wide {
    grid-column: 1 / -1;
  }
  .friend-info dt {
    flex: 0 0 2.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-ed-subtle);
  }
  .friend-info dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 0.8125rem;
    color: var(--color-ed-fg);
  }

  /* 友链申请风铃：悬在导航栏下沿，摇铃 = 推送提醒给站长。
     top 由脚本跟随导航底边（导航滑隐时风铃随之上收） */
  .bark-chime {
    position: fixed;
    z-index: 35;
    right: clamp(1.25rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: grab;
    touch-action: none;
    transform-origin: top center;
  }
  .bark-chime:active {
    cursor: grabbing;
  }
  .bark-chime__string {
    width: 1px;
    height: 34px;
    background: var(--color-ed-rule-strong);
  }
  .bark-chime__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: transform;
  }
  .bark-chime__bell {
    color: var(--color-ed-accent);
    filter: drop-shadow(0 1px 1.5px rgba(28, 28, 28, 0.16));
  }
  .bark-chime__clapper {
    width: 5px;
    height: 5px;
    margin-top: -3px;
    border-radius: 50%;
    background: var(--color-ed-accent);
  }
  .bark-chime__tanzaku {
    margin-top: 4px;
    padding: 0.55rem 0.18rem 0.75rem;
    writing-mode: vertical-rl;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    color: var(--color-ed-fg);
    background: var(--color-ed-bg);
    border: 1px solid var(--color-ed-rule);
    border-radius: 0 0 3px 3px;
    box-shadow: 0 1px 2px rgba(28, 28, 28, 0.08);
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }
  .bark-chime:hover .bark-chime__tanzaku,
  .bark-chime:focus-visible .bark-chime__tanzaku {
    color: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
  }
  .bark-chime:hover .bark-chime__bell {
    animation: chime-ring 0.9s var(--ease-ed);
  }
  .bark-chime__bell,
  .bark-chime__clapper {
    transform-origin: top center;
  }
  .bark-chime[aria-disabled="true"] {
    cursor: default;
  }
  .bark-chime[aria-disabled="true"] .bark-chime__bell {
    color: var(--color-ed-subtle);
  }
  .bark-chime[aria-disabled="true"] .bark-chime__tanzaku {
    color: var(--color-ed-subtle);
    border-color: var(--color-ed-hairline);
  }
  @keyframes chime-ring {
    0% {
      transform: rotate(0);
    }
    25% {
      transform: rotate(10deg);
    }
    50% {
      transform: rotate(-8deg);
    }
    75% {
      transform: rotate(4deg);
    }
    100% {
      transform: rotate(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bark-chime:hover .bark-chime__bell {
      animation: none;
    }
  }
  @media (max-width: 767px) {
    .bark-chime {
      scale: 0.85;
      right: 0.9rem;
    }
  }

  @media (max-width: 640px) {
    .friend-grid,
    .friend-info {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Bark 推送：点击 → POST /api/bark（Worker 限每人每天一次 + 转发到站长 Bark）。
  // 推送成功/当日已提醒则禁用按钮；失败（502/503）可重试。
  // KV 是最终一致（跨边缘读不到刚写的记录），秒级双击会在服务端漏过——
  // 浏览器侧再用 localStorage 记当日已提醒，双保险。模块级委托，VT 换页安全
  const BARK_LS = "friend-bark:last-day";
  const barkDay = () =>
    new Date().toLocaleDateString("sv-SE", { timeZone: "Asia/Shanghai" });

  // 风铃 top 跟随导航底边（导航向下滑隐时风铃随之上收，像真的挂在导航上）。
  // ResizeObserver 盯住导航尺寸：字体加载等导致导航变高时立即重新贴线
  const siteNav = document.querySelector(".site-nav");
  const chimeBtn = document.getElementById("bark-push");
  let chimeRaf = 0;
  const placeChime = () => {
    if (chimeRaf || !siteNav || !chimeBtn) return;
    chimeRaf = requestAnimationFrame(() => {
      chimeRaf = 0;
      // 紧贴导航分割线：只留 1px，避免风铃悬空
      chimeBtn.style.top = `${siteNav.getBoundingClientRect().bottom + 1}px`;
    });
  };
  placeChime();
  if (siteNav && typeof ResizeObserver !== "undefined") {
    new ResizeObserver(placeChime).observe(siteNav);
  }
  window.addEventListener("resize", placeChime, { passive: true });
  window.addEventListener("scroll", placeChime, { passive: true });
  window.addEventListener("load", placeChime);

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;
  const tanzaku = chimeBtn?.querySelector(
    ".bark-chime__tanzaku"
  ) as HTMLElement | null;

  // —— 状态文案（短册） ——
  const setTanzaku = (s: string) => {
    if (tanzaku) tanzaku.textContent = s;
  };
  const barkDisable = (msg: string) => {
    if (!chimeBtn) return;
    chimeBtn.setAttribute("aria-disabled", "true");
    setTanzaku(msg);
  };

  let busy = false;
  async function barkFire() {
    if (!chimeBtn || busy) return;
    busy = true;
    setTanzaku("推送中…");
    try {
      const res = await fetch("/api/bark", { method: "POST" });
      const data = (await res.json().catch(() => ({}))) as { error?: string };
      if (res.ok) {
        localStorage.setItem(BARK_LS, barkDay());
        barkDisable("已提醒 ✓");
      } else if (data.error === "daily_cap") {
        localStorage.setItem(BARK_LS, barkDay());
        barkDisable("名额已满");
      } else if (res.status === 429 || data.error === "already_sent") {
        localStorage.setItem(BARK_LS, barkDay());
        barkDisable("已提醒过啦");
      } else {
        setTanzaku("推送暂时失败，请到 GitHub 直接提申请");
      }
    } catch {
      setTanzaku("网络异常，请稍后再试");
    } finally {
      busy = false;
    }
  }

  // —— 竖直弹簧物理：往下拉挂绳，松手弹回（拉一下就是提示） ——
  const STRING_BASE = 34; // 挂绳静止长度（px）
  const MAX_PULL = 90; // 最大下拉距离（px）
  const MIN_PULL = -10; // 上推距离（挂绳压缩下限）
  const SPRING_K = 34; // 弹簧刚度 /s²
  const SPRING_C = 4.2; // 阻尼 /s
  const G_LAT = 900; // 横向单摆重力 /s²（等效摆长约 100px）
  const DAMP_LAT = 0.8; // 横向阻尼 /s
  const MAX_SWING = 0.7; // 横向最大摆角（rad ≈ 40°，右缘不出屏）
  let offset = 0; // 挂绳伸长量（正 = 下拉）
  let vel = 0; // px/s
  let swing = 0; // 横向摆角（rad，0 = 铅直）
  let swingVel = 0;
  let dragging = false;
  let grabBase = 0; // 抓住时的指针 Y
  let grabX = 0; // 抓住时的指针 X
  let grabY = 0; // 抓住时的指针 Y
  let grabOffset = 0; // 抓住时的位移
  let grabSwing = 0; // 抓住时的摆角
  let lastSwing = 0;
  let lastOffset = 0;
  let lastMoveY = 0;
  let lastMoveT = 0;
  let frameRaf = 0;
  let lastFrame = 0;

  function renderChime() {
    if (!chimeBtn) return;
    const stringEl = chimeBtn.querySelector(
      ".bark-chime__string"
    ) as HTMLElement | null;
    if (stringEl) {
      stringEl.style.height = `${STRING_BASE + Math.max(-22, offset)}px`;
    }
    if (chimeBtn) {
      // swing 以物理约定存值（正 = 向右），CSS rotate 正角是顺时针——
      // 挂点在上方时顺时针会让铃体向左跑，渲染取负号才是「向右拉风铃向右」
      chimeBtn.style.transform = `rotate(${(-((swing * 180) / Math.PI)).toFixed(2)}deg)`;
    }
  }

  function stepPhysics(dt: number, now: number) {
    if (dragging) return;
    // 弹簧回弹 + 一点环境风：静止时也有呼吸般的微沉微浮
    const wind = Math.sin(now / 1100) * 0.5;
    vel += (-SPRING_K * offset - SPRING_C * vel + wind) * dt;
    offset += vel * dt;
    if (offset < MIN_PULL) {
      offset = MIN_PULL;
      vel = Math.abs(vel) * 0.3;
    }
    // 横向单摆 + 环境风：静止时也有呼吸般的微晃
    const breeze = Math.sin(now / 900) * 0.1;
    swingVel +=
      (-(G_LAT / 100) * Math.sin(swing) - DAMP_LAT * swingVel + breeze) * dt;
    swing += swingVel * dt;
    if (Math.abs(swing) > MAX_SWING) {
      swing = Math.sign(swing) * MAX_SWING;
      swingVel *= -0.4;
    }
    renderChime();
  }

  function frame(now: number) {
    const dt = lastFrame ? Math.min(0.05, (now - lastFrame) / 1000) : 0.016;
    lastFrame = now;
    stepPhysics(dt, now);
    frameRaf = requestAnimationFrame(frame);
  }
  if (!prefersReducedMotion) frameRaf = requestAnimationFrame(frame);

  // —— 拉拽交互：抓住拖动（横竖都可），松手即推送 ——
  function onChimeDown(e: PointerEvent) {
    if (busy) return;
    dragging = true;
    grabX = e.clientX;
    grabY = e.clientY;
    grabSwing = swing;
    grabOffset = offset;
    lastSwing = swing;
    lastOffset = offset;
    lastMoveY = e.clientY;
    lastMoveT = performance.now();
    chimeBtn?.classList.add("is-grabbed");
  }
  chimeBtn?.addEventListener("pointerdown", onChimeDown);

  window.addEventListener(
    "pointermove",
    (e) => {
      if (!dragging) return;
      const dx = e.clientX - grabX;
      const dy = e.clientY - grabY;
      // 横向用 asin 反解：铃体横移严格等于鼠标横移（贴合鼠标不脱手），
      // 悬挂长度 = 挂绳 + 铃体中心偏移；纵向 1:1 跟随
      const HANG_LEN = STRING_BASE + 14;
      swing = Math.asin(Math.max(-0.99, Math.min(0.99, dx / HANG_LEN)));
      offset = Math.max(
        MIN_PULL,
        Math.min(MAX_PULL, grabOffset + (e.clientY - grabBase))
      );
      const now = performance.now();
      const dtm = Math.max(16, now - lastMoveT);
      swingVel = (swing - lastSwing) / dtm;
      vel = Math.max(
        -420,
        Math.min(480, ((e.clientY - lastMoveY) / dtm) * 1000)
      );
      lastSwing = swing;
      lastOffset = offset;
      lastMoveY = e.clientY;
      lastMoveT = now;
      renderChime();
    },
  );
  function onRelease() {
    if (!dragging) return;
    dragging = false;
    chimeBtn?.classList.remove("is-grabbed");
    // 松手速度取自指针：甩得多狠弹得多高
    vel = Math.max(-420, Math.min(480, vel));
    swingVel = Math.max(-5, Math.min(5, swingVel));
    if (prefersReducedMotion) {
      offset = 0;
      vel = 0;
      swing = 0;
      swingVel = 0;
      renderChime();
    }
    barkFire(); // 拉一下就是提示：松手即推送（当日已限过则提示已提醒）
  }
  window.addEventListener("pointerup", onRelease);
  window.addEventListener(
    "pointercancel",
    () => {
      dragging = false;
      chimeBtn?.classList.remove("is-grabbed");
    }
  );

  // 键盘可达：Enter/Space 触发按钮原生 click（detail === 0 区分鼠标）
  document.addEventListener("click", (e) => {
    const t = (e.target as Element).closest?.("#bark-push");
    if (t && (e as MouseEvent).detail === 0) barkFire();
  });

  // 页面加载：当日已提醒则禁用（KV 传播延迟时的客户端兜底）
  document.addEventListener("astro:page-load", () => {
    placeChime();
    renderChime();
    if (localStorage.getItem(BARK_LS) === barkDay()) {
      barkDisable("今日已提醒过啦");
    }
  });
</script>
