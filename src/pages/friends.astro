---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import {
  SITE_NAME,
  SITE_URL,
  SITE_AVATAR,
  SITE_DESCRIPTION,
  SITE_SOCIAL,
} from "../consts";
import { FRIENDS } from "../data/friends";
import FriendTreeDialog from "../components/FriendTreeDialog.astro";

const github = SITE_SOCIAL.find((s) => s.icon === "mdi:github");
const avatarUrl = new URL(SITE_AVATAR, SITE_URL).href;
const bare = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
const friendItems = FRIENDS.map((f) => ({
  name: f.name,
  url: f.url,
  host: bare(f.url),
  desc: f.desc,
  avatar: f.avatar ?? null,
}));
---

<BaseLayout title="友链" description="友链：独立博客之间的互相推荐与交换。">
  <div class="page-shell page-shell--medium">
    <header class="page-head">
      <div class="page-head__row">
        <h1 class="page-head__title">友链</h1>
        <div class="page-head__asides">
          <button type="button" class="page-head__aside" data-friend-site-tree>
            本站二维码
          </button>
          <a
            href="https://www.travellings.cn/go.html"
            class="page-head__aside"
            target="_blank"
            rel="noopener noreferrer">开往 →</a
          >
        </div>
      </div>
    </header>

    <section class="mb-14" aria-labelledby="site-info-label">
      <h2 class="section-label section-label--plain" id="site-info-label">本站信息</h2>

      <dl class="friend-info">
        <div>
          <dt>名称</dt>
          <dd>{SITE_NAME}</dd>
        </div>
        <div>
          <dt>地址</dt>
          <dd>{bare(SITE_URL)}</dd>
        </div>
        <div>
          <dt>头像</dt>
          <dd>{bare(avatarUrl)}</dd>
        </div>
        <div class="friend-info__wide">
          <dt>简介</dt>
          <dd>{SITE_DESCRIPTION}</dd>
        </div>
      </dl>

      <div class="friend-bark">
        <button type="button" id="bark-push" class="friend-bark-btn">
          申请友链 · 推送提醒给站长
        </button>
        <p class="friend-bark-hint" aria-live="polite">
          点击推送到站长手机，每天限一次；然后到
          {github && <a href={github.href} target="_blank" rel="noopener noreferrer">GitHub</a>}
          提交申请即可。
        </p>
      </div>
    </section>

    {FRIENDS.length > 0 && (
      <section aria-labelledby="friends-label">
        <h2 class="sr-only" id="friends-label">友链</h2>

        <ul class="friend-grid" data-friend-grid>
          {FRIENDS.map((friend, i) => (
            <li class="friend-item reveal" style={`--reveal-delay: ${Math.min(i * 60, 300)}ms`}>
              <button
                type="button"
                class="friend-card"
                data-friend-select={i}
                aria-haspopup="dialog"
              >
                {friend.avatar ? (
                  <img
                    class="friend-avatar"
                    src={friend.avatar}
                    alt=""
                    width="44"
                    height="44"
                    loading="lazy"
                  />
                ) : (
                  <span class="friend-avatar friend-avatar--fallback" aria-hidden="true">
                    {friend.name.slice(0, 1)}
                  </span>
                )}
                <span class="friend-body">
                  <span class="friend-name">{friend.name}</span>
                  {friend.desc && <span class="friend-desc">{friend.desc}</span>}
                  <span class="friend-host">{bare(friend.url)}</span>
                </span>
                <span class="friend-qr" aria-hidden="true">
                  <Icon name="mdi:qrcode" />
                </span>
                <span class="sr-only">打开二维码</span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <FriendTreeDialog
    friends={friendItems}
    siteName={SITE_NAME}
    siteUrl={SITE_URL}
    siteDesc={SITE_DESCRIPTION}
    siteAvatar={SITE_AVATAR}
  />
</BaseLayout>

<style>
  .friend-item {
    position: relative;
  }

  .friend-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .friend-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    padding: 1.1rem 1.15rem;
    border: 0;
    border-radius: 4px;
    background: rgba(28, 28, 28, 0.035);
    font: inherit;
    text-align: left;
    color: var(--color-ed-fg);
    cursor: pointer;
    transition: background-color 180ms ease;
  }
  .friend-card:hover,
  .friend-card:focus-visible {
    background: rgba(166, 58, 43, 0.07);
  }
  .friend-card:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: -2px;
  }
  .friend-card:hover .friend-name,
  .friend-card:focus-visible .friend-name {
    color: var(--color-ed-accent);
  }
  .friend-card:hover .friend-qr,
  .friend-card:focus-visible .friend-qr {
    color: var(--color-ed-accent);
    opacity: 1;
  }

  .friend-avatar {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
    background: rgba(28, 28, 28, 0.06);
  }
  .friend-avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--color-ed-muted);
  }

  .friend-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .friend-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.4;
    transition: color 180ms ease;
  }
  .friend-desc {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-ed-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .friend-host {
    overflow-wrap: anywhere;
    font-size: 0.6875rem;
    color: var(--color-ed-subtle);
  }

  /* 卡片右侧的二维码提示：让人知道点开是二维码，而不是直接跳走 */
  .friend-qr {
    margin-left: auto;
    align-self: center;
    flex: none;
    color: var(--color-ed-subtle);
    opacity: 0.5;
    transition: color 180ms ease, opacity 180ms ease;
  }
  .friend-qr :global(svg) {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
  }

  .friend-info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.95rem 2.5rem;
    margin: 0;
    padding: 1.3rem 1.35rem;
    border-radius: 4px;
    background: rgba(28, 28, 28, 0.035);
  }
  .friend-info > div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .friend-info__wide {
    grid-column: 1 / -1;
  }
  .friend-info dt {
    flex: 0 0 2.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-ed-subtle);
  }
  .friend-info dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 0.8125rem;
    color: var(--color-ed-fg);
  }

  .friend-bark {
    margin-top: 1.25rem;
  }
  .friend-bark-btn {
    padding: 0.55rem 1.2rem;
    border: 1px solid var(--color-ed-rule-strong);
    border-radius: 4px;
    background: transparent;
    font: inherit;
    color: var(--color-ed-fg);
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }
  .friend-bark-btn:hover:not([aria-disabled="true"]) {
    color: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
    background: rgba(166, 58, 43, 0.06);
  }
  .friend-bark-btn[aria-disabled="true"] {
    color: var(--color-ed-subtle);
    border-color: var(--color-ed-hairline);
    cursor: default;
  }
  .friend-bark-hint {
    margin: 0.7rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-ed-muted);
  }
  .friend-bark-hint a {
    color: var(--color-ed-fg);
    text-decoration: underline;
    text-decoration-color: var(--color-ed-subtle);
  }

  /* 页头右侧：本站二维码 + 开往（按钮态样式走全局 button.page-head__aside） */
  .page-head__asides {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .friend-grid,
    .friend-info {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Bark 推送：点击 → POST /api/bark（Worker 限每人每天一次 + 转发到站长 Bark）。
  // 推送成功/当日已提醒则禁用按钮；失败（502/503）可重试。
  // 模块级 document 委托，VT 换页安全
  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element).closest?.(
      "#bark-push"
    ) as HTMLButtonElement | null;
    if (!btn || btn.dataset.busy === "1" || btn.getAttribute("aria-disabled") === "true") {
      return;
    }
    const hint = document.getElementById("bark-hint");
    const baseText = btn.textContent;
    btn.dataset.busy = "1";
    btn.textContent = "推送中…";
    try {
      const res = await fetch("/api/bark", { method: "POST" });
      const data = (await res.json().catch(() => ({}))) as { error?: string };
      if (res.ok) {
        btn.textContent = "今日已提醒 ✓";
        btn.setAttribute("aria-disabled", "true");
        if (hint) hint.textContent = "提醒已送达站长手机；记得到 GitHub 提交申请。";
      } else if (data.error === "daily_cap") {
        btn.textContent = "今日名额已满";
        btn.setAttribute("aria-disabled", "true");
        if (hint) hint.textContent = "今天的提醒额度已被领完，明天再来吧。";
      } else if (res.status === 429 || data.error === "already_sent") {
        btn.textContent = "今日已提醒过啦";
        btn.setAttribute("aria-disabled", "true");
        if (hint) hint.textContent = "每人每天一次，明天再来提醒我吧。";
      } else {
        btn.textContent = baseText;
        if (hint) hint.textContent = "推送暂时失败，请到 GitHub 直接提申请。";
      }
    } catch {
      btn.textContent = baseText;
      if (hint) hint.textContent = "网络异常，请稍后再试。";
    } finally {
      btn.dataset.busy = "0";
    }
  });
</script>
