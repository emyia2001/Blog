---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import {
  SITE_NAME,
  SITE_URL,
  SITE_AVATAR,
  SITE_DESCRIPTION,
  SITE_SOCIAL,
} from "../consts";
import { FRIENDS } from "../data/friends";
import { fetchFriendFeeds } from "../utils/friendFeeds";
import FriendTreeDialog from "../components/FriendTreeDialog.astro";

const github = SITE_SOCIAL.find((s) => s.icon === "mdi:github");
const avatarUrl = new URL(SITE_AVATAR, SITE_URL).href;
const bare = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
const friendItems = FRIENDS.map((f) => ({
  name: f.name,
  url: f.url,
  host: bare(f.url),
  desc: f.desc,
  avatar: f.avatar ?? null,
}));

// 友链最新文章（构建期抓取，每日定时构建自动刷新；失败只 warn 不挂构建）
const friendFeeds = await fetchFriendFeeds(FRIENDS);
const fmtDay = (iso: string) =>
  new Date(iso).toLocaleDateString("zh-CN", { month: "long", day: "numeric" });
---

<BaseLayout title="友链" description="友链：独立博客之间的互相推荐与交换。">
  <div class="page-shell page-shell--medium">
    <header class="page-head">
      <div class="page-head__row">
        <h1 class="page-head__title">友链</h1>
        <div class="page-head__asides">
          <button type="button" class="page-head__aside" data-friend-site-tree>
            本站二维码
          </button>
          <a
            href="https://www.travellings.cn/go.html"
            class="page-head__aside"
            target="_blank"
            rel="noopener noreferrer">开往 →</a
          >
        </div>
      </div>
    </header>

    {FRIENDS.length > 0 && (
      <section class="mb-14" aria-labelledby="friends-label">
        <h2 class="sr-only" id="friends-label">友链</h2>

        <ul class="friend-grid" data-friend-grid>
          {FRIENDS.map((friend, i) => (
            <li class="friend-item reveal" style={`--reveal-delay: ${Math.min(i * 60, 300)}ms`}>
              <button
                type="button"
                class="friend-card"
                data-friend-select={i}
                aria-haspopup="dialog"
              >
                {friend.avatar ? (
                  <img
                    class="friend-avatar"
                    src={friend.avatar}
                    alt=""
                    width="44"
                    height="44"
                    loading="lazy"
                  />
                ) : (
                  <span class="friend-avatar friend-avatar--fallback" aria-hidden="true">
                    {friend.name.slice(0, 1)}
                  </span>
                )}
                <span class="friend-body">
                  <span class="friend-name">{friend.name}</span>
                  {friend.desc && <span class="friend-desc">{friend.desc}</span>}
                  <span class="friend-host">{bare(friend.url)}</span>
                </span>
                <span class="friend-qr" aria-hidden="true">
                  <Icon name="mdi:qrcode" />
                </span>
                <span class="sr-only">打开二维码</span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    )}

    {friendFeeds.length > 0 && (
      <section class="mb-14" aria-labelledby="friend-posts-label">
        <h2 class="section-label section-label--plain" id="friend-posts-label">
          友链文章
        </h2>
        <div class="friend-posts">
          {friendFeeds.map((feed) => (
            <div class="friend-feed reveal">
              <h3 class="friend-feed__site">
                <a href={feed.url} target="_blank" rel="noopener noreferrer">
                  {feed.name}
                </a>
              </h3>
              <ul class="friend-feed__list">
                {feed.posts.map((p) => (
                  <li class="friend-feed__item">
                    <a
                      class="friend-feed__title"
                      href={p.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {p.title}
                    </a>
                    {p.date && <time class="friend-feed__date">{fmtDay(p.date)}</time>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <section aria-labelledby="site-info-label">
      <h2 class="section-label section-label--plain" id="site-info-label">本站信息</h2>

      <dl class="friend-info">
        <div>
          <dt>名称</dt>
          <dd>{SITE_NAME}</dd>
        </div>
        <div>
          <dt>地址</dt>
          <dd>{bare(SITE_URL)}</dd>
        </div>
        <div>
          <dt>头像</dt>
          <dd>{bare(avatarUrl)}</dd>
        </div>
        <div class="friend-info__wide">
          <dt>简介</dt>
          <dd>{SITE_DESCRIPTION}</dd>
        </div>
      </dl>

      {github && (
        <p class="friend-apply">
          欢迎交换友链：把本站信息加到你的友链页后，到
          <a href={github.href} target="_blank" rel="noopener noreferrer">GitHub</a>
          告诉我。
        </p>
      )}
    </section>
  </div>

  <FriendTreeDialog
    friends={friendItems}
    siteName={SITE_NAME}
    siteUrl={SITE_URL}
    siteDesc={SITE_DESCRIPTION}
    siteAvatar={SITE_AVATAR}
  />
</BaseLayout>

<style>
  .friend-item {
    position: relative;
  }

  .friend-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .friend-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    padding: 1.1rem 1.15rem;
    border: 0;
    border-radius: 4px;
    background: rgba(28, 28, 28, 0.035);
    font: inherit;
    text-align: left;
    color: var(--color-ed-fg);
    cursor: pointer;
    transition: background-color 180ms ease;
  }
  .friend-card:hover,
  .friend-card:focus-visible {
    background: rgba(166, 58, 43, 0.07);
  }
  .friend-card:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: -2px;
  }
  .friend-card:hover .friend-name,
  .friend-card:focus-visible .friend-name {
    color: var(--color-ed-accent);
  }
  .friend-card:hover .friend-qr,
  .friend-card:focus-visible .friend-qr {
    color: var(--color-ed-accent);
    opacity: 1;
  }

  .friend-avatar {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
    background: rgba(28, 28, 28, 0.06);
  }
  .friend-avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--color-ed-muted);
  }

  .friend-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .friend-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.4;
    transition: color 180ms ease;
  }
  .friend-desc {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-ed-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .friend-host {
    overflow-wrap: anywhere;
    font-size: 0.6875rem;
    color: var(--color-ed-subtle);
  }

  /* 卡片右侧的二维码提示：让人知道点开是二维码，而不是直接跳走 */
  .friend-qr {
    margin-left: auto;
    align-self: center;
    flex: none;
    color: var(--color-ed-subtle);
    opacity: 0.5;
    transition: color 180ms ease, opacity 180ms ease;
  }
  .friend-qr :global(svg) {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
  }

  /* 友链文章：每个站点一块，标题行 + 日期，外链新窗口打开 */
  .friend-posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .friend-feed {
    padding: 1.1rem 1.15rem 1.25rem;
    border-radius: 4px;
    background: rgba(28, 28, 28, 0.035);
  }
  .friend-feed__site {
    margin: 0 0 0.65rem;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 400;
  }
  .friend-feed__site a {
    color: var(--color-ed-fg);
    transition: color 180ms ease;
  }
  .friend-feed__site a:hover {
    color: var(--color-ed-accent);
  }
  .friend-feed__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .friend-feed__item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .friend-feed__title {
    min-width: 0;
    overflow: hidden;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ed-fg);
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 180ms ease;
  }
  .friend-feed__title:hover {
    color: var(--color-ed-accent);
  }
  .friend-feed__title::after {
    content: " ↗";
    font-size: 0.75rem;
    color: var(--color-ed-subtle);
  }
  .friend-feed__date {
    flex: none;
    font-size: 0.6875rem;
    color: var(--color-ed-subtle);
  }

  .friend-info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.95rem 2.5rem;
    margin: 0;
    padding: 1.3rem 1.35rem;
    border-radius: 4px;
    background: rgba(28, 28, 28, 0.035);
  }
  .friend-info > div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .friend-info__wide {
    grid-column: 1 / -1;
  }
  .friend-info dt {
    flex: 0 0 2.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-ed-subtle);
  }
  .friend-info dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 0.8125rem;
    color: var(--color-ed-fg);
  }

  .friend-apply {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    line-height: 1.75;
    color: var(--color-ed-muted);
  }
  .friend-apply a {
    color: var(--color-ed-fg);
    text-decoration: underline;
    text-decoration-color: var(--color-ed-subtle);
    text-underline-offset: 0.15em;
  }

  /* 页头右侧：本站二维码 + 开往（按钮态样式走全局 button.page-head__aside） */
  .page-head__asides {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .friend-grid,
    .friend-posts,
    .friend-info {
      grid-template-columns: 1fr;
    }
  }
</style>
