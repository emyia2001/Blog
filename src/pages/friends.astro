---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import {
  SITE_NAME,
  SITE_URL,
  SITE_AVATAR,
  SITE_DESCRIPTION,
} from "../consts";
import { FRIENDS } from "../data/friends";
import FriendTreeDialog from "../components/FriendTreeDialog.astro";

const avatarUrl = new URL(SITE_AVATAR, SITE_URL).href;
const bare = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
const friendItems = FRIENDS.map((f) => ({
  name: f.name,
  url: f.url,
  host: bare(f.url),
  desc: f.desc,
  avatar: f.avatar ?? null,
}));
---

<BaseLayout title="友链" description="友链：独立博客之间的互相推荐与交换。">
  <div class="page-shell page-shell--medium">
    <header class="page-head">
      <div class="page-head__row">
        <h1 class="page-head__title">友链</h1>
      </div>
    </header>

    <section class="mb-14" aria-labelledby="site-info-label">
      <h2 class="section-label section-label--plain" id="site-info-label">本站信息</h2>

      <dl class="friend-info">
        <div>
          <dt>名称</dt>
          <dd>{SITE_NAME}</dd>
        </div>
        <div>
          <dt>地址</dt>
          <dd>{bare(SITE_URL)}</dd>
        </div>
        <div>
          <dt>头像</dt>
          <dd>{bare(avatarUrl)}</dd>
        </div>
        <div class="friend-info__wide">
          <dt>简介</dt>
          <dd>{SITE_DESCRIPTION}</dd>
        </div>
      </dl>

      <div class="friend-bark">
        <div class="bark-widget">
          <span class="bark-widget__hook" aria-hidden="true"></span>
          <span class="bark-widget__string" aria-hidden="true"></span>
          <button
            type="button"
            id="bark-push"
            class="bark-widget__btn"
            aria-label="申请友链 · 摇铃推送提醒给站长"
          >
            <svg
              class="bark-widget__bell"
              viewBox="0 0 24 24"
              width="17"
              height="17"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3a5 5 0 0 0-5 5v3.6c0 .6-.2 1.2-.6 1.7L5 15.4c-.5.7 0 1.6.9 1.6h12.2c.9 0 1.4-.9.9-1.6l-1.4-2.1a2.9 2.9 0 0 1-.6-1.7V8a5 5 0 0 0-5-5Z"></path>
              <path d="M10 19.5a2 2 0 0 0 4 0"></path>
            </svg>
            <span class="bark-widget__text">申请友链</span>
          </button>
          <span class="bark-widget__status" id="bark-hint" aria-live="polite">
            点击摇铃，推送提醒到站长手机
          </span>
        </div>
      </div>
    </section>

    {FRIENDS.length > 0 && (
      <section aria-labelledby="friends-label">
        <h2 class="sr-only" id="friends-label">友链</h2>

        <ul class="friend-grid" data-friend-grid>
          {FRIENDS.map((friend, i) => (
            <li class="friend-item reveal" style={`--reveal-delay: ${Math.min(i * 60, 300)}ms`}>
              <button
                type="button"
                class="friend-card"
                data-friend-select={i}
                aria-haspopup="dialog"
              >
                {friend.avatar ? (
                  <img
                    class="friend-avatar"
                    src={friend.avatar}
                    alt=""
                    width="44"
                    height="44"
                    loading="lazy"
                  />
                ) : (
                  <span class="friend-avatar friend-avatar--fallback" aria-hidden="true">
                    {friend.name.slice(0, 1)}
                  </span>
                )}
                <span class="friend-body">
                  <span class="friend-name">{friend.name}</span>
                  {friend.desc && <span class="friend-desc">{friend.desc}</span>}
                  <span class="friend-host">{bare(friend.url)}</span>
                </span>
                <span class="friend-qr" aria-hidden="true">
                  <Icon name="mdi:qrcode" />
                </span>
                <span class="sr-only">打开二维码</span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <FriendTreeDialog
    friends={friendItems}
    siteName={SITE_NAME}
    siteUrl={SITE_URL}
    siteDesc={SITE_DESCRIPTION}
    siteAvatar={SITE_AVATAR}
  />
</BaseLayout>

<style>
  .friend-item {
    position: relative;
  }

  .friend-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .friend-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    padding: 1.1rem 1.15rem;
    border: 0;
    border-radius: 4px;
    background: rgba(28, 28, 28, 0.035);
    font: inherit;
    text-align: left;
    color: var(--color-ed-fg);
    cursor: pointer;
    transition: background-color 180ms ease;
  }
  .friend-card:hover,
  .friend-card:focus-visible {
    background: rgba(166, 58, 43, 0.07);
  }
  .friend-card:focus-visible {
    outline: 2px solid var(--color-ed-accent);
    outline-offset: -2px;
  }
  .friend-card:hover .friend-name,
  .friend-card:focus-visible .friend-name {
    color: var(--color-ed-accent);
  }
  .friend-card:hover .friend-qr,
  .friend-card:focus-visible .friend-qr {
    color: var(--color-ed-accent);
    opacity: 1;
  }

  .friend-avatar {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
    background: rgba(28, 28, 28, 0.06);
  }
  .friend-avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--color-ed-muted);
  }

  .friend-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .friend-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.4;
    transition: color 180ms ease;
  }
  .friend-desc {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-ed-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .friend-host {
    overflow-wrap: anywhere;
    font-size: 0.6875rem;
    color: var(--color-ed-subtle);
  }

  /* 卡片右侧的二维码提示：让人知道点开是二维码，而不是直接跳走 */
  .friend-qr {
    margin-left: auto;
    align-self: center;
    flex: none;
    color: var(--color-ed-subtle);
    opacity: 0.5;
    transition: color 180ms ease, opacity 180ms ease;
  }
  .friend-qr :global(svg) {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
  }

  .friend-info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.95rem 2.5rem;
    margin: 0;
    padding: 1.3rem 1.35rem;
    border-radius: 4px;
    background: rgba(28, 28, 28, 0.035);
  }
  .friend-info > div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .friend-info__wide {
    grid-column: 1 / -1;
  }
  .friend-info dt {
    flex: 0 0 2.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-ed-subtle);
  }
  .friend-info dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 0.8125rem;
    color: var(--color-ed-fg);
  }

  /* 申请友链挂件：吊环 + 挂绳 + 铃铛卡片，随呼吸轻摆；悬停摇铃，推送中摆幅加快 */
  .friend-bark {
    display: flex;
    justify-content: center;
    padding-top: 1.5rem;
  }
  .bark-widget {
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: top center;
    animation: bark-sway 5.6s ease-in-out infinite;
  }
  .bark-widget__hook {
    width: 9px;
    height: 9px;
    border: 1.5px solid var(--color-ed-rule);
    border-radius: 50%;
  }
  .bark-widget__string {
    width: 1px;
    height: 14px;
    background: var(--color-ed-rule);
  }
  .bark-widget__btn {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 1.15rem 0.7rem;
    border: 1px solid var(--color-ed-rule);
    border-radius: 4px;
    background: var(--color-ed-bg);
    font: inherit;
    color: var(--color-ed-fg);
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }
  .bark-widget__btn:hover:not([aria-disabled="true"]),
  .bark-widget__btn:focus-visible {
    color: var(--color-ed-accent);
    border-color: var(--color-ed-accent);
    background: rgba(166, 58, 43, 0.05);
  }
  .bark-widget__btn[aria-disabled="true"] {
    color: var(--color-ed-subtle);
    border-color: var(--color-ed-hairline);
    cursor: default;
  }
  .bark-widget__btn:hover:not([aria-disabled="true"]) .bark-widget__bell {
    animation: bark-ring 0.9s var(--ease-ed);
  }
  .bark-widget__bell {
    transform-origin: top center;
  }
  .bark-widget__text {
    font-size: 0.875rem;
    letter-spacing: 0.02em;
  }
  .bark-widget__status {
    margin-top: 0.5rem;
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--color-ed-subtle);
    max-width: 15rem;
    text-align: center;
  }
  .bark-widget:has(#bark-push[data-busy="1"]) {
    animation-duration: 1.6s;
  }
  .bark-widget:has(#bark-push[aria-disabled="true"]) {
    animation: none;
  }
  @keyframes bark-sway {
    0%,
    100% {
      transform: rotate(-1.4deg);
    }
    50% {
      transform: rotate(1.4deg);
    }
  }
  @keyframes bark-ring {
    0% {
      transform: rotate(0);
    }
    20% {
      transform: rotate(13deg);
    }
    40% {
      transform: rotate(-11deg);
    }
    60% {
      transform: rotate(7deg);
    }
    80% {
      transform: rotate(-4deg);
    }
    100% {
      transform: rotate(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bark-widget,
    .bark-widget__btn:hover .bark-widget__bell {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .friend-grid,
    .friend-info {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Bark 推送：点击 → POST /api/bark（Worker 限每人每天一次 + 转发到站长 Bark）。
  // 推送成功/当日已提醒则禁用按钮；失败（502/503）可重试。
  // KV 是最终一致（跨边缘读不到刚写的记录），秒级双击会在服务端漏过——
  // 浏览器侧再用 localStorage 记当日已提醒，双保险。模块级委托，VT 换页安全
  const BARK_LS = "friend-bark:last-day";
  const barkDay = () =>
    new Date().toLocaleDateString("sv-SE", { timeZone: "Asia/Shanghai" });
  document.addEventListener("astro:page-load", () => {
    // 当日已提醒过：进页面就禁用按钮（KV 传播延迟时的客户端兜底）
    if (localStorage.getItem(BARK_LS) === barkDay()) {
      const btn = document.getElementById("bark-push") as HTMLButtonElement | null;
      const text = btn?.querySelector(".bark-widget__text");
      if (btn && text) {
        text.textContent = "今日已提醒过啦";
        btn.setAttribute("aria-disabled", "true");
      }
    }
  });
  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element).closest?.(
      "#bark-push"
    ) as HTMLButtonElement | null;
    if (!btn || btn.dataset.busy === "1" || btn.getAttribute("aria-disabled") === "true") {
      return;
    }
    const hint = document.getElementById("bark-hint");
    const text = btn.querySelector(".bark-widget__text") as HTMLElement | null;
    const baseText = text?.textContent ?? "";
    btn.dataset.busy = "1";
    if (text) text.textContent = "推送中…";
    try {
      const res = await fetch("/api/bark", { method: "POST" });
      const data = (await res.json().catch(() => ({}))) as { error?: string };
      if (res.ok) {
        localStorage.setItem(BARK_LS, barkDay());
        if (text) text.textContent = "今日已提醒 ✓";
        btn.setAttribute("aria-disabled", "true");
        if (hint) hint.textContent = "提醒已送达站长手机；记得到 GitHub 提交申请。";
      } else if (data.error === "daily_cap") {
        localStorage.setItem(BARK_LS, barkDay());
        if (text) text.textContent = "今日名额已满";
        btn.setAttribute("aria-disabled", "true");
        if (hint) hint.textContent = "今天的提醒额度已被领完，明天再来吧。";
      } else if (res.status === 429 || data.error === "already_sent") {
        localStorage.setItem(BARK_LS, barkDay());
        if (text) text.textContent = "今日已提醒过啦";
        btn.setAttribute("aria-disabled", "true");
        if (hint) hint.textContent = "每人每天一次，明天再来提醒我吧。";
      } else {
        if (text) text.textContent = baseText;
        if (hint) hint.textContent = "推送暂时失败，请到 GitHub 直接提申请。";
      }
    } catch {
      if (text) text.textContent = baseText;
      if (hint) hint.textContent = "网络异常，请稍后再试。";
    } finally {
      btn.dataset.busy = "0";
    }
  });
</script>
