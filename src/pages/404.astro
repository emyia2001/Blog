---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — 页面未找到">
  <section class="py-32 md:py-48 px-6 text-center">
    <h1 class="font-serif text-8xl md:text-9xl text-[var(--color-ed-fg)]">
      404
    </h1>
    <p class="mt-6 text-sm md:text-base text-[var(--color-ed-muted)]">
      您访问的页面不存在。
    </p>
    <a
      href="/"
      class="hover-underline inline-block mt-8 text-sm text-[var(--color-ed-fg)]"
    >
      &larr; 返回首页
    </a>
  </section>
</BaseLayout>
