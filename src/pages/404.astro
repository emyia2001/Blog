---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — 页面未找到"
  description="页面不存在。可以回到首页，或看看归档与纪事。"
  noindex
>
  <div class="page-shell page-shell--narrow">
    <section class="py-28 text-center md:py-40">
      <h1
        class="mt-4 font-serif leading-none text-[clamp(4.5rem,16vw,8rem)] text-[var(--color-ed-fg)]"
      >
        404
      </h1>
      <p class="mx-auto mt-6 max-w-md text-sm leading-relaxed text-[var(--color-ed-muted)]">
        这个页面不存在，可能是链接过期、地址拼错，或者内容已经被移走了。
      </p>
      <nav
        class="mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 text-sm"
        aria-label="404 页面导航"
      >
        <a href="/" class="hover-underline hit-24 text-[var(--color-ed-fg)]">返回首页</a>
        <a href="/archive/" class="hover-underline hit-24 text-[var(--color-ed-fg)]">浏览归档</a>
        <a href="/timeline/" class="hover-underline hit-24 text-[var(--color-ed-fg)]">看看纪事</a>
      </nav>
    </section>
  </div>
</BaseLayout>
