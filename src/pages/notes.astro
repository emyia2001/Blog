---
import { getCollection } from "astro:content";
import { execSync } from "node:child_process";
import BaseLayout from "../layouts/BaseLayout.astro";

// 取文件的 git 提交时间（作者时间，含时区，精确到分钟）作为随感的展示与排序依据，
// 这样从 CMS 发文后无需手填 date。无 git 信息时回退到 frontmatter 的 date。
function gitCommitDate(path: string | undefined): { iso: string; ms: number } | null {
  if (!path) return null;
  try {
    const out = execSync(`git log -1 --format=%aI -- "${path}"`, {
      encoding: "utf-8",
    }).trim();
    if (!out) return null;
    const ms = new Date(out).getTime();
    if (Number.isNaN(ms)) return null;
    return { iso: out, ms };
  } catch {
    return null;
  }
}

const all = await getCollection("notes");
const notes = all
  .filter((n) => !n.data.draft)
  .map((n) => {
    const c = gitCommitDate(n.filePath);
    const date = c ? new Date(c.ms) : n.data.date;
    return { entry: n, date: date ?? new Date(0), iso: c?.iso };
  })
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const rendered = await Promise.all(
  notes.map(async ({ entry, date, iso }) => {
    const display = iso
      ? iso.slice(0, 16).replace("T", " ")
      : date.toLocaleString("zh-CN", {
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
          hour: "2-digit",
          minute: "2-digit",
        });
    return {
      data: entry.data,
      Content: (await entry.render()).Content,
      datetime: iso ?? date.toISOString(),
      display,
    };
  })
);
---

<BaseLayout title="随感">
  <section class="py-24 md:py-32 px-6">
    <div class="mx-auto max-w-2xl">
      <h1 class="font-serif text-3xl md:text-4xl tracking-tighter text-[var(--color-ed-fg)] mb-3">
        随感
      </h1>
      <p class="text-xs tracking-[0.3em] text-[var(--color-ed-muted)] mb-14">NOTES</p>

      {rendered.length > 0 ? (
        <div class="space-y-12">
          {rendered.map(({ data, Content, datetime, display }) => (
            <article class="border-b border-[var(--color-ed-faint)] pb-10">
              <div class="flex items-baseline gap-4 mb-4">
                <time
                  datetime={datetime}
                  class="text-xs text-[var(--color-ed-subtle)] tabular-nums shrink-0"
                >
                  {display}
                </time>
                {data.title && (
                  <h2 class="font-serif text-xl text-[var(--color-ed-fg)] leading-snug">
                    {data.title}
                  </h2>
                )}
              </div>
              <div class="prose notes-prose">
                <Content />
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-[var(--color-ed-muted)]">暂无随感。</p>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  function styleNoteSources() {
    document.querySelectorAll(".notes-prose p").forEach((p) => {
      if (p.dataset.noteSrc) return;
      const text = p.textContent ?? "";
      const m = text.match(/^(.*)\s*[—–-]{1,2}\s*(.+?)\s*$/);
      if (m) {
        p.textContent = m[1].trim();
        const span = document.createElement("span");
        span.className = "note-source";
        span.textContent = "—— ".normalize("NFC").replace("——", "——") + m[2];
        p.appendChild(span);
        p.dataset.noteSrc = "1";
      }
    });
  }
  styleNoteSources();
  document.addEventListener("astro:page-load", styleNoteSources);
</script>
