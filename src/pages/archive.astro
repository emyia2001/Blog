---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TagCloud from "../components/TagCloud.astro";
import { postPath } from "../utils/urls";

const allPosts = await getCollection("posts");
const allMoments = await getCollection("moments");
const publishedPosts = allPosts.filter((p) => !p.data.draft);
// 归档收「回顾型」纪事（person/event）；日记流水（diary）只在 /timeline 看
const publishedMoments = allMoments.filter(
  (m) => !m.data.draft && m.data.type !== "diary"
);

type Entry = {
  kind: "post" | "person" | "event";
  title: string;
  date: Date;
  url: string;
};

const fmtShort = (d: Date) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });

const entries: Entry[] = [
  ...publishedPosts.map((p) => ({
    kind: "post" as const,
    title: p.data.title,
    date: p.data.date,
    url: postPath(p),
  })),
  ...publishedMoments.map((m) => ({
    kind: m.data.type as "person" | "event",
    title: m.data.title ?? fmtShort(m.data.date),
    date: m.data.date,
    url: "/timeline/",
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

// 全局序号：跨年份连续，避免每年都从 01 重新开始（读者会以为是同一篇）
const entryNo = new Map<Entry, string>(
  entries.map((e, i) => [e, String(i + 1).padStart(2, "0")])
);

// Group by year, sorted newest first
const byYear = new Map<number, Entry[]>();
for (const e of entries) {
  const year = e.date.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(e);
}

const years = [...byYear.keys()].sort((a, b) => b - a);
for (const year of years) {
  byYear.get(year)!.sort((a, b) => b.date.getTime() - a.date.getTime());
}

const kindLabel = (k: Entry["kind"]) =>
  k === "post" ? "文章" : k === "person" ? "人物" : "事件";
---

<BaseLayout title="归档" description="按时间倒序浏览全部文章、人物与事件。">
  <div class="page-shell page-shell--medium">
    <header class="page-head">
      <div class="page-head__row">
        <h1 class="page-head__title">归档 <small>Archive</small></h1>
        <a href="/timeline/" class="page-head__aside">纪事时间线 →</a>
      </div>
      <p class="page-head__dek">
        按时间倒序排在一条轴上：长文、人物与事件共用同一套编号，
        年份只作分组，不打断阅读顺序。
      </p>
      <p class="page-head__meta">
        {publishedPosts.length} 篇文章 · {publishedMoments.length} 条人物 / 事件
      </p>
    </header>

    <section class="mb-14 reveal" aria-labelledby="tag-cloud-label">
      <h2 class="section-label" id="tag-cloud-label">标签</h2>
      <TagCloud />
    </section>

    <section aria-labelledby="all-content-label">
      <h2 class="section-label" id="all-content-label">全部内容</h2>

      {years.length === 0 ? (
        <p class="empty-note">暂无内容。</p>
      ) : (
        years.map((year) => (
          <div class="mb-12 reveal">
            <h3 class="year-label">
              <span class="year-label__num">{year}</span>
              <span class="year-label__count">
                {byYear.get(year)!.length} 条
              </span>
            </h3>
            <ol class="entry-list">
              {byYear.get(year)!.map((e) => (
                <li>
                  <a href={e.url} class="entry-row">
                    <span class="entry-row__no">{entryNo.get(e)}</span>
                    <span class="entry-row__title">{e.title}</span>
                    <span class="kind-chip entry-row__kind">
                      {kindLabel(e.kind)}
                    </span>
                    <time
                      class="entry-row__date"
                      datetime={e.date.toISOString()}
                    >
                      {e.date.toLocaleDateString("zh-CN", {
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      )}
    </section>
  </div>
</BaseLayout>
