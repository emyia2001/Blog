---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import GraphView from "../components/GraphView.astro";
import { buildGraphData } from "../utils/graphData";
import { postPath } from "../utils/urls";

const allPosts = await getCollection("posts");
const allMoments = await getCollection("moments");
const publishedPosts = allPosts.filter((p) => !p.data.draft);
// 归档收「回顾型」纪事（person/event）；日记流水（diary）只在 /timeline 看
const publishedMoments = allMoments.filter(
  (m) => !m.data.draft && m.data.type !== "diary"
);

type Entry = {
  kind: "post" | "person" | "event";
  title: string;
  date: Date;
  url: string;
};

const fmtShort = (d: Date) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });

const entries: Entry[] = [
  ...publishedPosts.map((p) => ({
    kind: "post" as const,
    title: p.data.title,
    date: p.data.date,
    url: postPath(p),
  })),
  ...publishedMoments.map((m) => ({
    kind: m.data.type as "person" | "event",
    title: m.data.title ?? fmtShort(m.data.date),
    date: m.data.date,
    url: "/timeline/",
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

// 全局序号：跨年份连续，避免每年都从 01 重新开始（读者会以为是同一篇）
const entryNo = new Map<Entry, string>(
  entries.map((e, i) => [e, String(i + 1).padStart(2, "0")])
);

// Group by year, sorted newest first
const byYear = new Map<number, Entry[]>();
for (const e of entries) {
  const year = e.date.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(e);
}

const years = [...byYear.keys()].sort((a, b) => b - a);
for (const year of years) {
  byYear.get(year)!.sort((a, b) => b.date.getTime() - a.date.getTime());
}

// 关系图谱（原独立 /graph 页并入此处）：Obsidian 式——只有内容节点与真实关联边，
// 友链内容不入图（展示移至 /friends 页的「友链文章」）
const graphData = buildGraphData(allPosts, allMoments);
const graphNodes = graphData.nodes;
const graphLinks = graphData.links;

const kindLabel = (k: Entry["kind"]) =>
  k === "post" ? "文章" : k === "person" ? "人物" : "事件";

// 只有混合类型时标签才有信息量：全是文章时每行都标「文章」等于没标
const mixedKinds = new Set(entries.map((e) => e.kind)).size > 1;
---

<BaseLayout title="归档" description="按时间倒序浏览全部文章、人物与事件。">
  <div class="page-shell">
    <header class="page-head">
      <div class="page-head__row">
        <h1 class="page-head__title">归档</h1>
        <div class="flex items-center gap-4">
          <button
            type="button"
            data-open-search
            class="page-head__aside page-head__icon"
            aria-label="搜索"
            title="搜索"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M16.3 16.3 21 21"></path>
            </svg>
          </button>
          <a
            href="/tags/"
            class="page-head__aside page-head__icon"
            aria-label="全部标签"
            title="全部标签"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3.2 13.2V4a1 1 0 0 1 1-1h9.2l7.2 7.6a2 2 0 0 1 0 2.8Z"></path>
              <circle cx="7.8" cy="7.8" r="1.3" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <section class="graph-section" aria-label="关系图谱">
      {graphNodes.length > 1 ? (
        <div class="graph-thumb">
          <GraphView nodes={graphNodes} links={graphLinks} />
          <span class="graph-thumb-chip" aria-hidden="true">关系图谱</span>
          <button
            type="button"
            class="graph-thumb-open"
            aria-label="展开关系图谱"
            title="展开关系图谱"
          ></button>
        </div>
      ) : (
        <p class="empty-note">暂无内容。</p>
      )}
    </section>

    <section aria-labelledby="all-content-label">
      <h2 class="sr-only" id="all-content-label">全部内容</h2>

      {years.length === 0 ? (
        <p class="empty-note">暂无内容。</p>
      ) : (
        years.map((year, i) => (
          <div
            class="mb-12 reveal"
            style={`--reveal-delay: ${Math.min(i, 5) * 60}ms`}
          >
            <h3 class="year-label">
              <span class="year-label__num">{year}</span>
              <span class="year-label__count">
                {byYear.get(year)!.length} 条
              </span>
            </h3>
            <ol class="entry-list">
              {byYear.get(year)!.map((e) => (
                <li>
                  <a href={e.url} class="entry-row">
                    <span class="entry-row__no">{entryNo.get(e)}</span>
                    <span class="entry-row__title">{e.title}</span>
                    {mixedKinds && (
                      <span class="kind-chip entry-row__kind">
                        {kindLabel(e.kind)}
                      </span>
                    )}
                    <time
                      class="entry-row__date"
                      datetime={e.date.toISOString()}
                    >
                      {e.date.toLocaleDateString("zh-CN", {
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      )}
    </section>
  </div>
</BaseLayout>

<style>
  /* 关系图谱缩略条：MiniGraph 同规格的活体预览，整条可点 → 全屏展开。
     展开时 .graph-layout 脱离本容器挂到 body，控制按钮等 chrome 随之
     恢复显示；还原落位后 chrome 重新隐藏——作用域天然切换，无需 JS。
     上下间距与页头底距同值，保持节奏对称 */
  .graph-section {
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .graph-thumb {
    position: relative;
    --graph-h: 13rem;
  }
  .graph-thumb :global(.graph-controls),
  .graph-thumb :global(.graph-legend),
  .graph-thumb :global(.graph-hint) {
    display: none;
  }
  .graph-thumb-chip {
    position: absolute;
    top: 0.6rem;
    left: 0.7rem;
    z-index: 3;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    color: var(--color-ed-subtle);
    pointer-events: none;
  }
  .graph-thumb-open {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    transition: background-color 180ms ease;
  }
  .graph-thumb-open:hover,
  .graph-thumb-open:focus-visible {
    background: rgba(166, 58, 43, 0.04);
  }

  /* 页头图标按钮（搜索 / 全部标签）：细线 SVG，悬停变砖红 + 微底色 */
  .page-head__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 4px;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }
  .page-head__icon svg {
    display: block;
  }
  .page-head__icon:hover,
  .page-head__icon:focus-visible {
    background: rgba(166, 58, 43, 0.06);
  }
</style>

<script>
  // 关系图谱缩略条：整条可点，广播 graph:expand 让 GraphView 全屏展开；
  // 还原落位即回到缩略条，无收回逻辑。模块级委托，VT 换页安全
  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest?.(".graph-thumb-open")) return;
    document.dispatchEvent(new CustomEvent("graph:expand"));
  });
</script>
