---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TagCloud from "../components/TagCloud.astro";

const allPosts = await getCollection("posts");
const allMoments = await getCollection("moments");
const publishedPosts = allPosts.filter((p) => !p.data.draft);
const publishedMoments = allMoments.filter((m) => !m.data.draft);

type Entry = {
  kind: "post" | "person" | "event";
  title: string;
  date: Date;
  url: string;
};

const entries: Entry[] = [
  ...publishedPosts.map((p) => ({
    kind: "post" as const,
    title: p.data.title,
    date: p.data.date,
    url: `/blog/${p.id.replace(/\.mdx$/, "")}`,
  })),
  ...publishedMoments.map((m) => ({
    kind: m.data.type as "person" | "event",
    title: m.data.title,
    date: m.data.date,
    url: "/timeline",
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

// Group by year, sorted newest first
const byYear = new Map<number, Entry[]>();
for (const e of entries) {
  const year = e.date.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(e);
}

const years = [...byYear.keys()].sort((a, b) => b - a);
for (const year of years) {
  byYear.get(year)!.sort((a, b) => b.date.getTime() - a.date.getTime());
}

const kindLabel = (k: Entry["kind"]) =>
  k === "post" ? "文章" : k === "person" ? "人物" : "事件";
---

<BaseLayout title="归档">
  <section class="py-24 md:py-32 px-6">
    <div class="mx-auto max-w-2xl">
      <h1
        class="font-serif text-3xl md:text-4xl tracking-tighter text-[var(--color-ed-fg)] mb-16"
      >
        归档
      </h1>

      <div class="mb-20">
        <h2 class="font-serif text-sm tracking-[0.2em] uppercase text-[var(--color-ed-subtle)] mb-6">
          标签
        </h2>
        <TagCloud />
      </div>

      <h2 class="font-serif text-sm tracking-[0.2em] uppercase text-[var(--color-ed-subtle)] mb-10">
        全部内容
      </h2>

      {years.length === 0 ? (
        <p class="text-[var(--color-ed-muted)]">暂无内容。</p>
      ) : (
        years.map((year) => (
          <div class="mb-14">
            <div class="font-mono text-xs text-[var(--color-ed-subtle)] mb-6 tabular-nums">
              {year}
            </div>
            <ol>
              {byYear.get(year)!.map((e, i) => (
                <li class="border-b border-[var(--color-ed-faint)] py-6 first:border-t">
                  <a
                    href={e.url}
                    class="group flex items-baseline gap-6 no-underline"
                  >
                    <span class="font-mono text-xs text-[var(--color-ed-subtle)] tabular-nums shrink-0">
                      NO.{String(i + 1).padStart(2, "0")}
                    </span>
                    <span class="font-serif text-lg text-[var(--color-ed-fg)] group-hover:text-[var(--color-ed-muted)] transition-colors">
                      {e.title}
                    </span>
                    <span class="shrink-0 text-[10px] tracking-[0.05em] text-[var(--color-ed-subtle)]">
                      {kindLabel(e.kind)}
                    </span>
                    <span class="ml-auto shrink-0 text-xs text-[var(--color-ed-subtle)] tabular-nums">
                      {e.date.toLocaleDateString("zh-CN", {
                        month: "short",
                        day: "numeric",
                      })}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      )}
    </div>
  </section>
</BaseLayout>
